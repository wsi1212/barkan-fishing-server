# =========================================
# 마켓.sk
# 유저 마켓 (Player Market) 시스템
# /마켓 — 마켓 GUI 열기
# =========================================

options:
    prefix: &8[&6 마켓 &8]
    good: &a
    bad: &c
    hint: &7
    emph: &e
    info: &f
    gui_main: &6유저 마켓
    gui_sell: &6아이템 등록
    gui_mylist: &6내 판매 목록
    gui_confirm: &6구매 확인
    max_listings: 5
    list_fee_rate: 5
    expiry_secs: 172800
    min_mat_price: 50

# ===== 마켓 ID 생성 =====
function 마켓ID생성() :: text:
    if {마켓카운터} is not set:
        set {마켓카운터} to 0
    add 1 to {마켓카운터}
    set {_n} to {마켓카운터}
    # 6자리 패딩 (간단히)
    set {_id} to "MKT%{_n}%"
    return {_id}

# ===== 거래 가능 아이템 여부 =====
function 마켓거래가능(item: item) :: boolean:
    loop lore of {_item}:
        if loop-value contains "[물고기]":
            return true
        if loop-value contains "[조합 재료]":
            return true
    return false

# ===== 아이템 최소 판매가 계산 =====
function 마켓최소가격(item: item) :: number:
    # 물고기: fishprice 함수 활용
    loop lore of {_item}:
        if loop-value contains "[물고기]":
            set {_grade} to parsegrade({_item})
            if {_grade} is not "":
                set {_quality} to parsequality({_item})
                return fishprice({_grade}, {_quality})
    # 조합 재료: 50골드
    return {@min_mat_price}

# ===== 만료 아이템 처리 =====
function 마켓만료처리(id: text):
    set {_seller} to {마켓::%{_id}%::판매자}
    if {_seller} is not set:
        stop
    set {_item} to {마켓::%{_id}%::아이템}

    # 판매자 온라인이면 직접 지급, 아니면 우편함
    set {_sellerPl} to player {_seller}
    if {_sellerPl} is set:
        if {_item} is set:
            if {_sellerPl} can hold {_item}:
                give {_item} to {_sellerPl}
            else:
                drop {_item} at {_sellerPl}'s location
        message "{@prefix} {@hint}등록하신 아이템의 판매 기간이 만료되어 반환되었습니다." to {_sellerPl}
    else:
        # 우편함에 저장
        if {_item} is set:
            set {_mailIdx} to size of {우편::%{_seller}%::*} + 1
            set {우편::%{_seller}%::%{_mailIdx}%} to {_item}
            add {_mailIdx} to {우편::%{_seller}%::*}

    # 마켓 데이터 삭제
    remove {_id} from {마켓목록::*}
    delete {마켓::%{_id}%::판매자}
    delete {마켓::%{_id}%::아이템이름}
    delete {마켓::%{_id}%::아이템타입}
    delete {마켓::%{_id}%::가격}
    delete {마켓::%{_id}%::수량}
    delete {마켓::%{_id}%::등록시간}
    delete {마켓::%{_id}%::만료시간}
    delete {마켓::%{_id}%::아이템}

# ===== 만료 아이템 일괄 체크 =====
function 마켓만료체크():
    if {마켓목록::*} is not set:
        stop
    set {_now} to unix timestamp of now
    set {_expired::*} to {마켓목록::*}
    loop {_expired::*}:
        set {_id} to loop-value
        set {_exp} to {마켓::%{_id}%::만료시간}
        if {_exp} is set:
            if {_exp} < {_now}:
                마켓만료처리({_id})

# ===== 내 활성 등록 수 =====
function 마켓활성등록수(seller: text) :: number:
    set {_count} to 0
    if {마켓목록::*} is not set:
        return 0
    loop {마켓목록::*}:
        if {마켓::%loop-value%::판매자} is {_seller}:
            add 1 to {_count}
    return {_count}

# ===== 메인 마켓 GUI 열기 =====
function 마켓GUI열기(p: player, page: number):
    마켓만료체크()

    set {_page} to {_page}
    if {_page} <= 0:
        set {_page} to 1

    open chest with 6 rows named "{@gui_main}" to {_p}

    # 전체 목록 수집
    delete {_ids::*}
    if {마켓목록::*} is set:
        loop {마켓목록::*}:
            add loop-value to {_ids::*}

    set {_total} to size of {_ids::*}
    set {_maxPage} to max(1, ceil({_total} / 45))
    if {_page} > {_maxPage}:
        set {_page} to {_maxPage}

    set {마켓페이지::%{_p}%} to {_page}

    set {_start} to ({_page} - 1) * 45 + 1
    set {_end} to min({_total}, {_start} + 44)

    # 아이템 슬롯 채우기 (0~44)
    loop integers from 0 to 44:
        set slot loop-integer of {_p}'s current inventory to air

    set {_slot} to 0
    loop integers from {_start} to {_end}:
        set {_id} to {_ids::%loop-integer%}
        if {_id} is set:
            set {_listItem} to {마켓::%{_id}%::아이템}
            if {_listItem} is set:
                set {_price} to {마켓::%{_id}%::가격}
                set {_seller} to {마켓::%{_id}%::판매자}
                set {_qty} to {마켓::%{_id}%::수량}
                set {_exp} to {마켓::%{_id}%::만료시간}
                set {_now} to unix timestamp of now
                set {_remain} to {_exp} - {_now}
                set {_remainHr} to floor({_remain} / 3600)
                # 새 아이템 복사본에 마켓 lore 추가
                set {_displayItem} to {_listItem}
                set {_lore::*} to lore of {_displayItem}
                add "" to {_lore::*}
                add "&7판매자: &f%{_seller}%" to {_lore::*}
                add "&7가격: &e%{_price}%골드" to {_lore::*}
                add "&7수량: &f%{_qty}%" to {_lore::*}
                add "&7남은 시간: &f%{_remainHr}%시간" to {_lore::*}
                add "" to {_lore::*}
                add "&a클릭하여 구매" to {_lore::*}
                set lore of {_displayItem} to {_lore::*}
                set {마켓슬롯ID::%{_p}%::%{_slot}%} to {_id}
                set slot {_slot} of {_p}'s current inventory to {_displayItem}
        add 1 to {_slot}

    # 하단 네비게이션 바
    # 슬롯 45: 이전 페이지
    if {_page} > 1:
        set slot 45 of {_p}'s current inventory to arrow named "&7◀ 이전 페이지"
    else:
        set slot 45 of {_p}'s current inventory to gray stained glass pane named "&8이전 페이지 없음"

    # 슬롯 46: 판매 등록
    set slot 46 of {_p}'s current inventory to chest named "&a&l아이템 등록" with lore "&7클릭하여 아이템 판매 등록"

    # 슬롯 47: 내 목록
    set slot 47 of {_p}'s current inventory to book named "&e내 판매 목록" with lore "&7등록한 아이템 확인 및 취소"

    # 슬롯 48: 빈칸
    set slot 48 of {_p}'s current inventory to gray stained glass pane named "&f"

    # 슬롯 49: 정보
    set {_infoItem} to paper named "&f유저 마켓"
    set lore of {_infoItem} to "&7총 등록 아이템: &f%{_total}%개" and "&7페이지: &f%{_page}% / %{_maxPage}%" and "" and "&7등록 수수료: {@list_fee_rate}%% (비환불)" and "&7만료 기간: 48시간" and "&7최대 등록: {@max_listings}개"
    set slot 49 of {_p}'s current inventory to {_infoItem}

    # 슬롯 50: 빈칸
    set slot 50 of {_p}'s current inventory to gray stained glass pane named "&f"

    # 슬롯 51: 우편함 (미수령 아이템)
    set {_mailCount} to size of {우편::%{_p}%::*}
    if {_mailCount} > 0:
        set slot 51 of {_p}'s current inventory to chest_minecart named "&6우편함 &c(%{_mailCount}%)" with lore "&7만료된 아이템 %{_mailCount}%개 대기 중" and "&7클릭하여 수령"
    else:
        set slot 51 of {_p}'s current inventory to gray stained glass pane named "&8우편함 없음"

    # 슬롯 52: 빈칸
    set slot 52 of {_p}'s current inventory to gray stained glass pane named "&f"

    # 슬롯 53: 다음 페이지
    if {_page} < {_maxPage}:
        set slot 53 of {_p}'s current inventory to arrow named "&7다음 페이지 ▶"
    else:
        set slot 53 of {_p}'s current inventory to gray stained glass pane named "&8다음 페이지 없음"

# ===== 아이템 등록 GUI =====
function 마켓등록GUI열기(p: player):
    open chest with 3 rows named "{@gui_sell}" to {_p}
    # 슬롯 0: 아이템 넣는 칸
    set slot 0 of {_p}'s current inventory to air
    # 설명
    set slot 2 of {_p}'s current inventory to paper named "&f사용법" with lore "&71. 왼쪽 슬롯에 판매할 아이템을 넣으세요" and "&72. 가격 설정: &e/마켓가격 <금액>" and "&73. 등록 버튼 클릭" and "" and "&7거래 가능: &f물고기, 조합 재료" and "&c거래 불가: 장비, 낚싯대, 부품"
    # 슬롯 4: 가격 표시
    set {_price} to {마켓등록가격::%{_p}%}
    if {_price} is not set:
        set {_price} to 0
    set {_priceItem} to gold_ingot named "&e판매 가격: %{_price}%골드"
    set lore of {_priceItem} to "&7채팅에 &e/마켓가격 <금액> &7입력" and "&7수수료: {@list_fee_rate}%% 선불 (비환불)"
    set slot 4 of {_p}'s current inventory to {_priceItem}
    # 슬롯 6: 등록 버튼
    set slot 6 of {_p}'s current inventory to lime_dye named "&a&l등록하기" with lore "&7아이템과 가격 설정 후 클릭"
    # 슬롯 8: 취소
    set slot 8 of {_p}'s current inventory to barrier named "&c취소"

    # 슬롯 9-17: 구분선
    loop integers from 9 to 17:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&f"
    # 슬롯 13: 수수료 안내
    set {_feeItem} to paper named "&7수수료 안내"
    set lore of {_feeItem} to "&7등록 시 판매 가격의 {@list_fee_rate}%%를 선불로 납부합니다." and "&7아이템이 팔리지 않더라도 수수료는 환불되지 않습니다."
    set slot 13 of {_p}'s current inventory to {_feeItem}

    # 슬롯 18-26: 미리보기
    set slot 18 of {_p}'s current inventory to gray stained glass pane named "&f"
    set slot 19 of {_p}'s current inventory to gray stained glass pane named "&f"
    set slot 20 of {_p}'s current inventory to gray stained glass pane named "&f"

# ===== 내 판매 목록 GUI =====
function 마켓내목록GUI열기(p: player):
    open chest with 6 rows named "{@gui_mylist}" to {_p}

    set {_slot} to 0
    if {마켓목록::*} is set:
        loop {마켓목록::*}:
            set {_id} to loop-value
            if {마켓::%{_id}%::판매자} is {_p}'s name:
                if {_slot} < 45:
                    set {_item} to {마켓::%{_id}%::아이템}
                    if {_item} is set:
                        set {_price} to {마켓::%{_id}%::가격}
                        set {_exp} to {마켓::%{_id}%::만료시간}
                        set {_now} to unix timestamp of now
                        set {_remainHr} to floor(({_exp} - {_now}) / 3600)
                        set {_displayItem} to {_item}
                        set {_lore::*} to lore of {_displayItem}
                        add "" to {_lore::*}
                        add "&7가격: &e%{_price}%골드" to {_lore::*}
                        add "&7남은 시간: &f%{_remainHr}%시간" to {_lore::*}
                        add "" to {_lore::*}
                        add "&c우클릭: 등록 취소 (수수료 미환불)" to {_lore::*}
                        set lore of {_displayItem} to {_lore::*}
                        set {마켓내목록슬롯::%{_p}%::%{_slot}%} to {_id}
                        set slot {_slot} of {_p}'s current inventory to {_displayItem}
                        add 1 to {_slot}

    # 빈 슬롯 채우기
    loop integers from {_slot} to 44:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&8빈 슬롯"

    # 하단
    loop integers from 45 to 53:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&f"
    set slot 49 of {_p}'s current inventory to arrow named "&7← 마켓으로 돌아가기"
    set slot 45 of {_p}'s current inventory to paper named "&f내 등록 현황" with lore "&7활성 등록: &f%{_slot}% / {@max_listings}개"

# ===== 구매 확인 GUI =====
function 마켓구매확인GUI열기(p: player, id: text):
    set {마켓구매확인ID::%{_p}%} to {_id}
    open chest with 3 rows named "{@gui_confirm}" to {_p}

    set {_item} to {마켓::%{_id}%::아이템}
    set {_price} to {마켓::%{_id}%::가격}
    set {_seller} to {마켓::%{_id}%::판매자}

    loop integers from 0 to 26:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&f"

    if {_item} is set:
        set {_displayItem} to {_item}
        set {_lore::*} to lore of {_displayItem}
        add "" to {_lore::*}
        add "&7판매자: &f%{_seller}%" to {_lore::*}
        add "&7가격: &e%{_price}%골드" to {_lore::*}
        set lore of {_displayItem} to {_lore::*}
        set slot 13 of {_p}'s current inventory to {_displayItem}

    # 확인
    set {_myMoney} to {돈::%{_p}%}
    if {_myMoney} is not set:
        set {_myMoney} to 0
    if {_myMoney} >= {_price}:
        set slot 11 of {_p}'s current inventory to lime_dye named "&a&l구매 확인" with lore "&7가격: &e%{_price}%골드" and "&7잔액: &f%{_myMoney}%골드" and "&7구매 후 잔액: &f%({_myMoney} - {_price})%골드"
    else:
        set slot 11 of {_p}'s current inventory to red_dye named "&c골드 부족" with lore "&7가격: &e%{_price}%골드" and "&c잔액: &f%{_myMoney}%골드 &c(부족)"
    set slot 15 of {_p}'s current inventory to barrier named "&c취소"

# ===== /마켓 명령어 =====
command /마켓:
    aliases: /akfex
    trigger:
        마켓GUI열기(player, 1)

# ===== /마켓가격 명령어 — 등록 GUI에서 가격 설정 =====
command /마켓가격 [<text>]:
    aliases: /akfexrkrur
    trigger:
        if arg-1 is not set:
            message "{@prefix} {@hint}사용법: {@emph}/마켓가격 <금액>" to player
            stop
        set {_amount} to arg-1 parsed as integer
        if {_amount} is not set:
            message "{@prefix} {@bad}올바른 금액을 입력해주세요." to player
            stop
        if {_amount} <= 0:
            message "{@prefix} {@bad}가격은 1 이상이어야 합니다." to player
            stop
        set {마켓등록가격::%player%} to {_amount}
        message "{@prefix} {@good}판매 가격을 {@emph}%{_amount}%골드&a로 설정했습니다." to player
        # GUI 갱신
        if name of player's current inventory is "{@gui_sell}":
            마켓등록GUI열기(player)

# ===== 마켓 메인 GUI 클릭 =====
on inventory click:
    if name of player's current inventory is "{@gui_main}":
        cancel event
        set {_slot} to index of clicked slot

        # 슬롯 0~44: 아이템 구매
        if {_slot} >= 0:
            if {_slot} <= 44:
                set {_id} to {마켓슬롯ID::%player%::%{_slot}%}
                if {_id} is set:
                    if {마켓::%{_id}%::판매자} is player's name:
                        message "{@prefix} {@bad}자신의 아이템은 구매할 수 없습니다. {@hint}내 판매 목록에서 취소하세요." to player
                        stop
                    마켓구매확인GUI열기(player, {_id})
                stop

        # 슬롯 45: 이전 페이지
        if {_slot} is 45:
            set {_page} to {마켓페이지::%player%}
            if {_page} is not set:
                set {_page} to 1
            if {_page} > 1:
                마켓GUI열기(player, {_page} - 1)
            stop

        # 슬롯 46: 아이템 등록
        if {_slot} is 46:
            # 최대 등록 수 체크
            set {_active} to 마켓활성등록수(player's name)
            if {_active} >= {@max_listings}:
                message "{@prefix} {@bad}최대 등록 수({@max_listings}개)를 초과했습니다." to player
                stop
            마켓등록GUI열기(player)
            stop

        # 슬롯 47: 내 목록
        if {_slot} is 47:
            마켓내목록GUI열기(player)
            stop

        # 슬롯 49: 정보 (무시)
        if {_slot} is 49:
            stop

        # 슬롯 51: 우편함
        if {_slot} is 51:
            if {우편::%player%::*} is set:
                loop {우편::%player%::*}:
                    set {_mailItem} to {우편아이템::%player%::%loop-value%}
                    if {_mailItem} is not set:
                        set {_mailItem} to {우편::%player%::%loop-value%}
                    if {_mailItem} is set:
                        if player can hold {_mailItem}:
                            give {_mailItem} to player
                        else:
                            drop {_mailItem} at player's location
                delete {우편::%player%::*}
                message "{@prefix} {@good}우편함 아이템을 모두 수령했습니다." to player
                마켓GUI열기(player, 1)
            else:
                message "{@prefix} {@hint}수령할 아이템이 없습니다." to player
            stop

        # 슬롯 53: 다음 페이지
        if {_slot} is 53:
            set {_page} to {마켓페이지::%player%}
            if {_page} is not set:
                set {_page} to 1
            마켓GUI열기(player, {_page} + 1)
            stop

# ===== 아이템 등록 GUI 클릭 =====
on inventory click:
    if name of player's current inventory is "{@gui_sell}":
        set {_slot} to index of clicked slot

        # 슬롯 0: 아이템 넣기/빼기 허용 (단, 거래 불가 차단)
        if {_slot} is 0:
            set {_clickedItem} to event-item
            if {_clickedItem} is not air:
                if 마켓거래가능({_clickedItem}) is false:
                    cancel event
                    message "{@prefix} {@bad}이 아이템은 마켓에 등록할 수 없습니다. {@hint}(물고기, 조합 재료만 가능)" to player
                    stop
            stop

        # 슬롯 4: 가격 설정 안내
        if {_slot} is 4:
            cancel event
            message "{@prefix} {@hint}채팅에 {@emph}/마켓가격 <금액> {@hint}을 입력하세요." to player
            stop

        # 슬롯 6: 등록 버튼
        if {_slot} is 6:
            cancel event
            # 아이템 체크
            set {_listItem} to slot 0 of player's current inventory
            if {_listItem} is air:
                message "{@prefix} {@bad}등록할 아이템을 슬롯에 넣어주세요." to player
                stop
            if 마켓거래가능({_listItem}) is false:
                message "{@prefix} {@bad}이 아이템은 마켓에 등록할 수 없습니다." to player
                stop

            # 가격 체크
            set {_price} to {마켓등록가격::%player%}
            if {_price} is not set:
                message "{@prefix} {@bad}가격을 먼저 설정해주세요. ({@emph}/마켓가격 <금액>&c)" to player
                stop
            if {_price} <= 0:
                message "{@prefix} {@bad}가격은 1 이상이어야 합니다." to player
                stop

            # 최소 가격 체크
            set {_minPrice} to 마켓최소가격({_listItem})
            if {_price} < {_minPrice}:
                message "{@prefix} {@bad}최소 판매가는 {@emph}%{_minPrice}%골드&c입니다." to player
                stop

            # 수수료 계산 및 차감
            set {_fee} to floor({_price} * {@list_fee_rate} / 100)
            if {돈::%player%} is not set:
                set {돈::%player%} to 0
            if {돈::%player%} < {_fee}:
                message "{@prefix} {@bad}등록 수수료 {@emph}%{_fee}%골드&c가 부족합니다. {@hint}현재 잔액: {@emph}%{돈::%player%}%골드" to player
                stop

            # 최대 등록 수 체크
            set {_active} to 마켓활성등록수(player's name)
            if {_active} >= {@max_listings}:
                message "{@prefix} {@bad}최대 등록 수({@max_listings}개)를 초과했습니다." to player
                stop

            # 등록 처리
            remove {_fee} from {돈::%player%}
            set {_id} to 마켓ID생성()
            set {_qty} to item amount of {_listItem}
            set {_now} to unix timestamp of now

            set {마켓::%{_id}%::판매자} to player's name
            set {마켓::%{_id}%::아이템이름} to name of {_listItem}
            set {마켓::%{_id}%::가격} to {_price}
            set {마켓::%{_id}%::수량} to {_qty}
            set {마켓::%{_id}%::등록시간} to {_now}
            set {마켓::%{_id}%::만료시간} to {_now} + {@expiry_secs}
            set {마켓::%{_id}%::아이템} to {_listItem}
            add {_id} to {마켓목록::*}

            # 인벤에서 아이템 제거
            set slot 0 of player's current inventory to air

            delete {마켓등록가격::%player%}
            close player's inventory

            message "{@prefix} {@good}아이템을 마켓에 등록했습니다!" to player
            message "{@prefix} {@hint}가격: {@emph}%{_price}%골드 {@hint}| 수수료: {@emph}%{_fee}%골드 {@hint}| 만료: 48시간 후" to player
            stop

        # 슬롯 8: 취소
        if {_slot} is 8:
            cancel event
            # 슬롯 0 아이템 반환
            set {_returnItem} to slot 0 of player's current inventory
            if {_returnItem} is not air:
                set slot 0 of player's current inventory to air
                if player can hold {_returnItem}:
                    give {_returnItem} to player
                else:
                    drop {_returnItem} at player's location
            close player's inventory
            stop

        # 나머지 슬롯 차단
        if {_slot} is not 0:
            cancel event

# ===== 내 판매 목록 GUI 클릭 =====
on inventory click:
    if name of player's current inventory is "{@gui_mylist}":
        cancel event
        set {_slot} to index of clicked slot

        # 슬롯 49: 마켓으로 돌아가기
        if {_slot} is 49:
            마켓GUI열기(player, 1)
            stop

        # 슬롯 0~44: 우클릭 = 등록 취소
        if {_slot} >= 0:
            if {_slot} <= 44:
                if mouse button is right:
                    set {_id} to {마켓내목록슬롯::%player%::%{_slot}%}
                    if {_id} is set:
                        # 아이템 반환
                        set {_item} to {마켓::%{_id}%::아이템}
                        if {_item} is set:
                            if player can hold {_item}:
                                give {_item} to player
                            else:
                                drop {_item} at player's location

                        # 마켓 데이터 삭제
                        remove {_id} from {마켓목록::*}
                        delete {마켓::%{_id}%::판매자}
                        delete {마켓::%{_id}%::아이템이름}
                        delete {마켓::%{_id}%::가격}
                        delete {마켓::%{_id}%::수량}
                        delete {마켓::%{_id}%::등록시간}
                        delete {마켓::%{_id}%::만료시간}
                        delete {마켓::%{_id}%::아이템}

                        message "{@prefix} {@good}등록 취소 완료. 아이템을 반환했습니다. {@hint}(수수료 미환불)" to player
                        마켓내목록GUI열기(player)
                    stop

# ===== 구매 확인 GUI 클릭 =====
on inventory click:
    if name of player's current inventory is "{@gui_confirm}":
        cancel event
        set {_slot} to index of clicked slot

        # 슬롯 11: 구매 확인
        if {_slot} is 11:
            set {_id} to {마켓구매확인ID::%player%}
            if {_id} is not set:
                close player's inventory
                stop

            # 만료 체크
            set {_exp} to {마켓::%{_id}%::만료시간}
            if {_exp} is not set:
                message "{@prefix} {@bad}해당 아이템은 더 이상 판매 중이지 않습니다." to player
                close player's inventory
                stop
            if {_exp} < unix timestamp of now:
                마켓만료처리({_id})
                message "{@prefix} {@bad}해당 아이템의 판매 기간이 만료되었습니다." to player
                close player's inventory
                stop

            set {_price} to {마켓::%{_id}%::가격}
            set {_seller} to {마켓::%{_id}%::판매자}
            set {_item} to {마켓::%{_id}%::아이템}

            if {돈::%player%} is not set:
                set {돈::%player%} to 0
            if {돈::%player%} < {_price}:
                message "{@prefix} {@bad}골드가 부족합니다. {@hint}현재 잔액: {@emph}%{돈::%player%}%골드" to player
                close player's inventory
                stop

            # 구매 처리
            remove {_price} from {돈::%player%}
            if {돈::%{_seller}%} is not set:
                set {돈::%{_seller}%} to 0
            add {_price} to {돈::%{_seller}%}

            # 아이템 지급
            if player can hold {_item}:
                give {_item} to player
            else:
                drop {_item} at player's location

            # 판매자에게 알림
            set {_sellerPl} to player {_seller}
            if {_sellerPl} is set:
                message "{@prefix} {@good}%player%&a님이 아이템을 구매했습니다! {@emph}%{_price}%골드 {@good}수령!" to {_sellerPl}

            # 마켓 데이터 삭제
            remove {_id} from {마켓목록::*}
            delete {마켓::%{_id}%::판매자}
            delete {마켓::%{_id}%::아이템이름}
            delete {마켓::%{_id}%::가격}
            delete {마켓::%{_id}%::수량}
            delete {마켓::%{_id}%::등록시간}
            delete {마켓::%{_id}%::만료시간}
            delete {마켓::%{_id}%::아이템}
            delete {마켓구매확인ID::%player%}

            message "{@prefix} {@good}구매 완료! {@hint}잔액: {@emph}%{돈::%player%}%골드" to player
            close player's inventory
            stop

        # 슬롯 15: 취소
        if {_slot} is 15:
            delete {마켓구매확인ID::%player%}
            close player's inventory
            마켓GUI열기(player, 1)
            stop

# ===== 로그인 시 우편함 알림 =====
on join:
    if {우편::%player%::*} is set:
        set {_cnt} to size of {우편::%player%::*}
        if {_cnt} > 0:
            message "{@prefix} {@emph}/마켓 {@hint}→ 우편함에 수령 대기 중인 아이템이 {@emph}%{_cnt}%개 {@hint}있습니다." to player

# ===== 1시간마다 만료 체크 =====
every 1 hour:
    마켓만료체크()
