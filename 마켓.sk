# =========================================
# 마켓.sk
# 유저 마켓 (Player Market) 시스템
# /마켓          — 마켓 GUI 열기 (구경/구매)
# /마켓등록 <가격> — 손에 든 아이템 등록
# /마켓취소       — 내 판매 목록 GUI (취소용)
# =========================================

options:
    prefix: &8[&6 마켓 &8]
    good: &a
    bad: &c
    hint: &7
    emph: &e
    info: &f
    gui_main: &6유저 마켓
    gui_mylist: &6내 판매 목록
    gui_confirm: &6구매 확인
    max_listings: 5
    list_fee_rate: 10
    expiry_secs: 172800
    min_mat_price: 50

# ===== 마켓 ID 생성 =====
function 마켓ID생성() :: text:
    if {마켓카운터} is not set:
        set {마켓카운터} to 0
    add 1 to {마켓카운터}
    return "MKT%{마켓카운터}%"

# ===== 거래 가능 아이템 여부 =====
function 마켓거래가능(item: item) :: boolean:
    loop lore of {_item}:
        if loop-value contains "[물고기]":
            return true
        if loop-value contains "[조합 재료]":
            return true
        # 기존 물고기 호환 (태그 없이 생성된 물고기)
        if loop-value contains "&8f:":
            return true
    return false

# ===== 아이템 최소 판매가 계산 =====
function 마켓최소가격(item: item) :: number:
    loop lore of {_item}:
        if loop-value contains "[물고기]":
            set {_grade} to parsegrade({_item})
            if {_grade} is not "":
                set {_quality} to parsequality({_item})
                return fishprice({_grade}, {_quality})
    return {@min_mat_price}

# ===== 만료 아이템 처리 =====
function 마켓만료처리(id: text):
    set {_seller} to {마켓::%{_id}%::판매자}
    if {_seller} is not set:
        stop
    set {_item} to {마켓::%{_id}%::아이템}

    # 판매자 온라인이면 직접 지급, 아니면 우편함
    delete {_sellerPl}
    loop all players:
        if loop-player's name is {_seller}:
            set {_sellerPl} to loop-player
            stop loop
    if {_sellerPl} is set:
        if {_item} is set:
            if {_sellerPl} can hold {_item}:
                give {_item} to {_sellerPl}
            else:
                drop {_item} at {_sellerPl}'s location
        message "{@prefix} {@hint}등록하신 아이템의 판매 기간이 만료되어 반환되었습니다." to {_sellerPl}
    else:
        if {_item} is set:
            set {_mailIdx} to size of {우편::%{_seller}%::*} + 1
            set {우편::%{_seller}%::%{_mailIdx}%} to {_item}
            add {_mailIdx} to {우편::%{_seller}%::*}

    # 마켓 로그 (파일)
    set {_iname} to {마켓::%{_id}%::아이템이름}
    if {_iname} is not set:
        set {_iname} to "?"
    set {_price} to {마켓::%{_id}%::가격}
    log "[만료] %now% | ID:%{_id}% | 판매자:%{_seller}% | 아이템:%{_iname}% | 가격:%{_price}%" to "마켓로그.log"

    # 마켓 데이터 삭제
    remove {_id} from {마켓목록::*}
    delete {마켓::%{_id}%::판매자}
    delete {마켓::%{_id}%::아이템이름}
    delete {마켓::%{_id}%::가격}
    delete {마켓::%{_id}%::수량}
    delete {마켓::%{_id}%::등록시간}
    delete {마켓::%{_id}%::만료시간}
    delete {마켓::%{_id}%::아이템}

# ===== 만료 아이템 일괄 체크 =====
function 마켓만료체크():
    if {마켓목록::*} is not set:
        stop
    set {_now} to unix timestamp of now
    set {_expired::*} to {마켓목록::*}
    loop {_expired::*}:
        set {_id} to loop-value
        set {_exp} to {마켓::%{_id}%::만료시간}
        if {_exp} is set:
            if {_exp} < {_now}:
                마켓만료처리({_id})

# ===== 내 활성 등록 수 =====
function 마켓활성등록수(seller: text) :: number:
    set {_count} to 0
    if {마켓목록::*} is not set:
        return 0
    loop {마켓목록::*}:
        if {마켓::%loop-value%::판매자} is {_seller}:
            add 1 to {_count}
    return {_count}

# ===== 메인 마켓 GUI 열기 =====
function 마켓GUI열기(p: player, page: number):
    마켓만료체크()

    set {_page} to {_page}
    if {_page} <= 0:
        set {_page} to 1

    open chest with 6 rows named "{@gui_main}" to {_p}

    # 전체 목록 수집
    delete {_ids::*}
    if {마켓목록::*} is set:
        loop {마켓목록::*}:
            add loop-value to {_ids::*}

    set {_total} to size of {_ids::*}
    set {_maxPage} to max(1, ceil({_total} / 45))
    if {_page} > {_maxPage}:
        set {_page} to {_maxPage}

    set {마켓페이지::%{_p}%} to {_page}

    set {_start} to ({_page} - 1) * 45 + 1
    set {_end} to min({_total}, {_start} + 44)

    # 아이템 슬롯 초기화
    loop integers from 0 to 44:
        set slot loop-integer of {_p}'s current inventory to air

    set {_slot} to 0
    loop integers from {_start} to {_end}:
        set {_id} to {_ids::%loop-integer%}
        if {_id} is set:
            set {_listItem} to {마켓::%{_id}%::아이템}
            if {_listItem} is set:
                set {_price} to {마켓::%{_id}%::가격}
                set {_seller} to {마켓::%{_id}%::판매자}
                set {_qty} to {마켓::%{_id}%::수량}
                set {_exp} to {마켓::%{_id}%::만료시간}
                set {_remainHr} to floor(({_exp} - unix timestamp of now) / 3600)
                set {_displayItem} to {_listItem}
                set {_lore::*} to lore of {_displayItem}
                add "" to {_lore::*}
                add "&7판매자: &f%{_seller}%" to {_lore::*}
                add "&7가격: &e%{_price}%골드" to {_lore::*}
                add "&7수량: &f%{_qty}%" to {_lore::*}
                add "&7남은 시간: &f%{_remainHr}%시간" to {_lore::*}
                add "" to {_lore::*}
                add "&a클릭하여 구매" to {_lore::*}
                set lore of {_displayItem} to {_lore::*}
                set {마켓슬롯ID::%{_p}%::%{_slot}%} to {_id}
                set slot {_slot} of {_p}'s current inventory to {_displayItem}
        add 1 to {_slot}

    # 하단 네비게이션 바
    loop integers from 45 to 53:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&f"

    # 슬롯 45: 이전 페이지
    if {_page} > 1:
        set slot 45 of {_p}'s current inventory to arrow named "&7◀ 이전 페이지"
    else:
        set slot 45 of {_p}'s current inventory to gray stained glass pane named "&8◀ 이전 페이지 없음"

    # 슬롯 46: 내 목록 / 취소
    set slot 46 of {_p}'s current inventory to book named "&e내 판매 목록" with lore "&7등록한 아이템 확인 및 취소" and "&7우클릭으로 등록 취소 가능"

    # 슬롯 48: 우편함
    set {_mailCount} to size of {우편::%{_p}%::*}
    if {_mailCount} > 0:
        set slot 48 of {_p}'s current inventory to chest_minecart named "&6우편함 &c(%{_mailCount}%)" with lore "&7만료 아이템 %{_mailCount}%개 대기 중" and "&7클릭하여 수령"
    else:
        set slot 48 of {_p}'s current inventory to gray stained glass pane named "&8우편함 없음"

    # 슬롯 49: 마켓 정보
    set {_active} to 마켓활성등록수({_p}'s name)
    set {_infoItem} to paper named "&f유저 마켓"
    set lore of {_infoItem} to "&7총 등록 아이템: &f%{_total}%개" and "&7페이지: &f%{_page}% / %{_maxPage}%" and "" and "&e등록: &f손에 아이템 들고 /마켓등록 <가격>" and "&e취소: &f왼쪽 책 아이콘 → 우클릭" and "" and "&7내 등록: &f%{_active}% / {@max_listings}개" and "&c판매 수수료: &f{@list_fee_rate}%% &7(판매 시 차감)" and "&7만료 기간: &f48시간"
    set slot 49 of {_p}'s current inventory to {_infoItem}

    # 슬롯 53: 다음 페이지
    if {_page} < {_maxPage}:
        set slot 53 of {_p}'s current inventory to arrow named "&7다음 페이지 ▶"
    else:
        set slot 53 of {_p}'s current inventory to gray stained glass pane named "&8다음 페이지 없음 ▶"

# ===== 내 판매 목록 GUI =====
function 마켓내목록GUI열기(p: player):
    open chest with 6 rows named "{@gui_mylist}" to {_p}

    set {_slot} to 0
    if {마켓목록::*} is set:
        loop {마켓목록::*}:
            set {_id} to loop-value
            if {마켓::%{_id}%::판매자} is {_p}'s name:
                if {_slot} < 45:
                    set {_item} to {마켓::%{_id}%::아이템}
                    if {_item} is set:
                        set {_price} to {마켓::%{_id}%::가격}
                        set {_remainHr} to floor(({마켓::%{_id}%::만료시간} - unix timestamp of now) / 3600)
                        set {_displayItem} to {_item}
                        set {_lore::*} to lore of {_displayItem}
                        add "" to {_lore::*}
                        add "&7가격: &e%{_price}%골드" to {_lore::*}
                        add "&7남은 시간: &f%{_remainHr}%시간" to {_lore::*}
                        add "" to {_lore::*}
                        add "&c우클릭: 등록 취소 (수수료 미환불)" to {_lore::*}
                        set lore of {_displayItem} to {_lore::*}
                        set {마켓내목록슬롯::%{_p}%::%{_slot}%} to {_id}
                        set slot {_slot} of {_p}'s current inventory to {_displayItem}
                        add 1 to {_slot}

    loop integers from {_slot} to 44:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&8빈 슬롯"

    loop integers from 45 to 53:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&f"
    set slot 45 of {_p}'s current inventory to paper named "&f내 등록 현황" with lore "&7활성 등록: &f%{_slot}% / {@max_listings}개"
    set slot 49 of {_p}'s current inventory to arrow named "&7← 마켓으로 돌아가기"

# ===== 구매 확인 GUI =====
function 마켓구매확인GUI열기(p: player, id: text):
    set {마켓구매확인ID::%{_p}%} to {_id}
    open chest with 3 rows named "{@gui_confirm}" to {_p}

    set {_item} to {마켓::%{_id}%::아이템}
    set {_price} to {마켓::%{_id}%::가격}
    set {_seller} to {마켓::%{_id}%::판매자}

    loop integers from 0 to 26:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&f"

    if {_item} is set:
        set {_displayItem} to {_item}
        set {_lore::*} to lore of {_displayItem}
        add "" to {_lore::*}
        add "&7판매자: &f%{_seller}%" to {_lore::*}
        add "&7가격: &e%{_price}%골드" to {_lore::*}
        set lore of {_displayItem} to {_lore::*}
        set slot 13 of {_p}'s current inventory to {_displayItem}

    set {_myMoney} to {돈::%{_p}%}
    if {_myMoney} is not set:
        set {_myMoney} to 0
    if {_myMoney} >= {_price}:
        set slot 11 of {_p}'s current inventory to lime_dye named "&a&l구매 확인" with lore "&7가격: &e%{_price}%골드" and "&7잔액: &f%{_myMoney}%골드" and "&7구매 후 잔액: &f%({_myMoney} - {_price})%골드"
    else:
        set slot 11 of {_p}'s current inventory to red_dye named "&c골드 부족" with lore "&7가격: &e%{_price}%골드" and "&c잔액: &f%{_myMoney}%골드 &c(부족)"
    set slot 15 of {_p}'s current inventory to barrier named "&c취소"

# ===== /마켓 — 마켓 GUI 열기 =====
command /마켓:
    aliases: /akfex
    trigger:
        마켓GUI열기(player, 1)

# ===== /마켓등록 <가격> — 손에 든 아이템 등록 =====
on tab complete of "/마켓등록":
    set tab completions for position 1 to "<가격>"

command /마켓등록 [<text>]:
    aliases: /akfexehf
    trigger:
        # 사용법
        if arg-1 is not set:
            message "{@prefix} {@hint}사용법: {@emph}/마켓등록 <가격>" to player
            message "{@prefix} {@hint}손에 든 아이템이 마켓에 등록됩니다." to player
            stop

        # 가격 파싱
        set {_price} to arg-1 parsed as integer
        if {_price} is not set:
            message "{@prefix} {@bad}가격은 숫자로 입력해주세요." to player
            stop
        if {_price} <= 0:
            message "{@prefix} {@bad}가격은 1 이상이어야 합니다." to player
            stop

        # 손에 든 아이템 확인
        set {_hand} to player's tool
        if {_hand} is air:
            message "{@prefix} {@bad}손에 아이템을 들고 사용해주세요." to player
            stop

        # 거래 가능 여부
        if 마켓거래가능({_hand}) is false:
            message "{@prefix} {@bad}이 아이템은 마켓에 등록할 수 없습니다." to player
            message "{@prefix} {@hint}등록 가능: &f물고기, 조합 재료" to player
            stop

        # 최소 가격 체크
        set {_minPrice} to 마켓최소가격({_hand})
        if {_price} < {_minPrice}:
            message "{@prefix} {@bad}최소 판매가는 {@emph}%{_minPrice}%골드&c입니다." to player
            stop

        # 최대 등록 수 체크
        set {_active} to 마켓활성등록수(player's name)
        if {_active} >= {@max_listings}:
            message "{@prefix} {@bad}최대 {@max_listings}개까지 등록 가능합니다. {@hint}현재: %{_active}%개" to player
            stop

        # 등록 처리 (수수료는 판매 시 차감)
        set {_id} to 마켓ID생성()
        set {_qty} to amount of player's tool
        set {_now} to unix timestamp of now

        set {마켓::%{_id}%::판매자} to player's name
        set {마켓::%{_id}%::아이템이름} to name of {_hand}
        set {마켓::%{_id}%::가격} to {_price}
        set {마켓::%{_id}%::수량} to {_qty}
        set {마켓::%{_id}%::등록시간} to {_now}
        set {마켓::%{_id}%::만료시간} to {_now} + {@expiry_secs}
        set {마켓::%{_id}%::아이템} to {_hand}
        add {_id} to {마켓목록::*}

        # 손에서 아이템 제거
        set player's tool to air

        # 마켓 로그 (파일)
        set {_iname} to name of {_hand}
        if {_iname} is not set:
            set {_iname} to "%type of {_hand}%"
        set {_fee} to floor({_price} * {@list_fee_rate} / 100)
        log "[등록] %now% | ID:%{_id}% | 판매자:%player's name% | 아이템:%{_iname}% x%{_qty}% | 가격:%{_price}%" to "마켓로그.log"

        message "{@prefix} {@good}마켓 등록 완료!" to player
        message "{@prefix} {@hint}가격: {@emph}%{_price}%골드 {@hint}| 판매 시 수수료: {@emph}%{_fee}%골드({@list_fee_rate}%%%%) {@hint}| 만료: 48시간 후" to player
        도전과제체크(player, "마켓등록", "1")
        message "{@prefix} {@hint}등록 현황: {@emph}%({_active} + 1)% / {@max_listings}개" to player

# ===== 메인 마켓 GUI 클릭 =====
on inventory click:
    if name of player's current inventory is "{@gui_main}":
        cancel event
        set {_slot} to index of clicked slot

        # 슬롯 0~44: 아이템 구매
        if {_slot} >= 0:
            if {_slot} <= 44:
                set {_id} to {마켓슬롯ID::%player%::%{_slot}%}
                if {_id} is set:
                    if {마켓::%{_id}%::판매자} is player's name:
                        message "{@prefix} {@bad}자신의 아이템은 구매할 수 없습니다. {@hint}내 판매 목록에서 취소 가능" to player
                        stop
                    마켓구매확인GUI열기(player, {_id})
                stop

        # 슬롯 45: 이전 페이지
        if {_slot} is 45:
            set {_page} to {마켓페이지::%player%}
            if {_page} is not set:
                set {_page} to 1
            if {_page} > 1:
                마켓GUI열기(player, {_page} - 1)
            stop

        # 슬롯 46: 내 목록
        if {_slot} is 46:
            마켓내목록GUI열기(player)
            stop

        # 슬롯 48: 우편함
        if {_slot} is 48:
            if {우편::%player%::*} is set:
                loop {우편::%player%::*}:
                    set {_mailItem} to {우편::%player%::%loop-value%}
                    if {_mailItem} is set:
                        if player can hold {_mailItem}:
                            give {_mailItem} to player
                        else:
                            drop {_mailItem} at player's location
                delete {우편::%player%::*}
                message "{@prefix} {@good}우편함 아이템을 모두 수령했습니다." to player
                마켓GUI열기(player, 1)
            else:
                message "{@prefix} {@hint}수령할 아이템이 없습니다." to player
            stop

        # 슬롯 53: 다음 페이지
        if {_slot} is 53:
            set {_page} to {마켓페이지::%player%}
            if {_page} is not set:
                set {_page} to 1
            마켓GUI열기(player, {_page} + 1)
            stop

# ===== 내 판매 목록 GUI 클릭 =====
on inventory click:
    if name of player's current inventory is "{@gui_mylist}":
        cancel event
        set {_slot} to index of clicked slot

        # 슬롯 49: 마켓으로 돌아가기
        if {_slot} is 49:
            마켓GUI열기(player, 1)
            stop

        # 슬롯 0~44: 우클릭 = 등록 취소
        if {_slot} >= 0:
            if {_slot} <= 44:
                if click type is right mouse button:
                    set {_id} to {마켓내목록슬롯::%player%::%{_slot}%}
                    if {_id} is set:
                        set {_item} to {마켓::%{_id}%::아이템}
                        if {_item} is set:
                            if player can hold {_item}:
                                give {_item} to player
                            else:
                                drop {_item} at player's location

                        remove {_id} from {마켓목록::*}
                        delete {마켓::%{_id}%::판매자}
                        delete {마켓::%{_id}%::아이템이름}
                        delete {마켓::%{_id}%::가격}
                        delete {마켓::%{_id}%::수량}
                        delete {마켓::%{_id}%::등록시간}
                        delete {마켓::%{_id}%::만료시간}
                        delete {마켓::%{_id}%::아이템}

                        # 마켓 로그 (파일)
                        set {_iname} to name of {_item}
                        if {_iname} is not set:
                            set {_iname} to "%type of {_item}%"
                        log "[취소] %now% | ID:%{_id}% | 판매자:%player's name% | 아이템:%{_iname}%" to "마켓로그.log"

                        message "{@prefix} {@good}등록 취소 완료. {@hint}아이템 반환 (수수료 미환불)" to player
                        마켓내목록GUI열기(player)
                    stop

# ===== 구매 확인 GUI 클릭 =====
on inventory click:
    if name of player's current inventory is "{@gui_confirm}":
        cancel event
        set {_slot} to index of clicked slot

        # 슬롯 11: 구매 확인
        if {_slot} is 11:
            set {_id} to {마켓구매확인ID::%player%}
            if {_id} is not set:
                close player's inventory
                stop

            # 만료 체크
            set {_exp} to {마켓::%{_id}%::만료시간}
            if {_exp} is not set:
                message "{@prefix} {@bad}해당 아이템은 더 이상 판매 중이지 않습니다." to player
                close player's inventory
                stop
            if {_exp} < unix timestamp of now:
                마켓만료처리({_id})
                message "{@prefix} {@bad}판매 기간이 만료된 아이템입니다." to player
                close player's inventory
                stop

            set {_price} to {마켓::%{_id}%::가격}
            set {_seller} to {마켓::%{_id}%::판매자}
            set {_item} to {마켓::%{_id}%::아이템}

            if {돈::%player%} is not set:
                set {돈::%player%} to 0
            if {돈::%player%} < {_price}:
                message "{@prefix} {@bad}골드가 부족합니다. {@hint}잔액: {@emph}%{돈::%player%}%골드" to player
                close player's inventory
                stop

            # 구매 처리 (판매자에게 수수료 차감 후 지급)
            remove {_price} from {돈::%player%}
            set {_fee} to floor({_price} * {@list_fee_rate} / 100)
            set {_sellerGain} to {_price} - {_fee}
            set {_sellerP} to {_seller} parsed as offline player
            if {돈::%{_sellerP}%} is not set:
                set {돈::%{_sellerP}%} to 0
            add {_sellerGain} to {돈::%{_sellerP}%}

            # 아이템 지급
            if player can hold {_item}:
                give {_item} to player
            else:
                drop {_item} at player's location

            # 판매자 알림
            delete {_sellerPl}
            loop all players:
                if loop-player's name is {_seller}:
                    set {_sellerPl} to loop-player
                    stop loop
            set {_iname} to name of {_item}
            if {_iname} is not set:
                set {_iname} to "%type of {_item}%"
            if {_sellerPl} is set:
                message "{@prefix} {@good}%player's name%&a님이 아이템을 구매! {@emph}+%{_sellerGain}%골드 {@hint}(수수료 %{_fee}%골드)" to {_sellerPl}
            else:
                # 오프라인 → 접속 시 알림용 저장
                if {마켓판매알림::%{_seller}%} is not set:
                    set {마켓판매알림::%{_seller}%} to 0
                    set {마켓판매골드::%{_seller}%} to 0
                add 1 to {마켓판매알림::%{_seller}%}
                add {_sellerGain} to {마켓판매골드::%{_seller}%}
                add {_fee} to {마켓판매수수료::%{_seller}%}

            # 마켓 데이터 삭제
            remove {_id} from {마켓목록::*}
            delete {마켓::%{_id}%::판매자}
            delete {마켓::%{_id}%::아이템이름}
            delete {마켓::%{_id}%::가격}
            delete {마켓::%{_id}%::수량}
            delete {마켓::%{_id}%::등록시간}
            delete {마켓::%{_id}%::만료시간}
            delete {마켓::%{_id}%::아이템}
            delete {마켓구매확인ID::%player%}

            # 마켓 로그 (파일)
            set {_iname} to name of {_item}
            if {_iname} is not set:
                set {_iname} to "%type of {_item}%"
            log "[구매] %now% | ID:%{_id}% | 구매자:%player's name% | 판매자:%{_seller}% | 아이템:%{_iname}% | 가격:%{_price}%" to "마켓로그.log"

            message "{@prefix} {@good}구매 완료! {@hint}잔액: {@emph}%{돈::%player%}%골드" to player
            close player's inventory
            stop

        # 슬롯 15: 취소
        if {_slot} is 15:
            delete {마켓구매확인ID::%player%}
            close player's inventory
            마켓GUI열기(player, 1)
            stop

# ===== 로그인 시 우편함 + 판매 알림 =====
on join:
    wait 20 ticks
    # 판매 알림
    if {마켓판매알림::%player's name%} is set:
        if {마켓판매알림::%player's name%} > 0:
            message "{@prefix} {@good}부재 중 마켓 아이템이 {@emph}%{마켓판매알림::%player's name%}%개 {@good}판매되었습니다!" to player
            message "{@prefix} {@emph}+%{마켓판매골드::%player's name%}%골드 {@hint}(수수료 %{마켓판매수수료::%player's name%}%골드 차감)" to player
            delete {마켓판매알림::%player's name%}
            delete {마켓판매골드::%player's name%}
            delete {마켓판매수수료::%player's name%}
    # 우편함 알림
    if {우편::%player%::*} is set:
        set {_cnt} to size of {우편::%player%::*}
        if {_cnt} > 0:
            message "{@prefix} {@emph}/마켓 {@hint}→ 우편함에 수령 대기 중인 아이템이 {@emph}%{_cnt}%개 {@hint}있습니다." to player

# ===== 1시간마다 만료 체크 =====
every 1 hour:
    마켓만료체크()
