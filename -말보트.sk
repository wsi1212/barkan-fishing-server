# =========================================
# 말보트.sk
# 투명 말 보트 테스트 — 공중 이동, Y좌표 고정
# =========================================

options:
    horse_prefix: &8[&b 말보트 &8]
    speed: 0.4

# ===== 정리 함수 =====
function horseBoatCleanup(p: player):
    set {_horse} to {말보트::%{_p}%}
    if {_horse} is set:
        if {_horse} is valid:
            kill {_horse}
    delete {말보트::%{_p}%}
    delete {말보트탑승::%{_p}%}
    delete {말보트이전X::%{_p}%}
    delete {말보트이전Z::%{_p}%}

# ===== 소환 =====
command /말 [<text>]:
    aliases: /akf
    trigger:
        if arg-1 is "제거" or "wprj":
            if {말보트::%player%} is set:
                horseBoatCleanup(player)
                message "{@horse_prefix} &c말보트를 제거했습니다." to player
            else:
                message "{@horse_prefix} &c소환된 말보트가 없습니다." to player
            stop

        # 이미 소환 확인
        if {말보트::%player%} is set:
            set {_old} to {말보트::%player%}
            if {_old} is valid:
                message "{@horse_prefix} &c이미 소환된 말보트가 있습니다. &7(/말 제거)" to player
                stop
            else:
                horseBoatCleanup(player)

        # 말 소환
        set {_loc} to player's location
        spawn a horse at {_loc}
        set {_horse} to last spawned entity

        # 투명 + 무적 + NoAI + 중력없음 + 무음 + 이름표시
        apply invisibility without particles to {_horse} for 999999 seconds
        set custom name of {_horse} to "&b말보트"
        execute console command "data merge entity %uuid of {_horse}% {Invulnerable:1b,Tame:1b,NoAI:1b,NoGravity:1b,Silent:1b,CustomNameVisible:1b,SaddleItem:{id:""minecraft:saddle"",count:1}}"

        # 변수 저장
        set {말보트::%player%} to {_horse}
        set {말보트탑승::%player%} to false
        set {말보트이전X::%player%} to x-coordinate of {_loc}
        set {말보트이전Z::%player%} to z-coordinate of {_loc}

        message "{@horse_prefix} &a말보트를 소환했습니다! &7(10초 내 탑승하세요)" to player
        message "{@horse_prefix} &7제거: &f/말 제거" to player

        # 탑승 대기 (10초)
        loop 200 times:
            wait 1 tick
            if {말보트::%player%} is not set:
                stop
            if {_horse} is not valid:
                horseBoatCleanup(player)
                stop
            if vehicle of player is {_horse}:
                set {말보트탑승::%player%} to true
                message "{@horse_prefix} &a출발!" to player
                stop

        # 타임아웃
        if {말보트탑승::%player%} is not true:
            if {말보트::%player%} is set:
                horseBoatCleanup(player)
                message "{@horse_prefix} &e시간 초과로 말보트가 사라졌습니다." to player

# ===== 이동 처리 — 플레이어 방향 기반 =====
every 1 tick:
    loop all players:
        if {말보트탑승::%loop-player%} is true:
            set {_horse} to {말보트::%loop-player%}
            if {_horse} is not valid:
                horseBoatCleanup(loop-player)
            else:
                # 플레이어 위치 변화 감지 (WASD 입력)
                set {_loc} to location of loop-player
                set {_x} to x-coordinate of {_loc}
                set {_z} to z-coordinate of {_loc}
                set {_prevX} to {말보트이전X::%loop-player%}
                set {_prevZ} to {말보트이전Z::%loop-player%}
                set {_dx} to {_x} - {_prevX}
                set {_dz} to {_z} - {_prevZ}

                # 이동 감지됐으면 말을 플레이어 보는 방향으로 이동
                if abs({_dx}) > 0.001:
                    set {_moving} to true
                else if abs({_dz}) > 0.001:
                    set {_moving} to true
                else:
                    set {_moving} to false

                if {_moving} is true:
                    set {_yaw} to yaw of loop-player
                    set {_rad} to {_yaw} * -1 * 3.14159265 / 180
                    set {_vx} to sin({_rad}) * {@speed}
                    set {_vz} to cos({_rad}) * {@speed}
                    set {_horseLoc} to location of {_horse}
                    set {_newX} to x-coordinate of {_horseLoc} + {_vx}
                    set {_newZ} to z-coordinate of {_horseLoc} + {_vz}
                    set {_newY} to y-coordinate of {_horseLoc}
                    # 말을 플레이어 방향으로 텔레포트
                    teleport {_horse} to location({_newX}, {_newY}, {_newZ}, world of loop-player, {_yaw}, 0)

                # 이전 위치 갱신
                set {말보트이전X::%loop-player%} to {_x}
                set {말보트이전Z::%loop-player%} to {_z}

# ===== 하차 처리 =====
on dismount:
    set {_vehicle} to event-entity
    if {말보트::%player%} is {_vehicle}:
        wait 1 tick
        horseBoatCleanup(player)
        message "{@horse_prefix} &7말보트에서 내렸습니다." to player

# ===== 접속 종료 시 정리 =====
on quit:
    if {말보트탑승::%player%} is true:
        horseBoatCleanup(player)
