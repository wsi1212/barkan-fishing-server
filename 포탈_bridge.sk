# =========================================
# 포탈_bridge.sk — 포탈 Java 이관 마이그 브릿지 (일회성 import)
# Java(PortalManager, portals.json)로 전환. 기존 op 빌드 {포탈} 정의를 Java로 1회 import.
#  - on load: 미마이그 시 {포탈목록} 전부 /portalimport 로 push (1회, {포탈마이그됨} 가드)
#  - /포탈마이그 (op): 수동 재실행
# import 후 Java가 포탈 전부 소유(/포탈, 근접감지 TP). 이 브릿지는 import 전용.
# =========================================

function 포탈마이그실행() :: integer:
    if {포탈목록::*} is not set:
        return 0
    set {_n2} to 0
    loop {포탈목록::*}:
        set {_n} to loop-value
        if {포탈::%{_n}%::월드} is set:
            set {_dw} to {포탈::%{_n}%::도착월드}
            if {_dw} is not set:
                set {_dw} to "_"
                set {_dx} to 0
                set {_dy} to 0
                set {_dz} to 0
            else:
                set {_dx} to {포탈::%{_n}%::도착x}
                set {_dy} to {포탈::%{_n}%::도착y}
                set {_dz} to {포탈::%{_n}%::도착z}
            execute console command "portalimport %{_n}% %{포탈::%{_n}%::월드}% %{포탈::%{_n}%::minX}% %{포탈::%{_n}%::minY}% %{포탈::%{_n}%::minZ}% %{포탈::%{_n}%::maxX}% %{포탈::%{_n}%::maxY}% %{포탈::%{_n}%::maxZ}% %{_dw}% %{_dx}% %{_dy}% %{_dz}%"
            set {_n2} to {_n2} + 1
    return {_n2}

on load:
    wait 40 ticks
    if {포탈마이그됨} is not set:
        set {_n} to 포탈마이그실행()
        set {포탈마이그됨} to true
        if {_n} > 0:
            send "[포탈마이그] %{_n}% 개 포탈을 Java(portals.json)로 import했습니다." to console

command /포탈마이그:
    permission: op
    trigger:
        set {_n} to 포탈마이그실행()
        send "&a[포탈마이그] %{_n}% 개 포탈 import 완료 (portals.json)." to player
