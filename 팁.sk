# ===== 주기적 팁 표시 시스템 =====

on load:
    delete {팁목록::*}
    set {_i} to 0

    # ========== 조작/기본 ==========
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &fShift + F&7로 &a메뉴&7를 열 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/q&7로 &d퀘스트 창&7을 열 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/도감&7으로 물고기 도감을 열 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/도전과제&7로 달성 가능한 업적을 확인하세요!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/칭호&7로 획득한 칭호를 장착할 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/날씨&7로 현재 시간대와 날씨 보너스를 확인하세요."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/레벨&7로 현재 낚시 레벨과 경험치를 확인하세요."

    # ========== 낚시 기초 ==========
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7물고기 등급은 &fE < D < C < B < A < S < S+ < M < L < G &7순입니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7낚시 레벨이 높을수록 &a더 좋은 등급&7의 물고기가 잡힙니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7같은 물고기라도 &e크기&7가 클수록 &e판매 가격&7이 높습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7물고기의 &a신선도&7는 시간이 지나면 떨어집니다. 빨리 판매하세요!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7미니게임에서 &e초록 영역&7을 정확히 맞추면 성공! &6노란 칸&7은 크리티컬!"

    # ========== 낚시 고급 ==========
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7크리티컬 낚시에 성공하면 &e크기와 판매 가격&7이 증가합니다!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &6S+&7 이상 물고기는 &c도주&7할 수 있으니 빠르게 잡으세요!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7가장 희귀한 &4G등급&7 물고기의 확률은 &c0.01%%&7입니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7더블/트리플 낚시는 &e독립 확률&7로 동시에 발동할 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7연속으로 낚시에 성공하면 &d콤보&7가 쌓여 보너스를 받습니다!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7100cm가 넘는 큰 물고기를 들면 &e머리 위에 표시&7됩니다!"

    # ========== 장비/강화 ==========
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/장비&7로 낚싯대에 부품을 장착할 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7장비가 좋을수록 &a경험치&7와 &e등급업 확률&7이 크게 올라갑니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/부품상점&7에서 낚싯대와 부품을 구매할 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/강화&7로 낚싯대를 강화할 수 있습니다. 실패하면 레벨이 떨어질 수 있어요!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/축복&7으로 계정 전체에 적용되는 영구 버프를 얻을 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7등급특화 낚싯대는 특정 등급 물고기가 &e2배 확률&7로 나옵니다!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7부품에는 &f내구도&7가 있습니다. 낚시하면 소모되니 관리하세요."

    # ========== 경제 ==========
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/판매&7로 손에 든 물고기를 판매합니다. &f/판매 전부&7로 일괄 판매!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/마켓&7에서 다른 플레이어에게 아이템을 사고팔 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7마켓 판매 수수료는 &c10%%&7입니다. 판매 시 차감됩니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/수표&7로 돈을 종이 수표로 만들 수 있습니다. 수수료 &c10%%&7!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/송금&7으로 다른 플레이어에게 돈을 보낼 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7직거래로 다른 플레이어와 안전하게 아이템을 교환하세요!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7마켓에 오프라인일 때 판매되면 &e접속 시 알림&7을 받습니다."

    # ========== 지역/탐험 ==========
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7지역마다 잡히는 물고기가 다릅니다. 여러 곳을 탐험해보세요!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7한번 방문한 지역은 &b페리&7를 통해 빠르게 이동할 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7일부 지역은 일정 &e낚시 레벨&7 이상이어야 입장할 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7사막에서는 &6모래바람&7이나 &e☀ 땡볕&7이 올 수 있습니다!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/보트&7로 보트를 소환하여 바다를 항해할 수 있습니다."

    # ========== 날씨/환경 ==========
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7시간대와 날씨에 따라 &a환경 보너스&7가 달라집니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7비 올 때 낚시하면 &b크기 보너스&7를 받습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7뇌우가 치면 &c등급업 확률&7이 크게 증가합니다! 기회를 놓치지 마세요!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7새벽 시간대에는 특별한 물고기가 출현합니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7안개가 끼면 &5희귀 물고기&7 출현 확률이 올라갑니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7지역마다 날씨가 다릅니다! 사막에는 비가 오지 않아요."

    # ========== 퀘스트 ==========
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &d일일 퀘스트&7는 매일 새로 갱신됩니다. 매일 도전해보세요!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &d주간 퀘스트&7는 매주 월요일에 갱신됩니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7NPC에게 말을 걸면 &d퀘스트&7를 받을 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7메인 퀘스트를 클리어하면 다음 퀘스트가 &e자동 해금&7됩니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7일일 퀘스트를 &e전부 완료&7하면 도전과제를 달성할 수 있어요!"

    # ========== 도전과제/칭호 ==========
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7L키를 눌러 &6도전과제 탭&7을 확인해보세요!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7도전과제를 달성하면 &e돈&7과 &d칭호&7를 보상으로 받습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7칭호는 머리 위에 표시됩니다. &f/칭호&7에서 바꿔보세요!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &4G등급&7 물고기를 낚으면 &4神殺者&7 칭호를 획득합니다!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &d200 콤보&7를 달성하면 &d불꽃 연타&7 칭호를 획득합니다!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &6백만장자&7 칭호는 100만원을 보유하면 획득할 수 있습니다."

    # ========== 도감/수집 ==========
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7도감에서 나침반을 클릭하면 &f전체 물고기 등급별 도감&7을 볼 수 있습니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &7도감에 최대 크기 기록이 저장됩니다. &e신기록&7에 도전해보세요!"
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &750종 이상의 물고기를 도감에 등록하면 &c물고기 박사&7 칭호를 획득!"

    # ========== 아이스박스/도핑 ==========
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &b아이스박스&7에 물고기를 보관하면 &a신선도&7가 보존됩니다."
    add 1 to {_i}
    set {팁목록::%{_i}%} to "&b[TIP] &f/도핑상점&7에서 일시적 버프를 구매할 수 있습니다. 한 번에 1개만!"

    set {팁총수} to {_i}
    set {팁타이머작동} to true

every 3 minutes:
    if {팁타이머작동} is not true:
        stop
    set {_max} to {팁총수}
    if {_max} is not set:
        stop
    if {_max} <= 0:
        stop
    set {_rand} to a random integer between 1 and {_max}
    set {_msg} to {팁목록::%{_rand}%}
    if {_msg} is set:
        loop all players:
            set {_lpn} to name of loop-player
            if {차단팁::%{_lpn}%} is not true:
                message "%{_msg}%" to loop-player

command /팁 [<text>]:
    permission: op
    trigger:
        set {_max} to {팁총수}
        if {_max} is not set:
            message "&8[&b 팁 &8] &c팁 데이터가 없습니다."
            stop
        set {_rand} to a random integer between 1 and {_max}
        set {_msg} to {팁목록::%{_rand}%}
        if {_msg} is set:
            loop all players:
                set {_lpn} to name of loop-player
                if {차단팁::%{_lpn}%} is not true:
                    message "%{_msg}%" to loop-player
            message "&8[&b 팁 &8] &a팁을 전송했습니다."

command /팁목록:
    permission: op
    trigger:
        set {_max} to {팁총수}
        if {_max} is not set:
            message "&8[&b 팁 &8] &c팁 데이터가 없습니다."
            stop
        message "&8========== &b팁 목록 &8(%{_max}%개) =========="
        loop integers from 1 to {_max}:
            set {_msg} to {팁목록::%loop-integer%}
            if {_msg} is set:
                message "&8#%loop-integer% %{_msg}%"
        message "&8======================================"
