# =========================================
# 판매유틸_bridge.sk — 물고기 아이템 공용 함수 (판매.sk에서 분리, 유지)
# fishprice/parse*/freshness/calcFishPrice/isfish 등 — 낚시.sk·마켓.sk·낚시이벤트_bridge가 호출.
# /sellhook = SellCommand(Java)가 판매 후 부수효과(퀘스트/주간랭킹/총판매/도전과제/사이드바) 실행용.
# 판매 명령/상점 GUI는 Java(SellCommand)로 이관됨.
# =========================================

function parseFishData(item: item) :: text:
    loop lore of {_item}:
        set {_raw} to uncolored loop-value
        if {_raw} starts with "f:":
            replace "f:" with "" in {_raw}
            return {_raw}
    return ""

# ===== 신선도 라벨 (색상+%+이름) =====
function freshnessLabel(item: item) :: text:
    set {_data} to parseFishData({_item})
    if {_data} is "":
        return "&a신선함"
    set {_parts::*} to split {_data} at ":"
    set {_catchUnix} to {_parts::1} parsed as number
    if {_catchUnix} is not set:
        return "&a신선함"
    set {_preserveMins} to {_parts::2} parsed as number
    if {_preserveMins} is not set:
        set {_preserveMins} to 0
    set {_nowUnix} to unix timestamp of now
    set {_ageSecs} to {_nowUnix} - {_catchUnix}
    set {_ageMins} to floor({_ageSecs} / 60) - {_preserveMins}
    if {_ageMins} < 0:
        set {_ageMins} to 0
    if {_ageMins} <= 15:
        set {_pct} to 100 - {_ageMins}
        return "&a%{_pct}%%%"
    else if {_ageMins} <= 40:
        set {_pct} to 85 - floor(({_ageMins} - 15) * 20 / 25)
        return "&e%{_pct}%%%"
    else if {_ageMins} <= 90:
        set {_pct} to 65 - floor(({_ageMins} - 40) * 25 / 50)
        return "&6%{_pct}%%%"
    else if {_ageMins} <= 180:
        set {_pct} to 40 - floor(({_ageMins} - 90) * 20 / 90)
        return "&c%{_pct}%%%"
    return "&420%%"

# ===== 신선도 lore 업데이트 함수 =====
function updateFreshnessLore(item: item) :: item:
    set {_label} to freshnessLabel({_item})
    set {_newLore::*} to lore of {_item}
    set {_idx} to 0
    loop {_newLore::*}:
        add 1 to {_idx}
        if loop-value contains "신선도":
            set {_newLore::%{_idx}%} to "&7신선도 &e: %{_label}%"
    set lore of {_item} to {_newLore::*}
    return {_item}
# ===== 물고기인지 확인 =====
function isfish(item: item) :: boolean:
    if {_item} is cod:
        loop lore of {_item}:
            if loop-value contains "[물고기]":
                return true
            if loop-value contains "&8f:":
                return true
            if loop-value contains "&7등급":
                return true
    return false

# ===== 2분마다 인벤토리 물고기 신선도 lore 자동 갱신 =====
every 2 minutes:
    loop all players:
        loop integers from 0 to 35:
            set {_item} to slot loop-integer of loop-player's inventory
            if {_item} is not air:
                if isfish({_item}):
                    set {_data} to parseFishData({_item})
                    if {_data} is not "":
                        set {_updated} to updateFreshnessLore({_item})
                        set slot loop-integer of loop-player's inventory to {_updated}

