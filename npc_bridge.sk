# ===========================================================================
# NPC 브릿지 — Java(BlockShip NpcManager) → Skript 변수 동기화 수신
#
# Java가 npc.json + dialogue.json의 권위 소스. 서버 시작/리로드/편집 시
# /npcsync 로 {NPC::*}, {NPC목록::*}, {대화::*} 변수를 채운다.
# 기존 대화 엔진(NPC.sk)과 퀘스트·여관·조합대 로직은 이 변수를 그대로 읽음.
#
# 전송 포맷: /npcsync <필드들을 §§로 join한 단일 인자>
#   init
#   npc§§<id>
#   npcfield§§<id>§§<필드>§§<값>
#   npcquest§§<id>§§<퀘스트ID>
#   line§§<id>§§<키>§§<대사>                (키는 "진행중::튜토01" 처럼 :: 포함 가능)
#   choice§§<id>§§<키>§§<cid>§§<action>§§<next>§§<텍스트>
# ===========================================================================

command /npcsync <text>:
    permission: op
    executable by: console
    trigger:
        set {_p::*} to arg-1 split at "§§"
        set {_sub} to {_p::1}

        if {_sub} is "init":
            delete {NPC::*}
            delete {NPC목록::*}
            delete {대화::*}

        else if {_sub} is "npc":
            add {_p::2} to {NPC목록::*}

        else if {_sub} is "npcfield":
            set {_id} to {_p::2}
            set {_f} to {_p::3}
            set {_v} to {_p::4}
            if {_f} is "페리" or "상점" or "여관" or "대장간":
                set {NPC::%{_id}%::%{_f}%} to true
            else if {_f} is "여관스폰x" or "여관스폰y" or "여관스폰z":
                set {NPC::%{_id}%::%{_f}%} to {_v} parsed as number
            else:
                set {NPC::%{_id}%::%{_f}%} to {_v}

        else if {_sub} is "npcquest":
            add {_p::3} to {NPC::%{_p::2}%::퀘스트::*}

        else if {_sub} is "line":
            set {_id} to {_p::2}
            set {_key} to {_p::3}
            add {_p::4} to {대화::%{_id}%::%{_key}%::대사::*}

        else if {_sub} is "choice":
            set {_id} to {_p::2}
            set {_key} to {_p::3}
            set {_cid} to {_p::4}
            add {_cid} to {대화::%{_id}%::%{_key}%::선택지::*}
            set {대화::%{_id}%::%{_key}%::선택지액션::%{_cid}%} to {_p::5}
            set {대화::%{_id}%::%{_key}%::선택지이동::%{_cid}%} to {_p::6}
            set {대화::%{_id}%::%{_key}%::선택지텍스트::%{_cid}%} to {_p::7}
