# =========================================
# 수리_bridge.sk — 장비 수리 비용/실행 (수리.sk에서 분리, 유지)
# GUI/비용계산/돈 체크·차감 = Java(RepairGui, PlayerData.money 권위). Skript는 내구도 set만(내구도=Skript 권위).
# /durread: 내구도를 Java 캐시(PlayerData)로 동기(GUI 표시 정확). /repairdo: 내구도 회복 적용.
# =========================================

# 수리 비용 = (최대내구 - 현재내구) × 등급단가 (수리.sk 8-39)
function 수리비용(type: text, p: player) :: number:
    set {_name} to {낚싯대부품::%{_type}%::%{_p}%}
    if {_name} is not set:
        return 0
    set {_maxDur} to get_part_durability({_type}, {_name})
    set {_curDur} to {부품내구도::%{_type}%::%{_p}%}
    if {_curDur} is not set:
        set {_curDur} to 0
    set {_missing} to {_maxDur} - {_curDur}
    if {_missing} <= 0:
        return 0
    set {_grade} to get_part_grade({_type}, {_name})
    set {_단가} to 50
    if {_grade} is "D":
        set {_단가} to 100
    else if {_grade} is "C":
        set {_단가} to 200
    else if {_grade} is "B":
        set {_단가} to 400
    else if {_grade} is "A":
        set {_단가} to 800
    else if {_grade} is "S":
        set {_단가} to 1500
    else if {_grade} is "S+":
        set {_단가} to 3000
    else if {_grade} is "M":
        set {_단가} to 6000
    else if {_grade} is "L":
        set {_단가} to 12000
    else if {_grade} is "G":
        set {_단가} to 25000
    return {_missing} * {_단가}

# 내구도 동기 (GUI 표시용): 5부위 현재 내구도를 Java PlayerData 캐시에 push
command /durread <text>:
    permission: op
    executable by: console
    trigger:
        set {_p} to arg-1 parsed as player
        if {_p} is not set:
            stop
        loop "릴", "줄", "바늘", "미끼", "찌":
            set {_name} to {낚싯대부품::%loop-value%::%{_p}%}
            if {_name} is set:
                set {_dur} to {부품내구도::%loop-value%::%{_p}%}
                if {_dur} is not set:
                    set {_dur} to 0
                execute console command "durcacheset %{_p}'s name% %loop-value% %{_dur}%"

# 실제 수리: player§§type (Java GUI 클릭이 호출).
# ★ 돈 체크/차감/메시지/사운드 = Java RepairGui.onClick(PlayerData.money 권위). 여기선 내구도 set만(내구도=Skript 권위).
command /repairdo <text>:
    permission: op
    executable by: console
    trigger:
        set {_t::*} to split arg-1 at "§§"
        set {_p} to {_t::1} parsed as player
        if {_p} is not set:
            stop
        set {_type} to {_t::2}
        set {_name} to {낚싯대부품::%{_type}%::%{_p}%}
        if {_name} is not set:
            stop
        set {부품내구도::%{_type}%::%{_p}%} to get_part_durability({_type}, {_name})
