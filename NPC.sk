# ===== NPC + 대화 시스템 =====
# NPC 등록, 클릭 이벤트, 텍스트 디스플레이 말풍선 + GUI 선택지

# =========================================
#   텍스트 디스플레이 헬퍼
# =========================================

function npc텍스트생성(p: player):
    # 기존 텍스트 제거
    npc텍스트제거({_p})
    # NPC 엔티티 위치 체크
    set {_entity} to {대화엔티티::%{_p}%}
    if {_entity} is not set:
        stop
    if {_entity} is not valid:
        stop
    # 텍스트 카운터 초기화
    set {대화텍스트카운터::%{_p}%} to 0

function npc텍스트업데이트(p: player, npcName: text, line: text):
    set {_entity} to {대화엔티티::%{_p}%}
    if {_entity} is not set:
        stop
    if {_entity} is not valid:
        stop
    # 카운터 증가 & 줄 저장
    add 1 to {대화텍스트카운터::%{_p}%}
    set {_cnt} to {대화텍스트카운터::%{_p}%}
    set {대화텍스트줄::%{_p}%::%{_cnt}%} to {_line}
    set {대화텍스트줄NPC::%{_p}%::%{_cnt}%} to {_npcName}
    # 기존 디스플레이 전부 제거
    loop integers from 1 to 5:
        if {대화텍스트::%{_p}%::%loop-integer%} is set:
            if {대화텍스트::%{_p}%::%loop-integer%} is valid:
                kill {대화텍스트::%{_p}%::%loop-integer%}
            delete {대화텍스트::%{_p}%::%loop-integer%}
    # 표시할 줄 범위 (최근 5개)
    set {_start} to {_cnt} - 4
    if {_start} < 1:
        set {_start} to 1
    set {_total} to {_cnt} - {_start} + 1
    # 새로 스폰 (위=오래된 줄, 아래=최신 줄)
    set {_slot} to 1
    loop integers from {_start} to {_cnt}:
        set {_loc} to location of {_entity}
        set {_yOffset} to 2.3 + (({_total} - {_slot}) * 0.35)
        add {_yOffset} to y-coordinate of {_loc}
        spawn a text display at {_loc}
        set {_display} to last spawned entity
        set {_npc} to {대화텍스트줄NPC::%{_p}%::%loop-integer%}
        set {_text} to {대화텍스트줄::%{_p}%::%loop-integer%}
        # 제일 위: NPC이름 포함 / 나머지: 대사만 / 전부 페이드 적용
        set {_age} to {_cnt} - loop-integer
        if {_slot} is 1:
            if {_age} >= 3:
                set text of {_display} to "&8&l%{_npc}%%nl%&8%{_text}%"
            else if {_age} >= 1:
                set text of {_display} to "&7&l%{_npc}%%nl%&7%{_text}%"
            else:
                set text of {_display} to "&e&l%{_npc}%%nl%&f%{_text}%"
        else:
            if {_age} >= 3:
                set text of {_display} to "&8%{_text}%"
            else if {_age} >= 1:
                set text of {_display} to "&7%{_text}%"
            else:
                set text of {_display} to "&f%{_text}%"
        set billboard of {_display} to center
        loop all players:
            if loop-player is not {_p}:
                hide {_display} from loop-player
        set {대화텍스트::%{_p}%::%{_slot}%} to {_display}
        add 1 to {_slot}

function npc텍스트제거(p: player):
    # 멀티라인 텍스트 디스플레이 제거
    loop integers from 1 to 5:
        if {대화텍스트::%{_p}%::%loop-integer%} is set:
            if {대화텍스트::%{_p}%::%loop-integer%} is valid:
                kill {대화텍스트::%{_p}%::%loop-integer%}
            delete {대화텍스트::%{_p}%::%loop-integer%}
    delete {대화텍스트카운터::%{_p}%}
    delete {대화텍스트줄::%{_p}%::*}
    delete {대화텍스트줄NPC::%{_p}%::*}

function npc대화정리(p: player):
    npc텍스트제거({_p})
    delete {대화진행::%{_p}%}
    delete {대화NPC::%{_p}%}
    delete {대화키::%{_p}%}
    delete {대화기록타입::%{_p}%::*}
    delete {대화기록내용::%{_p}%::*}
    delete {대화선택지슬롯::%{_p}%::*}
    delete {대화엔티티::%{_p}%}
    delete {대화퀘스트::%{_p}%}
    delete {대화GUI전환::%{_p}%}
    delete {대화진행퀘스트::%{_p}%}

# =========================================
#   NPC 클릭 이벤트
# =========================================

on right click on entity:
    if name of clicked entity is set:
        set {_clickedName} to uncolored name of clicked entity
        if {NPC목록::*} is not set:
            stop
        loop {NPC목록::*}:
            set {_npcName} to {NPC::%loop-value%::이름}
            if {_npcName} is not set:
                continue
            set {_npcName} to uncolored {_npcName}
            if {_clickedName} is {_npcName}:
                cancel event
                if {NPC::%loop-value%::페리} is true:
                    페리탑승GUI(player)
                    stop
                if {NPC::%loop-value%::상점} is true:
                    opensellgui(player)
                    stop
                if {NPC::%loop-value%::대장간} is true:
                    set {_village} to {NPC::%loop-value%::대장간마을}
                    if {_village} is not set:
                        set {_village} to ""
                    # 조합대 Java 이관 — Java CraftingGui로 위임 (craftopen <player>§§<category>§§<village>)
                    execute console command "craftopen %player%§§고급§§%{_village}%"
                    stop
                set {대화엔티티::%player%} to clicked entity
                npc대화시작(player, loop-value)
                stop

# =========================================
#   대화 시작
# =========================================

function npc대화시작(p: player, npcId: text):
    # 이미 대화 중이면 정리
    if {대화진행::%{_p}%} is true:
        npc대화정리({_p})
    set {대화진행::%{_p}%} to true
    set {대화NPC::%{_p}%} to {_npcId}
    add 1 to {대화세션::%{_p}%}
    if {대화세션::%{_p}%} is not set:
        set {대화세션::%{_p}%} to 1
    # 대화 기록 초기화
    delete {대화기록타입::%{_p}%::*}
    delete {대화기록내용::%{_p}%::*}
    delete {대화진행퀘스트::%{_p}%}
    # 텍스트 디스플레이 생성
    npc텍스트생성({_p})
    # 일일/주간 퀘스트 체크
    일일퀘스트리셋({_p})
    주간퀘스트체크({_p})
    # 퀘스트 상태 확인
    set {_hasComplete} to false
    set {_hasActive} to false
    set {_activeQid} to "x"
    set {_completeQid} to "x"
    if {NPC::%{_npcId}%::퀘스트::*} is set:
        loop {NPC::%{_npcId}%::퀘스트::*}:
            if {퀘스트상태::%loop-value%::%{_p}%} is "완료대기":
                set {_hasComplete} to true
                set {_completeQid} to loop-value
                stop loop
            if {퀘스트상태::%loop-value%::%{_p}%} is "진행":
                set {_hasActive} to true
                set {_activeQid} to loop-value
    # 시작 대화 키 결정
    if {_hasComplete} is true:
        set {대화퀘스트::%{_p}%} to {_completeQid}
        npc대화표시({_p}, {_npcId}, "퀘스트완료")
    else if {_hasActive} is true:
        set {대화진행퀘스트::%{_p}%} to {_activeQid}
        npc진행중대화({_p}, {_npcId}, {_activeQid})
    else:
        npc대화표시({_p}, {_npcId}, "인사")

# =========================================
#   진행 중 퀘스트 대화
# =========================================

function npc진행중대화(p: player, npcId: text, questId: text):
    set {_npcName} to {NPC::%{_npcId}%::이름}
    if {_npcName} is not set:
        set {_npcName} to {_npcId}
    set {_session} to {대화세션::%{_p}%}
    # 퀘스트별 → NPC기본 → 하드코딩 순으로 대사 표시
    set {_said} to false
    if {대화::%{_npcId}%::진행중::%{_questId}%::대사::*} is set:
        loop {대화::%{_npcId}%::진행중::%{_questId}%::대사::*}:
            if {대화세션::%{_p}%} is not {_session}:
                stop
            npc텍스트업데이트({_p}, {_npcName}, loop-value)
            add "npc" to {대화기록타입::%{_p}%::*}
            add loop-value to {대화기록내용::%{_p}%::*}
            wait 30 ticks
        set {_said} to true
    if {_said} is false:
        if {대화::%{_npcId}%::진행중::대사::*} is set:
            loop {대화::%{_npcId}%::진행중::대사::*}:
                if {대화세션::%{_p}%} is not {_session}:
                    stop
                npc텍스트업데이트({_p}, {_npcName}, loop-value)
                add "npc" to {대화기록타입::%{_p}%::*}
                add loop-value to {대화기록내용::%{_p}%::*}
                wait 30 ticks
        else:
            set {_fallback} to "아직 할 일이 남았을 텐데?"
            npc텍스트업데이트({_p}, {_npcName}, {_fallback})
            add "npc" to {대화기록타입::%{_p}%::*}
            add {_fallback} to {대화기록내용::%{_p}%::*}
            wait 30 ticks
    if {대화세션::%{_p}%} is not {_session}:
        stop
    # 선택지 데이터 세팅 (동적)
    set {대화::%{_npcId}%::진행중::선택지::*} to "c1" and "c2"
    set {대화::%{_npcId}%::진행중::선택지텍스트::c1} to "퀘스트 포기"
    set {대화::%{_npcId}%::진행중::선택지액션::c1} to "포기"
    set {대화::%{_npcId}%::진행중::선택지이동::c1} to {_questId}
    set {대화::%{_npcId}%::진행중::선택지텍스트::c2} to "다음에 올게요"
    set {대화::%{_npcId}%::진행중::선택지액션::c2} to "닫기"
    set {대화::%{_npcId}%::진행중::선택지이동::c2} to "x"
    # GUI 열기
    npc선택지GUI({_p}, {_npcId}, "진행중")

# =========================================
#   대화 출력
# =========================================

function npc대화표시(p: player, npcId: text, key: text):
    set {_npcName} to {NPC::%{_npcId}%::이름}
    if {_npcName} is not set:
        set {_npcName} to {_npcId}
    set {_session} to {대화세션::%{_p}%}
    # 대사 출력 (퀘스트별 → 일반 → 기본)
    set {_qid} to {대화퀘스트::%{_p}%}
    set {_said} to false
    if {_qid} is set:
        if {대화::%{_npcId}%::%{_key}%::%{_qid}%::대사::*} is set:
            loop {대화::%{_npcId}%::%{_key}%::%{_qid}%::대사::*}:
                if {대화세션::%{_p}%} is not {_session}:
                    stop
                npc텍스트업데이트({_p}, {_npcName}, loop-value)
                add "npc" to {대화기록타입::%{_p}%::*}
                add loop-value to {대화기록내용::%{_p}%::*}
                wait 30 ticks
            set {_said} to true
    if {_said} is false:
        if {대화::%{_npcId}%::%{_key}%::대사::*} is set:
            loop {대화::%{_npcId}%::%{_key}%::대사::*}:
                if {대화세션::%{_p}%} is not {_session}:
                    stop
                npc텍스트업데이트({_p}, {_npcName}, loop-value)
                add "npc" to {대화기록타입::%{_p}%::*}
                add loop-value to {대화기록내용::%{_p}%::*}
                wait 30 ticks
        else:
            npc텍스트업데이트({_p}, {_npcName}, "...")
            add "npc" to {대화기록타입::%{_p}%::*}
            add "..." to {대화기록내용::%{_p}%::*}
    # 세션 체크
    if {대화세션::%{_p}%} is not {_session}:
        stop
    # 선택지가 있으면 GUI, 없으면 대화 종료
    if {대화::%{_npcId}%::%{_key}%::선택지::*} is set:
        npc선택지GUI({_p}, {_npcId}, {_key})
    else:
        npc대화정리({_p})

# =========================================
#   선택지 GUI (대화 히스토리 + 선택 버튼)
# =========================================

function npc선택지GUI(p: player, npcId: text, key: text):
    set {대화키::%{_p}%} to {_key}
    delete {대화선택지슬롯::%{_p}%::*}
    set {_npcName} to {NPC::%{_npcId}%::이름}
    if {_npcName} is not set:
        set {_npcName} to {_npcId}
    # GUI 열기 (4줄)
    open chest inventory with 4 rows named "&0대화" to {_p}
    wait 1 tick
    # --- Row 1-2 (0-17): 대화 기록 ---
    set {_histSize} to size of {대화기록타입::%{_p}%::*}
    if {_histSize} is not set:
        set {_histSize} to 0
    set {_startIdx} to 1
    if {_histSize} > 18:
        set {_startIdx} to {_histSize} - 17
    set {_slot} to 0
    if {_histSize} > 0:
        loop integers from {_startIdx} to {_histSize}:
            if {_slot} > 17:
                stop loop
            set {_type} to {대화기록타입::%{_p}%::%loop-integer%}
            set {_text} to {대화기록내용::%{_p}%::%loop-integer%}
            if {_type} is "npc":
                set slot {_slot} of {_p}'s current inventory to paper named "&e%{_npcName}% &8> &f%{_text}%"
            else:
                set slot {_slot} of {_p}'s current inventory to book named "&b나 &8> &7%{_text}%"
            add 1 to {_slot}
    # 빈 슬롯 채우기
    loop integers from {_slot} to 17:
        set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
    # --- Row 3 (18-26): 구분선 ---
    loop integers from 18 to 26:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&f"
    # 진행중 퀘스트 정보 (중앙)
    if {대화진행퀘스트::%{_p}%} is set:
        set {_qid} to {대화진행퀘스트::%{_p}%}
        set {_qName} to {퀘스트::%{_qid}%::이름}
        set {_progress} to 퀘스트목표텍스트({_qid}, {_p})
        delete {_qlore::*}
        add "&7%{_progress}%" to {_qlore::*}
        set slot 22 of {_p}'s current inventory to filled map named "&e%{_qName}%" with lore {_qlore::*}
    # --- Row 4 (27-35): 선택지 ---
    loop integers from 27 to 35:
        set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
    # 남은 퀘스트 여부 체크
    set {_hasQuest} to false
    if {NPC::%{_npcId}%::퀘스트::*} is set:
        loop {NPC::%{_npcId}%::퀘스트::*}:
            if {퀘스트상태::%loop-value%::%{_p}%} is not "완료":
                set {_hasQuest} to true
                stop loop
    # 선택지 수집
    delete {_choices::*}
    if {대화::%{_npcId}%::%{_key}%::선택지::*} is set:
        loop {대화::%{_npcId}%::%{_key}%::선택지::*}:
            set {_cid} to loop-value
            set {_action} to {대화::%{_npcId}%::%{_key}%::선택지액션::%{_cid}%}
            set {_showChoice} to true
            if {_action} is "퀘스트목록":
                if {_hasQuest} is false:
                    set {_showChoice} to false
            if {_showChoice} is true:
                add {_cid} to {_choices::*}
    # 가운데 정렬 배치
    set {_count} to size of {_choices::*}
    if {_count} is not set:
        set {_count} to 0
    if {_count} <= 0:
        stop
    # 중앙 슬롯 계산 (Row 4 = 27-35, 중앙 = 31)
    if {_count} is 1:
        set {_slots::1} to 31
    else if {_count} is 2:
        set {_slots::1} to 30
        set {_slots::2} to 32
    else if {_count} is 3:
        set {_slots::1} to 29
        set {_slots::2} to 31
        set {_slots::3} to 33
    else:
        set {_slots::1} to 29
        set {_slots::2} to 30
        set {_slots::3} to 32
        set {_slots::4} to 33
    set {_i} to 1
    loop {_choices::*}:
        set {_cid} to loop-value
        set {_choiceSlot} to {_slots::%{_i}%}
        set {_text} to {대화::%{_npcId}%::%{_key}%::선택지텍스트::%{_cid}%}
        set {_action} to {대화::%{_npcId}%::%{_key}%::선택지액션::%{_cid}%}
        # 아이콘 결정
        if {_action} is "포기":
            set slot {_choiceSlot} of {_p}'s current inventory to red wool named "&c%{_text}%"
        else if {_action} is "닫기":
            set slot {_choiceSlot} of {_p}'s current inventory to gray wool named "&7%{_text}%"
        else if {_action} is "여관설정":
            set slot {_choiceSlot} of {_p}'s current inventory to yellow wool named "&e%{_text}%"
        else:
            set slot {_choiceSlot} of {_p}'s current inventory to lime wool named "&a%{_text}%"
        set {대화선택지슬롯::%{_p}%::%{_choiceSlot}%} to {_cid}
        add 1 to {_i}

# =========================================
#   대화 GUI 클릭 처리
# =========================================

on inventory click:
    if player's current inventory's name is "&0대화":
        cancel event
        if clicked inventory is player's inventory:
            stop
        set {_ci} to index of clicked slot
        set {_cid} to {대화선택지슬롯::%player%::%{_ci}%}
        if {_cid} is not set:
            stop
        set {_npcId} to {대화NPC::%player%}
        set {_key} to {대화키::%player%}
        if {_npcId} is not set:
            stop
        set {_action} to {대화::%{_npcId}%::%{_key}%::선택지액션::%{_cid}%}
        set {_target} to {대화::%{_npcId}%::%{_key}%::선택지이동::%{_cid}%}
        # 선택한 내용을 기록에 추가
        set {_choiceText} to {대화::%{_npcId}%::%{_key}%::선택지텍스트::%{_cid}%}
        add "player" to {대화기록타입::%player%::*}
        add {_choiceText} to {대화기록내용::%player%::*}
        if {_action} is "대화":
            set {대화GUI전환::%player%} to true
            close player's inventory
            wait 2 ticks
            npc대화표시(player, {_npcId}, {_target})
        else if {_action} is "퀘스트목록":
            set {대화GUI전환::%player%} to true
            close player's inventory
            wait 1 tick
            npc대화정리(player)
            npc퀘스트목록GUI(player, {_npcId})
        else if {_action} is "포기":
            set {대화GUI전환::%player%} to true
            close player's inventory
            wait 1 tick
            퀘스트포기(player, {_target})
            npc대화정리(player)
        else if {_action} is "닫기":
            set {대화GUI전환::%player%} to true
            close player's inventory
            wait 1 tick
            npc대화정리(player)
        else if {_action} is "여관설정":
            set {대화GUI전환::%player%} to true
            close player's inventory
            wait 1 tick
            여관스폰설정(player, {_npcId})
            npc대화정리(player)

# =========================================
#   대화 GUI 닫힘 감지
# =========================================

on inventory close:
    if name of event-inventory is "&0대화":
        if {대화GUI전환::%player%} is true:
            delete {대화GUI전환::%player%}
            stop
        # ESC로 닫은 경우 → 대화 정리
        npc대화정리(player)

# =========================================
#   이벤트: 퇴장 / 접속
# =========================================

on quit:
    npc대화정리(player)
    delete {퀘스트GUI_NPC::%player%}
    delete {퀘스트GUI슬롯::%player%::*}
    delete {퀘스트저널슬롯::%player%::*}

on join:
    # 현재 대화 중인 플레이어들의 텍스트 디스플레이를 새 접속자에게 숨김
    wait 2 ticks
    loop all players:
        loop integers from 1 to 5:
            if {대화텍스트::%loop-player%::%loop-integer%} is set:
                if {대화텍스트::%loop-player%::%loop-integer%} is valid:
                    hide {대화텍스트::%loop-player%::%loop-integer%} from player

# ===== NPC 등록/역할/대사 관리 + on load 대사 데이터는 BlockShip(Java)로 이관됨 =====
# 레지스트리: npc.json, 대사: dialogue.json. /npc등록 /npc이름 ... /npc대사추가 등은 Java 명령어.
# Java가 /npcsync 로 {NPC::*},{NPC목록::*},{대화::*} 변수를 채우면 위 엔진이 그대로 사용.
