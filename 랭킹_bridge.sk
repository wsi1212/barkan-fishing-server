# =========================================
# 랭킹_bridge.sk — 랭킹 Java 이관 브릿지
# Java(RankingManager)가 랭킹 전체 소유(/랭킹, 개인/주간 GUI, 월요일 리셋, 추천코인 보상).
# 주간 데이터 훅만 중계: 낚시/판매 시 호출되는 주간랭킹_물고기/판매 → /weekrank 위임(Java 주간필드 갱신).
#   호출처: 낚시훅_bridge, 낚시이벤트_bridge, 낚시.sk, 판매유틸_bridge.
# =========================================

# 물고기 잡았을 때 → 대어왕 + 고수 갱신 (Java)
function 주간랭킹_물고기(p: player, fishName: text, grade: text, size: number):
    execute console command "weekrank fish %{_p}'s name% %{_grade}% %{_size}% %{_fishName}%"

# 판매했을 때 → 거상 갱신 (Java)
function 주간랭킹_판매(p: player, income: number):
    execute console command "weekrank sell %{_p}'s name% %{_income}%"
