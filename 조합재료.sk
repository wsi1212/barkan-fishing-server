    add "낡은갈고리:6" to {조합재료드롭::안개섬::*}
    add "별빛진주:4" to {조합재료드롭::안개섬::*}
    # ----- 산호군도 -----
    add "산호조각:10" to {조합재료드롭::산호군도::*}
    add "진주:5" to {조합재료드롭::산호군도::*}
    add "물고기비늘:10" to {조합재료드롭::산호군도::*}
    add "강화실:7" to {조합재료드롭::산호군도::*}
    add "녹슨부품:5" to {조합재료드롭::산호군도::*}
    add "별빛진주:5" to {조합재료드롭::산호군도::*}
    # ----- 정글섬 -----
    add "야자수섬유:10" to {조합재료드롭::정글섬::*}
    add "거대비늘:5" to {조합재료드롭::정글섬::*}
    add "물고기비늘:10" to {조합재료드롭::정글섬::*}
    add "낡은갈고리:6" to {조합재료드롭::정글섬::*}
    add "깃털찌조각:5" to {조합재료드롭::정글섬::*}
    add "별빛진주:4" to {조합재료드롭::정글섬::*}
    # ----- 폐허섬 -----
    add "고대룬:7" to {조합재료드롭::폐허섬::*}
    add "학자의잉크:9" to {조합재료드롭::폐허섬::*}
    add "물고기비늘:10" to {조합재료드롭::폐허섬::*}
    add "녹슨부품:7" to {조합재료드롭::폐허섬::*}
    add "강화실:6" to {조합재료드롭::폐허섬::*}
    add "별빛진주:4" to {조합재료드롭::폐허섬::*}
    # ----- 용암군도 / lavatest -----
    add "용암수지:14" to {조합재료드롭::lavatest::*}
