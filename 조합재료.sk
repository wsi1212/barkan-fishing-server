# =========================================
# 조합재료.sk
# 낚시 중 획득 가능한 조합 재료 시스템
# 낚싯대 조합대 제작용 재료
# =========================================

# ===== 재료 데이터 초기화 =====
# 형식: {조합재료::<ID>} = "표시이름|마인크래프트아이템|설명"
on load:
    delete {조합재료::*}
    # === 기본 재료 (전 지역) === (모두 64개 중첩 가능)
    set {조합재료::낡은갈고리} to "낡은 갈고리|tripwire_hook|낚싯대 조합에 사용되는 오래된 갈고리"
    set {조합재료::물고기비늘} to "물고기 비늘|paper|물고기에서 채취한 비늘 조각"
    set {조합재료::강화실} to "강화 실|string|특수 처리된 낚싯줄 재료"
    set {조합재료::녹슨부품} to "녹슨 부품|iron_nugget|낡고 녹슨 금속 부품"
    set {조합재료::깃털찌조각} to "깃털 찌 조각|feather|찌 제작에 쓰이는 희귀 깃털"
    # === 안개섬 ===
    set {조합재료::안개수정} to "안개 수정|amethyst_shard|안개에 잠긴 신비한 결정"
    set {조합재료::행운의구슬} to "행운의 구슬|chorus_fruit|행운이 깃든 푸른 구슬"
    # === 산호군도 ===
    set {조합재료::산호조각} to "산호 조각|brain_coral|산호초에서 떨어진 조각"
    set {조합재료::진주} to "진주|nautilus_shell|조개에서 채취한 빛나는 진주"
    # === 정글섬 ===
    set {조합재료::거대비늘} to "거대 비늘|turtle_scute|대물에서만 얻는 두꺼운 비늘"
    set {조합재료::야자수섬유} to "야자수 섬유|bamboo|질기고 튼튼한 식물 섬유"
    # === 폐허섬 ===
    set {조합재료::고대룬} to "고대 룬|echo_shard|폐허에서 발견된 마법의 기호"
    set {조합재료::학자의잉크} to "학자의 잉크|ink_sac|연구가 깃든 검은 잉크"
    # === 용암군도 ===
    set {조합재료::용암수지} to "용암 수지|magma_cream|용암 지대의 특수 수지"
    set {조합재료::마그마결정} to "마그마 결정|fire_charge|용암 속에서 응결된 결정"
    # === 심연균열 (S급 재료) ===
    set {조합재료::심해수정} to "심해 수정|prismarine_crystals|심해에서 발견되는 신비한 수정"
    set {조합재료::고대비늘} to "고대 비늘|nautilus_shell|고대 생물의 단단한 비늘"
    set {조합재료::바르칸조각} to "바르칸 조각|amethyst_cluster|바르칸 열도 특산 광물 조각"
    set {조합재료::용비늘} to "용 비늘|dragon_breath|G등급 보스에서 드물게 떨어지는 비늘"
    # === 공통 재료 — 모든 지역 드롭, 거의 모든 레시피에 사용 ===
    set {조합재료::별빛진주} to "별빛 진주|heart_of_the_sea|모든 바다에서 드물게 발견되는 빛나는 진주. 낚시 제작의 핵심 재료"
    # === 강화 광물 (조합대 광물 카테고리 결과물) ===
    set {조합재료::강화자갈} to "강화 자갈|gravel|자갈 16개를 압축한 강화 광물"
    set {조합재료::강화모래} to "강화 모래|sand|모래 16개를 압축한 강화 광물"
    set {조합재료::강화부싯돌} to "강화 부싯돌|flint|부싯돌 16개를 압축한 강화 광물"
    set {조합재료::강화석탄} to "강화 석탄|coal|석탄 16개를 압축한 강화 광물"
    set {조합재료::강화철괴} to "강화 철괴|iron_ingot|철괴 16개를 압축한 강화 광물"
    set {조합재료::강화금괴} to "강화 금괴|gold_ingot|금괴 16개를 압축한 강화 광물"
    set {조합재료::강화구리괴} to "강화 구리괴|copper_ingot|구리괴 16개를 압축한 강화 광물"
    set {조합재료::강화다이아몬드} to "강화 다이아몬드|diamond|다이아몬드 16개를 압축한 강화 보석"
    set {조합재료::강화청금석} to "강화 청금석|lapis_lazuli|청금석 16개를 압축한 강화 광물"
    set {조합재료::강화에메랄드} to "강화 에메랄드|emerald|에메랄드 16개를 압축한 강화 보석"
    set {조합재료::강화네더라이트파편} to "강화 네더라이트 파편|netherite_scrap|네더라이트 파편 8개를 압축한 희귀 광물"
    # === 강화 농산물 ===
    set {조합재료::강화밀} to "강화 밀|wheat|밀 16개를 압축한 강화 농산물"
    set {조합재료::강화당근} to "강화 당근|carrot|당근 16개를 압축한 강화 농산물"
    set {조합재료::강화감자} to "강화 감자|potato|감자 16개를 압축한 강화 농산물"
    set {조합재료::강화비트루트} to "강화 비트루트|beetroot|비트루트 16개를 압축한 강화 농산물"
    # === 고급 (압축 블록/주괴 등) ===
    set {조합재료::압축석탄블록} to "압축 석탄 블록|coal_block|강화 석탄 32개를 압축한 고밀도 블록"
    set {조합재료::압축철블록} to "압축 철 블록|iron_block|강화 철괴 32개를 압축한 고밀도 블록"
    set {조합재료::압축금블록} to "압축 금 블록|gold_block|강화 금괴 32개를 압축한 고밀도 블록"
    set {조합재료::압축다이아블록} to "압축 다이아 블록|diamond_block|강화 다이아몬드 32개를 압축한 고밀도 블록"
    set {조합재료::압축에메랄드블록} to "압축 에메랄드 블록|emerald_block|강화 에메랄드 32개를 압축한 고밀도 블록"
    set {조합재료::황금건초더미} to "황금 건초 더미|hay_block|강화 밀 32개를 압축한 최상급 농산물"
    set {조합재료::황금당근} to "황금 당근|golden_carrot|강화 당근 32개를 압축한 최상급 농산물"
    set {조합재료::네더라이트주괴} to "네더라이트 주괴|netherite_ingot|최상급 합금 주괴"
    # === 중간재 (낚시 제작용 부품) ===
    set {조합재료::정제된갈고리} to "정제된 갈고리|tripwire_hook|본섬 — 낡은 갈고리를 다듬은 부품"
    set {조합재료::단단한자루} to "단단한 자루|stick|본섬 — 낚싯대 손잡이용 부품"
    set {조합재료::강철심} to "강철 심|iron_ingot|본섬 — 단단한 금속 심"
    set {조합재료::행운의매듭} to "행운의 매듭|chorus_fruit|안개섬 — 행운이 깃든 매듭"
    set {조합재료::진주코어} to "진주 코어|heart_of_the_sea|산호군도 — 진주를 응결한 코어"
    set {조합재료::정글그립} to "정글 그립|bamboo|정글섬 — 거대물고기를 위한 손잡이"
    set {조합재료::고대부적} to "고대 부적|echo_shard|폐허섬 — 룬과 잉크로 봉인된 부적"
    set {조합재료::용암코어} to "용암 코어|magma_block|용암군도 — 식지 않는 용암 코어"
    set {조합재료::심해코어} to "심해 코어|heart_of_the_sea|심연균열 — 심해의 정수가 응축된 코어"
    set {조합재료::바르칸핵} to "바르칸 핵|netherite_ingot|심연균열 — 바르칸 열도의 정수"

# 재료 드롭/판별은 Java CraftingManager.dropMaterials 권위(조합재료드롭체크/조합재료여부/{조합재료드롭} 제거).
# {조합재료} 데이터는 퀘스트보상_bridge 재료지급용으로 유지.
