    add "고대비늘:5" to {조합재료드롭::lavatest::*}
    add "바르칸조각:5" to {조합재료드롭::lavatest::*}
    add "심해수정:4" to {조합재료드롭::lavatest::*}
    add "별빛진주:4" to {조합재료드롭::lavatest::*}
    add "용암수지:14" to {조합재료드롭::용암군도::*}
    add "마그마결정:10" to {조합재료드롭::용암군도::*}
    add "고대비늘:5" to {조합재료드롭::용암군도::*}
    add "바르칸조각:5" to {조합재료드롭::용암군도::*}
    add "녹슨부품:8" to {조합재료드롭::용암군도::*}
    add "별빛진주:4" to {조합재료드롭::용암군도::*}
