# ===========================================================================
# 칭호 브릿지 — Java(BlockShip TitleDefManager) → Skript 변수 동기화 수신
#
# Java가 titles.json(칭호 정의)의 권위 소스. /titlesync 로 {칭호데이터::*}, {칭호목록::*}을 채움.
# 기존 칭호.sk 엔진(GUI/채팅/태그/자동획득)은 이 변수를 그대로 읽음.
# 플레이어 보유/장착({보유칭호},{장착칭호})은 여기서 안 다룸(여전히 Skript+PlayerData).
#
# 전송 포맷: /titlesync <필드들을 §§로 join>
#   init
#   title§§<id>
#   field§§<id>§§<필드>§§<값>      (필드: 이름/색상/설명/아이콘/애니메이션)
# ===========================================================================

command /titlesync <text>:
    permission: op
    executable by: console
    trigger:
        set {_p::*} to arg-1 split at "§§"
        set {_sub} to {_p::1}

        if {_sub} is "init":
            delete {칭호데이터::*}
            delete {칭호목록::*}

        else if {_sub} is "title":
            add {_p::2} to {칭호목록::*}

        else if {_sub} is "field":
            set {_id} to {_p::2}
            set {_f} to {_p::3}
            set {_v} to {_p::4}
            if {_f} is "아이콘":
                set {칭호데이터::%{_id}%::아이콘} to {_v} parsed as item
            else if {_f} is "애니메이션":
                set {칭호데이터::%{_id}%::애니메이션} to true
            else:
                set {칭호데이터::%{_id}%::%{_f}%} to {_v}
