# ===========================================================================
# 칭호 브릿지 — Java(BlockShip TitleDefManager) → Skript 변수 동기화 수신
#
# Java가 titles.json(칭호 정의)의 권위 소스. /titlesync 로 {칭호데이터::*}, {칭호목록::*}을 채움.
# 기존 칭호.sk 엔진(GUI/채팅/태그/자동획득)은 이 변수를 그대로 읽음.
# 플레이어 보유/장착({보유칭호},{장착칭호})은 여기서 안 다룸(여전히 Skript+PlayerData).
#
# 전송 포맷: /titlesync <필드들을 §§로 join>
#   init
#   title§§<id>
#   field§§<id>§§<필드>§§<값>      (필드: 이름/색상/설명/아이콘/애니메이션)
# ===========================================================================

command /titlesync <text>:
    permission: op
    executable by: console
    trigger:
        set {_p::*} to arg-1 split at "§§"
        set {_sub} to {_p::1}

        if {_sub} is "init":
            delete {칭호데이터::*}
            delete {칭호목록::*}

        else if {_sub} is "title":
            add {_p::2} to {칭호목록::*}

        else if {_sub} is "field":
            set {_id} to {_p::2}
            set {_f} to {_p::3}
            set {_v} to {_p::4}
            if {_f} is "아이콘":
                set {칭호데이터::%{_id}%::아이콘} to {_v} parsed as item
            else if {_f} is "애니메이션":
                set {칭호데이터::%{_id}%::애니메이션} to true
            else:
                set {칭호데이터::%{_id}%::%{_f}%} to {_v}

# ===========================================================================
# Java(TitleGuiManager) → Skript 권위 변수 쓰기 시밍
#   칭호 GUI/명령은 Java로 이관됐으나 {장착칭호}/{보유칭호}는 Skript 권위(퀘스트/도전과제/
#   캐시상점 등 5파일이 직접 write). 따라서 Java는 아래 콘솔명령으로 위임만 한다.
#   각 핸들러는 권위 변수 갱신 + 칭호태그업데이트() 호출 + PlayerData 미러 즉시 push.
# ===========================================================================

# /titleequip <name> <titleId> — GUI에서 칭호 장착
command /titleequip <text> <text>:
    permission: op
    executable by: console
    trigger:
        set {_p} to arg-1 parsed as player
        if {_p} is not set:
            stop
        if {보유칭호::%{_p}%::%arg-2%} is not true:
            stop
        set {장착칭호::%{_p}%} to arg-2
        set {_name} to {칭호데이터::%arg-2%::이름}
        if {_name} is not set:
            set {_name} to arg-2
        message "&8[&e 칭호 &8] &a%{_name}% &a칭호를 장착했습니다!" to {_p}
        칭호태그업데이트({_p})
        칭호미러푸시({_p})

# /titlegrant <name> <titleId> — 어드민 칭호 부여
command /titlegrant <text> <text>:
    permission: op
    executable by: console
    trigger:
        set {_target} to arg-1 parsed as player
        if {_target} is not set:
            stop
        set {보유칭호::%{_target}%::%arg-2%} to true
        message "&8[&e 칭호 &8] &a%{_target}'s name%에게 '%arg-2%' 칭호를 부여했습니다." to console
        message "&8[&e 칭호 &8] &a새 칭호를 받았습니다! /칭호 에서 확인하세요." to {_target}
        칭호미러푸시({_target})

# /titlerevoke <name> <titleId> — 어드민 칭호 회수
command /titlerevoke <text> <text>:
    permission: op
    executable by: console
    trigger:
        set {_target} to arg-1 parsed as player
        if {_target} is not set:
            stop
        delete {보유칭호::%{_target}%::%arg-2%}
        if {장착칭호::%{_target}%} is arg-2:
            delete {장착칭호::%{_target}%}
            칭호태그업데이트({_target})
        message "&8[&e 칭호 &8] &c%{_target}'s name%에게서 '%arg-2%' 칭호를 회수했습니다." to console
        칭호미러푸시({_target})

# PlayerData(ownedTitles/equippedTitle) 즉시 미러 — GUI가 다음 열 때 최신값을 읽도록.
# 데이터백업.sk의 정기 pdbackup title 과 동일 포맷.
function 칭호미러푸시(p: player):
    set {_n} to {_p}'s name
    set {_title} to {장착칭호::%{_p}%}
    if {_title} is not set:
        set {_title} to "없음"
    else:
        replace all " " with "_" in {_title}
    set {_ownedTitles} to ""
    loop {보유칭호::%{_p}%::*}:
        set {_tname} to loop-index
        replace all " " with "_" in {_tname}
        if {_ownedTitles} is "":
            set {_ownedTitles} to {_tname}
        else:
            set {_ownedTitles} to "%{_ownedTitles}%||%{_tname}%"
    if {_ownedTitles} is "":
        set {_ownedTitles} to "없음"
    execute console command "pdbackup %{_n}% title %{_title}% %{_ownedTitles}%"
