# ===== 퀘스트 도감 시스템 =====
# 전체 퀘스트 목록 조회 GUI — 설명, 달성조건, 보상, 체인 한눈에 확인

# ===== 목표 텍스트 생성 (정적 — 플레이어 진행도 없이) =====
function 도감목표텍스트(goalStr: text) :: text:
    set {_obj::*} to split {_goalStr} at "|"
    if {_obj::1} is "fish":
        set {_fishName} to {_obj::2}
        set {_gradeName} to {_obj::3}
        set {_target} to {_obj::4}
        set {_minSize} to {_obj::5}
        if {_fishName} is "아무":
            set {_fishName} to "아무 물고기"
        if {_gradeName} is not "아무":
            set {_fishName} to "%{_gradeName}%등급+ %{_fishName}%"
        set {_result} to "&f%{_fishName}% &7%{_target}%마리 잡기"
        set {_ms} to {_minSize} parsed as number
        if {_ms} is set:
            if {_ms} > 0:
                set {_result} to "%{_result}% &8(%{_minSize}%cm+)"
        return {_result}
    else if {_obj::1} is "fish_fresh":
        set {_fishName} to {_obj::2}
        set {_gradeName} to {_obj::3}
        set {_target} to {_obj::4}
        set {_minSize} to {_obj::5}
        set {_minQuality} to {_obj::6}
        if {_fishName} is "아무":
            set {_fishName} to "아무 물고기"
        if {_gradeName} is not "아무":
            set {_fishName} to "%{_gradeName}%등급+ %{_fishName}%"
        set {_result} to "&f%{_fishName}% &7%{_target}%마리 &8(신선도 유지)"
        set {_ms} to {_minSize} parsed as number
        if {_ms} is set:
            if {_ms} > 0:
                set {_result} to "%{_result}% &8(%{_minSize}%cm+)"
        set {_mq} to {_minQuality} parsed as number
        if {_mq} is set:
            if {_mq} > 0:
                set {_result} to "%{_result}% &8(품질%{_minQuality}%이상)"
        return {_result}
    else if {_obj::1} is "material":
        set {_matId} to {_obj::2}
        set {_count} to {_obj::3}
        if {_matId} is "아무":
            return "&f아무 재료 &7%{_count}%개 수집"
        return "&f%{_matId}% &7%{_count}%개 수집"
    else if {_obj::1} is "level":
        return "&f낚시 레벨 Lv.%{_obj::2}% &7달성"
    else if {_obj::1} is "area":
        return "&f%{_obj::2}% &7방문"
    else if {_obj::1} is "sell":
        return "&f물고기 %{_obj::2}%마리 &7판매"
    else if {_obj::1} is "money":
        return "&f소지금 %{_obj::2}%원 &7달성"
    else if {_obj::1} is "login":
        return "&f%{_obj::2}%일 &7접속"
    else if {_obj::1} is "quest_daily":
        return "&f일일 퀘스트 %{_obj::2}%개 &7완료"
    else if {_obj::1} is "craft":
        if {_obj::2} is "아무":
            return "&f아이템 %{_obj::3}%개 &7조합"
        set {_dn} to {_obj::2}
        replace all "_" with " " in {_dn}
        return "&f%{_dn}% &7%{_obj::3}%개 조합"
    return "&7%{_goalStr}%"

# ===== 카테고리 선택 GUI =====
function 퀘스트도감메인(p: player):
    open chest inventory with 3 rows named "&0퀘스트 도감" to {_p}
    wait 1 tick
    loop integers from 0 to 26:
        set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 4 of {_p}'s current inventory to bookshelf named "&e&l퀘스트 도감" with lore "&7서버의 모든 퀘스트를 확인하세요."
    set slot 8 of {_p}'s current inventory to barrier named "&c&l닫기"
    # 메인 퀘스트 카운트
    set {_mainTotal} to 0
    set {_mainDone} to 0
    loop {퀘스트목록::*}:
        set {_cat} to {퀘스트::%loop-value%::카테고리}
        if {_cat} is "메인" or "튜토":
            add 1 to {_mainTotal}
            if {퀘스트상태::%loop-value%::%{_p}%} is "완료":
                add 1 to {_mainDone}
    set slot 10 of {_p}'s current inventory to writable book named "&e&l메인 퀘스트" with lore "&7스토리 퀘스트" and "" and "&7전체: &f%{_mainTotal}%개 &8| &7완료: &a%{_mainDone}%개" and "" and "&a클릭하여 보기"
    # 일일 퀘스트 카운트
    set {_dailyTotal} to 0
    loop {퀘스트목록::*}:
        if {퀘스트::%loop-value%::카테고리} is "일일":
            add 1 to {_dailyTotal}
    set slot 12 of {_p}'s current inventory to clock named "&b&l일일 퀘스트" with lore "&7매일 갱신되는 퀘스트" and "" and "&7전체: &f%{_dailyTotal}%개 &8(난이도별)" and "" and "&a클릭하여 보기"
    # 주간 퀘스트 카운트
    set {_weeklyTotal} to 0
    loop {퀘스트목록::*}:
        if {퀘스트::%loop-value%::카테고리} is "주간":
            add 1 to {_weeklyTotal}
    set slot 14 of {_p}'s current inventory to recovery compass named "&d&l주간 퀘스트" with lore "&7매주 갱신되는 퀘스트" and "" and "&7전체: &f%{_weeklyTotal}%개" and "" and "&a클릭하여 보기"
    # 사이드 퀘스트 카운트 (사이드 + 반복 모두 포함)
    set {_sideTotal} to 0
    set {_sideDone} to 0
    set {_sideOnce} to 0
    set {_sideRepeat} to 0
    loop {퀘스트목록::*}:
        set {_sc} to {퀘스트::%loop-value%::카테고리}
        if {_sc} is "사이드":
            add 1 to {_sideTotal}
            add 1 to {_sideOnce}
            if {퀘스트상태::%loop-value%::%{_p}%} is "완료":
                add 1 to {_sideDone}
        if {_sc} is "반복":
            add 1 to {_sideTotal}
            add 1 to {_sideRepeat}
            if {퀘스트상태::%loop-value%::%{_p}%} is "완료":
                add 1 to {_sideDone}
    set slot 16 of {_p}'s current inventory to name tag named "&a&l사이드 퀘스트" with lore "&7NPC 사이드 퀘스트" and "" and "&7전체: &f%{_sideTotal}%개 &8| &7완료: &a%{_sideDone}%개" and "&8일회성: %{_sideOnce}%개 | 반복: %{_sideRepeat}%개" and "" and "&a클릭하여 보기"

# ===== 카테고리 선택 클릭 =====
on inventory click:
    if player's current inventory's name is "&0퀘스트 도감":
        cancel event
        if clicked inventory is player's inventory:
            stop
        if clicked slot is 8:
            close player's inventory
            stop
        if clicked slot is 10:
            set {도감카테고리::%player%} to "메인"
            set {도감메인필터::%player%} to "전체"
            set {도감페이지::%player%} to 1
            wait 1 tick
            도감목록GUI(player)
            stop
        if clicked slot is 12:
            set {도감카테고리::%player%} to "일일"
            set {도감일일필터::%player%} to "전체"
            set {도감페이지::%player%} to 1
            wait 1 tick
            도감목록GUI(player)
            stop
        if clicked slot is 14:
            set {도감카테고리::%player%} to "주간"
            set {도감페이지::%player%} to 1
            wait 1 tick
            도감목록GUI(player)
            stop
        if clicked slot is 16:
            set {도감카테고리::%player%} to "사이드"
            set {도감사이드필터::%player%} to "전체"
            set {도감페이지::%player%} to 1
            wait 1 tick
            도감목록GUI(player)
            stop

# ===== 퀘스트 목록 GUI =====
function 도감목록GUI(p: player):
    set {_cat} to {도감카테고리::%{_p}%}
    set {_page} to {도감페이지::%{_p}%}
    if {_page} is not set:
        set {_page} to 1
    # 카테고리별 색상/이름
    set {_catColor} to "&e"
    set {_catName} to "메인"
    if {_cat} is "일일":
        set {_catColor} to "&b"
        set {_catName} to "일일"
    else if {_cat} is "주간":
        set {_catColor} to "&d"
        set {_catName} to "주간"
    else if {_cat} is "사이드":
        set {_catColor} to "&a"
        set {_catName} to "사이드"

    open chest inventory with 6 rows named "&0도감 목록" to {_p}
    wait 1 tick
    # 전체 유리 채우기
    loop integers from 0 to 53:
        set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
    # 상단 바
    set slot 0 of {_p}'s current inventory to arrow named "&e← 도감 메뉴"
    set slot 4 of {_p}'s current inventory to bookshelf named "%{_catColor}%&l%{_catName}% 퀘스트"
    set slot 8 of {_p}'s current inventory to barrier named "&c&l닫기"

    # 메인 퀘스트 마을 필터 탭
    if {_cat} is "메인":
        set {_mFilter} to {도감메인필터::%{_p}%}
        if {_mFilter} is not set:
            set {_mFilter} to "전체"
        if {_mFilter} is "전체":
            set slot 1 of {_p}'s current inventory to lime dye named "&a&l전체"
        else:
            set slot 1 of {_p}'s current inventory to gray dye named "&7전체"
        if {_mFilter} is "튜토":
            set slot 2 of {_p}'s current inventory to writable book named "&e&l튜토리얼"
        else:
            set slot 2 of {_p}'s current inventory to white concrete named "&7튜토리얼"
        if {_mFilter} is "본섬":
            set slot 3 of {_p}'s current inventory to grass block named "&e&l바르칸 본섬"
        else:
            set slot 3 of {_p}'s current inventory to white concrete named "&7바르칸 본섬"
        if {_mFilter} is "상단":
            set slot 5 of {_p}'s current inventory to barrel named "&b&l상단마을"
        else:
            set slot 5 of {_p}'s current inventory to white concrete named "&7상단마을"
        if {_mFilter} is "사막":
            set slot 6 of {_p}'s current inventory to sand named "&6&l사막"
        else:
            set slot 6 of {_p}'s current inventory to white concrete named "&7사막"

    # 일일 퀘스트 난이도 필터 탭
    if {_cat} is "일일":
        set {_filter} to {도감일일필터::%{_p}%}
        if {_filter} is not set:
            set {_filter} to "전체"
        if {_filter} is "전체":
            set slot 2 of {_p}'s current inventory to lime dye named "&a&l전체"
        else:
            set slot 2 of {_p}'s current inventory to gray dye named "&7전체"
        if {_filter} is "쉬움":
            set slot 3 of {_p}'s current inventory to lime concrete named "&a&l쉬움"
        else:
            set slot 3 of {_p}'s current inventory to white concrete named "&7쉬움"
        if {_filter} is "보통":
            set slot 5 of {_p}'s current inventory to yellow concrete named "&e&l보통"
        else:
            set slot 5 of {_p}'s current inventory to white concrete named "&7보통"
        if {_filter} is "어려움":
            set slot 6 of {_p}'s current inventory to orange concrete named "&6&l어려움"
        else:
            set slot 6 of {_p}'s current inventory to white concrete named "&7어려움"
        if {_filter} is "전문":
            set slot 7 of {_p}'s current inventory to red concrete named "&c&l전문"
        else:
            set slot 7 of {_p}'s current inventory to white concrete named "&7전문"

    # 사이드 마을 필터 탭
    if {_cat} is "사이드":
        set {_sFilter} to {도감사이드필터::%{_p}%}
        if {_sFilter} is not set:
            set {_sFilter} to "전체"
        if {_sFilter} is "전체":
            set slot 1 of {_p}'s current inventory to lime dye named "&a&l전체"
        else:
            set slot 1 of {_p}'s current inventory to gray dye named "&7전체"
        if {_sFilter} is "본섬":
            set slot 2 of {_p}'s current inventory to grass block named "&e&l바르칸 본섬"
        else:
            set slot 2 of {_p}'s current inventory to white concrete named "&7바르칸 본섬"
        if {_sFilter} is "사막":
            set slot 3 of {_p}'s current inventory to sand named "&6&l사막"
        else:
            set slot 3 of {_p}'s current inventory to white concrete named "&7사막"
        if {_sFilter} is "상단":
            set slot 5 of {_p}'s current inventory to barrel named "&b&l상단마을"
        else:
            set slot 5 of {_p}'s current inventory to white concrete named "&7상단마을"

    # 퀘스트 수집
    delete {_quests::*}
    loop {퀘스트목록::*}:
        set {_qCat} to {퀘스트::%loop-value%::카테고리}
        set {_match} to false
        if {_cat} is "메인":
            set {_isMain} to false
            if {_qCat} is "메인":
                set {_isMain} to true
            if {_qCat} is "튜토":
                set {_isMain} to true
            if {_isMain} is true:
                set {_mFilter} to {도감메인필터::%{_p}%}
                if {_mFilter} is "전체":
                    set {_match} to true
                else if {_mFilter} is "튜토":
                    if loop-value starts with "튜토":
                        set {_match} to true
                else if {_mFilter} is "본섬":
                    if loop-value starts with "본섬":
                        set {_match} to true
                else if {_mFilter} is "상단":
                    if loop-value starts with "본상단":
                        set {_match} to true
                else if {_mFilter} is "사막":
                    if loop-value starts with "사막":
                        set {_match} to true
        else if {_cat} is "일일":
            if {_qCat} is "일일":
                set {_filter} to {도감일일필터::%{_p}%}
                if {_filter} is "전체":
                    set {_match} to true
                else if {_filter} is "쉬움":
                    if {퀘스트일일쉬움::*} contains loop-value:
                        set {_match} to true
                else if {_filter} is "보통":
                    if {퀘스트일일보통::*} contains loop-value:
                        set {_match} to true
                else if {_filter} is "어려움":
                    if {퀘스트일일어려움::*} contains loop-value:
                        set {_match} to true
                else if {_filter} is "전문":
                    if {퀘스트일일전문::*} contains loop-value:
                        set {_match} to true
        else if {_cat} is "주간":
            if {_qCat} is "주간":
                set {_match} to true
        else if {_cat} is "사이드":
            # 사이드 또는 반복 카테고리 모두 사이드 퀘스트로 취급
            set {_isSide} to false
            if {_qCat} is "사이드":
                set {_isSide} to true
            if {_qCat} is "반복":
                set {_isSide} to true
            if {_isSide} is true:
                set {_sFilter} to {도감사이드필터::%{_p}%}
                if {_sFilter} is "전체":
                    set {_match} to true
                else if {_sFilter} is "본섬":
                    if loop-value starts with "본사이드_":
                        set {_match} to true
                else if {_sFilter} is "사막":
                    if loop-value starts with "사사이드_":
                        set {_match} to true
                else if {_sFilter} is "상단":
                    if loop-value starts with "상사이드_":
                        set {_match} to true
        if {_match} is true:
            add loop-value to {_quests::*}

    # 페이지 계산 (28개/페이지)
    set {_total} to size of {_quests::*}
    if {_total} is not set:
        set {_total} to 0
    set {_perPage} to 28
    if {_total} > 0:
        set {_maxPage} to ceil({_total} / {_perPage})
    else:
        set {_maxPage} to 1
    if {_page} > {_maxPage}:
        set {_page} to {_maxPage}
    set {도감페이지::%{_p}%} to {_page}
    set {_start} to ({_page} - 1) * {_perPage}

    # 슬롯 배열 (rows 1~4, columns 1~7)
    delete {_slots::*}
    add 10 to {_slots::*}
    add 11 to {_slots::*}
    add 12 to {_slots::*}
    add 13 to {_slots::*}
    add 14 to {_slots::*}
    add 15 to {_slots::*}
    add 16 to {_slots::*}
    add 19 to {_slots::*}
    add 20 to {_slots::*}
    add 21 to {_slots::*}
    add 22 to {_slots::*}
    add 23 to {_slots::*}
    add 24 to {_slots::*}
    add 25 to {_slots::*}
    add 28 to {_slots::*}
    add 29 to {_slots::*}
    add 30 to {_slots::*}
    add 31 to {_slots::*}
    add 32 to {_slots::*}
    add 33 to {_slots::*}
    add 34 to {_slots::*}
    add 37 to {_slots::*}
    add 38 to {_slots::*}
    add 39 to {_slots::*}
    add 40 to {_slots::*}
    add 41 to {_slots::*}
    add 42 to {_slots::*}
    add 43 to {_slots::*}

    # 아이콘 배치
    delete {도감슬롯::%{_p}%::*}
    if {_total} <= 0:
        set slot 22 of {_p}'s current inventory to gray stained glass pane named "&7퀘스트가 없습니다"
        stop
    delete {_pageQuests::*}
    set {_qi} to 0
    loop {_quests::*}:
        add 1 to {_qi}
        if {_qi} > {_start}:
            if size of {_pageQuests::*} < {_perPage}:
                add loop-value to {_pageQuests::*}
    set {_si} to 0
    loop {_pageQuests::*}:
        add 1 to {_si}
        set {_sl} to {_slots::%{_si}%}
        도감아이콘({_p}, loop-value, {_sl})

    # 네비게이션
    set slot 49 of {_p}'s current inventory to paper named "&7페이지 %{_page}%/%{_maxPage}% &8(총 %{_total}%개)"
    if {_page} > 1:
        set slot 48 of {_p}'s current inventory to arrow named "&e← 이전 페이지"
    if {_page} < {_maxPage}:
        set slot 50 of {_p}'s current inventory to arrow named "&e다음 페이지 →"

# ===== 아이콘 렌더링 =====
function 도감아이콘(p: player, questId: text, slot: integer):
    set {_name} to {퀘스트::%{_questId}%::이름}
    if {_name} is not set:
        set {_name} to {_questId}
    set {_status} to {퀘스트상태::%{_questId}%::%{_p}%}
    set {_cat} to {퀘스트::%{_questId}%::카테고리}

    delete {_lore::*}
    # ID & 카테고리
    set {_catLabel} to "&7메인"
    if {_cat} is "일일":
        set {_catLabel} to "&b일일"
    else if {_cat} is "주간":
        set {_catLabel} to "&d주간"
    else if {_cat} is "튜토":
        set {_catLabel} to "&e튜토리얼"
    else if {_cat} is "사이드":
        set {_catLabel} to "&a일회성"
    else if {_cat} is "반복":
        set {_catLabel} to "&6반복"
    add "&8[%{_catLabel}%&8] &8%{_questId}%" to {_lore::*}

    # 필요 레벨
    set {_reqLv} to {퀘스트::%{_questId}%::필요레벨}
    if {_reqLv} is not set:
        set {_reqLv} to 1
    add "&7필요 레벨: &fLv.%{_reqLv}%" to {_lore::*}

    # 상태
    if {_status} is "완료":
        add "&a✔ 완료" to {_lore::*}
    else if {_status} is "완료대기":
        add "&6★ 보상 대기" to {_lore::*}
    else if {_status} is "진행":
        add "&e● 진행 중" to {_lore::*}
    else:
        add "&7○ 미시작" to {_lore::*}
    add "" to {_lore::*}

    # 설명 (대화 내역)
    add "&e&l[ 설명 ]" to {_lore::*}
    if {퀘스트::%{_questId}%::설명::*} is set:
        loop {퀘스트::%{_questId}%::설명::*}:
            add "  %loop-value%" to {_lore::*}
    else:
        add "  &7(설명 없음)" to {_lore::*}
    add "" to {_lore::*}

    # 달성 조건
    add "&6&l[ 달성 조건 ]" to {_lore::*}
    if {퀘스트::%{_questId}%::목표::*} is set:
        loop {퀘스트::%{_questId}%::목표::*}:
            set {_goalText} to 도감목표텍스트(loop-value)
            add "  &7▸ %{_goalText}%" to {_lore::*}
        # 진행 중이면 현재 진행도 표시
        if {_status} is "진행":
            set {_progress} to 퀘스트목표텍스트({_questId}, {_p})
            if {_progress} is set:
                add "  &8현재: %{_progress}%" to {_lore::*}
    else:
        add "  &7(목표 없음)" to {_lore::*}
    add "" to {_lore::*}

    # 보상
    add "&a&l[ 보상 ]" to {_lore::*}
    set {_hasReward} to false
    if {퀘스트::%{_questId}%::보상돈} is set:
        add "  &e▸ %{퀘스트::%{_questId}%::보상돈}%원" to {_lore::*}
        set {_hasReward} to true
    if {퀘스트::%{_questId}%::보상경험치} is set:
        add "  &a▸ %{퀘스트::%{_questId}%::보상경험치}%exp" to {_lore::*}
        set {_hasReward} to true
    if {퀘스트::%{_questId}%::보상칭호} is set:
        set {_tn} to {칭호데이터::%{퀘스트::%{_questId}%::보상칭호}%::이름}
        if {_tn} is not set:
            set {_tn} to {퀘스트::%{_questId}%::보상칭호}
        add "  &d▸ 칭호: %{_tn}%" to {_lore::*}
        set {_hasReward} to true
    if {퀘스트::%{_questId}%::보상페리} is set:
        add "  &b▸ 페리: %{퀘스트::%{_questId}%::보상페리}% 노선 해금" to {_lore::*}
        set {_hasReward} to true
    if {퀘스트::%{_questId}%::보상재료} is set:
        set {_mrP::*} to split {퀘스트::%{_questId}%::보상재료} at ":"
        add "  &6▸ 재료: %{_mrP::1}% x%{_mrP::2}%" to {_lore::*}
        set {_hasReward} to true
    if {_hasReward} is false:
        add "  &7없음" to {_lore::*}

    # 선행/다음 퀘스트
    if {퀘스트::%{_questId}%::선행퀘스트} is set:
        set {_prereqName} to {퀘스트::%{퀘스트::%{_questId}%::선행퀘스트}%::이름}
        if {_prereqName} is not set:
            set {_prereqName} to {퀘스트::%{_questId}%::선행퀘스트}
        add "" to {_lore::*}
        add "&8← 선행: %{_prereqName}%" to {_lore::*}
    if {퀘스트::%{_questId}%::다음퀘스트} is set:
        set {_nextName} to {퀘스트::%{퀘스트::%{_questId}%::다음퀘스트}%::이름}
        if {_nextName} is not set:
            set {_nextName} to {퀘스트::%{_questId}%::다음퀘스트}
        add "&8→ 다음: %{_nextName}%" to {_lore::*}

    # 아이콘 결정
    if {_status} is "완료":
        set slot {_slot} of {_p}'s current inventory to lime stained glass pane named "&a%{_name}%" with lore {_lore::*}
    else if {_status} is "완료대기":
        set slot {_slot} of {_p}'s current inventory to golden apple named "&e%{_name}%" with lore {_lore::*}
    else if {_status} is "진행":
        set slot {_slot} of {_p}'s current inventory to filled map named "&e%{_name}%" with lore {_lore::*}
    else:
        set slot {_slot} of {_p}'s current inventory to paper named "%{_name}%" with lore {_lore::*}
    set {도감슬롯::%{_p}%::%{_slot}%} to {_questId}

# ===== 목록 GUI 클릭 =====
on inventory click:
    if player's current inventory's name is "&0도감 목록":
        cancel event
        if clicked inventory is player's inventory:
            stop
        # 닫기
        if clicked slot is 8:
            close player's inventory
            stop
        # 뒤로 (도감 메뉴)
        if clicked slot is 0:
            wait 1 tick
            퀘스트도감메인(player)
            stop
        # 페이지 이동
        if clicked slot is 48:
            if {도감페이지::%player%} > 1:
                remove 1 from {도감페이지::%player%}
                wait 1 tick
                도감목록GUI(player)
            stop
        if clicked slot is 50:
            add 1 to {도감페이지::%player%}
            wait 1 tick
            도감목록GUI(player)
            stop
        # 메인 마을 필터 (slots 1,2,3,5,6)
        if {도감카테고리::%player%} is "메인":
            set {_newFilter} to ""
            if clicked slot is 1:
                set {_newFilter} to "전체"
            else if clicked slot is 2:
                set {_newFilter} to "튜토"
            else if clicked slot is 3:
                set {_newFilter} to "본섬"
            else if clicked slot is 5:
                set {_newFilter} to "상단"
            else if clicked slot is 6:
                set {_newFilter} to "사막"
            if {_newFilter} is not "":
                set {도감메인필터::%player%} to {_newFilter}
                set {도감페이지::%player%} to 1
                wait 1 tick
                도감목록GUI(player)
                stop
        # 일일 난이도 필터 (slots 2,3,5,6,7)
        if {도감카테고리::%player%} is "일일":
            set {_newFilter} to ""
            if clicked slot is 2:
                set {_newFilter} to "전체"
            else if clicked slot is 3:
                set {_newFilter} to "쉬움"
            else if clicked slot is 5:
                set {_newFilter} to "보통"
            else if clicked slot is 6:
                set {_newFilter} to "어려움"
            else if clicked slot is 7:
                set {_newFilter} to "전문"
            if {_newFilter} is not "":
                set {도감일일필터::%player%} to {_newFilter}
                set {도감페이지::%player%} to 1
                wait 1 tick
                도감목록GUI(player)
                stop
        # 사이드 마을 필터 (slots 1,2,3,5)
        if {도감카테고리::%player%} is "사이드":
            set {_newFilter} to ""
            if clicked slot is 1:
                set {_newFilter} to "전체"
            else if clicked slot is 2:
                set {_newFilter} to "본섬"
            else if clicked slot is 3:
                set {_newFilter} to "사막"
            else if clicked slot is 5:
                set {_newFilter} to "상단"
            if {_newFilter} is not "":
                set {도감사이드필터::%player%} to {_newFilter}
                set {도감페이지::%player%} to 1
                wait 1 tick
                도감목록GUI(player)
                stop

# ===== 명령어 =====
command /퀘스트도감:
    aliases: /zptmxmehrka
    trigger:
        퀘스트도감메인(player)

on tab complete of "/퀘스트도감":
    stop
