# ===== 수집품 시스템 (코르그) =====
# 숨겨진 플레이어 머리를 찾아 우클릭하면 도감 등록 + 탐험exp

# ===== collectiblesync 브릿지 (Java → Skript) =====
# 포맷: /collectiblesync add <ID> <섬> <world>:<x>:<y>:<z>
command /collectiblesync <text> [<text>] [<text>] [<text>]:
    permission: op
    executable by: console
    trigger:
        if arg-1 is "init":
            delete {수집품목록::*}
            delete {수집품섬목록::*}
        else if arg-1 is "add":
            # /collectiblesync add <ID> <섬> <world>:<x>:<y>:<z>:<headType>
            add arg-2 to {수집품목록::*}
            set {수집품::%arg-2%::섬} to arg-3
            set {_loc::*} to split arg-4 at ":"
            set {수집품::%arg-2%::월드} to {_loc::1}
            set {수집품::%arg-2%::x} to {_loc::2} parsed as integer
            set {수집품::%arg-2%::y} to {_loc::3} parsed as integer
            set {수집품::%arg-2%::z} to {_loc::4} parsed as integer
            if {_loc::5} is set:
                set {수집품::%arg-2%::타입} to {_loc::5}
            if {수집품섬목록::*} does not contain arg-3:
                add arg-3 to {수집품섬목록::*}
        else if arg-1 is "remove":
            remove arg-2 from {수집품목록::*}
            delete {수집품::%arg-2%::*}

# ===== 우클릭 이벤트 — Java에서 /collectiblefound 브릿지로 호출 =====
# Java PlayerInteractEvent에서 머리 블록 우클릭 감지 → 이 명령어 호출
command /collectiblefound <player> <text>:
    permission: op
    executable by: console
    trigger:
        set {_p} to arg-1
        set {_foundId} to arg-2
        # 이미 발견?
        if {수집품발견::%{_p}%::%{_foundId}%} is true:
            message "&8[&5 수집품 &8] &7이미 발견한 수집품입니다." to {_p}
            stop
        # 첫 발견!
        set {수집품발견::%{_p}%::%{_foundId}%} to true
        # 탐험 경험치
        탐험경험치추가({_p}, 40)
        # 총 발견 수 계산
        set {_totalFound} to 0
        loop {수집품목록::*}:
            if {수집품발견::%{_p}%::%loop-value%} is true:
                add 1 to {_totalFound}
        set {_totalAll} to size of {수집품목록::*}
        # 섬별 진행도 계산
        set {_island} to {수집품::%{_foundId}%::섬}
        set {_islandCount} to 도감카운트_수집품섬({_p}, {_island})
        # 메시지 + 효과
        message "&8[&5 수집품 &8] &d숨겨진 수집품 발견! &f%{_foundId}%" to {_p}
        message "&8[&5 수집품 &8] &7%{_island}% &8- &f%{_islandCount}% &8| &7전체 &f%{_totalFound}%/%{_totalAll}%" to {_p}
        message "&8[&5 수집품 &8] &5+40 탐험 경험치" to {_p}
        play sound "entity.player.levelup" with volume 0.5 and pitch 1.8 to {_p}
        # 마일스톤 체크
        수집품마일스톤({_p}, {_totalFound})

# ===== 마일스톤 보상 =====
function 수집품마일스톤(p: player, count: number):
    if {_count} is 5:
        if {수집품마일스톤::%{_p}%::5} is not true:
            set {수집품마일스톤::%{_p}%::5} to true
            if {돈::%{_p}%} is not set:
                set {돈::%{_p}%} to 0
            add 1000 to {돈::%{_p}%}
            set {보유칭호::%{_p}%::수집가} to true
            message "&6[마일스톤] &e수집품 5개 달성! &f+1000원 &d칭호: 수집가" to {_p}
            send title "&6&l마일스톤!" with subtitle "&e수집품 5개 달성!" to {_p} for 3 seconds
            play sound "ui.toast.challenge_complete" with volume 0.7 to {_p}
    if {_count} is 15:
        if {수집품마일스톤::%{_p}%::15} is not true:
            set {수집품마일스톤::%{_p}%::15} to true
            add 3000 to {돈::%{_p}%}
            message "&6[마일스톤] &e수집품 15개 달성! &f+3000원" to {_p}
            send title "&6&l마일스톤!" with subtitle "&e수집품 15개 달성!" to {_p} for 3 seconds
            play sound "ui.toast.challenge_complete" with volume 0.7 to {_p}
    if {_count} is 30:
        if {수집품마일스톤::%{_p}%::30} is not true:
            set {수집품마일스톤::%{_p}%::30} to true
            add 10000 to {돈::%{_p}%}
            set {보유칭호::%{_p}%::탐험의달인} to true
            message "&6[마일스톤] &e수집품 30개 달성! &f+10000원 &d칭호: 탐험의 달인" to {_p}
            send title "&6&l마일스톤!" with subtitle "&e수집품 30개 달성!" to {_p} for 3 seconds
            play sound "ui.toast.challenge_complete" with volume 0.7 to {_p}
    if {_count} is 50:
        if {수집품마일스톤::%{_p}%::50} is not true:
            set {수집품마일스톤::%{_p}%::50} to true
            add 30000 to {돈::%{_p}%}
            message "&6[마일스톤] &e수집품 50개 달성! &f+30000원" to {_p}
            send title "&6&l마일스톤!" with subtitle "&e수집품 50개 달성!" to {_p} for 3 seconds
            play sound "ui.toast.challenge_complete" with volume 0.7 to {_p}
    # 전부 발견
    set {_total} to size of {수집품목록::*}
    if {_count} >= {_total}:
        if {_total} > 0:
            if {수집품마일스톤::%{_p}%::전부} is not true:
                set {수집품마일스톤::%{_p}%::전부} to true
                set {보유칭호::%{_p}%::모든것의발견자} to true
                message "&6[마일스톤] &6&l모든 수집품을 발견했습니다! &d칭호: 모든 것의 발견자" to {_p}
                send title "&6&l완전 정복!" with subtitle "&d모든 수집품 발견!" to {_p} for 5 seconds
                play sound "ui.toast.challenge_complete" with volume 1 and pitch 0.8 to {_p}

# ===== 도감용 카운트 함수 =====
function 도감카운트_수집품(p: player) :: text:
    set {_found} to 0
    set {_total} to size of {수집품목록::*}
    if {_total} is not set:
        set {_total} to 0
    loop {수집품목록::*}:
        if {수집품발견::%{_p}%::%loop-value%} is true:
            add 1 to {_found}
    return "%{_found}%/%{_total}%"

function 도감카운트_수집품섬(p: player, island: text) :: text:
    set {_found} to 0
    set {_total} to 0
    loop {수집품목록::*}:
        if {수집품::%loop-value%::섬} is {_island}:
            add 1 to {_total}
            if {수집품발견::%{_p}%::%loop-value%} is true:
                add 1 to {_found}
    return "%{_found}%/%{_total}%"

# ===== 수집품 도감 GUI (섬별) =====
function 도감_수집품GUI(p: player):
    open chest inventory with 4 rows named "&0도감: 수집품" to {_p}
    wait 1 tick
    loop integers from 0 to 35:
        set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 0 of {_p}'s current inventory to arrow named "&e← 도감 메뉴"
    set {_cc} to 도감카운트_수집품({_p})
    set slot 4 of {_p}'s current inventory to player head named "&5&l수집품 도감" with lore "&7숨겨진 수집품 찾기" and "" and "&7발견: &f%{_cc}%"
    set slot 8 of {_p}'s current inventory to barrier named "&c&l닫기"
    # 섬별 표시
    set {_si} to 0
    set {_slots::1} to 10
    set {_slots::2} to 11
    set {_slots::3} to 12
    set {_slots::4} to 13
    set {_slots::5} to 14
    set {_slots::6} to 15
    set {_slots::7} to 16
    set {_slots::8} to 19
    set {_slots::9} to 20
    set {_slots::10} to 21
    set {_slots::11} to 22
    set {_slots::12} to 23
    set {_slots::13} to 24
    set {_slots::14} to 25
    delete {수집품GUI슬롯::%{_p}%::*}
    loop {수집품섬목록::*}:
        add 1 to {_si}
        if {_si} > 14:
            stop
        set {_sl} to {_slots::%{_si}%}
        set {_island} to loop-value
        set {_ic} to 도감카운트_수집품섬({_p}, {_island})
        set {수집품GUI슬롯::%{_p}%::%{_sl}%} to {_island}
        set slot {_sl} of {_p}'s current inventory to filled map named "&5%{_island}%" with lore "&7수집품: &f%{_ic}%" and "" and "&a클릭하여 상세 보기"

on inventory click:
    if player's current inventory's name is "&0도감: 수집품":
        cancel event
        if clicked slot is 0:
            wait 1 tick
            도감메인GUI(player)
            stop
        if clicked slot is 8:
            close player's inventory
            stop
        # 섬 클릭 → 상세 페이지
        set {_ci} to index of clicked slot
        set {_island} to {수집품GUI슬롯::%player%::%{_ci}%}
        if {_island} is set:
            set {수집품상세섬::%player%} to {_island}
            set {수집품상세페이지::%player%} to 1
            wait 1 tick
            도감_수집품상세GUI(player)
            stop

# ===== 수집품 상세 GUI (섬별 개별 수집품 목록) =====
function 도감_수집품상세GUI(p: player):
    set {_island} to {수집품상세섬::%{_p}%}
    set {_page} to {수집품상세페이지::%{_p}%}
    if {_page} is not set:
        set {_page} to 1
    open chest inventory with 6 rows named "&0수집품: %{_island}%" to {_p}
    wait 1 tick
    loop integers from 0 to 53:
        set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 0 of {_p}'s current inventory to arrow named "&e← 수집품 도감"
    set {_ic} to 도감카운트_수집품섬({_p}, {_island})
    set slot 4 of {_p}'s current inventory to filled map named "&5&l%{_island}%" with lore "&7수집품: &f%{_ic}%"
    set slot 8 of {_p}'s current inventory to barrier named "&c&l닫기"
    # 해당 섬의 수집품 수집
    delete {_items::*}
    loop {수집품목록::*}:
        if {수집품::%loop-value%::섬} is {_island}:
            add loop-value to {_items::*}
    # 페이지 계산
    set {_total} to size of {_items::*}
    if {_total} is not set:
        set {_total} to 0
    set {_perPage} to 28
    if {_total} > 0:
        set {_maxPage} to ceil({_total} / {_perPage})
    else:
        set {_maxPage} to 1
    if {_page} > {_maxPage}:
        set {_page} to {_maxPage}
    set {수집품상세페이지::%{_p}%} to {_page}
    set {_start} to ({_page} - 1) * {_perPage}
    # 슬롯 배열
    delete {_slots::*}
    add 10 to {_slots::*}
    add 11 to {_slots::*}
    add 12 to {_slots::*}
    add 13 to {_slots::*}
    add 14 to {_slots::*}
    add 15 to {_slots::*}
    add 16 to {_slots::*}
    add 19 to {_slots::*}
    add 20 to {_slots::*}
    add 21 to {_slots::*}
    add 22 to {_slots::*}
    add 23 to {_slots::*}
    add 24 to {_slots::*}
    add 25 to {_slots::*}
    add 28 to {_slots::*}
    add 29 to {_slots::*}
    add 30 to {_slots::*}
    add 31 to {_slots::*}
    add 32 to {_slots::*}
    add 33 to {_slots::*}
    add 34 to {_slots::*}
    add 37 to {_slots::*}
    add 38 to {_slots::*}
    add 39 to {_slots::*}
    add 40 to {_slots::*}
    add 41 to {_slots::*}
    add 42 to {_slots::*}
    add 43 to {_slots::*}
    # 배치
    if {_total} <= 0:
        set slot 22 of {_p}'s current inventory to gray stained glass pane named "&7이 섬에 수집품이 없습니다"
    else:
        delete {_pageItems::*}
        set {_qi} to 0
        loop {_items::*}:
            add 1 to {_qi}
            if {_qi} > {_start}:
                if size of {_pageItems::*} < {_perPage}:
                    add loop-value to {_pageItems::*}
        set {_si} to 0
        set {_num} to {_start}
        loop {_pageItems::*}:
            add 1 to {_si}
            add 1 to {_num}
            set {_sl} to {_slots::%{_si}%}
            set {_cid} to loop-value
            if {수집품발견::%{_p}%::%{_cid}%} is true:
                # 수집품 타입에 맞는 아이템
                set {_typeName} to {수집품::%{_cid}%::타입}
                if {_typeName} is not set:
                    set {_typeName} to "creeper head"
                replace all "_" with " " in {_typeName}
                set {_typeName} to lowercase {_typeName}
                set {_displayItem} to {_typeName} parsed as item type
                if {_displayItem} is not set:
                    set {_displayItem} to creeper head
                set slot {_sl} of {_p}'s current inventory to {_displayItem} named "&a#%{_num}% &f%{_cid}%" with lore "&a발견!"
            else:
                set slot {_sl} of {_p}'s current inventory to coal named "&8#%{_num}% ???" with lore "&7아직 발견하지 못한 수집품"
    # 네비게이션
    set slot 49 of {_p}'s current inventory to paper named "&7페이지 %{_page}%/%{_maxPage}% &8(%{_total}%개)"
    if {_page} > 1:
        set slot 48 of {_p}'s current inventory to arrow named "&e← 이전 페이지"
    if {_page} < {_maxPage}:
        set slot 50 of {_p}'s current inventory to arrow named "&e다음 페이지 →"

on inventory click:
    if player's current inventory's name starts with "&0수집품:":
        cancel event
        if clicked slot is 0:
            wait 1 tick
            도감_수집품GUI(player)
            stop
        if clicked slot is 8:
            close player's inventory
            stop
        if clicked slot is 48:
            if {수집품상세페이지::%player%} > 1:
                remove 1 from {수집품상세페이지::%player%}
                wait 1 tick
                도감_수집품상세GUI(player)
            stop
        if clicked slot is 50:
            add 1 to {수집품상세페이지::%player%}
            wait 1 tick
            도감_수집품상세GUI(player)
            stop

# ===== 한글 명령어 (OP) =====
command /수집품배치 <text> <text>:
    permission: op
    trigger:
        execute console command "collectible place %arg-1% %arg-2%"
        # Java 명령어는 콘솔 전용이므로 플레이어 위치를 직접 전달
        execute player command "collectible place %arg-1% %arg-2%"

command /수집품제거 <text>:
    permission: op
    trigger:
        execute player command "collectible remove %arg-1%"

command /수집품목록 [<text>]:
    permission: op
    trigger:
        if arg-1 is set:
            execute player command "collectible list %arg-1%"
        else:
            execute player command "collectible list"

command /수집품리로드:
    permission: op
    trigger:
        execute player command "collectible reload"

on tab complete of "/수집품배치":
    set tab completions for position 1 to "<ID>"
    set tab completions for position 2 to {수집품섬목록::*}

on tab complete of "/수집품제거":
    set tab completions for position 1 to {수집품목록::*}

on tab complete of "/수집품목록":
    set tab completions for position 1 to {수집품섬목록::*}
