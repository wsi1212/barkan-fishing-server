# =========================================
# 페리.sk
# 지역 간 페리(배) 이동 시스템
# 일정 간격 출발, 요금, 보스바 카운트다운
# 탑승 등록제: NPC 대화를 통한 탑승
# =========================================

options:
    ferry_prefix: &8[&9 페리 &8]

# ===== 탭 자동완성 =====
on tab complete of "/페리설정":
    if {페리노선목록::*} is set:
        set tab completions for position 1 to {페리노선목록::*}
    set tab completions for position 2 to "출발지", "도착지", "배", "간격", "소요시간", "요금", "탑승지역" and "도착지역"
    set tab completions for position 3 to all areas

on tab complete of "/페리시작":
    if {페리노선목록::*} is set:
        set tab completions for position 1 to {페리노선목록::*}

on tab complete of "/페리정지":
    if {페리노선목록::*} is set:
        set tab completions for position 1 to {페리노선목록::*}

on tab complete of "/페리삭제":
    if {페리노선목록::*} is set:
        set tab completions for position 1 to {페리노선목록::*}

# ===== 탑승 등록 함수 =====
function ferryRegister(p: player, route: text):
    # 이미 등록했는지 확인
    if {페리대기::%{_route}%::*} contains {_p}:
        message "{@ferry_prefix} &c이미 %{_route}% 노선에 탑승 등록되어 있습니다." to {_p}
        stop
    # 노선이 운행 중인지 확인
    if {페리상태::%{_route}%} is not set:
        message "{@ferry_prefix} &c해당 노선이 운행 중이 아닙니다." to {_p}
        stop
    if {페리상태::%{_route}%} is "이동중":
        message "{@ferry_prefix} &c페리가 이미 출발했습니다. 다음 편을 이용해주세요." to {_p}
        stop
    # 탑승 지역 확인
    set {_area} to {페리노선::%{_route}%::탑승지역}
    if {area::%{_p}%} is not {_area}:
        message "{@ferry_prefix} &c탑승 지역에 있어야 등록할 수 있습니다." to {_p}
        stop
    # 방문한 지역인지 확인
    set {_destArea} to {페리노선::%{_route}%::도착지역}
    if {_destArea} is set:
        if {방문지역::%{_p}%::*} does not contain {_destArea}:
            message "{@ferry_prefix} &c아직 방문하지 않은 지역입니다. 직접 방문한 적이 있는 지역만 이용 가능합니다." to {_p}
            stop
    # 목적지 레벨 제한 확인
    if {_destArea} is set:
        set {_destReq} to regionRequiredLevel({_destArea})
        if {_destReq} > 0:
            if {낚시레벨::%{_p}%} is not set:
                set {낚시레벨::%{_p}%} to 1
            if {낚시레벨::%{_p}%} < {_destReq}:
                set {_destDisplay} to regionDisplayName({_destArea})
                message "{@ferry_prefix} &c목적지 &e%{_destDisplay}%&c은(는) 낚시 레벨 &e%{_destReq}% &c이상만 입장할 수 있습니다. &7(현재: Lv.%{낚시레벨::%{_p}%}%)" to {_p}
                stop
    # 요금 확인
    set {_fare} to {페리노선::%{_route}%::요금}
    if {돈::%{_p}%} is not set:
        set {돈::%{_p}%} to 0
    if {돈::%{_p}%} < {_fare}:
        message "{@ferry_prefix} &c잔액이 부족합니다. &7(필요: %{_fare}%원, 잔액: %{돈::%{_p}%}%원)" to {_p}
        stop
    # 등록 완료
    add {_p} to {페리대기::%{_route}%::*}
    set {_left} to {페리남은초::%{_route}%}
    set {_min} to floor({_left} / 60)
    set {_sec} to mod({_left}, 60)
    if {_sec} < 10:
        set {_timeStr} to "%{_min}%:0%{_sec}%"
    else:
        set {_timeStr} to "%{_min}%:%{_sec}%"
    message "{@ferry_prefix} &a%{_route}% 노선에 탑승 등록했습니다! &7(요금: %{_fare}%원, 출발: %{_timeStr}% 후)" to {_p}
    message "{@ferry_prefix} &7취소하려면 &f/페리취소 &7를 입력하세요." to {_p}
    # 대기 보스바 세팅 + 추가
    set {_total} to {페리총초::%{_route}%}
    set {_prog} to ({_left} / {_total}) * 100
    set {_waitBar} to bossbar named "ferry_wait_%{_route}%" with title "&e%{_route}% &f- 출발까지 &e%{_timeStr}%" with color green with style segmented 20 with progress {_prog}
    add {_p} to bossbar players of {_waitBar}

# ===== 페리 탑승 GUI (NPC 대화 연동) =====
function 페리탑승GUI(p: player):
    set {_myArea} to {area::%{_p}%}
    delete {페리GUI슬롯::%{_p}%::*}
    delete {페리GUI취소::%{_p}%::*}
    # 이미 등록된 노선 확인
    set {_registered} to ""
    if {페리노선목록::*} is set:
        loop {페리노선목록::*}:
            if {페리대기::%loop-value%::*} contains {_p}:
                set {_registered} to loop-value
    # 현재 지역의 운행 중인 노선 수집
    delete {_routes::*}
    set {_count} to 0
    if {페리노선목록::*} is set:
        loop {페리노선목록::*}:
            if {페리상태::%loop-value%} is set:
                if {페리노선::%loop-value%::탑승지역} is {_myArea}:
                    add 1 to {_count}
                    add loop-value to {_routes::*}
    if {_count} is 0:
        if {_registered} is not "":
            # 등록된 노선은 있지만 현재 지역에 노선 없음 → 취소만 표시
            open chest inventory with 3 rows named "&0⛵ 페리" to {_p}
            loop integers from 0 to 26:
                set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
            set slot 4 of {_p}'s current inventory to book named "&9&l⛵ 페리 이용 안내" with lore "&7페리는 지역 간 이동 수단입니다." and "&7일정 간격으로 출발하며 요금을 내고 탑승합니다." and "&7" and "&e한번 방문한 지역만 이용 가능합니다."
            set slot 22 of {_p}'s current inventory to barrier named "&c&l탑승 취소" with lore "&7%{_registered}% 노선 탑승을 취소합니다." and "&7" and "&e클릭하여 취소"
            set {페리GUI슬롯::%{_p}%::22} to {_registered}
            set {페리GUI취소::%{_p}%::22} to true
            stop
        message "{@ferry_prefix} &c현재 위치에 운행 중인 페리 노선이 없습니다." to {_p}
        stop
    # GUI 열기 (3줄)
    open chest inventory with 3 rows named "&0⛵ 페리" to {_p}
    loop integers from 0 to 26:
        set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
    # Row 1: 안내 아이템
    set slot 4 of {_p}'s current inventory to book named "&9&l⛵ 페리 이용 안내" with lore "&7페리는 지역 간 이동 수단입니다." and "&7일정 간격으로 출발하며 요금을 내고 탑승합니다." and "&7" and "&e한번 방문한 지역만 이용 가능합니다." and "&7취소: NPC에게 다시 말 걸기 또는 &f/페리취소"
    # Row 2: 노선 목록 (슬롯 9~17, 가운데 정렬)
    set {_start} to 9 + floor((9 - {_count}) / 2)
    set {_i} to 0
    loop {_routes::*}:
        set {_r} to loop-value
        set {_slot} to {_start} + {_i}
        set {_to} to {페리노선::%{_r}%::도착지역}
        if {_to} is not set:
            set {_to} to "?"
        set {_toDisplay} to regionDisplayName({_to})
        set {_fare} to {페리노선::%{_r}%::요금}
        delete {_lore::*}
        add "&7목적지 &e: &f%{_toDisplay}%" to {_lore::*}
        add "&7요금 &e: &f%{_fare}%원" to {_lore::*}
        # 방문 여부 확인
        set {_visited} to false
        if {_to} is "?":
            set {_visited} to true
        else if {방문지역::%{_p}%::*} contains {_to}:
            set {_visited} to true
        if {_registered} is {_r}:
            # 탑승 등록된 노선 → 취소 버튼
            add "&7상태 &e: &a탑승 등록됨" to {_lore::*}
            if {페리상태::%{_r}%} is "대기":
                set {_left} to {페리남은초::%{_r}%}
                set {_min} to floor({_left} / 60)
                set {_sec} to mod({_left}, 60)
                if {_sec} < 10:
                    set {_timeStr} to "%{_min}%:0%{_sec}%"
                else:
                    set {_timeStr} to "%{_min}%:%{_sec}%"
                add "&7출발 &e: &a%{_timeStr}% 후" to {_lore::*}
            add "" to {_lore::*}
            add "&c클릭하여 탑승 취소" to {_lore::*}
            set slot {_slot} of {_p}'s current inventory to barrier named "&c%{_r}%" with lore {_lore::*}
            set {페리GUI슬롯::%{_p}%::%{_slot}%} to {_r}
            set {페리GUI취소::%{_p}%::%{_slot}%} to true
        else if {_visited} is false:
            # 방문하지 않은 지역 → 잠김 표시
            add "" to {_lore::*}
            add "&c아직 방문하지 않은 지역입니다." to {_lore::*}
            add "&7직접 방문한 적이 있는 지역만 이용 가능합니다." to {_lore::*}
            set slot {_slot} of {_p}'s current inventory to coal block named "&8%{_r}%" with lore {_lore::*}
        else if {페리상태::%{_r}%} is "대기":
            # 탑승 가능한 노선
            set {_left} to {페리남은초::%{_r}%}
            set {_min} to floor({_left} / 60)
            set {_sec} to mod({_left}, 60)
            if {_sec} < 10:
                set {_timeStr} to "%{_min}%:0%{_sec}%"
            else:
                set {_timeStr} to "%{_min}%:%{_sec}%"
            add "&7출발 &e: &a%{_timeStr}% 후" to {_lore::*}
            add "" to {_lore::*}
            if {_registered} is not "":
                add "&7이미 다른 노선에 등록되어 있습니다" to {_lore::*}
                set slot {_slot} of {_p}'s current inventory to compass named "&7%{_r}%" with lore {_lore::*}
            else:
                add "&a클릭하여 탑승 등록" to {_lore::*}
                set slot {_slot} of {_p}'s current inventory to compass named "&e%{_r}%" with lore {_lore::*}
                set {페리GUI슬롯::%{_p}%::%{_slot}%} to {_r}
        else:
            # 이동중인 노선
            add "&7상태 &e: &b이동중" to {_lore::*}
            add "" to {_lore::*}
            add "&7다음 편을 기다려주세요" to {_lore::*}
            set slot {_slot} of {_p}'s current inventory to compass named "&7%{_r}%" with lore {_lore::*}
        add 1 to {_i}
    # Row 3: 탑승 취소 버튼 (등록된 경우만)
    if {_registered} is not "":
        set slot 22 of {_p}'s current inventory to barrier named "&c&l탑승 취소" with lore "&7%{_registered}% 노선 탑승을 취소합니다." and "&7" and "&e클릭하여 취소"
        set {페리GUI슬롯::%{_p}%::22} to {_registered}
        set {페리GUI취소::%{_p}%::22} to true

on inventory click:
    if player's current inventory's name is "&0⛵ 페리":
        cancel event
        set {_ci} to index of clicked slot
        set {_route} to {페리GUI슬롯::%player%::%{_ci}%}
        if {_route} is not set:
            stop
        close player's inventory
        wait 1 tick
        if {페리GUI취소::%player%::%{_ci}%} is true:
            # 탑승 취소
            if {페리대기::%{_route}%::*} contains player:
                remove player from {페리대기::%{_route}%::*}
                remove player from bossbar players of (bossbar named "ferry_wait_%{_route}%")
                message "{@ferry_prefix} &e%{_route}% 노선 탑승을 취소했습니다." to player
            else:
                message "{@ferry_prefix} &c이미 취소되었거나 등록되지 않은 상태입니다." to player
        else:
            # 탑승 등록
            ferryRegister(player, {_route})

on inventory close:
    if player's current inventory's name is "&0⛵ 페리":
        delete {페리GUI슬롯::%player%::*}
        delete {페리GUI취소::%player%::*}

# ===== 플레이어 명령어: 페리 안내 =====
command /페리:
    aliases: /vpdl
    trigger:
        message "" to player
        message "&9&l  ⛵ 페리 이용 안내" to player
        message "" to player
        message "&7  페리는 지역 간 이동 수단입니다." to player
        message "&7  일정 간격으로 출발하며, 요금을 내고 탑승합니다." to player
        message "" to player
        message "&e&l  탑승 방법" to player
        message "&f  페리 NPC에게 말 걸기 &7- 노선 확인 및 탑승 등록" to player
        message "&f  /페리취소 &7- 탑승 등록 취소" to player
        message "" to player
        # 현재 지역에서 탈 수 있는 노선 표시
        set {_myArea} to {area::%player%}
        set {_count} to 0
        if {페리노선목록::*} is set:
            loop {페리노선목록::*}:
                if {페리상태::%loop-value%} is set:
                    if {페리노선::%loop-value%::탑승지역} is {_myArea}:
                        add 1 to {_count}
        if {_count} > 0:
            message "&e&l  이 지역에서 탑승 가능한 노선" to player
            loop {페리노선목록::*}:
                set {_r} to loop-value
                if {페리상태::%{_r}%} is set:
                    if {페리노선::%{_r}%::탑승지역} is {_myArea}:
                        set {_fare} to {페리노선::%{_r}%::요금}
                        set {_to} to {페리노선::%{_r}%::도착지역}
                        if {_to} is not set:
                            set {_to} to "?"
                        if {페리상태::%{_r}%} is "대기":
                            set {_left} to {페리남은초::%{_r}%}
                            set {_min} to floor({_left} / 60)
                            set {_sec} to mod({_left}, 60)
                            if {_sec} < 10:
                                set {_timeStr} to "%{_min}%:0%{_sec}%"
                            else:
                                set {_timeStr} to "%{_min}%:%{_sec}%"
                            message "&f  %{_r}% &8→ &7%{_to}% &8| &7요금 %{_fare}%원 &8| &a출발 %{_timeStr}% 후" to player
                        else:
                            message "&f  %{_r}% &8→ &7%{_to}% &8| &7요금 %{_fare}%원 &8| &b이동중" to player
        else:
            message "&7  현재 위치에서 탑승 가능한 페리가 없습니다." to player
        message "" to player

# ===== 플레이어 명령어: 탑승 등록 =====
on tab complete of "/페리탑승":
    # 현재 지역의 노선만 자동완성
    set {_list::*} to ""
    delete {_list::*}
    loop {페리노선목록::*}:
        if {페리상태::%loop-value%} is set:
            if {페리노선::%loop-value%::탑승지역} is {area::%player%}:
                add loop-value to {_list::*}
    if {_list::*} is set:
        set tab completions for position 1 to {_list::*}

command /페리탑승 [<text>]:
    permission: op
    trigger:
        if arg-1 is set:
            # 노선명 직접 지정
            ferryRegister(player, arg-1)
            stop
        # 노선명 미지정: 현재 지역에서 자동 탐색
        set {_count} to 0
        loop {페리노선목록::*}:
            set {_r} to loop-value
            if {페리상태::%{_r}%} is set:
                set {_area} to {페리노선::%{_r}%::탑승지역}
                if {area::%player%} is {_area}:
                    add 1 to {_count}
                    set {_last} to {_r}
        if {_count} is 0:
            message "{@ferry_prefix} &c현재 위치에 운행 중인 페리 노선이 없습니다." to player
        else if {_count} is 1:
            # 노선이 1개면 자동 등록
            ferryRegister(player, {_last})
        else:
            # 여러 노선이면 목록 표시
            message "{@ferry_prefix} &e이 지역에 여러 노선이 있습니다. 선택해주세요:" to player
            loop {페리노선목록::*}:
                set {_r} to loop-value
                if {페리상태::%{_r}%} is set:
                    if {페리노선::%{_r}%::탑승지역} is {area::%player%}:
                        set {_left} to {페리남은초::%{_r}%}
                        set {_min} to floor({_left} / 60)
                        set {_sec} to mod({_left}, 60)
                        if {_sec} < 10:
                            set {_timeStr} to "%{_min}%:0%{_sec}%"
                        else:
                            set {_timeStr} to "%{_min}%:%{_sec}%"
                        message "  &f/페리탑승 %{_r}% &8| &7요금: %{페리노선::%{_r}%::요금}%원 &8| &7출발: %{_timeStr}% 후" to player

# ===== 플레이어 명령어: 탑승 취소 =====
command /페리취소:
    trigger:
        set {_found} to false
        loop {페리노선목록::*}:
            set {_r} to loop-value
            if {페리대기::%{_r}%::*} contains player:
                remove player from {페리대기::%{_r}%::*}
                remove player from bossbar players of (bossbar named "ferry_wait_%{_r}%")
                message "{@ferry_prefix} &e%{_r}% 노선 탑승을 취소했습니다." to player
                set {_found} to true
                stop
        if {_found} is false:
            message "{@ferry_prefix} &c등록된 탑승이 없습니다." to player

# (표지판 탑승 제거됨 - NPC 대화로 탑승)

# ===== 관리 명령어: 노선 설정 =====
command /페리설정 [<text>] [<text>] [<text>]:
    permission: op
    trigger:
        if arg-1 is not set:
            message "{@ferry_prefix} &e사용법:"
            message "&7/페리설정 <노선명> 출발지 &f- 현재 위치를 출발 부두로"
            message "&7/페리설정 <노선명> 도착지 &f- 현재 위치를 도착 부두로"
            message "&7/페리설정 <노선명> 배 &f- 현재 위치를 배 텔포 지점으로"
            message "&7/페리설정 <노선명> 간격 <분> &f- 출발 간격"
            message "&7/페리설정 <노선명> 소요시간 <초> &f- 이동 시간"
            message "&7/페리설정 <노선명> 요금 <원> &f- 탑승 요금"
            message "&7/페리설정 <노선명> 탑승지역 <지역명> &f- 대기 지역"
            message "&7/페리설정 <노선명> 도착지역 <지역명> &f- 도착 지역 (레벨 제한용)"
            stop
        if arg-2 is not set:
            message "{@ferry_prefix} &c두 번째 인자가 필요합니다." to player
            stop
        set {_route} to arg-1
        set {_option} to arg-2
        # 노선 목록에 자동 추가
        if {페리노선목록::*} does not contain {_route}:
            add {_route} to {페리노선목록::*}
        if {_option} is "출발지":
            set {페리노선::%{_route}%::출발지} to player's location
            message "{@ferry_prefix} &a%{_route}% 노선의 출발지가 설정되었습니다." to player
        else if {_option} is "도착지":
            set {페리노선::%{_route}%::도착지} to player's location
            message "{@ferry_prefix} &a%{_route}% 노선의 도착지가 설정되었습니다." to player
        else if {_option} is "배":
            set {페리노선::%{_route}%::배} to player's location
            message "{@ferry_prefix} &a%{_route}% 노선의 배 위치가 설정되었습니다." to player
        else if {_option} is "간격":
            if arg-3 is not set:
                message "{@ferry_prefix} &c분 단위 숫자를 입력하세요." to player
                stop
            set {_val} to arg-3 parsed as number
            if {_val} is not set:
                message "{@ferry_prefix} &c숫자가 아닙니다." to player
                stop
            set {페리노선::%{_route}%::간격} to {_val}
            message "{@ferry_prefix} &a%{_route}% 노선의 출발 간격이 %{_val}%분으로 설정되었습니다." to player
        else if {_option} is "소요시간":
            if arg-3 is not set:
                message "{@ferry_prefix} &c초 단위 숫자를 입력하세요." to player
                stop
            set {_val} to arg-3 parsed as number
            if {_val} is not set:
                message "{@ferry_prefix} &c숫자가 아닙니다." to player
                stop
            set {페리노선::%{_route}%::소요시간} to {_val}
            message "{@ferry_prefix} &a%{_route}% 노선의 소요시간이 %{_val}%초로 설정되었습니다." to player
        else if {_option} is "요금":
            if arg-3 is not set:
                message "{@ferry_prefix} &c요금 숫자를 입력하세요." to player
                stop
            set {_val} to arg-3 parsed as number
            if {_val} is not set:
                message "{@ferry_prefix} &c숫자가 아닙니다." to player
                stop
            set {페리노선::%{_route}%::요금} to {_val}
            message "{@ferry_prefix} &a%{_route}% 노선의 요금이 %{_val}%원으로 설정되었습니다." to player
        else if {_option} is "탑승지역":
            if arg-3 is not set:
                message "{@ferry_prefix} &cMarSkRebirth 지역명을 입력하세요." to player
                stop
            set {페리노선::%{_route}%::탑승지역} to arg-3
            message "{@ferry_prefix} &a%{_route}% 노선의 탑승 지역이 '%arg-3%'(으)로 설정되었습니다." to player
        else if {_option} is "도착지역":
            if arg-3 is not set:
                message "{@ferry_prefix} &cMarSkRebirth 지역명을 입력하세요." to player
                stop
            set {페리노선::%{_route}%::도착지역} to arg-3
            set {_req} to regionRequiredLevel(arg-3)
            if {_req} > 0:
                message "{@ferry_prefix} &a%{_route}% 노선의 도착 지역이 '%arg-3%'(으)로 설정되었습니다. &7(레벨 제한: Lv.%{_req}%)" to player
            else:
                message "{@ferry_prefix} &a%{_route}% 노선의 도착 지역이 '%arg-3%'(으)로 설정되었습니다. &7(레벨 제한 없음)" to player
        else:
            message "{@ferry_prefix} &c알 수 없는 옵션: %{_option}%" to player

# ===== 운행 시작/정지/목록 =====
command /페리시작 [<text>]:
    permission: op
    trigger:
        if arg-1 is not set:
            message "{@ferry_prefix} &c사용법: /페리시작 <노선명>" to player
            stop
        set {_r} to arg-1
        # 필수 설정 확인
        if {페리노선::%{_r}%::출발지} is not set:
            message "{@ferry_prefix} &c출발지가 설정되지 않았습니다." to player
            stop
        if {페리노선::%{_r}%::도착지} is not set:
            message "{@ferry_prefix} &c도착지가 설정되지 않았습니다." to player
            stop
        if {페리노선::%{_r}%::배} is not set:
            message "{@ferry_prefix} &c배 위치가 설정되지 않았습니다." to player
            stop
        if {페리노선::%{_r}%::간격} is not set:
            message "{@ferry_prefix} &c출발 간격이 설정되지 않았습니다." to player
            stop
        if {페리노선::%{_r}%::소요시간} is not set:
            message "{@ferry_prefix} &c소요시간이 설정되지 않았습니다." to player
            stop
        if {페리노선::%{_r}%::요금} is not set:
            message "{@ferry_prefix} &c요금이 설정되지 않았습니다." to player
            stop
        if {페리노선::%{_r}%::탑승지역} is not set:
            message "{@ferry_prefix} &c탑승 지역이 설정되지 않았습니다." to player
            stop
        # 운행 시작
        set {페리상태::%{_r}%} to "대기"
        set {페리남은초::%{_r}%} to {페리노선::%{_r}%::간격} * 60
        set {페리총초::%{_r}%} to {페리노선::%{_r}%::간격} * 60
        delete {페리대기::%{_r}%::*}
        # 노선 목록에 추가
        if {페리노선목록::*} does not contain {_r}:
            add {_r} to {페리노선목록::*}
        message "{@ferry_prefix} &a%{_r}% 노선 운행을 시작합니다. &7(%{페리남은초::%{_r}%}%초 후 첫 출발)" to player

command /페리정지 [<text>]:
    permission: op
    trigger:
        if arg-1 is not set:
            message "{@ferry_prefix} &c사용법: /페리정지 <노선명>" to player
            stop
        set {_r} to arg-1
        if {페리상태::%{_r}%} is not set:
            message "{@ferry_prefix} &c해당 노선이 운행 중이 아닙니다." to player
            stop
        # 이동중이면 탑승자 도착지로 보내기
        if {페리상태::%{_r}%} is "이동중":
            loop {페리탑승자::%{_r}%::*}:
                teleport loop-value to {페리노선::%{_r}%::도착지}
                message "{@ferry_prefix} &e운행이 중단되어 도착지로 이동되었습니다." to loop-value
            delete bossbar named "ferry_%{_r}%"
            delete {페리탑승자::%{_r}%::*}
        delete {페리상태::%{_r}%}
        delete {페리남은초::%{_r}%}
        delete {페리총초::%{_r}%}
        delete {페리대기::%{_r}%::*}
        delete bossbar named "ferry_wait_%{_r}%"
        message "{@ferry_prefix} &c%{_r}% 노선 운행을 정지했습니다." to player

command /페리목록:
    permission: op
    trigger:
        if {페리노선목록::*} is not set:
            message "{@ferry_prefix} &7등록된 노선이 없습니다." to player
            stop
        message "{@ferry_prefix} &e===== 페리 노선 목록 =====" to player
        loop {페리노선목록::*}:
            set {_r} to loop-value
            set {_status} to {페리상태::%{_r}%}
            if {_status} is not set:
                set {_status} to "&7정지"
            else if {_status} is "대기":
                set {_status} to "&a대기 &7(%{페리남은초::%{_r}%}%초)"
            else if {_status} is "이동중":
                set {_status} to "&b이동중 &7(%{페리남은초::%{_r}%}%초)"
            set {_destInfo} to ""
            if {페리노선::%{_r}%::도착지역} is set:
                set {_dReq} to regionRequiredLevel({페리노선::%{_r}%::도착지역})
                if {_dReq} > 0:
                    set {_destInfo} to " &8| &7도착: %{페리노선::%{_r}%::도착지역}% (Lv.%{_dReq}%)"
                else:
                    set {_destInfo} to " &8| &7도착: %{페리노선::%{_r}%::도착지역}%"
            message "&f%{_r}% &8| %{_status}% &8| &7요금: %{페리노선::%{_r}%::요금}%원%{_destInfo}%" to player

command /페리삭제 [<text>]:
    permission: op
    trigger:
        if arg-1 is not set:
            message "{@ferry_prefix} &c사용법: /페리삭제 <노선명>" to player
            stop
        set {_r} to arg-1
        if {페리노선목록::*} does not contain {_r}:
            message "{@ferry_prefix} &c존재하지 않는 노선입니다." to player
            stop
        # 운행 중이면 먼저 정지
        if {페리상태::%{_r}%} is set:
            if {페리상태::%{_r}%} is "이동중":
                loop {페리탑승자::%{_r}%::*}:
                    teleport loop-value to {페리노선::%{_r}%::도착지}
                    message "{@ferry_prefix} &e노선이 삭제되어 도착지로 이동되었습니다." to loop-value
                delete bossbar named "ferry_%{_r}%"
                delete {페리탑승자::%{_r}%::*}
            delete {페리상태::%{_r}%}
            delete {페리남은초::%{_r}%}
            delete {페리총초::%{_r}%}
        delete {페리대기::%{_r}%::*}
        # 노선 데이터 삭제
        delete {페리노선::%{_r}%::출발지}
        delete {페리노선::%{_r}%::도착지}
        delete {페리노선::%{_r}%::배}
        delete {페리노선::%{_r}%::간격}
        delete {페리노선::%{_r}%::소요시간}
        delete {페리노선::%{_r}%::요금}
        delete {페리노선::%{_r}%::탑승지역}
        delete {페리노선::%{_r}%::도착지역}
        # 목록에서 제거
        remove {_r} from {페리노선목록::*}
        message "{@ferry_prefix} &c%{_r}% 노선이 완전히 삭제되었습니다." to player

# ===== 페리 메인 루프 =====
every 1 second:
    if {페리노선목록::*} is set:
        loop {페리노선목록::*}:
            set {_r} to loop-value
            if {페리상태::%{_r}%} is set:
                ferryTick({_r})

function ferryTick(route: text):
    if {페리상태::%{_route}%} is "대기":
        subtract 1 from {페리남은초::%{_route}%}
        set {_left} to {페리남은초::%{_route}%}
        set {_total} to {페리총초::%{_route}%}
        set {_area} to {페리노선::%{_route}%::탑승지역}
        # 대기 보스바 업데이트 (등록자 있을 때만)
        if {페리대기::%{_route}%::*} is set:
            set {_min} to floor({_left} / 60)
            set {_sec} to mod({_left}, 60)
            if {_sec} < 10:
                set {_waitTime} to "%{_min}%:0%{_sec}%"
            else:
                set {_waitTime} to "%{_min}%:%{_sec}%"
            set {_prog} to ({_left} / {_total}) * 100
            set {_waitBar} to bossbar named "ferry_wait_%{_route}%" with title "&e%{_route}% &f- 출발까지 &e%{_waitTime}%" with color green with style segmented 20 with progress {_prog}
            set bossbar title of {_waitBar} to "&e%{_route}% &f- 출발까지 &e%{_waitTime}%"
            set bossbar progress of {_waitBar} to {_prog}
        # 알림
        if {_left} is 60:
            loop all players:
                if {area::%loop-player%} is {_area}:
                    message "{@ferry_prefix} &e%{_route}% 페리가 &f1분 &e후 출발합니다!" to loop-player
                    message "{@ferry_prefix} &7탑승하려면 &f페리 NPC&7에게 말을 걸어주세요!" to loop-player
        else if {_left} is 30:
            loop all players:
                if {area::%loop-player%} is {_area}:
                    message "{@ferry_prefix} &e%{_route}% 페리 출발 &f30초 &e전!" to loop-player
        else if {_left} is 10:
            loop all players:
                if {area::%loop-player%} is {_area}:
                    message "{@ferry_prefix} &c%{_route}% 페리 출발 &f10초 &c전!" to loop-player
        else if {_left} is 5:
            loop all players:
                if {area::%loop-player%} is {_area}:
                    message "{@ferry_prefix} &c출발 &f5초 &c전!" to loop-player
        # 출발
        if {_left} <= 0:
            ferryDepart({_route})
    else if {페리상태::%{_route}%} is "이동중":
        subtract 1 from {페리남은초::%{_route}%}
        set {_left} to {페리남은초::%{_route}%}
        set {_total} to {페리총초::%{_route}%}
        # 보스바 업데이트
        set {_prog} to ({_left} / {_total}) * 100
        set bossbar progress of (bossbar named "ferry_%{_route}%") to {_prog}
        # 분:초 표시
        set {_min} to floor({_left} / 60)
        set {_sec} to mod({_left}, 60)
        if {_sec} < 10:
            set {_timeStr} to "%{_min}%:0%{_sec}%"
        else:
            set {_timeStr} to "%{_min}%:%{_sec}%"
        set bossbar title of (bossbar named "ferry_%{_route}%") to "&b%{_route}% &f- 도착까지 &e%{_timeStr}%"
        # 도착
        if {_left} <= 0:
            ferryArrive({_route})

# ===== 출발 처리 (등록된 플레이어만 탑승) =====
function ferryDepart(route: text):
    set {_area} to {페리노선::%{_route}%::탑승지역}
    set {_fare} to {페리노선::%{_route}%::요금}
    set {_boatLoc} to {페리노선::%{_route}%::배}
    set {_count} to 0
    delete {페리탑승자::%{_route}%::*}
    # 대기 보스바 제거
    delete bossbar named "ferry_wait_%{_route}%"
    # 등록된 플레이어만 탑승
    loop {페리대기::%{_route}%::*}:
        set {_p} to loop-value
        # 아직 탑승 지역에 있는지 확인
        if {area::%{_p}%} is {_area}:
            # 요금 차감
            if {돈::%{_p}%} is not set:
                set {돈::%{_p}%} to 0
            if {돈::%{_p}%} < {_fare}:
                message "{@ferry_prefix} &c잔액이 부족하여 탑승할 수 없습니다. &7(필요: %{_fare}%원, 잔액: %{돈::%{_p}%}%원)" to {_p}
            else:
                subtract {_fare} from {돈::%{_p}%}
                add {_p} to {페리탑승자::%{_route}%::*}
                teleport {_p} to {_boatLoc}
                message "{@ferry_prefix} &a%{_route}% 페리에 탑승했습니다! &7(-%{_fare}%원)" to {_p}
                add 1 to {_count}
        else:
            message "{@ferry_prefix} &c탑승 지역을 벗어나 탑승이 취소되었습니다." to {_p}
    # 대기 목록 초기화
    delete {페리대기::%{_route}%::*}
    # 탑승자가 없으면 바로 대기로 복귀
    if {_count} is 0:
        set {페리상태::%{_route}%} to "대기"
        set {페리남은초::%{_route}%} to {페리노선::%{_route}%::간격} * 60
        set {페리총초::%{_route}%} to {페리노선::%{_route}%::간격} * 60
        stop
    # 이동 상태 전환
    set {페리상태::%{_route}%} to "이동중"
    set {페리남은초::%{_route}%} to {페리노선::%{_route}%::소요시간}
    set {페리총초::%{_route}%} to {페리노선::%{_route}%::소요시간}
    # 보스바 생성
    delete bossbar named "ferry_%{_route}%"
    set {_bar} to bossbar named "ferry_%{_route}%" with title "&b%{_route}% &f- 출발!" with color blue with style segmented 20 with progress 100
    set bossbar players of {_bar} to {페리탑승자::%{_route}%::*}

# ===== 도착 처리 =====
function ferryArrive(route: text):
    set {_dest} to {페리노선::%{_route}%::도착지}
    loop {페리탑승자::%{_route}%::*}:
        teleport loop-value to {_dest}
        message "{@ferry_prefix} &a목적지에 도착했습니다!" to loop-value
    # 정리
    delete bossbar named "ferry_%{_route}%"
    delete {페리탑승자::%{_route}%::*}
    # 대기 상태 복귀
    set {페리상태::%{_route}%} to "대기"
    set {페리남은초::%{_route}%} to {페리노선::%{_route}%::간격} * 60
    set {페리총초::%{_route}%} to {페리노선::%{_route}%::간격} * 60
