{
  "enabledPlugins": {
    "google-analytics@local-desktop-app-uploads": false,
    "bizben-dynamodb@local-desktop-app-uploads": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-sk.sh\"",
            "timeout": 10,
            "statusMessage": ".sk 컨벤션 검증 중..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/balance-check.sh\"",
            "timeout": 15,
            "statusMessage": "밸런스 영향 분석 중...",
            "description": "밸런스 관련 변경 감지: 스탯 소비처/공급처 크로스체크"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/regen-docs-index.sh\"",
            "timeout": 10,
            "statusMessage": "docs-index 갱신 중...",
            "description": "프로젝트 최상위 .md 편집 시 docs-index.md 자동 재생성"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ops/hooks/guard-security.py\"",
            "statusMessage": "경제/동시성/별칭/OP권한 검사",
            "description": "유저 설정에도 같은 훅이 있다(맥에서 blockship-plugin 레포까지 커버). 여기 등록은 클라우드 세션용 — 겹치는 구간은 스크립트의 already_ran() 이 5초 TTL 마커로 한 번만 말하게 한다."
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ops/audit-dialogue.py\" --hook",
            "timeout": 20,
            "statusMessage": "NPC·대사 정합성 검사 중...",
            "description": "npc.json/dialogue.json/quests.json 을 건드린 호출에서만 동작. 오타 action·없는 노드 참조·영구 진행불가·이름 중복·내부 id 노출·볼드를 ERROR로 차단(exit 2). 컷씬이 8/6~8/20 조용히 죽어 있던 사고 재발 방지."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ops/hooks/guard-instance-data.py\"",
            "statusMessage": "인스턴스 데이터 서버간 복사 차단 검사",
            "description": "dev/prod 는 유저 데이터가 별개인 서버다. regions/islands/guilds/playerdata 등 인스턴스 전용 상태를 상대 서버의 plugins/ 트리에 쓰는 걸 차단(exit 2). 사고 3건(08-23·08-25·08-26 섬 소실) 재발 방지. 탈출구 ALLOW_INSTANCE_DATA_WRITE=1."
          }
        ]
      }
    ]
  }
}
