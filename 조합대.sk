# =========================================
# 조합대.sk — 하이픽셀 스타일 제작대
# 3x3 그리드 UI + 카테고리 + 대량 레시피
# =========================================

options:
    prefix: &8[&6 조합대 &8]
    gui_name: &0조합대

# ===== 재료 보유수 (바닐라 아이템 타입) =====
function 아이템재료보유수(p: player, typeName: text) :: number:
    set {_type} to {_typeName} parsed as item type
    if {_type} is not set:
        return 0
    set {_count} to 0
    loop items in {_p}'s inventory:
        if loop-item is {_type}:
            set {_l} to "%lore of loop-item%"
            if {_l} does not contain "mat:":
                add amount of loop-item to {_count}
    return {_count}

# ===== 재료 보유수 (커스텀 mat 태그) =====
function 커스텀재료보유수(p: player, matId: text) :: number:
    set {_count} to 0
    loop items in {_p}'s inventory:
        if loop-item is not air:
            set {_l} to "%lore of loop-item%"
            if {_l} contains "mat:%{_matId}%":
                add amount of loop-item to {_count}
    return {_count}

# ===== 바닐라 아이템 제거 =====
function 아이템재료제거(p: player, typeName: text, amount: number):
    set {_type} to {_typeName} parsed as item type
    if {_type} is not set:
        stop
    set {_left} to {_amount}
    loop items in {_p}'s inventory:
        if {_left} <= 0:
            stop
        if loop-item is {_type}:
            set {_l} to "%lore of loop-item%"
            if {_l} does not contain "mat:":
                set {_stack} to amount of loop-item
                if {_stack} <= {_left}:
                    subtract {_stack} from {_left}
                    remove loop-item from {_p}'s inventory
                else:
                    remove {_left} of loop-item from {_p}'s inventory
                    set {_left} to 0

# ===== 커스텀 재료 제거 =====
function 커스텀재료제거(p: player, matId: text, amount: number):
    set {_left} to {_amount}
    loop items in {_p}'s inventory:
        if {_left} <= 0:
            stop
        if loop-item is not air:
            set {_l} to "%lore of loop-item%"
            if {_l} contains "mat:%{_matId}%":
                set {_stack} to amount of loop-item
                if {_stack} <= {_left}:
                    subtract {_stack} from {_left}
                    remove loop-item from {_p}'s inventory
                else:
                    remove {_left} of loop-item from {_p}'s inventory
                    set {_left} to 0

# ===== 조합 가능 여부 =====
function 조합가능여부2(p: player, craftId: text) :: boolean:
    set {_cnt} to {조합법::%{_craftId}%::재료수}
    if {_cnt} is not set:
        return false
    loop integers from 1 to {_cnt}:
        set {_t} to {조합법::%{_craftId}%::재료::%loop-integer%::타입}
        set {_mid} to {조합법::%{_craftId}%::재료::%loop-integer%::ID}
        set {_need} to {조합법::%{_craftId}%::재료::%loop-integer%::수량}
        if {_t} is "item":
            set {_have} to 아이템재료보유수({_p}, {_mid})
        else:
            set {_have} to 커스텀재료보유수({_p}, {_mid})
        if {_have} < {_need}:
            return false
    return true

