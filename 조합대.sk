# 낚싯대 레시피 정의 헬퍼 (가변 인자 대신 텍스트 시리즈로)
function 낚싯대레시피정의(id: text, rodName: text, matCount: integer, t1: text, id1: text, n1: text, mc1: text, q1: integer, t2: text = "", id2: text = "", n2: text = "", mc2: text = "", q2: integer = 0, t3: text = "", id3: text = "", n3: text = "", mc3: text = "", q3: integer = 0):
    add {_id} to {조합카테::낚시::*}
    set {조합법::%{_id}%::이름} to {_rodName}
    set {조합법::%{_id}%::카테고리} to "낚시"
    set {조합법::%{_id}%::재료수} to {_matCount}
    set {조합법::%{_id}%::락잠금} to true
    set {조합법::%{_id}%::결과부품이름} to {_rodName}
    set {조합법::%{_id}%::재료::1::타입} to {_t1}
    set {조합법::%{_id}%::재료::1::ID} to {_id1}
    set {조합법::%{_id}%::재료::1::이름} to {_n1}
    set {조합법::%{_id}%::재료::1::MC} to {_mc1}
    set {조합법::%{_id}%::재료::1::수량} to {_q1}
    if {_matCount} >= 2:
        set {조합법::%{_id}%::재료::2::타입} to {_t2}
        set {조합법::%{_id}%::재료::2::ID} to {_id2}
        set {조합법::%{_id}%::재료::2::이름} to {_n2}
        set {조합법::%{_id}%::재료::2::MC} to {_mc2}
        set {조합법::%{_id}%::재료::2::수량} to {_q2}
    if {_matCount} >= 3:
        set {조합법::%{_id}%::재료::3::타입} to {_t3}
        set {조합법::%{_id}%::재료::3::ID} to {_id3}
        set {조합법::%{_id}%::재료::3::이름} to {_n3}
        set {조합법::%{_id}%::재료::3::MC} to {_mc3}
        set {조합법::%{_id}%::재료::3::수량} to {_q3}
    set {조합법::%{_id}%::결과} to 부품낚싯대생성({_rodName})
    # 부품→레시피ID 역매핑 (부품상점에서 사용)
    set {부품_레시피ID::낚싯대::%{_rodName}%} to {_id}

# === 이후 GUI/제작/드롭/명령(/조합대,/레시피마을,/레시피상태) 및 로직 헬퍼는 Java(com.blockship.crafting)로 이관됨 ===
# === 진입=craftopen, 결과=craftgive/craftpost, 드롭훅=craftmatdrop, 해금동기=craftunlockread (조합대_bridge.sk) ===
