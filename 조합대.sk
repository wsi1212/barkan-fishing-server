# ===== 조합대 GUI 열기 =====
# 슬롯 맵: 레시피목록(9,10,18,19,27,28,36,37) 그리드(12-14,21-23,30-32)
#          화살표(16) 결과(17) 제작(34) 카테탭(46-50) 페이지(45,53) 닫기(8)
function 조합대GUI열기(p: player, cat: text, page: integer, selId: text):
    open chest inventory with 6 rows named "{@gui_name}" to {_p}
    set {조합대카테::%{_p}%} to {_cat}
    set {조합대페이지::%{_p}%} to {_page}
    set {조합대선택::%{_p}%} to {_selId}
    # 배경 채우기
    loop integers from 0 to 53:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&f"
    # 닫기
    set slot 8 of {_p}'s current inventory to barrier named "&c&l닫기"
    # 안내
    set slot 0 of {_p}'s current inventory to book named "&e조합대 안내" with lore "&7재료를 모아 아이템을 제작하세요!" and "&7카테고리를 선택하고 레시피를 클릭!" and "" and "&7채굴/재배로 재료를 모으세요."
    # 카테고리 탭
    set {_cats::1} to "광물"
    set {_cats::2} to "농산물"
    set {_cats::3} to "고급"
    set {_cats::4} to "낚시"
    set {_cats::5} to "특수"
    set {_catIcons::1} to diamond pickaxe
    set {_catIcons::2} to wheat
    set {_catIcons::3} to enchanting table
    set {_catIcons::4} to fishing rod
    set {_catIcons::5} to nether star
    loop integers from 1 to 5:
        set {_catName} to {_cats::%loop-integer%}
        set {_catSlot} to 45 + loop-integer
        if {_catName} is {_cat}:
            set slot {_catSlot} of {_p}'s current inventory to {_catIcons::%loop-integer%} named "&e&l%{_catName}%" with lore "&a현재 선택됨"
        else:
            set slot {_catSlot} of {_p}'s current inventory to {_catIcons::%loop-integer%} named "&7%{_catName}%" with lore "&7클릭하여 이동"
    # 레시피 목록
    delete {조합대슬롯::%{_p}%::*}
    set {_recipeSlots::1} to 9
    set {_recipeSlots::2} to 10
    set {_recipeSlots::3} to 18
    set {_recipeSlots::4} to 19
    set {_recipeSlots::5} to 27
    set {_recipeSlots::6} to 28
    set {_recipeSlots::7} to 36
    set {_recipeSlots::8} to 37
    set {_perPage} to 8
    set {_start} to ({_page} - 1) * {_perPage} + 1
    set {_listIdx} to 0
    set {_totalInCat} to size of {조합카테::%{_cat}%::*}
    if {조합카테::%{_cat}%::*} is set:
        loop {조합카테::%{_cat}%::*}:
            add 1 to {_listIdx}
            if {_listIdx} >= {_start}:
                set {_slotIdx} to {_listIdx} - {_start} + 1
                if {_slotIdx} > {_perPage}:
                    stop loop
                set {_cid} to loop-value
                set {_rSlot} to {_recipeSlots::%{_slotIdx}%}
                set {_cname} to {조합법::%{_cid}%::이름}
                set {_canCraft} to 조합가능여부2({_p}, {_cid})
                set {_resultItem} to {조합법::%{_cid}%::결과}
                if {_resultItem} is set:
                    set {_listItem} to {_resultItem}
                else:
                    set {_listItem} to paper named "&f%{_cname}%"
                set {_newLore::*} to lore of {_listItem}
                add "" to {_newLore::*}
                if {_canCraft} is true:
                    add "&a제작 가능!" to {_newLore::*}
                else:
                    add "&c재료 부족" to {_newLore::*}
                if {_cid} is {_selId}:
                    set name of {_listItem} to "&e&l> %{_cname}%"
                set lore of {_listItem} to {_newLore::*}
                set slot {_rSlot} of {_p}'s current inventory to {_listItem}
                set {조합대슬롯::%{_p}%::%{_rSlot}%} to {_cid}
    # 페이지 버튼
    if {_start} > 1:
        set slot 45 of {_p}'s current inventory to arrow named "&c◀ 이전" with lore "&7이전 페이지"
    if {_start} + {_perPage} - 1 < {_totalInCat}:
        set slot 53 of {_p}'s current inventory to arrow named "&a다음 ▶" with lore "&7다음 페이지"
    # 3x3 그리드 + 결과 + 제작 버튼
    set {_gridSlots::1} to 12
    set {_gridSlots::2} to 13
    set {_gridSlots::3} to 14
    set {_gridSlots::4} to 21
    set {_gridSlots::5} to 22
    set {_gridSlots::6} to 23
    set {_gridSlots::7} to 30
    set {_gridSlots::8} to 31
    set {_gridSlots::9} to 32
    # 그리드 초기화 (검은 유리)
    loop integers from 1 to 9:
        set slot {_gridSlots::%loop-integer%} of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 16 of {_p}'s current inventory to gray stained glass pane named "&f"
    set slot 17 of {_p}'s current inventory to gray stained glass pane named "&f"
    set slot 34 of {_p}'s current inventory to gray stained glass pane named "&8제작 불가"
    if {_selId} is not "":
        if {조합법::%{_selId}%::이름} is set:
            set {_matCnt} to {조합법::%{_selId}%::재료수}
            set {_canCraft} to 조합가능여부2({_p}, {_selId})
            # 그리드에 재료 배치
            if {_matCnt} is set:
                loop integers from 1 to {_matCnt}:
                    if loop-integer <= 9:
                        set {_gSlot} to {_gridSlots::%loop-integer%}
                        set {_mName} to {조합법::%{_selId}%::재료::%loop-integer%::이름}
                        set {_mMC} to {조합법::%{_selId}%::재료::%loop-integer%::MC}
                        set {_mNeed} to {조합법::%{_selId}%::재료::%loop-integer%::수량}
                        set {_mType} to {조합법::%{_selId}%::재료::%loop-integer%::타입}
                        set {_mID} to {조합법::%{_selId}%::재료::%loop-integer%::ID}
                        # 보유수 체크
                        if {_mType} is "item":
                            set {_mHave} to 아이템재료보유수({_p}, {_mID})
                        else:
                            set {_mHave} to 커스텀재료보유수({_p}, {_mID})
                        # 그리드 아이템 생성
                        set {_mcType} to {_mMC} parsed as item type
                        if {_mcType} is set:
                            set {_gridItem} to 1 of {_mcType}
                        else:
                            set {_gridItem} to paper
                        set name of {_gridItem} to "&e%{_mName}% &7x%{_mNeed}%"
                        if {_mHave} >= {_mNeed}:
                            set lore of {_gridItem} to "&a보유: %{_mHave}% / 필요: %{_mNeed}%" and "&a✓ 충족"
                        else:
                            set lore of {_gridItem} to "&c보유: %{_mHave}% / 필요: %{_mNeed}%" and "&c✗ 부족"
                        set slot {_gSlot} of {_p}'s current inventory to {_gridItem}
            # 화살표
            set slot 16 of {_p}'s current inventory to arrow named "&e&l→"
            # 결과 미리보기
            set {_resultItem} to {조합법::%{_selId}%::결과}
            if {_resultItem} is set:
                set slot 17 of {_p}'s current inventory to {_resultItem}
            # 제작 버튼
            if {_canCraft} is true:
                set slot 34 of {_p}'s current inventory to lime concrete named "&a&l제작하기!" with lore "&7클릭하여 제작합니다."
            else:
                set slot 34 of {_p}'s current inventory to red concrete named "&c&l재료 부족" with lore "&7필요한 재료가 부족합니다."

# ===== 클릭 핸들러 =====
on inventory click:
    if name of player's current inventory is "{@gui_name}":
        cancel event
        set {_slot} to index of clicked slot
        # 닫기
        if {_slot} is 8:
            close player's inventory
            stop
        # 카테고리 탭 (46-50)
        if {_slot} >= 46:
            if {_slot} <= 50:
                set {_catIdx} to {_slot} - 45
                set {_cats::1} to "광물"
                set {_cats::2} to "농산물"
                set {_cats::3} to "고급"
                set {_cats::4} to "낚시"
                set {_cats::5} to "특수"
                set {_newCat} to {_cats::%{_catIdx}%}
                if {_newCat} is set:
                    wait 1 tick
                    조합대GUI열기(player, {_newCat}, 1, "")
                stop
        # 페이지 이동
        if {_slot} is 45:
            set {_pg} to {조합대페이지::%player%}
            if {_pg} is not set:
                set {_pg} to 1
            if {_pg} > 1:
                wait 1 tick
                조합대GUI열기(player, {조합대카테::%player%}, {_pg} - 1, {조합대선택::%player%})
            stop
        if {_slot} is 53:
            set {_pg} to {조합대페이지::%player%}
            if {_pg} is not set:
                set {_pg} to 1
            wait 1 tick
            조합대GUI열기(player, {조합대카테::%player%}, {_pg} + 1, {조합대선택::%player%})
            stop
        # 레시피 선택 (9,10,18,19,27,28,36,37)
        set {_cid} to {조합대슬롯::%player%::%{_slot}%}
        if {_cid} is set:
            wait 1 tick
            조합대GUI열기(player, {조합대카테::%player%}, {조합대페이지::%player%}, {_cid})
            stop
        # 제작 버튼 (34)
        if {_slot} is 34:
            set {_selId} to {조합대선택::%player%}
            if {_selId} is not set:
                stop
            if {_selId} is "":
                stop
            set {_canCraft} to 조합가능여부2(player, {_selId})
            if {_canCraft} is false:
                message "{@prefix} &c재료가 부족합니다." to player
                stop
            # 재료 제거
            set {_matCnt} to {조합법::%{_selId}%::재료수}
            loop integers from 1 to {_matCnt}:
                set {_mType} to {조합법::%{_selId}%::재료::%loop-integer%::타입}
                set {_mID} to {조합법::%{_selId}%::재료::%loop-integer%::ID}
                set {_mNeed} to {조합법::%{_selId}%::재료::%loop-integer%::수량}
                if {_mType} is "item":
                    아이템재료제거(player, {_mID}, {_mNeed})
                else:
                    커스텀재료제거(player, {_mID}, {_mNeed})
            # 결과 지급
            set {_result} to {조합법::%{_selId}%::결과}
            if {_result} is set:
                if player can hold {_result}:
                    give {_result} to player
                else:
                    drop {_result} at player's location
                    message "{@prefix} &7인벤토리가 가득 차 바닥에 떨어졌습니다!" to player
            set {_cname} to {조합법::%{_selId}%::이름}
            message "{@prefix} &a%{_cname}% &a제작 완료!" to player
            play sound "entity.player.levelup" with volume 0.7 and pitch 1.5 to player
            set {조합완료이름::%player%} to {_cname}
            execute console command "questcraftdone %player%"
            # 낚싯대 도감 등록
            set {_rlore} to "%lore of {_result}%"
            if {_rlore} contains "[낚싯대]":
                execute console command "dogamrod %player% %{_cname}%"
            # GUI 갱신
            wait 1 tick
            조합대GUI열기(player, {조합대카테::%player%}, {조합대페이지::%player%}, {_selId})
            stop

# ===== 명령어 =====
on tab complete of "/조합대":
    stop

command /조합대:
    aliases: /whqkqteo
    trigger:
        조합대GUI열기(player, "광물", 1, "")
