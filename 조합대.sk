# =========================================
# 조합대.sk — 하이픽셀 스타일 제작대
# 3x3 그리드 UI + 카테고리 + 대량 레시피
# =========================================

options:
    prefix: &8[&6 조합대 &8]
    gui_name: &0조합대

# ===== 재료 보유수 (바닐라 아이템 타입) =====
function 아이템재료보유수(p: player, typeName: text) :: number:
    set {_type} to {_typeName} parsed as item type
    if {_type} is not set:
        return 0
    set {_count} to 0
    loop items in {_p}'s inventory:
        if loop-item is {_type}:
            set {_l} to "%lore of loop-item%"
            if {_l} does not contain "mat:":
                add amount of loop-item to {_count}
    return {_count}

# ===== 재료 보유수 (커스텀 mat 태그) =====
function 커스텀재료보유수(p: player, matId: text) :: number:
    set {_count} to 0
    loop items in {_p}'s inventory:
        if loop-item is not air:
            set {_l} to "%lore of loop-item%"
            if {_l} contains "mat:%{_matId}%":
                add amount of loop-item to {_count}
    return {_count}

# ===== 바닐라 아이템 제거 =====
function 아이템재료제거(p: player, typeName: text, amount: number):
    set {_type} to {_typeName} parsed as item type
    if {_type} is not set:
        stop
    set {_left} to {_amount}
    loop items in {_p}'s inventory:
        if {_left} <= 0:
            stop
        if loop-item is {_type}:
            set {_l} to "%lore of loop-item%"
            if {_l} does not contain "mat:":
                set {_stack} to amount of loop-item
                if {_stack} <= {_left}:
                    subtract {_stack} from {_left}
                    remove loop-item from {_p}'s inventory
                else:
                    remove {_left} of loop-item from {_p}'s inventory
                    set {_left} to 0

# ===== 커스텀 재료 제거 =====
function 커스텀재료제거(p: player, matId: text, amount: number):
    set {_left} to {_amount}
    loop items in {_p}'s inventory:
        if {_left} <= 0:
            stop
        if loop-item is not air:
            set {_l} to "%lore of loop-item%"
            if {_l} contains "mat:%{_matId}%":
                set {_stack} to amount of loop-item
                if {_stack} <= {_left}:
                    subtract {_stack} from {_left}
                    remove loop-item from {_p}'s inventory
                else:
                    remove {_left} of loop-item from {_p}'s inventory
                    set {_left} to 0

# ===== 레시피 해금 여부 =====
function 레시피해금됨(p: player, craftId: text) :: boolean:
    if {조합법::%{_craftId}%::락잠금} is not true:
        return true
    if {레시피해금::%{_p}%::%{_craftId}%} is true:
        return true
    return false

function 레시피해금부여(p: player, craftId: text):
    set {레시피해금::%{_p}%::%{_craftId}%} to true

# ===== 부품데이터 기반 낚싯대 아이템 생성 (상점/조합 공용) =====
function 부품낚싯대생성(name: text) :: item:
    set {_grade} to get_part_grade("낚싯대", {_name})
    set {_color} to part_grade_color({_grade})
    set {_rod} to 1 of fishing rod named "%{_color}%%{_name}%"
    delete {_lore::*}
    add "&7등급 &e: %{_color}%%{_grade}%" to {_lore::*}
    set {_raw} to get_part_stats_raw("낚싯대", {_name})
    set {_pairs::*} to split {_raw} at ","
    loop {_pairs::*}:
        set {_kv::*} to split loop-value at ":"
        if {_kv::1} is "등급특화":
            add "&7등급 특화 &e: &f%{_kv::2}%등급 확률 2배" to {_lore::*}
        else:
            set {_desc} to stat_type_desc({_kv::1})
            set {_vt} to stat_value_text({_kv::1}, {_kv::2} parsed as number)
            add "&7%{_desc}% &e: &f%{_vt}%" to {_lore::*}
    set lore of {_rod} to {_lore::*}
    set {_rod} to unbreakable {_rod}
    enchant {_rod} with lure 2
    return {_rod}

# ===== 중간재 아이템 생성 헬퍼 =====
function 중간재아이템(matId: text, displayName: text, mc: text, color: text, desc: text) :: item:
    set {_t} to {_mc} parsed as item type
    if {_t} is not set:
        set {_t} to paper
    set {_item} to 1 of {_t}
    set name of {_item} to "%{_color}%%{_displayName}%"
    set lore of {_item} to "&7%{_desc}%" and "" and "&8[조합 재료]" and "&8mat:%{_matId}%"
    return {_item}

# ===== 별빛 진주 재료 추가 헬퍼 (자동으로 다음 slot에 추가) =====
# slot 인자는 호환성 위해 받지만 사용 안 함 (재료수+1 위치 자동 사용)
function 별빛진주재료추가(id: text, slot: integer, qty: integer):
    set {_cur} to {조합법::%{_id}%::재료수}
    if {_cur} is not set:
        set {_cur} to 0
    set {_new} to {_cur} + 1
    set {조합법::%{_id}%::재료수} to {_new}
    set {조합법::%{_id}%::재료::%{_new}%::타입} to "custom"
    set {조합법::%{_id}%::재료::%{_new}%::ID} to "별빛진주"
    set {조합법::%{_id}%::재료::%{_new}%::이름} to "별빛 진주"
    set {조합법::%{_id}%::재료::%{_new}%::MC} to "heart of the sea"
    set {조합법::%{_id}%::재료::%{_new}%::수량} to {_qty}

# ===== 일반 재료 추가 헬퍼 (낚싯대에 광물 추가용, 자동 슬롯) =====
# slot 인자는 호환성 위해 받지만 사용 안 함 (재료수+1 위치 자동 사용)
function 재료추가(id: text, slot: integer, matId: text, name: text, mc: text, qty: integer):
    set {_cur} to {조합법::%{_id}%::재료수}
    if {_cur} is not set:
        set {_cur} to 0
    set {_new} to {_cur} + 1
    set {조합법::%{_id}%::재료수} to {_new}
    set {조합법::%{_id}%::재료::%{_new}%::타입} to "custom"
    set {조합법::%{_id}%::재료::%{_new}%::ID} to {_matId}
    set {조합법::%{_id}%::재료::%{_new}%::이름} to {_name}
    set {조합법::%{_id}%::재료::%{_new}%::MC} to {_mc}
    set {조합법::%{_id}%::재료::%{_new}%::수량} to {_qty}

# ===== 조합 가능 여부 =====
function 조합가능여부2(p: player, craftId: text) :: boolean:
    set {_cnt} to {조합법::%{_craftId}%::재료수}
    if {_cnt} is not set:
        return false
    loop integers from 1 to {_cnt}:
        set {_t} to {조합법::%{_craftId}%::재료::%loop-integer%::타입}
        set {_mid} to {조합법::%{_craftId}%::재료::%loop-integer%::ID}
        set {_need} to {조합법::%{_craftId}%::재료::%loop-integer%::수량}
        if {_t} is "item":
            set {_have} to 아이템재료보유수({_p}, {_mid})
        else:
            set {_have} to 커스텀재료보유수({_p}, {_mid})
        if {_have} < {_need}:
            return false
    return true

