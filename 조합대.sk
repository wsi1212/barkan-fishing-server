    # --- C10: 바르칸 핵 (심연균열) ---
    set {_id} to "C10"
    add {_id} to {조합카테::고급::*}
    set {조합법::%{_id}%::이름} to "바르칸 핵"
    set {조합법::%{_id}%::카테고리} to "고급"
    set {조합법::%{_id}%::재료수} to 2
    set {조합법::%{_id}%::재료::1::타입} to "custom"
    set {조합법::%{_id}%::재료::1::ID} to "바르칸조각"
    set {조합법::%{_id}%::재료::1::이름} to "바르칸 조각"
    set {조합법::%{_id}%::재료::1::MC} to "amethyst cluster"
    set {조합법::%{_id}%::재료::1::수량} to 8
    set {조합법::%{_id}%::재료::2::타입} to "custom"
    set {조합법::%{_id}%::재료::2::ID} to "강화네더라이트파편"
    set {조합법::%{_id}%::재료::2::이름} to "강화 네더라이트 파편"
    set {조합법::%{_id}%::재료::2::MC} to "netherite scrap"
    set {조합법::%{_id}%::재료::2::수량} to 2
    set {조합법::%{_id}%::결과} to 중간재아이템("바르칸핵", "바르칸 핵", "netherite ingot", "&5", "심연균열 — 바르칸 열도의 정수")

    # ----- 중간재 별빛 진주 추가 (C01·C03은 기본 부품이라 제외) -----
    별빛진주재료추가("C02", 3, 1)
    별빛진주재료추가("C04", 3, 2)
    별빛진주재료추가("C05", 3, 2)
    별빛진주재료추가("C06", 3, 1)
    별빛진주재료추가("C07", 3, 1)
    별빛진주재료추가("C08", 3, 1)
    별빛진주재료추가("C09", 3, 2)
    별빛진주재료추가("C10", 3, 3)

    # ----- 중간재 광물 보강 -----
    재료추가("C03", 4, "강화부싯돌", "강화 부싯돌", "flint", 4)
    재료추가("C09", 4, "강화레드스톤", "강화 레드스톤", "redstone", 4)
    재료추가("C10", 4, "강화흑요석", "강화 흑요석", "obsidian", 2)
    재료추가("C04", 4, "강화청금석", "강화 청금석", "lapis lazuli", 4)
    재료추가("C07", 4, "강화에메랄드", "강화 에메랄드", "emerald", 2)

