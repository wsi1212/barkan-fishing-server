    set {조합법::%{_id}%::이름} to "강화 자갈"
    set {조합법::%{_id}%::카테고리} to "광물"
    set {조합법::%{_id}%::재료수} to 1
    set {조합법::%{_id}%::재료::1::타입} to "item"
    set {조합법::%{_id}%::재료::1::ID} to "gravel"
    set {조합법::%{_id}%::재료::1::이름} to "자갈"
    set {조합법::%{_id}%::재료::1::MC} to "gravel"
    set {조합법::%{_id}%::재료::1::수량} to 16
    set {_r} to 1 of gravel named "&e강화 자갈"
    set lore of {_r} to "&7자갈 16개를 압축한 강화 광물" and "" and "&8[조합 재료]" and "&8mat:강화자갈"
