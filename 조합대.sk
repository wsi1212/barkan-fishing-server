    재료추가("R35", 4, "압축에메랄드블록", "압축 에메랄드 블록", "emerald block", 1)

# 낚싯대 레시피 정의 헬퍼 (가변 인자 대신 텍스트 시리즈로)
function 낚싯대레시피정의(id: text, rodName: text, matCount: integer, t1: text, id1: text, n1: text, mc1: text, q1: integer, t2: text = "", id2: text = "", n2: text = "", mc2: text = "", q2: integer = 0, t3: text = "", id3: text = "", n3: text = "", mc3: text = "", q3: integer = 0):
    add {_id} to {조합카테::낚시::*}
    set {조합법::%{_id}%::이름} to {_rodName}
    set {조합법::%{_id}%::카테고리} to "낚시"
    set {조합법::%{_id}%::재료수} to {_matCount}
    set {조합법::%{_id}%::락잠금} to true
    set {조합법::%{_id}%::결과부품이름} to {_rodName}
    set {조합법::%{_id}%::재료::1::타입} to {_t1}
    set {조합법::%{_id}%::재료::1::ID} to {_id1}
    set {조합법::%{_id}%::재료::1::이름} to {_n1}
    set {조합법::%{_id}%::재료::1::MC} to {_mc1}
    set {조합법::%{_id}%::재료::1::수량} to {_q1}
    if {_matCount} >= 2:
        set {조합법::%{_id}%::재료::2::타입} to {_t2}
        set {조합법::%{_id}%::재료::2::ID} to {_id2}
        set {조합법::%{_id}%::재료::2::이름} to {_n2}
        set {조합법::%{_id}%::재료::2::MC} to {_mc2}
        set {조합법::%{_id}%::재료::2::수량} to {_q2}
    if {_matCount} >= 3:
        set {조합법::%{_id}%::재료::3::타입} to {_t3}
        set {조합법::%{_id}%::재료::3::ID} to {_id3}
        set {조합법::%{_id}%::재료::3::이름} to {_n3}
        set {조합법::%{_id}%::재료::3::MC} to {_mc3}
        set {조합법::%{_id}%::재료::3::수량} to {_q3}
    set {조합법::%{_id}%::결과} to 부품낚싯대생성({_rodName})
    # 부품→레시피ID 역매핑 (부품상점에서 사용)
    set {부품_레시피ID::낚싯대::%{_rodName}%} to {_id}

# ===== 조합대 GUI 열기 =====
# 슬롯 맵: 레시피목록(9,10,18,19,27,28,36,37) 그리드(12-14,21-23,30-32)
#          화살표(16) 결과(17) 제작(34) 카테탭(46-50) 페이지(45,53) 닫기(8)
function 조합대GUI열기(p: player, cat: text, page: integer, selId: text, village: text = ""):
    # village 파라미터: "" = 전체 (op /조합대), 이름 = 해당 마을 전용 레시피만
    set {_guiName} to "{@gui_name}"
    if {_village} is not "":
        set {_guiName} to "&0%{_village}% 대장간"
    open chest inventory with 6 rows named {_guiName} to {_p}
    set {조합대카테::%{_p}%} to {_cat}
    set {조합대페이지::%{_p}%} to {_page}
    set {조합대선택::%{_p}%} to {_selId}
    set {조합대마을::%{_p}%} to {_village}
    # 배경 채우기
    loop integers from 0 to 53:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&f"
    # 안내 (slot 0)
    set slot 0 of {_p}'s current inventory to book named "&e조합대 안내" with lore "&7재료를 모아 아이템을 제작하세요!" and "&7카테고리를 선택하고 레시피를 클릭!"
    # 닫기 (slot 8)
    set slot 8 of {_p}'s current inventory to barrier named "&c&l닫기"
    # 카테고리 탭 (slot 1~5, 상단)
    set {_cats::1} to "광물"
    set {_cats::2} to "농산물"
    set {_cats::3} to "고급"
    set {_cats::4} to "낚시"
    set {_cats::5} to "특수"
    set {_catIcons::1} to diamond pickaxe
    set {_catIcons::2} to wheat
    set {_catIcons::3} to enchanting table
    set {_catIcons::4} to fishing rod
    set {_catIcons::5} to nether star
    loop integers from 1 to 5:
        set {_catName} to {_cats::%loop-integer%}
        set {_catSlot} to loop-integer
        if {_catName} is {_cat}:
            set slot {_catSlot} of {_p}'s current inventory to {_catIcons::%loop-integer%} named "&e&l%{_catName}%" with lore "&a현재 선택됨"
        else:
            set slot {_catSlot} of {_p}'s current inventory to {_catIcons::%loop-integer%} named "&7%{_catName}%" with lore "&7클릭하여 이동"
    # 레시피 목록 (좌측 5열 × 5줄 = 25 슬롯, col 5는 구분선)
    delete {조합대슬롯::%{_p}%::*}
    set {_recipeSlots::1} to 9
    set {_recipeSlots::2} to 10
    set {_recipeSlots::3} to 11
    set {_recipeSlots::4} to 12
    set {_recipeSlots::5} to 13
    set {_recipeSlots::6} to 18
    set {_recipeSlots::7} to 19
    set {_recipeSlots::8} to 20
    set {_recipeSlots::9} to 21
    set {_recipeSlots::10} to 22
    set {_recipeSlots::11} to 27
    set {_recipeSlots::12} to 28
    set {_recipeSlots::13} to 29
    set {_recipeSlots::14} to 30
    set {_recipeSlots::15} to 31
    set {_recipeSlots::16} to 36
    set {_recipeSlots::17} to 37
    set {_recipeSlots::18} to 38
    set {_recipeSlots::19} to 39
    set {_recipeSlots::20} to 40
    set {_recipeSlots::21} to 45
    set {_recipeSlots::22} to 46
    set {_recipeSlots::23} to 47
    set {_recipeSlots::24} to 48
    set {_recipeSlots::25} to 49
    set {_perPage} to 25
    # col 5 구분선 (회색 유리는 배경 채우기에서 이미 됨, 명시적으로 유지)
    # 해금된 레시피만 별도 리스트로 필터링 + 마을 전용 체크
    delete {_visList::*}
    if {조합카테::%{_cat}%::*} is set:
        loop {조합카테::%{_cat}%::*}:
            if 레시피해금됨({_p}, loop-value) is true:
                # 마을 필터: 레시피의 소속마을이 비어있으면 전역(모든 대장간)
                # 설정되어 있으면 village와 일치할 때만 표시
                # village="" (op 직접 호출)이면 전부 표시
                set {_recipeVillage} to {조합법::%loop-value%::소속마을}
                if {_village} is "":
                    add loop-value to {_visList::*}
                else if {_recipeVillage} is not set:
                    add loop-value to {_visList::*}
                else if {_recipeVillage} is "":
                    add loop-value to {_visList::*}
                else if {_recipeVillage} is {_village}:
                    add loop-value to {_visList::*}
    set {_totalInCat} to size of {_visList::*}
    # 페이지 nav를 위해 첫/끝 슬롯 예약 → 실제 표시 가능 수 결정
    set {_hasPrev} to false
    set {_hasNext} to false
    if {_page} > 1:
        set {_hasPrev} to true
    if {_page} * {_perPage} < {_totalInCat}:
        set {_hasNext} to true
    set {_firstRecipeIdx} to 1
    set {_lastRecipeIdx} to {_perPage}
    if {_hasPrev} is true:
        set {_firstRecipeIdx} to 2
    if {_hasNext} is true:
        set {_lastRecipeIdx} to {_perPage} - 1
    set {_displayCount} to {_lastRecipeIdx} - {_firstRecipeIdx} + 1
    set {_start} to ({_page} - 1) * {_perPage} + 1
    set {_listIdx} to 0
    set {_displayed} to 0
    if {_visList::*} is set:
        loop {_visList::*}:
            add 1 to {_listIdx}
            if {_listIdx} >= {_start}:
                if {_displayed} >= {_displayCount}:
                    stop loop
                add 1 to {_displayed}
                set {_slotIdx} to {_firstRecipeIdx} + {_displayed} - 1
                set {_cid} to loop-value
                set {_rSlot} to {_recipeSlots::%{_slotIdx}%}
                set {_cname} to {조합법::%{_cid}%::이름}
                set {_canCraft} to 조합가능여부2({_p}, {_cid})
                set {_resultItem} to {조합법::%{_cid}%::결과}
                if {_resultItem} is set:
                    set {_listItem} to {_resultItem}
                else:
                    set {_listItem} to paper named "&f%{_cname}%"
                set {_newLore::*} to lore of {_listItem}
                add "" to {_newLore::*}
                if {_canCraft} is true:
                    add "&a제작 가능!" to {_newLore::*}
                else:
                    add "&c재료 부족" to {_newLore::*}
                if {_cid} is {_selId}:
                    set name of {_listItem} to "&e&l> %{_cname}%"
                set lore of {_listItem} to {_newLore::*}
                set slot {_rSlot} of {_p}'s current inventory to {_listItem}
                set {조합대슬롯::%{_p}%::%{_rSlot}%} to {_cid}
    # 페이지 버튼 — 레시피 영역 첫/끝 슬롯에 배치
    if {_hasPrev} is true:
        set slot 9 of {_p}'s current inventory to arrow named "&c◀ 이전" with lore "&7이전 페이지"
    if {_hasNext} is true:
        set slot 49 of {_p}'s current inventory to arrow named "&a다음 ▶" with lore "&7다음 페이지"
    # 3x3 그리드 (오른쪽 벽: slot 15,16,17 / 24,25,26 / 33,34,35)
    set {_gridSlots::1} to 15
    set {_gridSlots::2} to 16
    set {_gridSlots::3} to 17
    set {_gridSlots::4} to 24
    set {_gridSlots::5} to 25
    set {_gridSlots::6} to 26
    set {_gridSlots::7} to 33
    set {_gridSlots::8} to 34
    set {_gridSlots::9} to 35
    # 그리드 초기화 (검은 유리)
    loop integers from 1 to 9:
        set slot {_gridSlots::%loop-integer%} of {_p}'s current inventory to black stained glass pane named "&f"
    # 결과 미리보기 (slot 43, 그리드 아래 가운데)
    set slot 43 of {_p}'s current inventory to gray stained glass pane named "&f"
    # 제작 버튼 (slot 52, 결과 아래)
    set slot 52 of {_p}'s current inventory to gray stained glass pane named "&8제작 불가"
    if {_selId} is not "":
        if {조합법::%{_selId}%::이름} is set:
            set {_matCnt} to {조합법::%{_selId}%::재료수}
            set {_canCraft} to 조합가능여부2({_p}, {_selId})
            # 그리드에 재료 배치
            if {_matCnt} is set:
                loop integers from 1 to {_matCnt}:
                    if loop-integer <= 9:
                        set {_gSlot} to {_gridSlots::%loop-integer%}
                        set {_mName} to {조합법::%{_selId}%::재료::%loop-integer%::이름}
                        set {_mMC} to {조합법::%{_selId}%::재료::%loop-integer%::MC}
                        set {_mNeed} to {조합법::%{_selId}%::재료::%loop-integer%::수량}
                        set {_mType} to {조합법::%{_selId}%::재료::%loop-integer%::타입}
                        set {_mID} to {조합법::%{_selId}%::재료::%loop-integer%::ID}
                        # 보유수 체크
                        if {_mType} is "item":
                            set {_mHave} to 아이템재료보유수({_p}, {_mID})
                        else:
                            set {_mHave} to 커스텀재료보유수({_p}, {_mID})
                        # 그리드 아이템 생성
                        set {_mcType} to {_mMC} parsed as item type
                        if {_mcType} is set:
                            set {_gridItem} to 1 of {_mcType}
                        else:
                            set {_gridItem} to paper
                        set name of {_gridItem} to "&e%{_mName}% &7x%{_mNeed}%"
                        if {_mHave} >= {_mNeed}:
                            set lore of {_gridItem} to "&a보유: %{_mHave}% / 필요: %{_mNeed}%" and "&a✓ 충족"
                        else:
                            set lore of {_gridItem} to "&c보유: %{_mHave}% / 필요: %{_mNeed}%" and "&c✗ 부족"
                        set slot {_gSlot} of {_p}'s current inventory to {_gridItem}
            # 결과 미리보기 (slot 43)
            set {_resultItem} to {조합법::%{_selId}%::결과}
            if {_resultItem} is set:
                set slot 43 of {_p}'s current inventory to {_resultItem}
            # 제작 버튼 (slot 52)
            if {_canCraft} is true:
                set slot 52 of {_p}'s current inventory to lime concrete named "&a&l제작하기!" with lore "&7클릭하여 제작합니다."
            else:
                set slot 52 of {_p}'s current inventory to red concrete named "&c&l재료 부족" with lore "&7필요한 재료가 부족합니다."

# ===== 클릭 핸들러 =====
on inventory click:
    set {_invName} to name of player's current inventory
    set {_isCraftGUI} to false
    if {_invName} is "{@gui_name}":
        set {_isCraftGUI} to true
    else if {_invName} contains "대장간":
        set {_isCraftGUI} to true
    if {_isCraftGUI} is true:
        cancel event
        set {_slot} to index of clicked slot
        set {_curVillage} to {조합대마을::%player%}
        if {_curVillage} is not set:
            set {_curVillage} to ""
        # 닫기 (slot 8)
        if {_slot} is 8:
            close player's inventory
            stop
        # 카테고리 탭 (slot 1~5, 상단)
        if {_slot} >= 1:
            if {_slot} <= 5:
                set {_catIdx} to {_slot}
                set {_cats::1} to "광물"
                set {_cats::2} to "농산물"
                set {_cats::3} to "고급"
                set {_cats::4} to "낚시"
                set {_cats::5} to "특수"
                set {_newCat} to {_cats::%{_catIdx}%}
                if {_newCat} is set:
                    wait 1 tick
                    조합대GUI열기(player, {_newCat}, 1, "", {_curVillage})
                stop
        # 페이지 이동 (slot 9 = 이전, slot 49 = 다음 — 레시피 영역 첫/끝)
        if {_slot} is 9:
            if {조합대슬롯::%player%::9} is not set:
                set {_pg} to {조합대페이지::%player%}
                if {_pg} is not set:
                    set {_pg} to 1
                if {_pg} > 1:
                    wait 1 tick
                    조합대GUI열기(player, {조합대카테::%player%}, {_pg} - 1, {조합대선택::%player%}, {_curVillage})
                stop
        if {_slot} is 49:
            if {조합대슬롯::%player%::49} is not set:
                set {_pg} to {조합대페이지::%player%}
                if {_pg} is not set:
                    set {_pg} to 1
                wait 1 tick
                조합대GUI열기(player, {조합대카테::%player%}, {_pg} + 1, {조합대선택::%player%}, {_curVillage})
                stop
        # 레시피 선택
        set {_cid} to {조합대슬롯::%player%::%{_slot}%}
        if {_cid} is set:
            if 레시피해금됨(player, {_cid}) is false:
                message "{@prefix} &c레시피가 해금되지 않았습니다. 부품상점에서 구매하세요." to player
                stop
            wait 1 tick
            조합대GUI열기(player, {조합대카테::%player%}, {조합대페이지::%player%}, {_cid}, {_curVillage})
            stop
        # 제작 버튼 (slot 52)
        if {_slot} is 52:
            set {_selId} to {조합대선택::%player%}
            if {_selId} is not set:
                stop
            if {_selId} is "":
                stop
            set {_canCraft} to 조합가능여부2(player, {_selId})
            set {_opBypass} to false
            if {_canCraft} is false:
                if player is op:
                    # OP: 재료 부족이어도 바로 지급 (재료 소모 안 함)
                    set {_opBypass} to true
                    message "{@prefix} &e&l[OP] &c재료 부족 무시 &7→ 바로 지급합니다." to player
                else:
                    message "{@prefix} &c재료가 부족합니다." to player
                    stop
            # 재료 제거 (OP 바이패스 시 건너뜀)
            if {_opBypass} is false:
                set {_matCnt} to {조합법::%{_selId}%::재료수}
                loop integers from 1 to {_matCnt}:
                    set {_mType} to {조합법::%{_selId}%::재료::%loop-integer%::타입}
                    set {_mID} to {조합법::%{_selId}%::재료::%loop-integer%::ID}
                    set {_mNeed} to {조합법::%{_selId}%::재료::%loop-integer%::수량}
                    if {_mType} is "item":
                        아이템재료제거(player, {_mID}, {_mNeed})
                    else:
                        커스텀재료제거(player, {_mID}, {_mNeed})
            # 결과 지급
            set {_result} to {조합법::%{_selId}%::결과}
            if {_result} is set:
                if player can hold {_result}:
                    give {_result} to player
                else:
                    drop {_result} at player's location
                    message "{@prefix} &7인벤토리가 가득 차 바닥에 떨어졌습니다!" to player
            set {_cname} to {조합법::%{_selId}%::이름}
            message "{@prefix} &a%{_cname}% &a제작 완료!" to player
            play sound "entity.player.levelup" with volume 0.7 and pitch 1.5 to player
            set {조합완료이름::%player%} to {_cname}
            execute console command "questcraftdone %player%"
            # 낚싯대 도감 등록
            set {_rlore} to "%lore of {_result}%"
            if {_rlore} contains "[낚싯대]":
                execute console command "dogamrod %player% %{_cname}%"
            # 부품데이터 기반 낚싯대 — 결과부품이름이 있으면 정식 도감 등록
            if {조합법::%{_selId}%::결과부품이름} is set:
                set {_rodName} to {조합법::%{_selId}%::결과부품이름}
                도감_낚싯대(player, {_rodName})
            # 결과 아이템이 [조합 재료] mat 태그 보유 시 재료 도감 자동 등록
            if {_rlore} contains "mat:":
                loop lore of {_result}:
                    if loop-value contains "mat:":
                        set {_matSp::*} to split loop-value at "mat:"
                        if {_matSp::2} is set:
                            set {_matIdReg} to {_matSp::2}
                            # color/format 코드 제거 — 마지막 값이 mat ID
                            도감_재료(player, {_matIdReg})
                            stop loop
            # GUI 갱신
            wait 1 tick
            조합대GUI열기(player, {조합대카테::%player%}, {조합대페이지::%player%}, {_selId}, {_curVillage})
            stop

# ===== 명령어 =====
on tab complete of "/조합대":
    stop

command /조합대 [<text>]:
    aliases: /whqkqteo
    trigger:
        # op만 직접 호출 가능 (전체 레시피 보기). 일반 플레이어는 마을 대장간 NPC를 통해서만 가능.
        if player is not op:
            send "&8[&6 조합대 &8] &c조합은 마을의 &e대장간 NPC&c에게서만 가능합니다." to player
            stop
        # op + 마을 인자 → 그 마을의 대장간 시뮬레이션
        # op + 인자 없음 → 전체 레시피 (관리용)
        set {_v} to ""
        if arg-1 is set:
            set {_v} to arg-1
        조합대GUI열기(player, "낚시", 1, "", {_v})

on tab complete of "/조합대":
    # 등록된 대장간 마을 자동완성 (NPC 데이터에서 수집)
    delete {_villages::*}
    if {NPC목록::*} is set:
        loop {NPC목록::*}:
            if {NPC::%loop-value%::대장간} is true:
                set {_v} to {NPC::%loop-value%::대장간마을}
                if {_v} is set:
                    if {_villages::*} does not contain {_v}:
                        add {_v} to {_villages::*}
    if size of {_villages::*} > 0:
        set tab completions for position 1 to {_villages::*}
    else:
        set tab completions for position 1 to "<마을이름>"

# ===== 레시피 마을 지정 (op 관리용) =====
on tab complete of "/레시피마을":
    delete {_ids::*}
    loop {조합법::*}:
        if {조합법::%loop-index%::이름} is set:
            add loop-index to {_ids::*}
    if size of {_ids::*} > 0:
        set tab completions for position 1 to {_ids::*}
    else:
        set tab completions for position 1 to "<레시피ID>"
    set tab completions for position 2 to "<마을이름 또는 전역>"

command /레시피마을 [<text>] [<text>]:
    permission: op
    trigger:
        if arg-1 is not set:
            send "&8[&6 레시피 &8] &7사용법:" to player
            send "&8  &e/레시피마을 <레시피ID> <마을> &7— 레시피를 마을 전용으로 지정" to player
            send "&8  &e/레시피마을 <레시피ID> 전역 &7— 마을 제한 해제" to player
            stop
        set {_rid} to arg-1
        if {조합법::%{_rid}%::이름} is not set:
            send "&8[&6 레시피 &8] &c존재하지 않는 레시피: &f%{_rid}%" to player
            stop
        if arg-2 is not set:
            set {_cur} to {조합법::%{_rid}%::소속마을}
            if {_cur} is set:
                if {_cur} is not "":
                    send "&8[&6 레시피 &8] &7%{_rid}% (&f%{조합법::%{_rid}%::이름}%&7) → &e%{_cur}% &7전용" to player
                else:
                    send "&8[&6 레시피 &8] &7%{_rid}% → &a전역 (모든 대장간)" to player
            else:
                send "&8[&6 레시피 &8] &7%{_rid}% → &a전역 (모든 대장간)" to player
            stop
        if arg-2 is "전역":
            delete {조합법::%{_rid}%::소속마을}
            send "&8[&6 레시피 &8] &a%{_rid}% (&f%{조합법::%{_rid}%::이름}%&a) → 모든 대장간 표시" to player
        else:
            set {조합법::%{_rid}%::소속마을} to arg-2
            send "&8[&6 레시피 &8] &a%{_rid}% (&f%{조합법::%{_rid}%::이름}%&a) → &e%arg-2% &a대장간 전용" to player

# ===== 마을 전용 레시피 추가 헬퍼 (op 또는 스크립트용) =====
# 새 레시피 ID를 받아서 광물/낚시/특수 등 카테고리에 마을 전용으로 등록 가능하도록.
# 사용 패턴: 일반 레시피 등록 후 → 레시피마을_지정(id, "마을이름")
function 레시피마을_지정(id: text, village: text):
    set {조합법::%{_id}%::소속마을} to {_village}

# 디버그: 레시피 락 상태 + 해금 상태 확인
command /레시피상태 [<text>]:
    permission: op
    trigger:
        set {_target} to player
        if arg-1 is set:
            set {_pp} to arg-1 parsed as player
            if {_pp} is set:
                set {_target} to {_pp}
        send "&8[&6 레시피 &8] &f%{_target}'s name% &7상태:" to player
        set {_lockTotal} to 0
        set {_unlocked} to 0
        if {조합카테::낚시::*} is set:
            loop {조합카테::낚시::*}:
                set {_id} to loop-value
                if {조합법::%{_id}%::락잠금} is true:
                    add 1 to {_lockTotal}
                    set {_rname} to {조합법::%{_id}%::이름}
                    if {레시피해금::%{_target}%::%{_id}%} is true:
                        send "  &a✓ %{_id}% &7%{_rname}% &8(해금됨)" to player
                        add 1 to {_unlocked}
                    else:
                        send "  &c✗ %{_id}% &7%{_rname}% &8(잠김)" to player
        send "&8총 &e%{_unlocked}%&8/&e%{_lockTotal}% &7해금" to player
        # 부품_레시피ID 매핑 확인
        send "&8부품→ID 매핑:" to player
        set {_mapCount} to 0
        loop {부품_레시피ID::낚싯대::*}:
            add 1 to {_mapCount}
        send "  &e%{_mapCount}%&7개 등록됨" to player
