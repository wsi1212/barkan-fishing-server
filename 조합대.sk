# =========================================
# 조합대.sk — 레시피/재료 데이터 미러 + 결과 빌더 (조합대 이관 후)
# GUI/제작/드롭/명령은 Java(com.blockship.crafting)로 이관됨 (조합대_bridge.sk 위임).
# 이 파일은 도감.sk/퀘스트.sk/어드민.sk가 읽는 {조합법}/{조합카테} 데이터 미러(on load)와
# Java가 craftgive로 호출하는 결과 빌더(부품낚싯대생성/중간재아이템)만 유지한다 (읽기 전용).
# 데이터/로직 권위는 Java. 여기 변수는 다른 Skript의 읽기 호환용.
# =========================================

options:
    prefix: &8[&6 조합대 &8]
    gui_name: &0조합대

# ===== 부품데이터 기반 낚싯대 아이템 생성 (상점/조합 공용) =====
function 부품낚싯대생성(name: text) :: item:
    set {_grade} to get_part_grade("낚싯대", {_name})
    set {_color} to part_grade_color({_grade})
    set {_rod} to 1 of fishing rod named "%{_color}%%{_name}%"
    delete {_lore::*}
    add "&7등급 &e: %{_color}%%{_grade}%" to {_lore::*}
    set {_raw} to get_part_stats_raw("낚싯대", {_name})
    set {_pairs::*} to split {_raw} at ","
    loop {_pairs::*}:
        set {_kv::*} to split loop-value at ":"
        if {_kv::1} is "등급특화":
            add "&7등급 특화 &e: &f%{_kv::2}%등급 확률 2배" to {_lore::*}
        else:
            set {_desc} to stat_type_desc({_kv::1})
            set {_vt} to stat_value_text({_kv::1}, {_kv::2} parsed as number)
            add "&7%{_desc}% &e: &f%{_vt}%" to {_lore::*}
    set lore of {_rod} to {_lore::*}
    set {_rod} to unbreakable {_rod}
    enchant {_rod} with lure 2
    return {_rod}

# ===== 중간재 아이템 생성 헬퍼 =====
function 중간재아이템(matId: text, displayName: text, mc: text, color: text, desc: text) :: item:
    set {_t} to {_mc} parsed as item type
    if {_t} is not set:
        set {_t} to paper
    set {_item} to 1 of {_t}
    set name of {_item} to "%{_color}%%{_displayName}%"
    set lore of {_item} to "&7%{_desc}%" and "" and "&8[조합 재료]" and "&8mat:%{_matId}%"
    return {_item}

# ===== 별빛 진주 재료 추가 헬퍼 (자동으로 다음 slot에 추가) =====
# slot 인자는 호환성 위해 받지만 사용 안 함 (재료수+1 위치 자동 사용)
function 별빛진주재료추가(id: text, slot: integer, qty: integer):
    set {_cur} to {조합법::%{_id}%::재료수}
    if {_cur} is not set:
        set {_cur} to 0
    set {_new} to {_cur} + 1
    set {조합법::%{_id}%::재료수} to {_new}
    set {조합법::%{_id}%::재료::%{_new}%::타입} to "custom"
    set {조합법::%{_id}%::재료::%{_new}%::ID} to "별빛진주"
    set {조합법::%{_id}%::재료::%{_new}%::이름} to "별빛 진주"
    set {조합법::%{_id}%::재료::%{_new}%::MC} to "heart of the sea"
    set {조합법::%{_id}%::재료::%{_new}%::수량} to {_qty}

# ===== 일반 재료 추가 헬퍼 (낚싯대에 광물 추가용, 자동 슬롯) =====
# slot 인자는 호환성 위해 받지만 사용 안 함 (재료수+1 위치 자동 사용)
function 재료추가(id: text, slot: integer, matId: text, name: text, mc: text, qty: integer):
    set {_cur} to {조합법::%{_id}%::재료수}
    if {_cur} is not set:
        set {_cur} to 0
    set {_new} to {_cur} + 1
    set {조합법::%{_id}%::재료수} to {_new}
    set {조합법::%{_id}%::재료::%{_new}%::타입} to "custom"
    set {조합법::%{_id}%::재료::%{_new}%::ID} to {_matId}
    set {조합법::%{_id}%::재료::%{_new}%::이름} to {_name}
    set {조합법::%{_id}%::재료::%{_new}%::MC} to {_mc}
    set {조합법::%{_id}%::재료::%{_new}%::수량} to {_qty}

# ===== 레시피 데이터 초기화 (도감/퀘스트/어드민 읽기용 미러) =====
on load:
    delete {조합법::*}
    delete {조합카테::*}

    # ========== 광물 조합 (11개) ==========
