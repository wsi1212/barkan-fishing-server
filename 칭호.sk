# =========================================
# 칭호.sk
# 칭호 시스템 — GUI 선택, 자동 획득, 어드민 관리, 채팅 포맷
# =========================================

# ===== 기본 칭호 데이터 초기화 =====
on load:
    # 칭호 정의는 BlockShip(titles.json) 소유 → /titlesync 로 {칭호데이터}/{칭호목록} 자동 세팅됨
    # 리로드 시 온라인 플레이어 칭호 복원
    wait 10 ticks
    loop all players:
        execute console command "kill @e[tag=title_%loop-player's uuid%_t]"
        execute console command "kill @e[tag=title_%loop-player's uuid%_n]"
        execute console command "titlestop %loop-player's name%"
    wait 5 ticks
    loop all players:
        칭호태그업데이트(loop-player)

# ===== 첫 접속 시 뉴비 칭호 자동 부여 =====
on first join:
    set {보유칭호::%player%::뉴비} to true
    set {장착칭호::%player%} to "뉴비"

# 기존 유저도 뉴비 칭호 없으면 자동 부여 + 닉네임 팀 준비 + 칭호 태그 복원
on join:
    if {보유칭호::%player%::뉴비} is not true:
        set {보유칭호::%player%::뉴비} to true
    # 칭호 없으면 뉴비 강제 장착
    if {장착칭호::%player%} is not set:
        set {장착칭호::%player%} to "뉴비"
    칭호자동체크(player)
    # 기존 잔여 칭호 엔티티 제거 후 새로 생성
    wait 5 ticks
    execute console command "kill @e[tag=title_%player's uuid%_t]"
    execute console command "kill @e[tag=title_%player's uuid%_n]"
    execute console command "titlestop %player's name%"
    wait 3 ticks
    칭호태그업데이트(player)

# ===== 자동 획득 체크 (레벨업/콤보 시 호출) =====
function 칭호자동체크(p: player):
    set {_lv} to {낚시레벨::%{_p}%}
    if {_lv} is not set:
        set {_lv} to 1
    set {_combo} to {낚시콤보::%{_p}%}
    if {_combo} is not set:
        set {_combo} to 0
    # 콤보 칭호
    if {_combo} >= 100:
        if {보유칭호::%{_p}%::콤보} is not true:
            set {보유칭호::%{_p}%::콤보} to true
            message "&8[&e 칭호 &8] &d새 칭호 획득! &f[&d콤보&f] &7— 100 연속 낚시 달성!" to {_p}
    # 레벨 칭호 (Lv.5부터 자동 획득)
    if {_lv} >= 5:
        if {보유칭호::%{_p}%::레벨} is not true:
            set {보유칭호::%{_p}%::레벨} to true
            message "&8[&e 칭호 &8] &e새 칭호 획득! &eLv.%{_lv}% &7— 현재 레벨이 표시됩니다!" to {_p}
    # 장인 칭호 (Lv.50)
    if {_lv} >= 50:
        if {보유칭호::%{_p}%::장인} is not true:
            set {보유칭호::%{_p}%::장인} to true
            message "&8[&e 칭호 &8] &6새 칭호 획득! &f[&6장인&f] &7— 낚시 레벨 50 달성!" to {_p}
            play sound "ui.toast.challenge_complete" with volume 1.0 and pitch 1.0 to {_p}
    # 만렙전설 칭호 (Lv.100)
    if {_lv} >= 100:
        if {보유칭호::%{_p}%::만렙전설} is not true:
            set {보유칭호::%{_p}%::만렙전설} to true
            set {_t} to text component from "&4&l⭐ %{_p}'s name%&4&l님이 &f[&4&l만렙의 전설&f] &4&l칭호를 획득했습니다!"
            set hover event of {_t} to a new hover event showing "&4&l만렙의 전설%nl%&7획득 조건: &f낚시 레벨 100 달성%nl%&7설명: &f낚시 레벨 100에 도달한 전설적인 어부"
            send component {_t} to all players
            send title "&4&l만렙의 전설" with subtitle "&7낚시 레벨 100에 도달한 전설적인 어부" to {_p} for 5 seconds with fade in 1 second and fade out 2 seconds
            play sound "ui.toast.challenge_complete" with volume 1.0 and pitch 0.5 to {_p}
            wait 5 ticks
            play sound "entity.ender_dragon.growl" with volume 0.5 and pitch 1.2 to {_p}
    # 레벨 칭호 장착 중이면 갱신 (data merge로 가벼움)
    if {장착칭호::%{_p}%} is "레벨":
        칭호태그업데이트({_p})
    # 신살자 칭호 (G등급 낚은 적 있으면)
    if {도감G등급::%{_p}%} is true:
        if {보유칭호::%{_p}%::신살자} is not true:
            set {보유칭호::%{_p}%::신살자} to true
            set {_t} to text component from "&4&l⚡ %{_p}'s name%&4&l님이 &f[&4&l神殺者&f] &4&l칭호를 획득했습니다!"
            set hover event of {_t} to a new hover event showing "&4&l神殺者%nl%&7획득 조건: &fG등급 물고기 낚기%nl%&7설명: &f바다의 신을 낚아올린 자, 전설이 되다."
            send component {_t} to all players
            send title "&4&l神殺者" with subtitle "&7바다의 신을 낚아올린 자, 전설이 되다." to {_p} for 5 seconds with fade in 1 second and fade out 2 seconds
            play sound "ui.toast.challenge_complete" with volume 1.0 and pitch 0.5 to {_p}
            wait 5 ticks
            play sound "entity.wither.spawn" with volume 0.3 and pitch 1.5 to {_p}
    # 콤보 리셋 시 콤보 칭호 제거
    if {_combo} < 100:
        if {보유칭호::%{_p}%::콤보} is true:
            delete {보유칭호::%{_p}%::콤보}
            if {장착칭호::%{_p}%} is "콤보":
                delete {장착칭호::%{_p}%}
                message "&8[&e 칭호 &8] &c콤보 칭호가 사라졌습니다..." to {_p}

# ===== /칭호 명령 + 선택 GUI + 어드민(부여/회수/생성) → Java(TitleGuiManager) 이관 =====
#   BlockShipPlugin이 /칭호(별칭 /clrgn) 등록. 장착/부여/회수는 titleequip/titlegrant/
#   titlerevoke(칭호_bridge.sk)로 {장착칭호}/{보유칭호} 권위 변수 갱신 위임. 생성=titledef.
#   GUI 슬롯 매핑({칭호GUI슬롯})·on inventory click 핸들러도 Java로 이관됨.

# ===== 채팅 포맷: [칭호] 닉네임: 메시지 =====
on chat:
    set {_titleId} to {장착칭호::%player%}
    if {_titleId} is set:
        # 레벨 칭호: 현재 레벨 숫자를 동적으로 표시
        if {_titleId} is "레벨":
            set {_lv} to {낚시레벨::%player%}
            if {_lv} is not set:
                set {_lv} to 1
            if {_lv} >= 50:
                set {_titleDisplay} to "&4&lLv.%{_lv}%"
            else if {_lv} >= 30:
                set {_titleDisplay} to "&c&lLv.%{_lv}%"
            else if {_lv} >= 20:
                set {_titleDisplay} to "&6&lLv.%{_lv}%"
            else:
                set {_titleDisplay} to "&e&lLv.%{_lv}%"
            set chat format to "%{_titleDisplay}% &f%player's name%&7: &f%message%"
            stop
        set {_titleName} to {칭호데이터::%{_titleId}%::이름}
        if {_titleName} is set:
            set chat format to "%{_titleName}% &f%player's name%&7: &f%message%"
            stop
    set chat format to "&f%player's name%&7: &f%message%"

# ===== 탭 자동완성 → Java(/칭호 tabComplete)로 이관됨 =====

# ===== 칭호 TextDisplay 업데이트 (Java 플러그인 호출) =====
# BlockShip 플러그인의 /titleupdate, /titlecombo, /titleremove 사용
# → HEX 그라데이션 지원, 깜빡임 없음, 서버 부하 최소화
function 칭호태그업데이트(p: player):
    set {_tag} to "title_%{_p}'s uuid%"
    set {_titleId} to {장착칭호::%{_p}%}
    set {_name} to {_p}'s name
    set {_tagTitle} to "%{_tag}%_t"
    set {_tagName} to "%{_tag}%_n"
    # 기존 애니메이션 항상 먼저 정지
    execute console command "titlestop %{_name}%"
    # 칭호 없으면 제거
    if {_titleId} is not set:
        execute console command "titleremove %{_name}% %{_tagTitle}% %{_tagName}%"
        stop
    # 서포터 칭호 → Java 애니메이션 (색상 흐르는 효과)
    if {_titleId} is "서포터":
        execute console command "titleanim %{_name}% %{_tagTitle}% %{_tagName}% supporter Supporter"
        stop
    # 신살자 칭호 → Java 애니메이션 (빨간 그라데이션)
    if {_titleId} is "신살자":
        execute console command "titleanim %{_name}% %{_tagTitle}% %{_tagName}% godslayer 神殺者"
        stop
    # 콤보 칭호 → Java 파스텔 그라데이션
    if {_titleId} is "콤보":
        set {_combo} to {낚시최대콤보::%{_p}%}
        if {_combo} is not set:
            set {_combo} to 0
        execute console command "titlecombo %{_name}% %{_tagTitle}% %{_tagName}% %{_combo}%"
        stop
    # 레벨 칭호
    if {_titleId} is "레벨":
        set {_lv} to {낚시레벨::%{_p}%}
        if {_lv} is not set:
            set {_lv} to 1
        if {_lv} >= 50:
            set {_title} to "&4&lLv.%{_lv}%"
        else if {_lv} >= 30:
            set {_title} to "&c&lLv.%{_lv}%"
        else if {_lv} >= 20:
            set {_title} to "&6&lLv.%{_lv}%"
        else:
            set {_title} to "&e&lLv.%{_lv}%"
    else if {_titleId} is "뉴비":
        set {_title} to "&a&l뉴비"
    else:
        set {_tn} to {칭호데이터::%{_titleId}%::이름}
        if {_tn} is not set:
            set {_tn} to {_titleId}
        set {_title} to "%{_tn}%"
    # & → @@ 치환 (Java에서 @@ → & 복원)
    set {_safeTitle} to {_title}
    replace all "&" with "@@" in {_safeTitle}
    execute console command "titleupdate %{_name}% %{_tagTitle}% %{_tagName}% %{_safeTitle}%"

# 콤보 변경 시 업데이트
function 콤보네임태그(p: player):
    if {장착칭호::%{_p}%} is "콤보":
        칭호태그업데이트({_p})

# ===== 쉬프트 누르면 칭호 숨김, 떼면 다시 표시 =====
# player is sneaking = 토글 이전 상태 (true = 방금 스니크 해제, false = 방금 스니크 시작)
on sneak toggle:
    loop passengers of player:
        if loop-entity is a text display:
            if player is sneaking:
                # 방금 스니크 해제 → 불투명 복원 (-1b = 기본 255)
                add nbt from "{text_opacity:-1b}" to nbt of loop-entity
            else:
                # 방금 스니크 시작 → 반투명 (50/255, 바닐라 스니크 닉 효과)
                add nbt from "{text_opacity:50b}" to nbt of loop-entity

# 사망 시 칭호 제거 + 리스폰 시 복원
on death of player:
    execute console command "titlestop %victim's name%"
    execute console command "kill @e[tag=title_%victim's uuid%_t]"
    execute console command "kill @e[tag=title_%victim's uuid%_n]"

on respawn:
    wait 10 ticks
    칭호태그업데이트(player)

# 월드 이동 시 칭호 재생성
on world change:
    execute console command "kill @e[tag=title_%player's uuid%_t]"
    execute console command "kill @e[tag=title_%player's uuid%_n]"
    wait 10 ticks
    칭호태그업데이트(player)

# 접속종료 시 정리
on quit:
    execute console command "titlestop %player's name%"
    execute console command "titleremove %player's name% title_%player's uuid%_t title_%player's uuid%_n"
    execute console command "kill @e[tag=title_%player's uuid%_t]"
    execute console command "kill @e[tag=title_%player's uuid%_n]"

# 서버 종료 시 모든 칭호 엔티티 정리
on unload:
    execute console command "kill @e[type=text_display,tag=!fishback]"
