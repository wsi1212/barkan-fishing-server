on load:
    # 지역 리스트는 Java RegionManager에서 /regionlistsync로 동기화
    # 여기서는 아무것도 안 함 (on load 순서 문제 방지)



    delete {regionguiblock::*}
    add grass block to {regionguiblock::*}
    add stone to {regionguiblock::*}
    add basalt to {regionguiblock::*}
    add netherrack to {regionguiblock::*}
    add sand to {regionguiblock::*}
    add cobblestone to {regionguiblock::*}
function regiondictionary(p: player, r: text):
    set {_raw::*} to get_fish({_r})
    # 환경 물고기 추가
    add get_dawn_fish({_r}) to {_raw::*}
    add get_night_fish({_r}) to {_raw::*}
    add get_rain_fish({_r}) to {_raw::*}
    add get_thunder_fish({_r}) to {_raw::*}
    # 지역별 시간/날씨 물고기도 도감에 표시
    loop {지역물고기목록::%{_r}%::낮::*}:
        add {물고기::%loop-value%} to {_raw::*}
    loop {지역물고기목록::%{_r}%::낮맑음::*}:
        add {물고기::%loop-value%} to {_raw::*}
    loop {지역물고기목록::%{_r}%::낮비::*}:
        add {물고기::%loop-value%} to {_raw::*}
    loop {지역물고기목록::%{_r}%::밤::*}:
        add {물고기::%loop-value%} to {_raw::*}
    loop {지역물고기목록::%{_r}%::밤맑음::*}:
        add {물고기::%loop-value%} to {_raw::*}
    loop {지역물고기목록::%{_r}%::밤비::*}:
        add {물고기::%loop-value%} to {_raw::*}
    # ===== 등급별 정렬 =====
    loop {_raw::*}:
        set {_fp::*} to split loop-value at "|"
        set {_sortGrade} to {_fp::4}
        if {_sortGrade} contains "~":
            set {_sgr::*} to split {_sortGrade} at "~"
            set {_sortGrade} to {_sgr::1}
        if {_sortGrade} is "E":
            add loop-value to {_gE::*}
        else if {_sortGrade} is "D":
            add loop-value to {_gD::*}
        else if {_sortGrade} is "C":
            add loop-value to {_gC::*}
        else if {_sortGrade} is "B":
            add loop-value to {_gB::*}
        else if {_sortGrade} is "A":
            add loop-value to {_gA::*}
        else if {_sortGrade} is "S":
            add loop-value to {_gS::*}
        else if {_sortGrade} is "S+":
            add loop-value to {_gSP::*}
        else if {_sortGrade} is "M":
            add loop-value to {_gM::*}
        else if {_sortGrade} is "L":
            add loop-value to {_gL::*}
        else if {_sortGrade} is "G":
            add loop-value to {_gG::*}
    # 등급 구분선 + 물고기 합치기
    set {_gradeNames::1} to "E"
    set {_gradeNames::2} to "D"
    set {_gradeNames::3} to "C"
    set {_gradeNames::4} to "B"
    set {_gradeNames::5} to "A"
    set {_gradeNames::6} to "S"
    set {_gradeNames::7} to "S+"
    set {_gradeNames::8} to "M"
    set {_gradeNames::9} to "L"
    set {_gradeNames::10} to "G"
    set {_gradeColors::1} to "&7"
    set {_gradeColors::2} to "&f"
    set {_gradeColors::3} to "&a"
    set {_gradeColors::4} to "&9"
    set {_gradeColors::5} to "&5"
    set {_gradeColors::6} to "&6"
    set {_gradeColors::7} to "&c"
    set {_gradeColors::8} to "&3"
    set {_gradeColors::9} to "&d"
    set {_gradeColors::10} to "&e"
    set {_gradeLists::1::*} to {_gE::*}
    set {_gradeLists::2::*} to {_gD::*}
    set {_gradeLists::3::*} to {_gC::*}
    set {_gradeLists::4::*} to {_gB::*}
    set {_gradeLists::5::*} to {_gA::*}
    set {_gradeLists::6::*} to {_gS::*}
    set {_gradeLists::7::*} to {_gSP::*}
    set {_gradeLists::8::*} to {_gM::*}
    set {_gradeLists::9::*} to {_gL::*}
    set {_gradeLists::10::*} to {_gG::*}
    loop integers from 1 to 10:
        if size of {_gradeLists::%loop-integer%::*} > 0:
            add {_gradeLists::%loop-integer%::*} to {_fishes::*}
    # 물고기 데이터를 플레이어 변수에 캐시 (페이지네이션용)
    delete {도감캐시::%{_p}%::*}
    set {도감캐시::%{_p}%::*} to {_fishes::*}
    set {도감지역::%{_p}%} to {_r}
    set {도감물고기페이지::%{_p}%} to 0
    도감페이지렌더({_p}, 0)

# ===== 도감 페이지 렌더링 (페이지네이션) =====
# 행0(0-8): 지역 선택 | 행1~4(9-44): 물고기 36개 | 행5(45-53): 하단 바
function 도감페이지렌더(p: player, page: number):
    set {_fishes::*} to {도감캐시::%{_p}%::*}
    set {_total} to size of {_fishes::*}
    set {_perPage} to 36
    set {_maxPage} to ceil({_total} / {_perPage}) - 1
    if {_maxPage} < 0:
        set {_maxPage} to 0
    if {_page} > {_maxPage}:
        set {_page} to {_maxPage}
    if {_page} < 0:
        set {_page} to 0
    set {도감물고기페이지::%{_p}%} to {_page}
    # 항상 6행 GUI (재오픈 플래그로 close 시 캐시 삭제 방지)
    set {도감재오픈::%{_p}%} to true
    open chest inventory with 6 rows named "&0지역별 물고기도감" to {_p}
    wait 1 tick
    delete {도감재오픈::%{_p}%}
    # 캐시 복원 (close 핸들러에서 삭제됐을 수 있으므로)
    set {도감물고기페이지::%{_p}%} to {_page}
    set {도감캐시::%{_p}%::*} to {_fishes::*}
    # 행0: 지역 선택
    도감지역바({_p})
    # 행5(45-53): 하단 바 — 전부 유리판
    loop integers from 45 to 53:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&f"
    # 하단 도감 메뉴로 돌아가기 (슬롯 48)
    set slot 48 of {_p}'s current inventory to barrier named "&c← 도감 메뉴"
    # 하단 페이지 정보 (슬롯 49 = 가운데)
    set slot 49 of {_p}'s current inventory to paper named "&e페이지 %{_page} + 1%/%{_maxPage} + 1%" with lore "&7총 %{_total}%종"
    # 하단 이전 페이지 (슬롯 45 = 맨 왼쪽)
    if {_page} > 0:
        set slot 45 of {_p}'s current inventory to arrow named "&e◀ 이전 페이지" with lore "&7클릭하여 이전 페이지"
    # 하단 다음 페이지 (슬롯 53 = 맨 오른쪽)
    if {_page} < {_maxPage}:
        set slot 53 of {_p}'s current inventory to arrow named "&e다음 페이지 ▶" with lore "&7클릭하여 다음 페이지"
    # 행1~4(슬롯 9~44)에 물고기 배치
    set {_startIdx} to {_page} * {_perPage}
    set {_slot} to 9
    loop integers from 1 to {_perPage}:
        set {_idx} to {_startIdx} + loop-integer
        if {_idx} > {_total}:
            stop loop
        set {_data} to {_fishes::%{_idx}%}
        set {_fp::*} to split {_data} at "|"
        set {_fname} to {_fp::1}
        set {_fgrade} to {_fp::4}
        set {_envText} to get_fish_env_text({_fname})
        set {_regionText} to get_fish_regions({_fname})
        if {도감최대::%{_fname}%::%{_p}%} is set:
            set {_docItem} to cod named "&f%{_fname}%" with lore "&7등급 &e: &f%{_fgrade}%" and "&7크기 &e: &f%{_fp::2}%~%{_fp::3}%cm" and "&7최대기록 &e: &f%{도감최대::%{_fname}%::%{_p}%}%cm" and "&7출현 &e: %{_envText}%" and "&7지역 &e: &f%{_regionText}%" and "&7첫 낚은날 &e: &f%{처음낚은날짜::%{_fname}%::%{_p}%}%"
            set {_mid} to 물고기모델ID({_fname})
            if {_mid} is not "":
                apply custom model data to {_docItem}:
                    strings: {_mid}
            set slot {_slot} of {_p}'s current inventory to {_docItem}
        else:
            set slot {_slot} of {_p}'s current inventory to coal block named "&c??? &8(%{_fgrade}%)" with lore "&7등급 &e: &f%{_fgrade}%" and "&7크기 &e: &f???~???cm" and "&7출현 &e: %{_envText}%" and "&7지역 &e: &f%{_regionText}%"
        add 1 to {_slot}

# ===== 도감 상단 지역 바 (슬롯 0~8) =====
function 도감지역바(p: player):
    set {_regionPage} to {도감페이지::%{_p}%}
    if {_regionPage} is not set:
        set {_regionPage} to 0
    # 통합 목록 생성 (길드 섬 제외)
    delete {_도감통합목록::*}
    loop {섬리스트::*}:
        if loop-value does not start with "길드섬_":
            add loop-value to {_도감통합목록::*}
    loop {지역리스트::*}:
        if loop-value does not start with "길드섬_":
            add loop-value to {_도감통합목록::*}
    set {_totalRegions} to size of {_도감통합목록::*}
    set {_maxRegionPage} to ceil({_totalRegions} / 6) - 1
    if {_maxRegionPage} < 0:
        set {_maxRegionPage} to 0
    # 슬롯 0: 지역 이전 페이지
    if {_regionPage} > 0:
        set slot 0 of {_p}'s current inventory to arrow named "&e◀ 이전 지역" with lore "&7클릭하여 이전 지역 목록"
    else:
        set slot 0 of {_p}'s current inventory to black stained glass pane named "&7◀"
    # 슬롯 7: 지역 다음 페이지
    if {_regionPage} < {_maxRegionPage}:
        set slot 7 of {_p}'s current inventory to arrow named "&e다음 지역 ▶" with lore "&7클릭하여 다음 지역 목록"
    else:
        set slot 7 of {_p}'s current inventory to black stained glass pane named "&7▶"
    # 슬롯 8: 등급별 도감 전환
    set slot 8 of {_p}'s current inventory to compass named "&a&l등급별 도감" with lore "&7클릭하여 등급별 도감으로 전환"
    set {_startR} to {_regionPage} * 6
    loop integers from 1 to 6:
        set {_rIdx} to {_startR} + loop-integer
        if {_도감통합목록::%{_rIdx}%} is set:
            set {_rId} to {_도감통합목록::%{_rIdx}%}
            set {_rDisplay} to regionDisplayName({_rId})
            set {_reqLv} to regionRequiredLevel({_rId})
            if {_reqLv} > 0:
                set slot loop-integer of {_p}'s current inventory to {regionguiblock::%loop-integer%} named "%{_rDisplay}%" with lore "&7ID: %{_rId}%" and "&7필요 레벨 &e: &fLv.%{_reqLv}%"
            else:
                set slot loop-integer of {_p}'s current inventory to {regionguiblock::%loop-integer%} named "%{_rDisplay}%" with lore "&7ID: %{_rId}%"
        else:
            set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
on inventory click:
    if player's current inventory's name is "&0지역별 물고기도감":
        cancel event
        set {_ci} to index of clicked slot
        # 슬롯 45 = 물고기 이전 페이지
        if {_ci} is 45:
            if {도감물고기페이지::%player%} > 0:
                set {_newPage} to {도감물고기페이지::%player%} - 1
                도감페이지렌더(player, {_newPage})
        # 슬롯 53 = 물고기 다음 페이지
        else if {_ci} is 53:
            set {_total} to size of {도감캐시::%player%::*}
            set {_maxPage} to ceil({_total} / 36) - 1
            if {도감물고기페이지::%player%} < {_maxPage}:
                set {_newPage} to {도감물고기페이지::%player%} + 1
                도감페이지렌더(player, {_newPage})
        # 슬롯 48 = 도감 메인 메뉴로 돌아가기
        else if {_ci} is 48:
            close player's inventory
            wait 1 tick
            도감메인GUI(player)
        # 슬롯 8 = 나침반 → 전체 도감으로 전환
        else if {_ci} is 8:
            wait 1 tick
            전체도감열기(player)
        # 슬롯 0 = 지역 이전 페이지
        else if {_ci} is 0:
            if {도감페이지::%player%} is set:
                if {도감페이지::%player%} > 0:
                    remove 1 from {도감페이지::%player%}
                    regiondictionary(player, {도감지역::%player%})
        # 슬롯 7 = 지역 다음 페이지
        else if {_ci} is 7:
            set {_totalR} to size of {지역리스트::*}
            add size of {섬리스트::*} to {_totalR}
            set {_maxRP} to ceil({_totalR} / 6) - 1
            if {도감페이지::%player%} is not set:
                set {도감페이지::%player%} to 0
            if {도감페이지::%player%} < {_maxRP}:
                add 1 to {도감페이지::%player%}
                regiondictionary(player, {도감지역::%player%})
        # 슬롯 1~6 = 지역 선택
        else if {_ci} >= 1:
            if {_ci} <= 6:
                set {_regionPage} to {도감페이지::%player%}
                if {_regionPage} is not set:
                    set {_regionPage} to 0
                set {_regionIdx} to {_regionPage} * 6 + {_ci}
                # 통합 목록에서 선택 (섬 먼저, 그 다음 독립지역)
                delete {_통합::*}
                loop {섬리스트::*}:
                    add loop-value to {_통합::*}
                loop {지역리스트::*}:
                    add loop-value to {_통합::*}
                if {_통합::%{_regionIdx}%} is set:
                    regiondictionary(player, {_통합::%{_regionIdx}%})
on inventory close:
    if event-inventory's name is "&0지역별 물고기도감":
        if {도감재오픈::%player%} is set:
            stop
        delete {도감페이지::%player%}
        delete {도감물고기페이지::%player%}
        delete {도감캐시::%player%::*}
        delete {도감지역::%player%}
on inventory click:
    if player's current inventory's name contains "메뉴":
        if player's current inventory's name does not contain "gui":
            cancel event
            if clicked slot is 14:
                wait 1 tick
                if {도감해금::%player%} is not true:
                    message "&8[&d 도감 &8] &c아직 도감이 해금되지 않았습니다. 튜토리얼을 진행해주세요." to player
                    stop
                도감메인GUI(player)
            else if clicked slot is 10:
                wait 1 tick
                openWorkbench(player)
            else if clicked slot is 12:
                wait 1 tick
                레벨선택GUI(player)
            else if clicked slot is 16:
                wait 1 tick
                openPartShop(player, "낚싯대")
            else if clicked slot is 20:
                wait 1 tick
                퀘스트저널GUI(player)
            else if clicked slot is 22:
                wait 1 tick
                openIcebox(player)
    else if player's current inventory's name contains "&0지역별":
        cancel event

command /메뉴:
    aliases: /apsb
    trigger:
        open chest inventory with 3 rows named "&0메뉴" to player
        loop 27 times:
            set {_slot} to (loop-iteration)-1
            set slot {_slot} of player's current inventory to {gui::메뉴::%{_slot}%}
        set slot 10 of player's current inventory to anvil named "&e&l장비 작업대" with lore "&7낚시 장비를 장착합니다." and "&7클릭하여 작업대 열기"
        set slot 12 of player's current inventory to nether star named "&e&l레벨 로드맵" with lore "&7낚시 레벨과 스킬을 확인합니다." and "&7클릭하여 레벨 로드맵 열기"
        set slot 14 of player's current inventory to bookshelf named "&d&l도감" with lore "&7발견한 물고기와 수집품을 확인합니다." and "&7클릭하여 도감 열기"
        set slot 16 of player's current inventory to emerald named "&e&l부품 상점" with lore "&7낚시 부품을 구매합니다." and "&7클릭하여 상점 열기"
        set slot 20 of player's current inventory to book named "&d&l퀘스트 목록" with lore "&7현재 진행 중인 퀘스트를 확인합니다." and "&7클릭하여 퀘스트 목록 열기"
        set slot 22 of player's current inventory to packed ice named "&b&l아이스박스" with lore "&7물고기를 신선하게 보관합니다." and "&7클릭하여 아이스박스 열기"

# ===== Shift+F = 메뉴 열기 (양손들기 대신) =====
on swap hand items:
    if player is sneaking:
        cancel event
        execute player command "/메뉴"

command /도감:
    aliases: /ehrka
    trigger:
        if {도감해금::%player%} is not true:
            message "&8[&d 도감 &8] &c아직 도감이 해금되지 않았습니다. 튜토리얼을 진행해주세요." to player
            stop
        도감메인GUI(player)

# ===== 전체 도감 (등급별 정렬) =====
function 전체도감열기(p: player):
    # {물고기::*} 에서 전체 물고기를 등급별로 분류
    delete {_gE::*}
    delete {_gD::*}
    delete {_gC::*}
    delete {_gB::*}
    delete {_gA::*}
    delete {_gS::*}
    delete {_gSP::*}
    delete {_gM::*}
    delete {_gL::*}
    delete {_gG::*}
    loop {물고기::*}:
        set {_fp::*} to split loop-value at "|"
        set {_grade} to {_fp::4}
        if {_grade} contains "~":
            set {_sg::*} to split {_grade} at "~"
            set {_grade} to {_sg::1}
        if {_grade} is "E":
            add loop-value to {_gE::*}
        else if {_grade} is "D":
            add loop-value to {_gD::*}
        else if {_grade} is "C":
            add loop-value to {_gC::*}
        else if {_grade} is "B":
            add loop-value to {_gB::*}
        else if {_grade} is "A":
            add loop-value to {_gA::*}
        else if {_grade} is "S":
            add loop-value to {_gS::*}
        else if {_grade} is "S+":
            add loop-value to {_gSP::*}
        else if {_grade} is "M":
            add loop-value to {_gM::*}
        else if {_grade} is "L":
            add loop-value to {_gL::*}
        else if {_grade} is "G":
            add loop-value to {_gG::*}
    delete {_allFish::*}
    add {_gE::*} to {_allFish::*}
    add {_gD::*} to {_allFish::*}
    add {_gC::*} to {_allFish::*}
    add {_gB::*} to {_allFish::*}
    add {_gA::*} to {_allFish::*}
    add {_gS::*} to {_allFish::*}
    add {_gSP::*} to {_allFish::*}
    add {_gM::*} to {_allFish::*}
    add {_gL::*} to {_allFish::*}
    add {_gG::*} to {_allFish::*}
    # 캐시에 저장
    delete {전체도감캐시::%{_p}%::*}
    set {전체도감캐시::%{_p}%::*} to {_allFish::*}
    set {전체도감페이지::%{_p}%} to 0
    전체도감렌더({_p}, 0)

function 전체도감렌더(p: player, page: number):
    set {_fishes::*} to {전체도감캐시::%{_p}%::*}
    set {_total} to size of {_fishes::*}
    set {_perPage} to 36
    set {_maxPage} to ceil({_total} / {_perPage}) - 1
    if {_maxPage} < 0:
        set {_maxPage} to 0
    if {_page} > {_maxPage}:
        set {_page} to {_maxPage}
    if {_page} < 0:
        set {_page} to 0
    set {전체도감페이지::%{_p}%} to {_page}
    set {전체도감재오픈::%{_p}%} to true
    open chest inventory with 6 rows named "&0전체 물고기도감" to {_p}
    wait 1 tick
    delete {전체도감재오픈::%{_p}%}
    set {전체도감페이지::%{_p}%} to {_page}
    set {전체도감캐시::%{_p}%::*} to {_fishes::*}
    # 하단 바 (슬롯 45~53)
    loop integers from 45 to 53:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&f"
    set slot 48 of {_p}'s current inventory to barrier named "&c← 도감 메뉴"
    set slot 49 of {_p}'s current inventory to paper named "&e페이지 %{_page} + 1%/%{_maxPage} + 1%" with lore "&7총 %{_total}%종"
    if {_page} > 0:
        set slot 45 of {_p}'s current inventory to arrow named "&e◀ 이전 페이지"
    if {_page} < {_maxPage}:
        set slot 53 of {_p}'s current inventory to arrow named "&e다음 페이지 ▶"
    # 상단 바 (슬롯 0~8) — 등급 필터 버튼 (페이지제)
    # 등급 페이지: 0 = E,D,C,B,A,S,S+ (7개) | 1 = M,L,G (3개)
    set {_gPage} to {전체도감등급페이지::%{_p}%}
    if {_gPage} is not set:
        set {_gPage} to 0
    loop integers from 0 to 6:
        set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
    if {_gPage} is 0:
        set slot 0 of {_p}'s current inventory to gray dye named "&7E" with lore "&7클릭하여 E등급만 보기"
        set slot 1 of {_p}'s current inventory to white dye named "&fD" with lore "&7클릭하여 D등급만 보기"
        set slot 2 of {_p}'s current inventory to lime dye named "&aC" with lore "&7클릭하여 C등급만 보기"
        set slot 3 of {_p}'s current inventory to light blue dye named "&bB" with lore "&7클릭하여 B등급만 보기"
        set slot 4 of {_p}'s current inventory to yellow dye named "&eA" with lore "&7클릭하여 A등급만 보기"
        set slot 5 of {_p}'s current inventory to orange dye named "&6S" with lore "&7클릭하여 S등급만 보기"
        set slot 6 of {_p}'s current inventory to red dye named "&cS+" with lore "&7클릭하여 S+등급만 보기"
        set slot 7 of {_p}'s current inventory to arrow named "&e다음 등급 ▶" with lore "&7M, L, G 등급 보기"
    else:
        set slot 0 of {_p}'s current inventory to arrow named "&e◀ 이전 등급" with lore "&7E~S+ 등급 보기"
        set slot 1 of {_p}'s current inventory to purple dye named "&5M" with lore "&7클릭하여 M등급만 보기"
        set slot 2 of {_p}'s current inventory to magenta dye named "&dL" with lore "&7클릭하여 L등급만 보기"
        set slot 3 of {_p}'s current inventory to nether star named "&4&lG" with lore "&7클릭하여 G등급만 보기"
    set slot 8 of {_p}'s current inventory to compass named "&a&l지역별 도감" with lore "&7클릭하여 지역별 도감으로 전환"
    # 물고기 배치 (슬롯 9~44 = 36개)
    set {_startIdx} to {_page} * {_perPage}
    set {_slot} to 9
    loop integers from 1 to {_perPage}:
        set {_idx} to {_startIdx} + loop-integer
        if {_idx} > {_total}:
            stop loop
        set {_data} to {_fishes::%{_idx}%}
        set {_fp::*} to split {_data} at "|"
        set {_fname} to {_fp::1}
        set {_fgrade} to {_fp::4}
        set {_envText} to get_fish_env_text({_fname})
        set {_regionText} to get_fish_regions({_fname})
        if {도감최대::%{_fname}%::%{_p}%} is set:
            set {_docItem} to cod named "&f%{_fname}%" with lore "&7등급 &e: &f%{_fgrade}%" and "&7크기 &e: &f%{_fp::2}%~%{_fp::3}%cm" and "&7최대기록 &e: &f%{도감최대::%{_fname}%::%{_p}%}%cm" and "&7출현 &e: %{_envText}%" and "&7지역 &e: &f%{_regionText}%" and "&7첫 낚은날 &e: &f%{처음낚은날짜::%{_fname}%::%{_p}%}%"
            set {_mid} to 물고기모델ID({_fname})
            if {_mid} is not "":
                apply custom model data to {_docItem}:
                    strings: {_mid}
            set slot {_slot} of {_p}'s current inventory to {_docItem}
        else:
            set slot {_slot} of {_p}'s current inventory to coal block named "&c??? &8(%{_fgrade}%)" with lore "&7등급 &e: &f%{_fgrade}%" and "&7크기 &e: &f???~???cm" and "&7출현 &e: %{_envText}%" and "&7지역 &e: &f%{_regionText}%"
        add 1 to {_slot}

# 전체 도감 클릭 핸들러
on inventory click:
    if player's current inventory's name is "&0전체 물고기도감":
        cancel event
        set {_ci} to index of clicked slot
        # 슬롯 48 = 도감 메인 메뉴로
        if {_ci} is 48:
            close player's inventory
            wait 1 tick
            도감메인GUI(player)
        # 슬롯 8 = 나침반 → 지역별 도감
        else if {_ci} is 8:
            wait 1 tick
            set {도감페이지::%player%} to 0
            regiondictionary(player, {지역리스트::1})
        # 슬롯 45 = 이전 페이지
        else if {_ci} is 45:
            if {전체도감페이지::%player%} > 0:
                전체도감렌더(player, {전체도감페이지::%player%} - 1)
        # 슬롯 53 = 다음 페이지
        else if {_ci} is 53:
            set {_total} to size of {전체도감캐시::%player%::*}
            set {_maxPage} to ceil({_total} / 36) - 1
            if {전체도감페이지::%player%} < {_maxPage}:
                전체도감렌더(player, {전체도감페이지::%player%} + 1)
        # 슬롯 0~7 = 등급 필터 + 페이지 전환
        else if {_ci} >= 0:
            if {_ci} <= 7:
                set {_gPage} to {전체도감등급페이지::%player%}
                if {_gPage} is not set:
                    set {_gPage} to 0
                # 등급 페이지 전환 버튼
                if {_gPage} is 0:
                    if {_ci} is 7:
                        # 다음 등급 페이지
                        set {전체도감등급페이지::%player%} to 1
                        전체도감렌더(player, {전체도감페이지::%player%})
                        stop
                else:
                    if {_ci} is 0:
                        # 이전 등급 페이지
                        set {전체도감등급페이지::%player%} to 0
                        전체도감렌더(player, {전체도감페이지::%player%})
                        stop
                # 등급 필터 매핑 (페이지별)
                set {_targetGrade} to ""
                if {_gPage} is 0:
                    set {_g0::0} to "E"
                    set {_g0::1} to "D"
                    set {_g0::2} to "C"
                    set {_g0::3} to "B"
                    set {_g0::4} to "A"
                    set {_g0::5} to "S"
                    set {_g0::6} to "S+"
                    set {_targetGrade} to {_g0::%{_ci}%}
                else:
                    set {_g1::1} to "M"
                    set {_g1::2} to "L"
                    set {_g1::3} to "G"
                    set {_targetGrade} to {_g1::%{_ci}%}
                if {_targetGrade} is not "":
                    # 해당 등급 물고기만 필터링
                    delete {_filtered::*}
                    loop {물고기::*}:
                        set {_fp::*} to split loop-value at "|"
                        set {_g} to {_fp::4}
                        if {_g} contains "~":
                            set {_sg::*} to split {_g} at "~"
                            set {_g} to {_sg::1}
                        if {_g} is {_targetGrade}:
                            add loop-value to {_filtered::*}
                    delete {전체도감캐시::%player%::*}
                    set {전체도감캐시::%player%::*} to {_filtered::*}
                    set {전체도감페이지::%player%} to 0
                    전체도감렌더(player, 0)

on inventory close:
    if event-inventory's name is "&0전체 물고기도감":
        if {전체도감재오픈::%player%} is set:
            stop
        delete {전체도감페이지::%player%}
        delete {전체도감등급페이지::%player%}
        delete {전체도감캐시::%player%::*}

command /check:
    trigger:
        loop {지역리스트::*}:
            message "%loop-value%, %loop-index%" to player