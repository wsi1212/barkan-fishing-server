# ===========================================================================
# 메뉴.sk — /메뉴 허브 + 도감 진입점
# /메뉴 허브 GUI + 라우터 + Shift+F 단축키 → BlockShip MenuManager(Java)로 이관됨.
# 도감(5탭 컬렉션 + 물고기 지역별/전체) GUI → Java(com.blockship.dex.MainDexGui)로 이관됨.
#   데이터: FishLoader/PartLoader/RecipeLoader/MaterialLoader/RegionManager + PlayerData(dexDiscovery/fishRecords).
#   발견 기록(도감_*) write 함수는 도감.sk 에 유지. 이 파일은 진입점만.
# ===========================================================================

# /도감 — Java 메인 도감 GUI 진입 (maindex open 콘솔 위임)
command /도감:
    aliases: /ehrka
    trigger:
        execute console command "maindex open %player%"

command /check:
    trigger:
        loop {지역리스트::*}:
            message "%loop-value%, %loop-index%" to player