on load:
    delete {지역리스트::*}
    add "갈매기바위" to {지역리스트::*}
    add "바르칸물길" to {지역리스트::*}
    add "바르칸동굴" to {지역리스트::*}
    add "lavatest" to {지역리스트::*}



    delete {regionguiblock::*}
    add grass block to {regionguiblock::*}
    add stone to {regionguiblock::*}
    add basalt to {regionguiblock::*}
function regiondictionary(p: player, r: text):
    set {_raw::*} to get_fish({_r})
    # 환경 물고기 추가
    add get_dawn_fish({_r}) to {_raw::*}
    add get_night_fish({_r}) to {_raw::*}
    add get_rain_fish({_r}) to {_raw::*}
    add get_thunder_fish({_r}) to {_raw::*}
    # 지역별 시간/날씨 물고기도 도감에 표시
    loop {지역물고기목록::%{_r}%::낮::*}:
        add {물고기::%loop-value%} to {_raw::*}
    loop {지역물고기목록::%{_r}%::낮맑음::*}:
        add {물고기::%loop-value%} to {_raw::*}
    loop {지역물고기목록::%{_r}%::낮비::*}:
        add {물고기::%loop-value%} to {_raw::*}
    loop {지역물고기목록::%{_r}%::밤::*}:
        add {물고기::%loop-value%} to {_raw::*}
    loop {지역물고기목록::%{_r}%::밤맑음::*}:
        add {물고기::%loop-value%} to {_raw::*}
    loop {지역물고기목록::%{_r}%::밤비::*}:
        add {물고기::%loop-value%} to {_raw::*}
    # ===== 등급별 정렬 =====
    loop {_raw::*}:
        set {_fp::*} to split loop-value at "|"
        set {_sortGrade} to {_fp::4}
        if {_sortGrade} contains "~":
            set {_sgr::*} to split {_sortGrade} at "~"
            set {_sortGrade} to {_sgr::1}
        if {_sortGrade} is "E":
            add loop-value to {_gE::*}
        else if {_sortGrade} is "D":
            add loop-value to {_gD::*}
        else if {_sortGrade} is "C":
            add loop-value to {_gC::*}
        else if {_sortGrade} is "B":
            add loop-value to {_gB::*}
        else if {_sortGrade} is "A":
            add loop-value to {_gA::*}
        else if {_sortGrade} is "S":
            add loop-value to {_gS::*}
        else if {_sortGrade} is "S+":
            add loop-value to {_gSP::*}
        else if {_sortGrade} is "M":
            add loop-value to {_gM::*}
        else if {_sortGrade} is "L":
            add loop-value to {_gL::*}
        else if {_sortGrade} is "G":
            add loop-value to {_gG::*}
    # 등급 구분선 + 물고기 합치기
    set {_gradeNames::1} to "E"
    set {_gradeNames::2} to "D"
    set {_gradeNames::3} to "C"
    set {_gradeNames::4} to "B"
    set {_gradeNames::5} to "A"
    set {_gradeNames::6} to "S"
    set {_gradeNames::7} to "S+"
    set {_gradeNames::8} to "M"
    set {_gradeNames::9} to "L"
    set {_gradeNames::10} to "G"
    set {_gradeColors::1} to "&7"
    set {_gradeColors::2} to "&f"
    set {_gradeColors::3} to "&a"
    set {_gradeColors::4} to "&9"
    set {_gradeColors::5} to "&5"
    set {_gradeColors::6} to "&6"
    set {_gradeColors::7} to "&c"
    set {_gradeColors::8} to "&3"
    set {_gradeColors::9} to "&d"
    set {_gradeColors::10} to "&e"
    set {_gradeLists::1::*} to {_gE::*}
    set {_gradeLists::2::*} to {_gD::*}
    set {_gradeLists::3::*} to {_gC::*}
    set {_gradeLists::4::*} to {_gB::*}
    set {_gradeLists::5::*} to {_gA::*}
    set {_gradeLists::6::*} to {_gS::*}
    set {_gradeLists::7::*} to {_gSP::*}
    set {_gradeLists::8::*} to {_gM::*}
    set {_gradeLists::9::*} to {_gL::*}
    set {_gradeLists::10::*} to {_gG::*}
    loop integers from 1 to 10:
        set {_gn} to {_gradeNames::%loop-integer%}
        set {_gc} to {_gradeColors::%loop-integer%}
        if size of {_gradeLists::%loop-integer%::*} > 0:
            add "SEP|%{_gc}%%{_gn}%등급" to {_fishes::*}
            add {_gradeLists::%loop-integer%::*} to {_fishes::*}
    # GUI 열기
    set {_total} to size of {_fishes::*}
    set {_rows} to ceil(({_total} + 9) / 9)
    if {_rows} < 2:
        set {_rows} to 2
    if {_rows} > 6:
        set {_rows} to 6
    open chest inventory with {_rows} rows named "&0지역별 물고기도감" to {_p}
    set {_slot} to 9
    loop {_fishes::*}:
        if {_slot} >= {_rows} * 9:
            stop loop
        set {_data} to loop-value
        if {_data} starts with "SEP|":
            # 등급 구분선
            replace all "SEP|" with "" in {_data}
            set slot {_slot} of {_p}'s current inventory to orange stained glass pane named "%{_data}%"
        else:
            set {_fp::*} to split {_data} at "|"
            set {_fname} to {_fp::1}
            set {_fgrade} to {_fp::4}
            set {_envText} to get_fish_env_text({_fname})
            if {도감최대::%{_fname}%::%{_p}%} is set:
                set slot {_slot} of {_p}'s current inventory to cod named "&f%{_fname}%" with lore "&7등급 &e: &f%{_fgrade}%" and "&7크기 &e: &f%{_fp::2}%~%{_fp::3}%cm" and "&7최대기록 &e: &f%{도감최대::%{_fname}%::%{_p}%}%cm" and "&7출현 &e: %{_envText}%" and "&7첫 낚은날 &e: &f%{처음낚은날짜::%{_fname}%::%{_p}%}%"
            else:
                set slot {_slot} of {_p}'s current inventory to coal block named "&c??? &8(%{_fgrade}%)" with lore "&7등급 &e: &f%{_fgrade}%" and "&7크기 &e: &f???~???cm" and "&7출현 &e: %{_envText}%"
        add 1 to {_slot}

function regiondictionarygui(p: player):
    set slot 8 of {_p}'s current inventory to compass named "&a&l지역 검색"
    set slot 0 of {_p}'s current inventory to black stained glass pane named "&e이전 페이지"
    set slot 7 of {_p}'s current inventory to black stained glass pane named "&e다음 페이지"
    loop {지역리스트::*}:
        set {_reqLv} to regionRequiredLevel({지역리스트::%loop-index%})
        if {_reqLv} > 0:
            set slot loop-iteration of {_p}'s current inventory to {regionguiblock::%loop-iteration%} named "%{지역리스트::%loop-index%}%" with lore "&7필요 레벨 &e: &fLv.%{_reqLv}%"
        else:
            set slot loop-iteration of {_p}'s current inventory to {regionguiblock::%loop-iteration%} named "%{지역리스트::%loop-index%}%"
on inventory click:
    if player's current inventory's name is "&0지역별 물고기도감":
        if clicked slot >= 0:
            if clicked slot <= 8:
                set {_slot} to clicked slot's index
                add {도감페이지::%player%} * 8 to {_slot}
                regiondictionary(player, {지역리스트::%{_slot}%})
                regiondictionarygui(player)
on inventory close:
    if player's current inventory's name is "&0지역별 물고기도감":
        delete {도감페이지::%player%}
on inventory click:
    if player's current inventory's name contains "메뉴":
        if player's current inventory's name does not contain "gui":
            cancel event
            if clicked slot is 14:
                wait 1 tick
                open chest inventory with 2 rows named "&0지역별 물고기도감" to player
                regiondictionary(player, {지역리스트::1})
                regiondictionarygui(player)
                set {도감페이지::%player%} to 0
            else if clicked slot is 10:
                wait 1 tick
                openWorkbench(player)
            else if clicked slot is 12:
                wait 1 tick
                opensellgui(player)
            else if clicked slot is 16:
                wait 1 tick
                openPartShop(player, "낚싯대")
            else if clicked slot is 20:
                wait 1 tick
                퀘스트저널GUI(player)
            else if clicked slot is 22:
                wait 1 tick
                openIcebox(player)
    else if player's current inventory's name contains "&0지역별":
        cancel event

command /메뉴:
    aliases: /apsb
    trigger:
        open chest inventory with 3 rows named "&0메뉴" to player
        loop 27 times:
            set {_slot} to (loop-iteration)-1
            set slot {_slot} of player's current inventory to {gui::메뉴::%{_slot}%}
        set slot 10 of player's current inventory to anvil named "&e&l장비 작업대" with lore "&7낚시 장비를 장착합니다." and "&7클릭하여 작업대 열기"
        set slot 12 of player's current inventory to gold ingot named "&e&l물고기 상점" with lore "&7잡은 물고기를 판매합니다." and "&7클릭하여 상점 열기"
        set slot 16 of player's current inventory to emerald named "&e&l부품 상점" with lore "&7낚시 부품을 구매합니다." and "&7클릭하여 상점 열기"
        set slot 20 of player's current inventory to book named "&d&l퀘스트 목록" with lore "&7현재 진행 중인 퀘스트를 확인합니다." and "&7클릭하여 퀘스트 목록 열기"
        set slot 22 of player's current inventory to packed ice named "&b&l아이스박스" with lore "&7물고기를 신선하게 보관합니다." and "&7클릭하여 아이스박스 열기"

# ===== Shift+F = 메뉴 열기 (양손들기 대신) =====
on swap hand items:
    if player is sneaking:
        cancel event
        execute player command "/메뉴"

command /check:
    trigger:
        loop {지역리스트::*}:
            message "%loop-value%, %loop-index%" to player