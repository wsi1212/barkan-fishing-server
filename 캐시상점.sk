# =========================================
# 캐시상점.sk
# 캐시 상점: 카테고리별 탭 페이지
# 추천 코인 상점: 게임플레이 아이템
# =========================================

# ===== 상점 데이터 초기화 =====
on load:
    delete {캐시상점::*}
    delete {캐시상점목록::*}

    # ===== 게임플레이 (추천코인+캐시) =====
    set {캐시상점::하락방지1} to "하락방지권 (Lv.6~10)|1|500|paper|&7+6~10 강화 하락 방지 1회|scroll:하락방지:1"
    set {캐시상점::하락방지2} to "하락방지권 (Lv.11~15)|2|1000|paper|&7+11~15 강화 하락 방지 1회|scroll:하락방지:2"
    set {캐시상점::하락방지3} to "하락방지권 (Lv.16~18)|3|2000|paper|&7+16~18 강화 하락 방지 1회|scroll:하락방지:3"
    set {캐시상점::하락방지4} to "하락방지권 (Lv.19~20)|4|3000|paper|&7+19~20 강화 하락 방지 1회|scroll:하락방지:4"
    set {캐시상점::강화확률상승} to "강화확률 상승 (+5%%)|2|1000|paper|&7다음 1회 강화 시 성공률 +5%%|scroll:강화확률상승"
    set {캐시상점::경험치2배} to "경험치 2배 (1시간)|2|1000|paper|&7구매 시 1시간 동안 경험치 2배|buff:경험치2배"
    set {캐시상점::길드부스터} to "길드 부스터|3|2000|paper|&7길드원 전원 경험치 1.5배 30분|buff:길드부스터"
    set {캐시상점::강화이전} to "강화이전 주문서|10|10000|paper|&7낚싯대 강화를 이전 (-3레벨)|scroll:강화이전"
    add "하락방지1" to {캐시상점목록::게임::*}
    add "하락방지2" to {캐시상점목록::게임::*}
    add "하락방지3" to {캐시상점목록::게임::*}
    add "하락방지4" to {캐시상점목록::게임::*}
    add "강화확률상승" to {캐시상점목록::게임::*}
    add "경험치2배" to {캐시상점목록::게임::*}
    add "길드부스터" to {캐시상점목록::게임::*}
    add "강화이전" to {캐시상점목록::게임::*}

    # ===== 배 스킨 =====
    set {캐시상점::배스킨_황금호} to "황금호|0|10000|gold_ingot|&6황금빛 장식의 호화 선박|skin:배:황금호"
    set {캐시상점::배스킨_유령선} to "유령선|0|10000|ghast_tear|&b반투명 유령 이펙트의 신비한 배|skin:배:유령선"
    set {캐시상점::배스킨_용선} to "용선|0|10000|blaze_powder|&c용머리 장식의 위엄 있는 배|skin:배:용선"
    add "배스킨_황금호" to {캐시상점목록::배스킨::*}
    add "배스킨_유령선" to {캐시상점목록::배스킨::*}
    add "배스킨_용선" to {캐시상점목록::배스킨::*}

    # ===== 낚시 이펙트 =====
    set {캐시상점::fx_황금빛} to "황금빛 폭발|0|1500|firework_star|&eS등급+ 금색 파티클|cosmetic:황금빛"
    set {캐시상점::fx_불꽃놀이} to "불꽃놀이|0|1500|firework_star|&c불꽃 파티클|cosmetic:불꽃놀이"
    set {캐시상점::fx_벚꽃} to "벚꽃 바람|0|1500|firework_star|&d분홍 꽃잎|cosmetic:벚꽃"
    set {캐시상점::fx_번개} to "번개 강타|0|2000|firework_star|&bA등급+ 번개 이펙트|cosmetic:번개"
    set {캐시상점::fx_눈꽃} to "눈꽃 결정|0|1500|firework_star|&f눈 결정 파티클|cosmetic:눈꽃"
    add "fx_황금빛" to {캐시상점목록::낚시이펙트::*}
    add "fx_불꽃놀이" to {캐시상점목록::낚시이펙트::*}
    add "fx_벚꽃" to {캐시상점목록::낚시이펙트::*}
    add "fx_번개" to {캐시상점목록::낚시이펙트::*}
    add "fx_눈꽃" to {캐시상점목록::낚시이펙트::*}

    # ===== 자랑 이펙트 =====
    set {캐시상점::fx_팡파레} to "팡파레|0|1000|firework_star|&e금색 파티클 + 사운드|cosmetic:팡파레"
    set {캐시상점::fx_무지개} to "무지개 오라|0|1500|firework_star|&d무지개 원형 파티클|cosmetic:무지개"
    set {캐시상점::fx_용오름} to "용오름|0|2000|firework_star|&c불기둥 상승|cosmetic:용오름"
    add "fx_팡파레" to {캐시상점목록::자랑이펙트::*}
    add "fx_무지개" to {캐시상점목록::자랑이펙트::*}
    add "fx_용오름" to {캐시상점목록::자랑이펙트::*}

    # ===== 오라 =====
    set {캐시상점::fx_불꽃오라} to "불꽃 오라|0|2000|blaze_powder|&c발 아래 불꽃|cosmetic:불꽃오라"
    set {캐시상점::fx_물방울오라} to "물방울 오라|0|2000|prismarine_crystals|&b주변 물방울|cosmetic:물방울오라"
    set {캐시상점::fx_별빛오라} to "별빛 오라|0|2000|glowstone_dust|&e머리 위 별빛|cosmetic:별빛오라"
    add "fx_불꽃오라" to {캐시상점목록::오라::*}
    add "fx_물방울오라" to {캐시상점목록::오라::*}
    add "fx_별빛오라" to {캐시상점목록::오라::*}

    # ===== 날개 =====
    set {캐시상점::fx_천사날개} to "천사 날개|0|5000|feather|&f하얀 깃털 파티클|cosmetic:천사날개"
    set {캐시상점::fx_악마날개} to "악마 날개|0|5000|coal|&4붉은 불꽃|cosmetic:악마날개"
    set {캐시상점::fx_나비날개} to "나비 날개|0|5000|amethyst_shard|&d보라+분홍|cosmetic:나비날개"
    set {캐시상점::fx_용날개} to "용 날개|0|8000|blaze_rod|&6주황+금색|cosmetic:용날개"
    add "fx_천사날개" to {캐시상점목록::날개::*}
    add "fx_악마날개" to {캐시상점목록::날개::*}
    add "fx_나비날개" to {캐시상점목록::날개::*}
    add "fx_용날개" to {캐시상점목록::날개::*}

    # ===== 칭호 =====
    set {캐시상점::특수칭호} to "프리미엄 칭호 팩|0|5000|name_tag|&d금색/무지개/불꽃 3종|cosmetic:칭호"
    set {캐시상점::프리미엄자랑} to "프리미엄 자랑|0|2000|firework_star|&e큰 물고기 자랑 특수 연출|cosmetic:프리미엄자랑"
    add "특수칭호" to {캐시상점목록::칭호::*}
    add "프리미엄자랑" to {캐시상점목록::칭호::*}

# ===== 헬퍼 =====
function 캐시상점데이터(id: text) :: texts:
    set {_data::*} to split {캐시상점::%{_id}%} at "|"
    return {_data::*}

# ===== 명령어 =====
command /캐시상점:
    aliases: /zotltkdwja
    trigger:
        캐시상점탭GUI(player, "게임")

command /추천상점:
    aliases: /cnchstkdwja
    trigger:
        캐시상점코인GUI(player)

command /프리미엄상점 [<text>]:
    aliases: /vmflaldjtkdwja
    trigger:
        if arg-1 is "추천":
            캐시상점코인GUI(player)
        else:
            캐시상점탭GUI(player, "게임")

on tab complete of "/프리미엄상점":
    set tab completions for position 1 to "추천"

# ===== 코인 상점 GUI =====
function 캐시상점코인GUI(p: player):
    open chest inventory with 4 rows named "&0추천 코인 상점" to {_p}
    wait 1 tick
    loop 9 times:
        set slot (loop-number - 1) of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 4 of {_p}'s current inventory to emerald named "&a&l추천 코인 상점" with lore "&e보유: &f%{추천코인::%{_p}%}%개"
    set {_slot} to 9
    loop {캐시상점목록::게임::*}:
        set {_id} to loop-value
        set {_d::*} to 캐시상점데이터({_id})
        set {_coinPrice} to {_d::2} parsed as number
        if {_coinPrice} > 0:
            set {_itemType} to {_d::4} parsed as item type
            delete {_lore::*}
            add {_d::5} to {_lore::*}
            add "" to {_lore::*}
            add "&a가격: &f%{_coinPrice}% 추천코인" to {_lore::*}
            set slot {_slot} of {_p}'s current inventory to 1 of {_itemType} named "&e%{_d::1}%" with lore {_lore::*}
            set {캐시상점GUI::%{_p}%::%{_slot}%} to "%{_id}%:coin"
            add 1 to {_slot}

on inventory click:
    if player's current inventory's name is "&0추천 코인 상점":
        cancel event
        set {_mapping} to {캐시상점GUI::%player%::%index of clicked slot%}
        if {_mapping} is set:
            set {_parts::*} to split {_mapping} at ":"
            캐시상점구매(player, {_parts::1}, "coin")

# ===== 캐시 상점 탭 GUI =====
function 캐시상점탭GUI(p: player, tab: text):
    set {_gui} to chest inventory with 6 rows named "&0캐시 상점"
    set {캐시상점탭::%{_p}%} to {_tab}
    # 배경
    loop integers from 0 to 53:
        set slot loop-integer of {_gui} to black stained glass pane named "&f"
    # 탭 목록
    set {_tabs::1} to "게임"
    set {_tabs::2} to "배스킨"
    set {_tabs::3} to "낚시이펙트"
    set {_tabs::4} to "자랑이펙트"
    set {_tabs::5} to "오라"
    set {_tabs::6} to "날개"
    set {_tabs::7} to "칭호"
    set {_tabName::게임} to "&b강화/버프"
    set {_tabName::배스킨} to "&6배 스킨"
    set {_tabName::낚시이펙트} to "&e낚시 이펙트"
    set {_tabName::자랑이펙트} to "&d자랑 이펙트"
    set {_tabName::오라} to "&c오라"
    set {_tabName::날개} to "&f날개"
    set {_tabName::칭호} to "&5칭호"
    set {_tabIcon::게임} to anvil
    set {_tabIcon::배스킨} to oak boat
    set {_tabIcon::낚시이펙트} to fishing rod
    set {_tabIcon::자랑이펙트} to golden apple
    set {_tabIcon::오라} to blaze powder
    set {_tabIcon::날개} to elytra
    set {_tabIcon::칭호} to name tag
    # 행1: 탭 (슬롯 1~7)
    set {_tSlot} to 1
    loop 7 times:
        set {_tKey} to {_tabs::%loop-number%}
        set {_tIcon} to {_tabIcon::%{_tKey}%}
        if {_tKey} is {_tab}:
            set slot {_tSlot} of {_gui} to 1 of {_tIcon} named "&a&l▶ %{_tabName::%{_tKey}%}%" with lore "&7현재 탭"
        else:
            set slot {_tSlot} of {_gui} to 1 of {_tIcon} named "&7%{_tabName::%{_tKey}%}%" with lore "&e클릭하여 전환"
        set {캐시상점GUI::%{_p}%::tab::%{_tSlot}%} to {_tKey}
        add 1 to {_tSlot}
    # 슬롯 0: 잔액 + 코인
    set {_cash} to {캐시::%{_p}%}
    if {_cash} is not set:
        set {_cash} to 0
    set {_coin} to {추천코인::%{_p}%}
    if {_coin} is not set:
        set {_coin} to 0
    set slot 0 of {_gui} to gold ingot named "&6&l내 잔액" with lore "&6캐시: &f%{_cash}%" and "&a추천 코인: &f%{_coin}%개" and "" and "&7/추천상점 &8→ 코인 상점"
    # 슬롯 8: 구분선
    set slot 8 of {_gui} to gray stained glass pane named "&f"
    # 행2~5: 아이템 (슬롯 9~44)
    # 먼저 슬롯 매핑 초기화
    delete {캐시상점GUI::%{_p}%::*}
    # 탭 매핑 다시 세팅
    set {_tSlot} to 1
    loop 7 times:
        set {_tKey} to {_tabs::%loop-number%}
        set {캐시상점GUI::%{_p}%::tab::%{_tSlot}%} to {_tKey}
        add 1 to {_tSlot}
    set {_slot} to 9
    loop {캐시상점목록::%{_tab}%::*}:
        set {_id} to loop-value
        set {_d::*} to 캐시상점데이터({_id})
        set {_name} to {_d::1}
        set {_cashPrice} to {_d::3} parsed as number
        set {_itemType} to {_d::4} parsed as item type
        set {_tag} to {_d::6}
        delete {_lore::*}
        add {_d::5} to {_lore::*}
        add "" to {_lore::*}
        set {_owned} to false
        if {_tag} contains "skin:":
            if {캐시외형::%{_p}%::%{_tag}%} is true:
                set {_owned} to true
        if {_tag} contains "cosmetic:":
            if {캐시외형::%{_p}%::%{_tag}%} is true:
                set {_owned} to true
        if {_owned} is true:
            add "&a✔ 보유 중" to {_lore::*}
            set slot {_slot} of {_gui} to 1 of {_itemType} named "&a%{_name}% &7(보유)" with lore {_lore::*}
        else:
            add "&6가격: &f%{_cashPrice}% 캐시" to {_lore::*}
            add "&e클릭하여 구매" to {_lore::*}
            set slot {_slot} of {_gui} to 1 of {_itemType} named "&e%{_name}%" with lore {_lore::*}
        set {캐시상점GUI::%{_p}%::%{_slot}%} to "%{_id}%:cash"
        add 1 to {_slot}
    # 행6: 하단 정보
    set slot 49 of {_gui} to emerald named "&a&l추천 코인 상점" with lore "&7클릭하여 코인 상점 열기"
    set {캐시상점GUI::%{_p}%::coinshop} to true
    open {_gui} to {_p}

# ===== 캐시 상점 클릭 =====
on inventory click:
    if player's current inventory's name is "&0캐시 상점":
        cancel event
        set {_ci} to index of clicked slot
        # 탭 클릭 (slot 1~7)
        if {_ci} >= 1:
            if {_ci} <= 7:
                set {_newTab} to {캐시상점GUI::%player%::tab::%{_ci}%}
                if {_newTab} is set:
                    close player's inventory
                    wait 1 tick
                    캐시상점탭GUI(player, {_newTab})
                    stop
        # 코인 상점 버튼 (slot 49)
        if {_ci} is 49:
            close player's inventory
            wait 1 tick
            캐시상점코인GUI(player)
            stop
        # 아이템 클릭 (slot 9~44)
        if {_ci} >= 9:
            if {_ci} <= 44:
                set {_mapping} to {캐시상점GUI::%player%::%{_ci}%}
                if {_mapping} is set:
                    set {_parts::*} to split {_mapping} at ":"
                    캐시상점구매(player, {_parts::1}, "cash")
                    # GUI 새로고침
                    close player's inventory
                    wait 2 ticks
                    set {_tab} to {캐시상점탭::%player%}
                    if {_tab} is not set:
                        set {_tab} to "게임"
                    캐시상점탭GUI(player, {_tab})

# ===== 구매 처리 =====
function 캐시상점구매(p: player, itemId: text, currency: text):
    set {_d::*} to 캐시상점데이터({_itemId})
    if {_d::1} is not set:
        message "&c아이템 데이터가 없습니다." to {_p}
        stop
    set {_name} to {_d::1}
    set {_coinPrice} to {_d::2} parsed as number
    set {_cashPrice} to {_d::3} parsed as number
    set {_tag} to {_d::6}

    # 영구 아이템 중복 구매 방지
    if {_tag} contains "skin:":
        if {캐시외형::%{_p}%::%{_tag}%} is true:
            message "&c이미 보유 중인 아이템입니다!" to {_p}
            stop
    if {_tag} contains "cosmetic:":
        if {캐시외형::%{_p}%::%{_tag}%} is true:
            message "&c이미 보유 중인 아이템입니다!" to {_p}
            stop

    # 가격 확인 + 차감
    if {_currency} is "coin":
        if {_coinPrice} <= 0:
            message "&c이 아이템은 추천 코인으로 구매할 수 없습니다." to {_p}
            stop
        if {추천코인::%{_p}%} < {_coinPrice}:
            message "&c추천 코인 부족! &7(필요: %{_coinPrice}%개, 보유: %{추천코인::%{_p}%}%개)" to {_p}
            stop
        subtract {_coinPrice} from {추천코인::%{_p}%}
        message "&8[&a 상점 &8] &e%{_name}% &7구매! &a(-%{_coinPrice}% 추천코인)" to {_p}
    else:
        if {캐시::%{_p}%} < {_cashPrice}:
            message "&c캐시 부족! &7(필요: %{_cashPrice}%, 보유: %{캐시::%{_p}%}%)" to {_p}
            stop
        subtract {_cashPrice} from {캐시::%{_p}%}
        message "&8[&6 상점 &8] &e%{_name}% &7구매! &6(-%{_cashPrice}% 캐시)" to {_p}

    # 아이템 지급
    if {_tag} contains "scroll:":
        set {_item} to 1 of paper
        delete {_lore::*}
        add {_d::5} to {_lore::*}
        add "" to {_lore::*}
        add "&8[%{_name}%]" to {_lore::*}
        add "&8%{_tag}%" to {_lore::*}
        set name of {_item} to "&b%{_name}%"
        set lore of {_item} to {_lore::*}
        if {_p} can hold {_item}:
            give {_item} to {_p}
        else:
            drop {_item} at {_p}'s location
            message "&7인벤토리 가득! 바닥에 떨어졌습니다." to {_p}
    else if {_tag} contains "buff:경험치2배":
        set {경험치2배::%{_p}%} to true
        set {경험치2배만료::%{_p}%} to now
        add 1 hour to {경험치2배만료::%{_p}%}
        message "&a1시간 동안 경험치 2배!" to {_p}
    else if {_tag} contains "buff:길드부스터":
        message "&a길드 부스터 활성화! &7(길드 시스템 연동 예정)" to {_p}
    else if {_tag} is "cosmetic:칭호":
        set {캐시외형::%{_p}%::%{_tag}%} to true
        set {보유칭호::%{_p}%::프리미엄골드} to true
        set {보유칭호::%{_p}%::프리미엄무지개} to true
        set {보유칭호::%{_p}%::프리미엄불꽃} to true
        message "&d프리미엄 칭호 3종 해금!" to {_p}
        message "&7  &6✦ Gold &8| &c무&6지&e개 &8| &c🔥 불꽃" to {_p}
        message "&7  /칭호 에서 장착하세요!" to {_p}
    else if {_tag} contains "skin:":
        set {캐시외형::%{_p}%::%{_tag}%} to true
        message "&d외형 해금! &e%{_name}%" to {_p}
    else if {_tag} contains "cosmetic:":
        set {캐시외형::%{_p}%::%{_tag}%} to true
        message "&d외형 해금! &e%{_name}%" to {_p}
        message "&7  /이펙트 에서 장착하세요!" to {_p}

    play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.5 to {_p}

# ===== OP 명령어 =====
command /캐시지급 <player> <integer>:
    permission: op
    trigger:
        add arg-2 to {캐시::%arg-1%}
        message "&8[&6 캐시 &8] &e%arg-1%&7에게 &6%arg-2%캐시&7 지급!" to player
        message "&8[&6 캐시 &8] &6%arg-2%캐시&7 지급! &7(보유: %{캐시::%arg-1%}%)" to arg-1

command /추천코인지급 <player> <integer>:
    permission: op
    trigger:
        add arg-2 to {추천코인::%arg-1%}
        message "&8[&a 코인 &8] &e%arg-1%&7에게 &a%arg-2%코인&7 지급!" to player
        message "&8[&a 코인 &8] &a%arg-2%코인&7 지급! &7(보유: %{추천코인::%arg-1%}%)" to arg-1

# ===== 잔액 확인 =====
command /캐시:
    aliases: /zotl
    trigger:
        message "&8━━━━━━━━━━━━━━━━━━━━" to player
        message "&6  캐시: &f%{캐시::%player%}%" to player
        message "&a  추천 코인: &f%{추천코인::%player%}%개" to player
        message "&8━━━━━━━━━━━━━━━━━━━━" to player
        message "&7  /캐시상점 &8| &7/추천상점" to player
