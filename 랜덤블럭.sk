command /랜덤블럭10:
    aliases: /fosejaqmffjr10
    permission: op
    trigger:
        # 기준: 내가 서있는 곳 "아래" 블럭
        set {_b1} to block below player

        # x+9, z+9 한 지점(= 10칸 범위의 반대 꼭짓점)
        set {_loc2} to location of {_b1}
        add 9 to x-coordinate of {_loc2}
        add 9 to z-coordinate of {_loc2}
        set {_b2} to block at {_loc2}

        # 10x10 (y는 동일) 범위를 랜덤 블럭으로 교체
        loop blocks between {_b1} and {_b2}:
            set loop-block to a random element out of all blocks

        send "&a[완료] &f아래 블럭 기준 x+10, z+10 범위를 랜덤 블럭으로 변경했습니다." to player