# =========================================
# 낚시미니게임.sk
# 낚시 타이밍 미니게임 (클릭 핸들러, 게이지 함수, 접속종료 정리)
# =========================================

# ===== 등급별 미니게임 파라미터 =====
# 반환: "존폭|속도(틱)|도주기본확률|도주증가량|좌우속도|변속패턴|스팟이동속도|연속횟수|방향전환"
# 좌우속도: 커서 이동 속도 배율 (100=기본, 높을수록 빠름)
# 변속패턴: 0=없음, 1=느린사인파, 2=빠른사인파, 3=계단식, 4=급변
# 스팟이동속도: 초록/노란 스팟이 일정 방향으로 이동하는 속도 (0=고정, 1~5)
# 연속횟수: 미니게임 연속 횟수 (1=기본)
# 방향전환: 커서 방향 반전 빈도 (0=없음, 값=평균 N칸 이동마다 방향 전환 판정, 낮을수록 자주)
function 미니게임파라미터(grade: text) :: text:
    if {_grade} is "E":
        return "10|4|30|5|250|0|0|1|0"
    else if {_grade} is "D":
        return "8|3|40|6|250|0|0|1|0"
    else if {_grade} is "C":
        return "7|3|50|8|250|1|0|1|0"
    else if {_grade} is "B":
        return "6|2|60|10|250|1|1|1|0"
    else if {_grade} is "A":
        return "5|2|70|13|250|2|1|1|12"
    else if {_grade} is "S":
        return "4|2|80|16|300|2|2|1|10"
    else if {_grade} is "S+":
        return "3|2|85|20|350|3|2|2|8"
    else if {_grade} is "M":
        return "2|2|90|25|400|3|3|2|6"
    else if {_grade} is "L":
        return "2|2|95|30|450|4|3|3|5"
    else if {_grade} is "G":
        # G등급은 카오스(5) 또는 유령(6) 패턴 랜덤
        set {_gPattern} to random integer between 5 and 6
        return "1|2|98|35|500|4|%{_gPattern}%|3|3"
    return "10|4|15|5|250|0|0|1|0"

# ===== 물고기별 커스텀 미니게임 패턴 =====
# 등급 기본값 대신 사용할 개별 파라미터 (같은 포맷)
# 포맷: "존폭|속도(틱)|도주기본확률|도주증가량|좌우속도|변속패턴|스팟이동속도|연속횟수|방향전환"
# 설정하지 않은 물고기는 등급 기본값 사용
function 물고기커스텀패턴(fishName: text) :: text:
    # --- G등급 커스텀 ---
    # 예시: if {_fishName} is "심연어":
    #     return "1|2|99|40|350|5|4|3|2"
    # --- 여기에 물고기별 커스텀 패턴 추가 ---
    return ""

# ===== 물고기별 커스텀 방향 시퀀스 =====
# 커서가 이동할 때마다 순서대로 읽어서 방향을 결정
# R=오른쪽, L=왼쪽. 시퀀스 끝나면 처음부터 반복
# 빈 문자열 반환 시 기본 벽반사+방향전환 간격 사용
# 예시: "RRRRRLLRRRRRRRLRR" = 오른쪽 쭉→갑자기 왼쪽 2번→다시 오른쪽 쭉→한번 틀고→오른쪽
function 물고기방향시퀀스(fishName: text) :: text:
    # --- 여기에 물고기별 커스텀 방향 시퀀스 추가 ---
    # 예시:
    # if {_fishName} is "심연어":
    #     return "RRRRRRLLRRRRRRRRLRRRRLLLLRRR"
    return ""

# ===== 크기 기반 난이도 보정 =====
# 절대 크기(cm) 기준으로 보정. 클수록 난이도 증가 (존폭 감소)
# 반환: 존폭 보정값 (0 ~ -4, 클수록 어려움)
function 물고기크기난이도(size: number) :: integer:
    if {_size} < 50:
        return 0
    set {_diff} to floor(({_size} - 50) / 50) + 1
    if {_diff} > 7:
        set {_diff} to 7
    return {_diff}

# ===== 물고기 등급별 난이도 =====
function 물고기난이도(grade: text) :: number:
    if {_grade} is "E":
        return 0
    else if {_grade} is "D":
        return 2
    else if {_grade} is "C":
        return 4
    else if {_grade} is "B":
        return 8
    else if {_grade} is "A":
        return 12
    else if {_grade} is "S":
        return 16
    else if {_grade} is "S+":
        return 20
    else if {_grade} is "M":
        return 24
    else if {_grade} is "L":
        return 28
    else if {_grade} is "G":
        return 32
    return 0

# ===== 변속 패턴 속도 배율 계산 =====
# 패턴별로 일관된 속도 변화를 줌 (렉과 구분 가능하도록)
# step: 현재 틱 카운트, pattern: 변속패턴 번호
# 반환: 속도 배율 (50~200, 100이 기본)
function 변속배율(step: integer, pattern: integer) :: integer:
    if {_pattern} is 0:
        return 100
    # 패턴 1: 느린 사인파 (20틱 주기, 80~120)
    if {_pattern} is 1:
        set {_phase} to mod({_step}, 20)
        if {_phase} < 5:
            return 90
        else if {_phase} < 10:
            return 110
        else if {_phase} < 15:
            return 120
        else:
            return 80
    # 패턴 2: 빠른 사인파 (12틱 주기, 70~140)
    if {_pattern} is 2:
        set {_phase} to mod({_step}, 12)
        if {_phase} < 3:
            return 80
        else if {_phase} < 6:
            return 130
        else if {_phase} < 9:
            return 70
        else:
            return 140
    # 패턴 3: 계단식 (4단계, 각 8틱, 60~160)
    if {_pattern} is 3:
        set {_phase} to mod({_step}, 32)
        if {_phase} < 8:
            return 70
        else if {_phase} < 16:
            return 130
        else if {_phase} < 24:
            return 60
        else:
            return 160
    # 패턴 4: 급변 (6단계, 각 5틱, 50~200)
    if {_pattern} is 4:
        set {_phase} to mod({_step}, 30)
        if {_phase} < 5:
            return 60
        else if {_phase} < 10:
            return 180
        else if {_phase} < 15:
            return 50
        else if {_phase} < 20:
            return 200
        else if {_phase} < 25:
            return 80
        else:
            return 150
    # 패턴 5: G등급 카오스 (일시정지→급가속→감속→반전급가속, 24틱 주기)
    if {_pattern} is 5:
        set {_phase} to mod({_step}, 24)
        if {_phase} < 3:
            return 30
        else if {_phase} < 6:
            return 250
        else if {_phase} < 10:
            return 40
        else if {_phase} < 13:
            return 300
        else if {_phase} < 16:
            return 50
        else if {_phase} < 19:
            return 200
        else if {_phase} < 22:
            return 35
        else:
            return 280
    # 패턴 6: G등급 유령 (가끔 완전 정지 후 순간 이동급 가속)
    if {_pattern} is 6:
        set {_phase} to mod({_step}, 20)
        if {_phase} < 8:
            return 25
        else if {_phase} < 10:
            return 400
        else if {_phase} < 15:
            return 50
        else:
            return 350
    return 100

# ===== 게이지 문자열 생성 (가변 폭) =====
# 우선순위: 커서 > 크리칸(노란) > 스윗스팟(초록/주황) > 빈칸
# spotState: 0=일반(초록), 1=전조/쿨타임(주황)
function 미니게임게이지(p: player, cursor: integer, zoneStart: integer, zoneEnd: integer, barWidth: integer, spotState: integer) :: text:
    set {_bar} to ""
    # 스팟 상태에 따른 색상
    if {_spotState} is 1:
        set {_spotColor} to "&c"
    else:
        set {_spotColor} to "&a"
    loop {_barWidth} times:
        set {_i} to loop-iteration - 1
        set {_ch} to "&7░"
        if {_i} >= {_zoneStart}:
            if {_i} <= {_zoneEnd}:
                set {_ch} to "%{_spotColor}%▓"
                # 크리칸이면 노란색 (전조 중엔 주황 유지)
                if {_spotState} is 0:
                    if {미니게임크리칸::%{_p}%::%{_i}%} is true:
                        set {_ch} to "&6▓"
        if {_i} is {_cursor}:
            set {_ch} to "&e█"
        set {_bar} to "%{_bar}%%{_ch}%"
    return "&f[ %{_bar}% &f]"

# ===== 미니게임 변수 정리 =====
function 미니게임정리(p: player):
    delete {미니게임::%{_p}%}
    delete {미니게임커서::%{_p}%}
    delete {미니게임결과::%{_p}%}
    delete {미니게임존시작::%{_p}%}
    delete {미니게임존끝::%{_p}%}
    delete {미니게임크리칸::%{_p}%::*}
    delete {미니게임크리티컬확률::%{_p}%}
    delete {미니게임도주확률::%{_p}%}
    delete {미니게임도주증가::%{_p}%}
    delete {미니게임연속현재::%{_p}%}
    delete {미니게임연속총::%{_p}%}
    send action bar "" to {_p}
    delete bossbar named "fishTimer_%{_p}'s uuid%"

# ===== 미니게임 중 낚싯대 재사용 방지 =====
on right click with fishing rod:
    if {미니게임::%player%} is 1:
        cancel event

# ===== 좌클릭 핸들러 (미니게임) =====
on left click:
    if {미니게임::%player%} is 1:
        cancel event
        set {_cursor} to {미니게임커서::%player%}
        # 스윗스팟 존 판정 (초록+노란 전체)
        if {_cursor} >= {미니게임존시작::%player%}:
            if {_cursor} <= {미니게임존끝::%player%}:
                # 크리칸(노란색) 히트 → 크리티컬 확정
                if {미니게임크리칸::%player%::%{_cursor}%} is true:
                    set {미니게임결과::%player%} to "크리티컬"
                    play sound "entity.player.levelup" with volume 0.5 and pitch 1.5 to player
                    stop
                # 일반칸(초록) 히트 → 일반 성공
                set {미니게임결과::%player%} to "성공"
                play sound "entity.experience_orb.pickup" with volume 0.5 and pitch 1.2 to player
                stop
        # 미스 - 도주 확률 판정
        play sound "block.note_block.bass" with volume 0.4 and pitch 0.5 to player
        set {_escapeChance} to {미니게임도주확률::%player%}
        if {_escapeChance} is set:
            chance of {_escapeChance}%:
                set {미니게임결과::%player%} to "도주"
                stop
        # 도주 실패 → 다음 미스 때 확률 증가 (최대 100%)
        add {미니게임도주증가::%player%} to {미니게임도주확률::%player%}
        if {미니게임도주확률::%player%} > 100:
            set {미니게임도주확률::%player%} to 100
        send "&c놓쳤다! &8(&7도주 확률: &c%{미니게임도주확률::%player%}%%%&8)" to player

# ===== 접속 종료 시 정리 =====
on quit:
    if {미니게임::%player%} is 1:
        미니게임정리(player)
