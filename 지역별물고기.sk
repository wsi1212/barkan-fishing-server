# =========================================
# 지역별물고기.sk
# fish.json에서 물고기 데이터를 로드하여 변수에 매핑
# 등급 범위: "이름|최소크기|최대크기|최소등급~최대등급"
# =========================================

on load:
    delete {물고기::*}
    delete {물고기지역::*}
    delete {물고기환경::*}
    delete {물고기이벤트::*}
    delete {지역물고기목록::*}
    delete {환경물고기::*}

    # fish.json 로드 (SkBee JSON)
    set {_json} to json from file "plugins/Skript/scripts/fish.json"
    if {_json} is not set:
        broadcast "&c[물고기] fish.json 로드 실패!"
        stop

    # JSON 배열 순회
    loop values of {_json}:
        set {_fish} to loop-value
        set {_name} to tag "name" of {_fish}
        set {_min} to tag "minSize" of {_fish}
        set {_max} to tag "maxSize" of {_fish}
        set {_grade} to tag "grade" of {_fish}
        set {_region} to tag "region" of {_fish}
        set {_time} to tag "time" of {_fish}
        set {_weather} to tag "weather" of {_fish}
        set {_event} to tag "event" of {_fish}

        # 물고기 데이터 문자열 (기존 포맷 호환)
        set {물고기::%{_name}%} to "%{_name}%|%{_min}%|%{_max}%|%{_grade}%"

        # 환경 정보 저장
        set {물고기환경::%{_name}%::시간} to {_time}
        set {물고기환경::%{_name}%::날씨} to {_weather}

        # 이벤트 메시지
        if {_event} is set:
            if "%{_event}%" is not "null":
                set {물고기이벤트::%{_name}%} to {_event}

        # 지역별 목록 구성
        if {_region} is "전체":
            # 환경 특수 물고기 — 시간/날씨로 분류
            if {_time} is "새벽":
                add {_name} to {환경물고기::새벽::*}
            else if {_time} is "밤":
                add {_name} to {환경물고기::밤::*}
            if {_weather} is "비":
                add {_name} to {환경물고기::비::*}
            else if {_weather} is "뇌우":
                add {_name} to {환경물고기::뇌우::*}
        else:
            # 일반 지역 물고기
            if {_time} is "전체":
                if {_weather} is "전체":
                    add {_name} to {지역물고기목록::%{_region}%::기본::*}
                else if {_weather} is "맑음":
                    add {_name} to {지역물고기목록::%{_region}%::맑음::*}
                else if {_weather} is "비":
                    add {_name} to {지역물고기목록::%{_region}%::비::*}
                else if {_weather} is "뇌우":
                    add {_name} to {지역물고기목록::%{_region}%::뇌우::*}
            else if {_time} is "낮":
                if {_weather} is "전체":
                    add {_name} to {지역물고기목록::%{_region}%::낮::*}
                else if {_weather} is "맑음":
                    add {_name} to {지역물고기목록::%{_region}%::낮맑음::*}
                else if {_weather} is "비":
                    add {_name} to {지역물고기목록::%{_region}%::낮비::*}
            else if {_time} is "밤":
                if {_weather} is "전체":
                    add {_name} to {지역물고기목록::%{_region}%::밤::*}
                else if {_weather} is "맑음":
                    add {_name} to {지역물고기목록::%{_region}%::밤맑음::*}
                else if {_weather} is "비":
                    add {_name} to {지역물고기목록::%{_region}%::밤비::*}
            else if {_time} is "이벤트":
                add {_name} to {지역물고기목록::%{_region}%::이벤트::*}

    broadcast "&a[물고기] fish.json 로드 완료! (%size of {물고기::*}%종)"

# ===== 지역별 기본 물고기 가져오기 =====
function get_fish(l: text) :: texts:
    # 기본 물고기 (시간/날씨 무관)
    loop {지역물고기목록::%{_l}%::기본::*}:
        add {물고기::%loop-value%} to {_리턴물고기::*}
    return {_리턴물고기::*}

# ===== 환경별 물고기 가져오기 (원양어선 지역 시간/날씨 대응) =====
function get_region_env_fish(region: text, time: text, weather: text) :: texts:
    # 낮 시간대
    if {_time} is "낮":
        loop {지역물고기목록::%{_region}%::낮::*}:
            add {물고기::%loop-value%} to {_list::*}
        if {_weather} is "맑음":
            loop {지역물고기목록::%{_region}%::낮맑음::*}:
                add {물고기::%loop-value%} to {_list::*}
        else if {_weather} is "비" or "뇌우":
            loop {지역물고기목록::%{_region}%::낮비::*}:
                add {물고기::%loop-value%} to {_list::*}
    # 밤 시간대
    else if {_time} is "밤":
        loop {지역물고기목록::%{_region}%::밤::*}:
            add {물고기::%loop-value%} to {_list::*}
        if {_weather} is "맑음":
            loop {지역물고기목록::%{_region}%::밤맑음::*}:
                add {물고기::%loop-value%} to {_list::*}
        else if {_weather} is "비" or "뇌우":
            loop {지역물고기목록::%{_region}%::밤비::*}:
                add {물고기::%loop-value%} to {_list::*}
    return {_list::*}

# ===== 새벽 전용 물고기 =====
function get_dawn_fish(region: text) :: texts:
    # 전역 새벽 물고기
    loop {환경물고기::새벽::*}:
        add {물고기::%loop-value%} to {_list::*}
    return {_list::*}

# ===== 밤 전용 물고기 =====
function get_night_fish(region: text) :: texts:
    # 전역 밤 물고기
    loop {환경물고기::밤::*}:
        add {물고기::%loop-value%} to {_list::*}
    return {_list::*}

# ===== 비 전용 물고기 =====
function get_rain_fish(region: text) :: texts:
    loop {환경물고기::비::*}:
        add {물고기::%loop-value%} to {_list::*}
    return {_list::*}

# ===== 뇌우 전용 물고기 =====
function get_thunder_fish(region: text) :: texts:
    loop {환경물고기::뇌우::*}:
        add {물고기::%loop-value%} to {_list::*}
    return {_list::*}

# ===== 물고기 환경 정보 텍스트 =====
function get_fish_env_text(fishName: text) :: text:
    set {_time} to {물고기환경::%{_fishName}%::시간}
    set {_weather} to {물고기환경::%{_fishName}%::날씨}
    if {_time} is not set:
        return "&f전체"
    if {_time} is "전체":
        if {_weather} is "전체":
            return "&f전체"
        else if {_weather} is "뇌우":
            return "&d뇌우"
        else if {_weather} is "비":
            return "&b비"
        else if {_weather} is "맑음":
            return "&e맑음"
    else if {_time} is "새벽":
        return "&e새벽"
    else if {_time} is "밤":
        if {_weather} is "전체":
            return "&9밤"
        else if {_weather} is "맑음":
            return "&9밤 &e(맑음)"
        else if {_weather} is "비":
            return "&9밤 &b(비)"
    else if {_time} is "낮":
        if {_weather} is "전체":
            return "&6낮"
        else if {_weather} is "맑음":
            return "&6낮 &e(맑음)"
        else if {_weather} is "비":
            return "&6낮 &b(비)"
    else if {_time} is "이벤트":
        return "&c이벤트"
    return "&f전체"
