    set {물고기환경::항구고등어::날씨} to "전체"

    set {물고기::화물선농어} to "화물선농어|30|65|D~C"
    set {물고기환경::화물선농어::시간} to "전체"
    set {물고기환경::화물선농어::날씨} to "전체"

    set {물고기::상선단잉어} to "상선단잉어|25|55|C~B"
    set {물고기환경::상선단잉어::시간} to "전체"
    set {물고기환경::상선단잉어::날씨} to "전체"

    set {물고기::밀수꾼의전리품} to "밀수꾼의전리품|40|80|B~A"
    set {물고기환경::밀수꾼의전리품::시간} to "밤"
    set {물고기환경::밀수꾼의전리품::날씨} to "전체"

    # 본섬 상단항구 보물낚시
    set {물고기::상단화물꼬리표} to "상단화물꼬리표|1|1|E"
    set {물고기환경::상단화물꼬리표::시간} to "전체"
    set {물고기환경::상단화물꼬리표::날씨} to "전체"

    # ===== 상단 양식장 물고기 (크기 범위 좁음, 등급 낮음) =====
    set {물고기::양식붕어} to "양식붕어|18|25|E"
    set {물고기환경::양식붕어::시간} to "전체"
    set {물고기환경::양식붕어::날씨} to "전체"

    set {물고기::양식잉어} to "양식잉어|30|42|E~D"
    set {물고기환경::양식잉어::시간} to "전체"
    set {물고기환경::양식잉어::날씨} to "전체"

    set {물고기::양식농어} to "양식농어|25|35|E~D"
    set {물고기환경::양식농어::시간} to "전체"
    set {물고기환경::양식농어::날씨} to "전체"

    set {물고기::양식숭어} to "양식숭어|35|48|D~C"
    set {물고기환경::양식숭어::시간} to "전체"
    set {물고기환경::양식숭어::날씨} to "전체"

    set {물고기::양식메기} to "양식메기|28|38|D~C"
    set {물고기환경::양식메기::시간} to "전체"
    set {물고기환경::양식메기::날씨} to "전체"

    # ===== 사막 상단부두 물고기 + 보물낚시 =====
    set {물고기::교단의인장} to "교단의인장|1|1|E"
    set {물고기환경::교단의인장::시간} to "전체"
    set {물고기환경::교단의인장::날씨} to "전체"

    set {물고기::상단고등어} to "상단고등어|20|45|E~D"
    set {물고기환경::상단고등어::시간} to "전체"
    set {물고기환경::상단고등어::날씨} to "전체"

    set {물고기::교역소농어} to "교역소농어|30|65|D~C"
    set {물고기환경::교역소농어::시간} to "전체"
    set {물고기환경::교역소농어::날씨} to "전체"

    set {물고기::사막상선단잉어} to "사막상선단잉어|25|55|C~B"
    set {물고기환경::사막상선단잉어::시간} to "전체"
    set {물고기환경::사막상선단잉어::날씨} to "전체"

    broadcast "&a[물고기] 로드 완료! (331종)"
    # Java가 regions.json의 customFish를 재동기화하도록 요청
    # (delete {지역물고기목록::*} 가 커스텀 sublist도 날렸기 때문)
    execute console command "regionresync"

# ===== 지역별 기본 물고기 가져오기 (부모 섬 상속 포함, 제외 물고기 필터링) =====
function get_fish(l: text) :: texts:
    loop {지역물고기목록::%{_l}%::기본::*}:
        if {지역물고기제외::%{_l}%::%loop-value%} is not set:
            add {물고기::%loop-value%} to {_리턴물고기::*}
    loop {지역물고기목록::%{_l}%::커스텀::*}:
        if {지역물고기제외::%{_l}%::%loop-value%} is not set:
            add {물고기::%loop-value%} to {_리턴물고기::*}
    # 부모 체인 전체 상속 (오아시스 → 사막 → 바르칸 모든 조상). 자식 지역의 제외 목록은 상속 fish에도 적용
    set {_cur} to {_l}
    loop 32 times:
        set {_pid} to {지역부모섬::%{_cur}%}
        if {_pid} is not set:
            stop loop
        loop {지역물고기목록::%{_pid}%::기본::*}:
            if {지역물고기제외::%{_l}%::%loop-value-2%} is not set:
                add {물고기::%loop-value-2%} to {_리턴물고기::*}
        loop {지역물고기목록::%{_pid}%::커스텀::*}:
            if {지역물고기제외::%{_l}%::%loop-value-2%} is not set:
                add {물고기::%loop-value-2%} to {_리턴물고기::*}
        set {_cur} to {_pid}
    return {_리턴물고기::*}

# ===== 환경별 물고기 가져오기 (부모 체인 전체 상속) =====
function get_region_env_fish(region: text, time: text, weather: text) :: texts:
    # 이 지역의 환경 물고기
    set {_list::*} to _get_env_fish_single({_region}, {_time}, {_weather})
    # 부모 체인 전체 환경 물고기 상속
    set {_cur} to {_region}
    loop 32 times:
        set {_pid} to {지역부모섬::%{_cur}%}
        if {_pid} is not set:
            stop loop
        set {_iList::*} to _get_env_fish_single({_pid}, {_time}, {_weather})
        add {_iList::*} to {_list::*}
        set {_cur} to {_pid}
    return {_list::*}

# 내부 헬퍼: 단일 지역의 환경 물고기
function _get_env_fish_single(region: text, time: text, weather: text) :: texts:
    if {_time} is "낮":
        loop {지역물고기목록::%{_region}%::낮::*}:
            add {물고기::%loop-value%} to {_list::*}
        if {_weather} is "맑음":
            loop {지역물고기목록::%{_region}%::낮맑음::*}:
                add {물고기::%loop-value%} to {_list::*}
        else if {_weather} is "비" or "뇌우":
            loop {지역물고기목록::%{_region}%::낮비::*}:
                add {물고기::%loop-value%} to {_list::*}
    else if {_time} is "밤":
        loop {지역물고기목록::%{_region}%::밤::*}:
            add {물고기::%loop-value%} to {_list::*}
        if {_weather} is "맑음":
            loop {지역물고기목록::%{_region}%::밤맑음::*}:
                add {물고기::%loop-value%} to {_list::*}
        else if {_weather} is "비" or "뇌우":
            loop {지역물고기목록::%{_region}%::밤비::*}:
                add {물고기::%loop-value%} to {_list::*}
    return {_list::*}

# ===== 새벽 전용 물고기 (지역 제외 필터 적용) =====
function get_dawn_fish(region: text) :: texts:
    loop {환경물고기::새벽::*}:
        if {지역물고기제외::%{_region}%::%loop-value%} is not set:
            add {물고기::%loop-value%} to {_list::*}
    return {_list::*}

