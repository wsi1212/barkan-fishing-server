# 물고기 데이터 — Java FishLoader가 fish.json에서 로드해 console 명령으로 push
# 데이터 위치: plugins/BlockShip/fish.json
# Sync 명령어: /fishsyncreset, /fishdefsync, /regionfishsync, /envfishsync (공간.sk에 정의)
#
# 이 파일은 함수만 들고 있음. 데이터 추가/삭제는:
#   - 인게임: /지역 설정 <지역> 물고기추가/삭제/초기화
#   - 직접 편집: plugins/BlockShip/fish.json 수정 후 /지역 리로드 (또는 서버 재시작)

on load:
    # 변수 초기화는 fishsyncreset이 처리. Java가 onEnable 시 syncToSkript 호출.
    # /sk reload 시 plugin이 살아있으니 regionresync로 데이터 복원.
    execute console command "regionresync"

# ===== 지역별 물고기 가져오기 (부모 섬 상속 포함) =====
function get_fish(l: text) :: texts:
    loop {지역물고기목록::%{_l}%::기본::*}:
        add {물고기::%loop-value%} to {_리턴물고기::*}
    # 부모 체인 상속
    set {_cur} to {_l}
    loop 32 times:
        set {_pid} to {지역부모섬::%{_cur}%}
        if {_pid} is not set:
            stop loop
        loop {지역물고기목록::%{_pid}%::기본::*}:
            add {물고기::%loop-value-2%} to {_리턴물고기::*}
        set {_cur} to {_pid}
    return {_리턴물고기::*}

# ===== 환경별 물고기 가져오기 (시간/날씨 sublist + 부모 체인) =====
function get_region_env_fish(region: text, time: text, weather: text) :: texts:
    set {_list::*} to _get_env_fish_single({_region}, {_time}, {_weather})
    set {_cur} to {_region}
    loop 32 times:
        set {_pid} to {지역부모섬::%{_cur}%}
        if {_pid} is not set:
            stop loop
        set {_iList::*} to _get_env_fish_single({_pid}, {_time}, {_weather})
        add {_iList::*} to {_list::*}
        set {_cur} to {_pid}
    return {_list::*}

# 내부 헬퍼: 단일 지역의 시간/날씨 sublist
function _get_env_fish_single(region: text, time: text, weather: text) :: texts:
    if {_time} is "낮":
        loop {지역물고기목록::%{_region}%::낮::*}:
            add {물고기::%loop-value%} to {_list::*}
        if {_weather} is "맑음":
            loop {지역물고기목록::%{_region}%::낮맑음::*}:
                add {물고기::%loop-value%} to {_list::*}
        else if {_weather} is "비" or "뇌우":
            loop {지역물고기목록::%{_region}%::낮비::*}:
                add {물고기::%loop-value%} to {_list::*}
    else if {_time} is "밤":
        loop {지역물고기목록::%{_region}%::밤::*}:
            add {물고기::%loop-value%} to {_list::*}
        if {_weather} is "맑음":
            loop {지역물고기목록::%{_region}%::밤맑음::*}:
                add {물고기::%loop-value%} to {_list::*}
        else if {_weather} is "비" or "뇌우":
            loop {지역물고기목록::%{_region}%::밤비::*}:
                add {물고기::%loop-value%} to {_list::*}
    return {_list::*}

# ===== 글로벌 환경 fish (새벽/밤/비/뇌우) =====
function get_dawn_fish(region: text) :: texts:
    loop {환경물고기::새벽::*}:
        add {물고기::%loop-value%} to {_list::*}
    return {_list::*}

function get_night_fish(region: text) :: texts:
    loop {환경물고기::밤::*}:
        add {물고기::%loop-value%} to {_list::*}
    return {_list::*}

function get_rain_fish(region: text) :: texts:
    loop {환경물고기::비::*}:
        add {물고기::%loop-value%} to {_list::*}
    return {_list::*}

function get_thunder_fish(region: text) :: texts:
    loop {환경물고기::뇌우::*}:
        add {물고기::%loop-value%} to {_list::*}
    return {_list::*}

# ===== 물고기 환경 정보 텍스트 =====
function get_fish_env_text(fishName: text) :: text:
    set {_time} to {물고기환경::%{_fishName}%::시간}
    set {_weather} to {물고기환경::%{_fishName}%::날씨}
    if {_time} is not set:
        return "&f전체"
    if {_time} is "전체":
        if {_weather} is "전체":
            return "&f전체"
        else if {_weather} is "뇌우":
            return "&d뇌우"
        else if {_weather} is "비":
            return "&b비"
        else if {_weather} is "맑음":
            return "&e맑음"
    else if {_time} is "새벽":
        return "&e새벽"
    else if {_time} is "밤":
        if {_weather} is "전체":
            return "&9밤"
        else if {_weather} is "맑음":
            return "&9밤 &e(맑음)"
        else if {_weather} is "비":
            return "&9밤 &b(비)"
    else if {_time} is "낮":
        if {_weather} is "전체":
            return "&6낮"
        else if {_weather} is "맑음":
            return "&6낮 &e(맑음)"
        else if {_weather} is "비":
            return "&6낮 &b(비)"
    else if {_time} is "이벤트":
        return "&c이벤트"
    return "&f전체"

# 물고기 이름으로 출현 지역 목록 반환 (쉼표 구분 텍스트)
function get_fish_regions(fishName: text) :: text:
    set {_regions} to ""
    loop {지역리스트::*}:
        set {_region} to loop-value
        loop {지역물고기목록::%{_region}%::기본::*}:
            if loop-value-2 is {_fishName}:
                if {_regions} is "":
                    set {_regions} to {_region}
                else:
                    set {_regions} to "%{_regions}%, %{_region}%"
        loop {지역물고기목록::%{_region}%::새벽::*}:
            if loop-value-2 is {_fishName}:
                if {_regions} does not contain {_region}:
                    if {_regions} is "":
                        set {_regions} to {_region}
                    else:
                        set {_regions} to "%{_regions}%, %{_region}%"
        loop {지역물고기목록::%{_region}%::밤::*}:
            if loop-value-2 is {_fishName}:
                if {_regions} does not contain {_region}:
                    if {_regions} is "":
                        set {_regions} to {_region}
                    else:
                        set {_regions} to "%{_regions}%, %{_region}%"
        loop {지역물고기목록::%{_region}%::비::*}:
            if loop-value-2 is {_fishName}:
                if {_regions} does not contain {_region}:
                    if {_regions} is "":
                        set {_regions} to {_region}
                    else:
                        set {_regions} to "%{_regions}%, %{_region}%"
        loop {지역물고기목록::%{_region}%::뇌우::*}:
            if loop-value-2 is {_fishName}:
                if {_regions} does not contain {_region}:
                    if {_regions} is "":
                        set {_regions} to {_region}
                    else:
                        set {_regions} to "%{_regions}%, %{_region}%"
    if {_regions} is "":
        return "&7알 수 없음"
    return {_regions}
