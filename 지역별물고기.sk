# 자동 생성됨 — fish.json 기반
# 수정하지 마세요. fish.json을 수정 후 generate-fish.py 실행

on load:
    delete {물고기::*}
    delete {물고기환경::*}
    delete {물고기이벤트::*}
    delete {지역물고기목록::*}
