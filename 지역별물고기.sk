    set {물고기환경::수맥의수호자::시간} to "전체"
    set {물고기환경::수맥의수호자::날씨} to "전체"
    add "수맥의수호자" to {지역물고기목록::오아시스::기본::*}

    set {물고기::이프리트의핵} to "이프리트의핵|180|350|G"
    set {물고기환경::이프리트의핵::시간} to "전체"
    set {물고기환경::이프리트의핵::날씨} to "전체"
    add "이프리트의핵" to {지역물고기목록::오아시스::기본::*}

