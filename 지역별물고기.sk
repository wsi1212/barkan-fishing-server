    set {물고기::사구미꾸라지} to "사구미꾸라지|5|14|E"
    set {물고기환경::사구미꾸라지::시간} to "전체"
    set {물고기환경::사구미꾸라지::날씨} to "전체"
    add "사구미꾸라지" to {지역물고기목록::붉은사막::기본::*}

    set {물고기::모래참붕어} to "모래참붕어|8|20|E~D"
    set {물고기환경::모래참붕어::시간} to "전체"
