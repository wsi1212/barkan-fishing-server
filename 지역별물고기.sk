    set {물고기::사구의망둥이} to "사구의망둥이|12|28|C~B"
    set {물고기환경::사구의망둥이::시간} to "전체"
    set {물고기환경::사구의망둥이::날씨} to "전체"
    add "사구의망둥이" to {지역물고기목록::붉은사막::기본::*}

    set {물고기::사구의비밀} to "사구의비밀|30|60|B~A"
