#E D C B A S S+ M L G
on load:
    delete {물고기::*}
    set {물고기::피라미} to "피라미|13|22.5|E" #한국 강
    set {물고기::블루길} to "블루길|19.1|41|E" #한국 강
    set {물고기::모래무지} to "모래무지|10|29.2|E" #한국 강
    set {물고기::망둥어} to "망둥어|15|30|E" #한국 강 , 바르칸 물길 사라짐

    set {물고기::붕어} to "붕어|10|48|D" #한국 강
    set {물고기::참붕어} to "참붕어|8|12.5|D" #한국 강
    set {물고기::미꾸라지} to "미꾸라지|16|20|D" #한국 강
    
    set {물고기::누치} to "누치|33|67|C" #한국 강
    set {물고기::잉어} to "잉어|31|120|C" #한국 강
    set {물고기::메기} to "메기|37|130|C" #한국 강

    set {물고기::꺽지} to "꺽지|15|20|B" #한국 강
    set {물고기::끄리} to "끄리|10|40|B" #한국 강
    set {물고기::동자개} to "동자개|20|30|B" #한국 강
    set {물고기::빠가사리} to "빠가사리|7|15|B" #한국 강
    set {물고기::숭어} to "숭어|50|100|B" #한국 강

    set {물고기::가물치} to "가물치|30|100|A" #한국 강
    set {물고기::쏘가리} to "쏘가리|20|30|A" #한국 강
    set {물고기::뱀장어} to "뱀장어|40|150|A" #한국 강
    set {물고기::농어} to "농어|50|100|A" #한국 강

    set {물고기::은어} to "은어|15|70|S" #한국 강/하구(소상)
    set {물고기::산천어} to "산천어|20|79|S" #한국 강(상류/계류)
    set {물고기::연어} to "연어|60|100|S" #한국 강(동해안 하천 소상)
    set {물고기::황복} to "황복|20|40|S" #한국 강/하구(기수역)
    set {물고기::황어} to "황어|10|50|S" #한국 강/하구(소상)
    set {물고기::열목어} to "열목어|30|70|S" #한국 강(보호종 컨셉)

    set {물고기::동굴피라미} to "동굴피라미|8|18.5|E" #동굴
    set {물고기::암벽송사리} to "암벽송사리|6|14.0|E" #동굴
    set {물고기::석회미꾸리} to "석회미꾸리|9|19.5|E" #동굴
    set {물고기::지하실치} to "지하실치|7|16.0|E" #동굴
    set {물고기::탄광피라미} to "탄광피라미|10|21.0|E" #동굴
    set {물고기::흑점송사리} to "흑점송사리|6|15.5|E" #동굴
    set {물고기::동굴붕어} to "동굴붕어|11|23.0|E" #동굴
    set {물고기::자갈잉어} to "자갈잉어|9|20.5|E" #동굴
    set {물고기::맹안망둥이} to "맹안망둥이|5|13.0|E" #동굴
    set {물고기::지하은어} to "지하은어|8|17.5|E" #동굴

    # ---- D (7종) : 조금 흔함 ----
    set {물고기::동굴빙어} to "동굴빙어|12|24.0|D" #동굴
    set {물고기::석회송어} to "석회송어|14|28.0|D" #동굴
    set {물고기::흑비늘피라미} to "흑비늘피라미|13|26.5|D" #동굴
    set {물고기::지하황어} to "지하황어|15|30.0|D" #동굴
    set {물고기::광산메기} to "광산메기|16|32.0|D" #동굴
    set {물고기::맹안갈치} to "맹안갈치|18|34.5|D" #동굴
    set {물고기::심층빙어} to "심층빙어|13|27.0|D" #동굴

    # ---- C (5종) : 중간 ----
    set {물고기::동굴비단잉어} to "동굴비단잉어|20|38.0|C" #동굴
    set {물고기::암흑송어} to "암흑송어|22|40.5|C" #동굴
    set {물고기::지저농어} to "지저농어|24|44.0|C" #동굴
    set {물고기::심연붕어} to "심연붕어|21|39.5|C" #동굴
    set {물고기::동굴철갑어} to "동굴철갑어|23|42.0|C" #동굴

    # ---- B (4종) : 희귀 ----
    set {물고기::심연메기} to "심연메기|30|55.0|B" #동굴
    set {물고기::흑수정잉어} to "흑수정잉어|28|52.5|B" #동굴
    set {물고기::광맥송어} to "광맥송어|27|50.0|B" #동굴
    set {물고기::동굴전기뱀장어} to "동굴전기뱀장어|32|60.0|B" #동굴

    # ---- A (3종) : 매우 희귀 ----
    set {물고기::암흑철갑상어} to "암흑철갑상어|45|85.0|A" #동굴
    set {물고기::심연흰장어} to "심연흰장어|40|78.0|A" #동굴
    set {물고기::지하왕농어} to "지하왕농어|50|90.0|A" #동굴

    # ---- S (1종) : 초희귀 ----
    set {물고기::심연왕메기} to "심연왕메기|70|130.0|S" #동굴

    # C
    set {물고기::재비늘어} to "재비늘어|18|33|C"
    set {물고기::홍탄어} to "홍탄어|20|36|C"
    set {물고기::용흔어} to "용흔어|22|40|C"

    # B
    set {물고기::흑요어} to "흑요어|26|49|B"
    set {물고기::연무어} to "연무어|29|54|B"
    set {물고기::화결어} to "화결어|32|60|B"

    # A
    set {물고기::홍련어} to "홍련어|42|80|A"
    set {물고기::흑열어} to "흑열어|46|88|A"

    # S
    set {물고기::화산수호자} to "화산수호자|60|112|S"
    set {물고기::홍련포식자} to "홍련포식자|66|124|S"

    # S+
    set {물고기::염} to "염|72|138|S+|30"
    set {물고기::흑점} to "흑점|78|148|S+|30"

    # M
    set {물고기::인페르노} to "인페르노|96|182|M|50"
    set {물고기::라그나로크} to "라그나로크|104|200|M|50"

function get_fish(l: text) :: texts:
    if {_l} is "바르칸물길":
        add {물고기::피라미} to {_리턴물고기::*}
        add {물고기::블루길} to {_리턴물고기::*}
        add {물고기::모래무지} to {_리턴물고기::*}

        add {물고기::붕어} to {_리턴물고기::*}
        add {물고기::참붕어} to {_리턴물고기::*}
        add {물고기::미꾸라지} to {_리턴물고기::*}

        add {물고기::누치} to {_리턴물고기::*}
        add {물고기::잉어} to {_리턴물고기::*}
        add {물고기::메기} to {_리턴물고기::*}

        add {물고기::꺽지} to {_리턴물고기::*}
        add {물고기::끄리} to {_리턴물고기::*}
        add {물고기::동자개} to {_리턴물고기::*}
        add {물고기::빠가사리} to {_리턴물고기::*}
        add {물고기::숭어} to {_리턴물고기::*}

        add {물고기::가물치} to {_리턴물고기::*}
        add {물고기::쏘가리} to {_리턴물고기::*}
        add {물고기::뱀장어} to {_리턴물고기::*}
        add {물고기::농어} to {_리턴물고기::*}
        
        add {물고기::은어} to {_리턴물고기::*}
        add {물고기::산천어} to {_리턴물고기::*}
        add {물고기::연어} to {_리턴물고기::*}
        add {물고기::황복} to {_리턴물고기::*}
        add {물고기::황어} to {_리턴물고기::*}
        add {물고기::열목어} to {_리턴물고기::*}

        return {_리턴물고기::*}
    else if {_l} is "바르칸동굴":
        # ---- E ----
        add {물고기::동굴피라미} to {_리턴물고기::*}
        add {물고기::암벽송사리} to {_리턴물고기::*}
        add {물고기::석회미꾸리} to {_리턴물고기::*}
        add {물고기::지하실치} to {_리턴물고기::*}
        add {물고기::탄광피라미} to {_리턴물고기::*}
        add {물고기::흑점송사리} to {_리턴물고기::*}
        add {물고기::동굴붕어} to {_리턴물고기::*}
        add {물고기::자갈잉어} to {_리턴물고기::*}
        add {물고기::맹안망둥이} to {_리턴물고기::*}
        add {물고기::지하은어} to {_리턴물고기::*}

        # ---- D ----
        add {물고기::동굴빙어} to {_리턴물고기::*}
        add {물고기::석회송어} to {_리턴물고기::*}
        add {물고기::흑비늘피라미} to {_리턴물고기::*}
        add {물고기::지하황어} to {_리턴물고기::*}
        add {물고기::광산메기} to {_리턴물고기::*}
        add {물고기::맹안갈치} to {_리턴물고기::*}
        add {물고기::심층빙어} to {_리턴물고기::*}

        # ---- C ----
        add {물고기::동굴비단잉어} to {_리턴물고기::*}
        add {물고기::암흑송어} to {_리턴물고기::*}
        add {물고기::지저농어} to {_리턴물고기::*}
        add {물고기::심연붕어} to {_리턴물고기::*}
        add {물고기::동굴철갑어} to {_리턴물고기::*}

        # ---- B ----
        add {물고기::심연메기} to {_리턴물고기::*}
        add {물고기::흑수정잉어} to {_리턴물고기::*}
        add {물고기::광맥송어} to {_리턴물고기::*}
        add {물고기::동굴전기뱀장어} to {_리턴물고기::*}

        # ---- A ----
        add {물고기::암흑철갑상어} to {_리턴물고기::*}
        add {물고기::심연흰장어} to {_리턴물고기::*}
        add {물고기::지하왕농어} to {_리턴물고기::*}

        # ---- S ----
        add {물고기::심연왕메기} to {_리턴물고기::*}    

        return {_리턴물고기::*}
    else if {_l} is "lavatest":
        # C
        add {물고기::재비늘어} to {_리턴물고기::*}
        add {물고기::홍탄어} to {_리턴물고기::*}
        add {물고기::용흔어} to {_리턴물고기::*}

        # B
        add {물고기::흑요어} to {_리턴물고기::*}
        add {물고기::연무어} to {_리턴물고기::*}
        add {물고기::화결어} to {_리턴물고기::*}

        # A
        add {물고기::홍련어} to {_리턴물고기::*}
        add {물고기::흑열어} to {_리턴물고기::*}

        # S
        add {물고기::화산수호자} to {_리턴물고기::*}
        add {물고기::홍련포식자} to {_리턴물고기::*}

        # S+
        add {물고기::염} to {_리턴물고기::*}
        add {물고기::흑점} to {_리턴물고기::*}

        # M
        add {물고기::인페르노} to {_리턴물고기::*}
        add {물고기::라그나로크} to {_리턴물고기::*}



        return {_리턴물고기::*}