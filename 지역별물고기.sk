    set {물고기::용암수맥어} to "용암수맥어|18|40|C~B"
    set {물고기환경::용암수맥어::시간} to "전체"
    set {물고기환경::용암수맥어::날씨} to "전체"
    add "용암수맥어" to {지역물고기목록::오아시스::기본::*}

    set {물고기::이프리트의핏줄} to "이프리트의핏줄|30|65|B~A"
    set {물고기환경::이프리트의핏줄::시간} to "전체"
    set {물고기환경::이프리트의핏줄::날씨} to "전체"
    add "이프리트의핏줄" to {지역물고기목록::오아시스::기본::*}

    set {물고기::심연수맥어} to "심연수맥어|50|100|A~S"
