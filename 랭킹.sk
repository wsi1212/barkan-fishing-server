# =========================================
# 랭킹.sk
# 개인 랭킹 / 주간 랭킹 / 길드 랭킹
# /랭킹 → 3버튼 메인 GUI → 상세 페이지
# =========================================

# ===== 주간 데이터 변수 =====
# {주간랭킹::대어::%player%} — 이번주 잡은 최대 크기 (cm)
# {주간랭킹::대어이름::%player%} — 그 물고기 이름
# {주간랭킹::고수::%player%} — 이번주 S등급 이상 잡은 횟수
# {주간랭킹::거상::%player%} — 이번주 판매 수익 합계
# {주간리셋날짜} — 마지막 리셋 날짜 (월요일 체크용)

# ===== /랭킹 명령어 =====
command /랭킹:
    aliases: /fodzld
    trigger:
        랭킹메인GUI(player)

# ===== 메인 GUI (3버튼) =====
function 랭킹메인GUI(p: player):
    open chest inventory with 3 rows named "&0랭킹" to {_p}
    wait 1 tick
    loop 27 times:
        set slot (loop-number - 1) of {_p}'s current inventory to black stained glass pane named "&f"
    # 개인 랭킹
    set slot 11 of {_p}'s current inventory to player head named "&e&l개인 랭킹" with lore "&7레벨, 최대콤보, 도감 달성률" and "" and "&7클릭하여 확인"
    # 주간 랭킹
    set slot 13 of {_p}'s current inventory to golden apple named "&6&l주간 랭킹" with lore "&7이번주의 대어왕 / 고수 / 거상" and "&7매주 월요일 초기화" and "" and "&7클릭하여 확인"
    # 길드 랭킹
    set slot 15 of {_p}'s current inventory to shield named "&b&l길드 랭킹" with lore "&7길드 레벨, 총 어획량 순위" and "" and "&7클릭하여 확인"

# ===== 메인 GUI 클릭 =====
on inventory click:
    if player's current inventory's name is "&0랭킹":
        cancel event
        set {_ci} to index of clicked slot
        if {_ci} is 11:
            랭킹개인GUI(player, "레벨")
        else if {_ci} is 13:
            랭킹주간GUI(player, "대어")
        else if {_ci} is 15:
            # 기존 길드 랭킹 GUI로 직접 연결 (Java 동기화 경유)
            make player execute command "/rlfem 랭킹 레벨"

# =========================================
# 개인 랭킹 (1열 탭: 레벨 / 콤보 / 돈)
# 길드 랭킹 UI 구조 참조: 1열 탭 버튼 + 아래 TOP 10
# =========================================
function 랭킹개인GUI(p: player, type: text):
    open chest inventory with 6 rows named "&0개인 랭킹" to {_p}
    wait 1 tick
    set {개인랭킹탭::%{_p}%} to {_type}
    # 1열: 탭 버튼 (길드 랭킹 패턴)
    if {_type} is "레벨":
        set slot 2 of {_p}'s current inventory to lime stained glass pane named "&a▶ 레벨 랭킹"
    else:
        set slot 2 of {_p}'s current inventory to gray stained glass pane named "&7레벨 랭킹" with lore "&7낚시 레벨 기준" and "&7클릭하여 전환"
    if {_type} is "콤보":
        set slot 4 of {_p}'s current inventory to lime stained glass pane named "&a▶ 콤보 랭킹"
    else:
        set slot 4 of {_p}'s current inventory to gray stained glass pane named "&7콤보 랭킹" with lore "&7최대 콤보 기준" and "&7클릭하여 전환"
    if {_type} is "돈":
        set slot 6 of {_p}'s current inventory to lime stained glass pane named "&a▶ 자산 랭킹"
    else:
        set slot 6 of {_p}'s current inventory to gray stained glass pane named "&7자산 랭킹" with lore "&7소지금 기준" and "&7클릭하여 전환"
    # 뒤로가기
    set slot 0 of {_p}'s current inventory to arrow named "&c뒤로가기"
    # 랭킹 데이터 빌드
    delete {_pool::*}
    delete {_poolName::*}
    loop {낚시이름::*}:
        set {_pn} to loop-index
        set {_poolName::%{_pn}%} to {낚시이름::%{_pn}%}
        if {_type} is "레벨":
            set {_lv} to {낚시레벨::%{_pn}%}
            if {_lv} is not set:
                set {_lv} to 1
            set {_exp} to {낚시레벨현재경험치::%{_pn}%}
            if {_exp} is not set:
                set {_exp} to 0
            set {_pool::%{_pn}%} to {_lv} * 1000000 + {_exp}
        else if {_type} is "콤보":
            set {_val} to {낚시최대콤보::%{_pn}%}
            if {_val} is set:
                if {_val} > 0:
                    set {_pool::%{_pn}%} to {_val}
        else if {_type} is "돈":
            set {_val} to {돈::%{_pn}%}
            if {_val} is set:
                if {_val} > 0:
                    set {_pool::%{_pn}%} to {_val}
    # TOP 10 표시 (slot 9~18)
    set {_slot} to 9
    set {_rank} to 1
    loop 10 times:
        set {_bestKey} to ""
        set {_bestVal} to -1
        loop {_pool::*}:
            if loop-value-2 > {_bestVal}:
                set {_bestVal} to loop-value-2
                set {_bestKey} to loop-index
        if {_bestKey} is "":
            exit loop
        set {_dispName} to {_poolName::%{_bestKey}%}
        if {_dispName} is not set:
            set {_dispName} to {_bestKey}
        # 표시값 포맷
        if {_type} is "레벨":
            set {_dispVal} to "&7Lv.%floor({_bestVal} / 1000000)%"
        else if {_type} is "콤보":
            set {_dispVal} to "&e%{_bestVal}%콤보"
        else:
            set {_dispVal} to "&e%{_bestVal}%원"
        if {_rank} is 1:
            set slot {_slot} of {_p}'s current inventory to gold block named "&6&l🏆 1등 — %{_dispName}%" with lore "&f%{_dispVal}%"
        else if {_rank} is 2:
            set slot {_slot} of {_p}'s current inventory to iron block named "&f&l🥈 2등 — %{_dispName}%" with lore "&f%{_dispVal}%"
        else if {_rank} is 3:
            set slot {_slot} of {_p}'s current inventory to copper block named "&c&l🥉 3등 — %{_dispName}%" with lore "&f%{_dispVal}%"
        else:
            set slot {_slot} of {_p}'s current inventory to paper named "&7%{_rank}%등 — %{_dispName}%" with lore "&f%{_dispVal}%"
        delete {_pool::%{_bestKey}%}
        add 1 to {_slot}
        add 1 to {_rank}
    # 내 기록 (slot 49)
    set slot 49 of {_p}'s current inventory to nether star named "&d&l내 기록" with lore "&7레벨: &fLv.%{낚시레벨::%{_p}%}%" and "&7최대콤보: &f%{낚시최대콤보::%{_p}%}%" and "&7소지금: &f%{돈::%{_p}%}%원"
    # 새로고침
    set slot 53 of {_p}'s current inventory to sunflower named "&e새로고침"

# ===== 개인 랭킹 클릭 =====
on inventory click:
    if player's current inventory's name is "&0개인 랭킹":
        cancel event
        set {_ci} to index of clicked slot
        if {_ci} is 0:
            랭킹메인GUI(player)
        else if {_ci} is 2:
            랭킹개인GUI(player, "레벨")
        else if {_ci} is 4:
            랭킹개인GUI(player, "콤보")
        else if {_ci} is 6:
            랭킹개인GUI(player, "돈")
        else if {_ci} is 53:
            set {_type} to {개인랭킹탭::%player%}
            if {_type} is not set:
                set {_type} to "레벨"
            랭킹개인GUI(player, {_type})

# =========================================
# 주간 랭킹 (1열 탭: 대어왕 / 고수 / 거상)
# =========================================
function 랭킹주간GUI(p: player, type: text):
    open chest inventory with 6 rows named "&0주간 랭킹" to {_p}
    wait 1 tick
    set {주간랭킹탭::%{_p}%} to {_type}
    # 1열: 탭 버튼
    if {_type} is "대어":
        set slot 2 of {_p}'s current inventory to lime stained glass pane named "&a▶ 대어왕"
    else:
        set slot 2 of {_p}'s current inventory to gray stained glass pane named "&7대어왕" with lore "&7이번주 최대 크기 물고기" and "&7클릭하여 전환"
    if {_type} is "고수":
        set slot 4 of {_p}'s current inventory to lime stained glass pane named "&a▶ 고수"
    else:
        set slot 4 of {_p}'s current inventory to gray stained glass pane named "&7고수" with lore "&7S등급 이상 잡은 횟수" and "&7클릭하여 전환"
    if {_type} is "거상":
        set slot 6 of {_p}'s current inventory to lime stained glass pane named "&a▶ 거상"
    else:
        set slot 6 of {_p}'s current inventory to gray stained glass pane named "&7거상" with lore "&7이번주 판매 수익 합계" and "&7클릭하여 전환"
    set slot 0 of {_p}'s current inventory to arrow named "&c뒤로가기"
    # 랭킹 데이터 빌드
    delete {_pool::*}
    loop {주간랭킹::%{_type}%::*}:
        set {_pool::%loop-index%} to loop-value
    # TOP 10 표시 (slot 9~18)
    set {_slot} to 9
    set {_rank} to 1
    loop 10 times:
        set {_bestKey} to ""
        set {_bestVal} to -1
        loop {_pool::*}:
            if loop-value-2 > {_bestVal}:
                set {_bestVal} to loop-value-2
                set {_bestKey} to loop-index
        if {_bestKey} is "":
            exit loop
        set {_dispName} to {낚시이름::%{_bestKey}%}
        if {_dispName} is not set:
            set {_dispName} to {_bestKey}
        # 표시값 포맷
        if {_type} is "대어":
            set {_fishName} to {주간랭킹::대어이름::%{_bestKey}%}
            if {_fishName} is not set:
                set {_fishName} to "?"
            set {_dispVal} to "&b%{_bestVal}%cm &8(%{_fishName}%)"
        else if {_type} is "고수":
            set {_dispVal} to "&a%{_bestVal}%마리"
        else:
            set {_dispVal} to "&e%{_bestVal}%원"
        if {_rank} is 1:
            set slot {_slot} of {_p}'s current inventory to gold block named "&6&l🏆 1등 — %{_dispName}%" with lore "&f%{_dispVal}%"
        else if {_rank} is 2:
            set slot {_slot} of {_p}'s current inventory to iron block named "&f&l🥈 2등 — %{_dispName}%" with lore "&f%{_dispVal}%"
        else if {_rank} is 3:
            set slot {_slot} of {_p}'s current inventory to copper block named "&c&l🥉 3등 — %{_dispName}%" with lore "&f%{_dispVal}%"
        else:
            set slot {_slot} of {_p}'s current inventory to paper named "&7%{_rank}%등 — %{_dispName}%" with lore "&f%{_dispVal}%"
        delete {_pool::%{_bestKey}%}
        add 1 to {_slot}
        add 1 to {_rank}
    # 내 주간 기록 (slot 49)
    set {_mySize} to {주간랭킹::대어::%{_p}%}
    if {_mySize} is not set:
        set {_mySize} to 0
    set {_mySGrade} to {주간랭킹::고수::%{_p}%}
    if {_mySGrade} is not set:
        set {_mySGrade} to 0
    set {_myIncome} to {주간랭킹::거상::%{_p}%}
    if {_myIncome} is not set:
        set {_myIncome} to 0
    set slot 49 of {_p}'s current inventory to nether star named "&d&l내 이번주 기록" with lore "&7대어: &b%{_mySize}%cm" and "&7S등급+: &a%{_mySGrade}%마리" and "&7수익: &e%{_myIncome}%원"
    set slot 53 of {_p}'s current inventory to sunflower named "&e새로고침"

# ===== 주간 랭킹 클릭 =====
on inventory click:
    if player's current inventory's name is "&0주간 랭킹":
        cancel event
        set {_ci} to index of clicked slot
        if {_ci} is 0:
            랭킹메인GUI(player)
        else if {_ci} is 2:
            랭킹주간GUI(player, "대어")
        else if {_ci} is 4:
            랭킹주간GUI(player, "고수")
        else if {_ci} is 6:
            랭킹주간GUI(player, "거상")
        else if {_ci} is 53:
            set {_type} to {주간랭킹탭::%player%}
            if {_type} is not set:
                set {_type} to "대어"
            랭킹주간GUI(player, {_type})

# =========================================
# 주간 데이터 수집 훅 (낚시/판매 시 호출)
# =========================================

# 물고기 잡았을 때 → 대어왕 + 고수 업데이트
function 주간랭킹_물고기(p: player, fishName: text, grade: text, size: number):
    # 대어왕: 최대 크기 갱신
    set {_curMax} to {주간랭킹::대어::%{_p}%}
    if {_curMax} is not set:
        set {_curMax} to 0
    if {_size} > {_curMax}:
        set {주간랭킹::대어::%{_p}%} to {_size}
        set {주간랭킹::대어이름::%{_p}%} to {_fishName}
    # 고수: S등급 이상 카운트
    if {_grade} is "S" or "S+" or "M" or "L" or "G":
        if {주간랭킹::고수::%{_p}%} is not set:
            set {주간랭킹::고수::%{_p}%} to 0
        add 1 to {주간랭킹::고수::%{_p}%}

# 판매했을 때 → 거상 업데이트
function 주간랭킹_판매(p: player, income: number):
    if {주간랭킹::거상::%{_p}%} is not set:
        set {주간랭킹::거상::%{_p}%} to 0
    add {_income} to {주간랭킹::거상::%{_p}%}

# =========================================
# 주간 리셋 (매시간 체크, 월요일이면 리셋)
# =========================================
every 1 hour:
    # 현재 요일 체크 (now를 문자열로 변환하여 요일 확인)
    set {_day} to "%now%"
    # 월요일 00~01시 사이에 리셋
    if {_day} contains "Mon":
        if {주간리셋완료} is not true:
            주간랭킹리셋()
            set {주간리셋완료} to true
    else:
        delete {주간리셋완료}

function 주간랭킹리셋():
    # 보상 지급 (리셋 전)
    주간랭킹보상지급()
    # 데이터 초기화
    delete {주간랭킹::대어::*}
    delete {주간랭킹::대어이름::*}
    delete {주간랭킹::고수::*}
    delete {주간랭킹::거상::*}
    broadcast "&8[&6 주간랭킹 &8] &e이번주 랭킹이 초기화되었습니다! 새로운 한 주가 시작됩니다!"

function 주간랭킹보상지급():
    # 대어왕 TOP 3
    주간랭킹카테고리보상("대어", "이번주의 대어왕")
    # 고수 TOP 3
    주간랭킹카테고리보상("고수", "이번주의 고수")
    # 거상 TOP 3
    주간랭킹카테고리보상("거상", "이번주의 거상")

function 주간랭킹카테고리보상(category: text, title: text):
    delete {_pool::*}
    loop {주간랭킹::%{_category}%::*}:
        set {_pool::%loop-index%} to loop-value
    # 1등
    set {_bestKey} to ""
    set {_bestVal} to -1
    loop {_pool::*}:
        if loop-value > {_bestVal}:
            set {_bestVal} to loop-value
            set {_bestKey} to loop-index
    if {_bestKey} is not "":
        # 1등 보상: 추천코인 2개
        add 2 to {추천코인::%{_bestKey}%}
        set {_name1} to {낚시이름::%{_bestKey}%}
        if {_name1} is not set:
            set {_name1} to {_bestKey}
        broadcast "&8[&6 주간랭킹 &8] &6%{_title}% 1위: &e%{_name1}% &7(추천코인 2개)"
        delete {_pool::%{_bestKey}%}
    # 2등
    set {_bestKey} to ""
    set {_bestVal} to -1
    loop {_pool::*}:
        if loop-value > {_bestVal}:
            set {_bestVal} to loop-value
            set {_bestKey} to loop-index
    if {_bestKey} is not "":
        add 1 to {추천코인::%{_bestKey}%}
        delete {_pool::%{_bestKey}%}
    # 3등
    set {_bestKey} to ""
    set {_bestVal} to -1
    loop {_pool::*}:
        if loop-value > {_bestVal}:
            set {_bestVal} to loop-value
            set {_bestKey} to loop-index
    if {_bestKey} is not "":
        add 1 to {추천코인::%{_bestKey}%}

# ===== OP 수동 리셋 =====
command /주간랭킹리셋:
    permission: op
    trigger:
        주간랭킹리셋()
        message "&a주간 랭킹이 수동 리셋되었습니다." to player
