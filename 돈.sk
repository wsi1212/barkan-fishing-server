options:
    bank_prefix: &8[&b 돈 &8] 
    bank_color_info: &f
    bank_color_hint: &7
    bank_color_good: &a
    bank_color_bad: &c
    bank_color_emph: &e

command /돈 [<text>] [<text>] [<text>]:
    aliases: /ehs
    trigger:
        # 기본값 보정 (none 방지)
        if {돈::%player%} is not set:
            set {돈::%player%} to 0

        # /돈
        if arg-1 is not set:
            message "{@bank_prefix} {@bank_color_info}%player's name%님의 잔액: {@bank_color_good}%{돈::%player%}%원" to player
            stop

        # /돈 설정 플레이어 금액 (온라인 플레이어만)
        else if arg-1 is "설정":
            if player is not op:
                message "{@bank_prefix} {@bank_color_bad}권한이 부족합니다." to player
                stop

            if arg-2 is not set:
                message "{@bank_prefix} {@bank_color_bad}플레이어를 입력해 주세요. {@bank_color_hint}(/돈 설정 <닉네임> <금액>)" to player
                stop

            if arg-3 is not set:
                message "{@bank_prefix} {@bank_color_bad}설정할 금액을 입력해 주세요. {@bank_color_hint}(/돈 설정 <닉네임> <금액>)" to player
                stop

            set {_amt} to arg-3 parsed as number
            if {_amt} is not set:
                message "{@bank_prefix} {@bank_color_bad}금액은 숫자만 입력해 주세요." to player
                stop
            if {_amt} < 0:
                message "{@bank_prefix} {@bank_color_bad}금액에 음수는 입력할 수 없습니다." to player
                stop

            delete {_target}
            loop all players:
                if loop-player's name is arg-2:
                    set {_target} to loop-player
                    stop loop

            if {_target} is not set:
                message "{@bank_prefix} {@bank_color_bad}존재하지 않는 플레이어입니다. {@bank_color_hint}(현재 접속 중인 플레이어만 설정 가능)" to player
                stop

            set {돈::%{_target}%} to {_amt}
            message "{@bank_prefix} {@bank_color_emph}관리자 &f%player's name%{@bank_color_emph}님이 잔액을 {@bank_color_good}%{_amt}%원{@bank_color_emph}으로 설정했습니다." to {_target}
            message "{@bank_prefix} {@bank_color_good}설정 완료! {@bank_color_info}%arg-2%{@bank_color_hint}님의 잔액을 {@bank_color_emph}%{_amt}%원{@bank_color_hint}으로 변경했습니다." to player
            stop

        # /돈 보내기|송금 플레이어 금액 (온라인 플레이어만)
        else if arg-1 is "보내기" or "송금":
            if arg-2 is not set:
                message "{@bank_prefix} {@bank_color_bad}보낼 플레이어를 입력해 주세요. {@bank_color_hint}(/돈 %arg-1% <닉네임> <금액>)" to player
                stop

            if arg-3 is not set:
                message "{@bank_prefix} {@bank_color_bad}금액을 입력해 주세요. {@bank_color_hint}(/돈 %arg-1% <닉네임> <금액>)" to player
                stop

            set {_pay} to arg-3 parsed as number
            if {_pay} is not set:
                message "{@bank_prefix} {@bank_color_bad}금액은 숫자만 입력해 주세요." to player
                stop
            if {_pay} < 0:
                message "{@bank_prefix} {@bank_color_bad}금액에 음수는 입력할 수 없습니다." to player
                stop
            if {돈::%player%} < {_pay}:
                message "{@bank_prefix} {@bank_color_bad}잔액이 부족합니다. {@bank_color_hint}(보유: {@bank_color_info}%{돈::%player%}%원{@bank_color_hint})" to player
                stop

            delete {_target}
            loop all players:
                if loop-player's name is arg-2:
                    set {_target} to loop-player
                    stop loop

            if {_target} is not set:
                message "{@bank_prefix} {@bank_color_bad}존재하지 않는 플레이어입니다. {@bank_color_hint}(현재 접속 중인 플레이어만 송금 가능)" to player
                stop

            if {_target} is player:
                message "{@bank_prefix} {@bank_color_bad}자기 자신에게는 송금할 수 없습니다." to player
                stop

            subtract {_pay} from {돈::%player%}
            add {_pay} to {돈::%{_target}%}

            message "{@bank_prefix} {@bank_color_good}송금 완료! {@bank_color_info}%arg-2%{@bank_color_hint}님에게 {@bank_color_emph}%{_pay}%원{@bank_color_hint}을 보냈습니다. | 잔액: {@bank_color_info}%{돈::%player%}%원" to player
            message "{@bank_prefix} {@bank_color_good}입금 알림! {@bank_color_info}%player's name%{@bank_color_hint}님이 {@bank_color_emph}%{_pay}%원{@bank_color_hint}을 송금했습니다." to {_target}
            stop



# ===== 수표 검증 함수 =====
function 수표검증(item: item) :: boolean:
    loop lore of {_item}:
        if loop-value contains "[바르칸열도 정식발행]":
            return true
    return false

function 수표금액(item: item) :: number:
    set {_n} to name of {_item}
    replace all "&e" with "" in {_n}
    replace all "원" with "" in {_n}
    set {_v} to {_n} parsed as number
    if {_v} is set:
        return {_v}
    return 0

# ===== 수표: 우클릭(1장 입금) =====
on rightclick:
    if {돈::%player%} is not set:
        set {돈::%player%} to 0

    if player's tool is paper:
        if 수표검증(player's tool) is true:
            set {_money} to 수표금액(player's tool)
            if {_money} <= 0:
                message "{@bank_prefix} {@bank_color_bad}해당 수표의 금액을 읽을 수 없습니다." to player
                stop
            remove 1 of player's tool from player
            add {_money} to {돈::%player%}
            message "{@bank_prefix} {@bank_color_good}입금 완료! {@bank_color_hint}입금: {@bank_color_emph}%{_money}%원 {@bank_color_hint}| 잔액: {@bank_color_info}%{돈::%player%}%원" to player


# ===== 수표: 좌클릭(손에 든 묶음 전부 입금) =====
on leftclick:
    if {돈::%player%} is not set:
        set {돈::%player%} to 0

    if player's tool is paper:
        if 수표검증(player's tool) is true:
            set {_money} to 수표금액(player's tool)
            if {_money} <= 0:
                message "{@bank_prefix} {@bank_color_bad}해당 수표의 금액을 읽을 수 없습니다." to player
                stop
            set {_amt} to amount of player's tool
            set player's tool to air
            set {_total} to {_money} * {_amt}
            add {_total} to {돈::%player%}
            message "{@bank_prefix} {@bank_color_good}일괄 입금 완료! {@bank_color_hint}입금: {@bank_color_emph}%{_total}%원 {@bank_color_hint}(&f%{_amt}%장{@bank_color_hint}) | 잔액: {@bank_color_info}%{돈::%player%}%원" to player