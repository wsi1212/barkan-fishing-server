options:
    bank_prefix: &8[&b 돈 &8] 
    bank_color_info: &f
    bank_color_hint: &7
    bank_color_good: &a
    bank_color_bad: &c
    bank_color_emph: &e

command /돈 [<text>] [<text>] [<text>]:
    aliases: /ehs
    trigger:
        # 기본값 보정 (none 방지)
        if {돈::%player%} is not set:
            set {돈::%player%} to 0

        # /돈
        if arg-1 is not set:
            message "{@bank_prefix} {@bank_color_info}%player's name%님의 잔액: {@bank_color_good}%{돈::%player%}%원" to player
            stop

        # /돈 출금|인출|뽑기 금액 [갯수]
        else if arg-1 is "출금" or "인출" or "뽑기":
            if arg-2 is not set:
                message "{@bank_prefix} {@bank_color_bad}출금 금액을 입력해 주세요. {@bank_color_hint}(/돈 %arg-1% <금액> [갯수])" to player
                stop

            set {_금액} to arg-2
            set {_check} to {_금액} parsed as number
            if {_check} is not set:
                message "{@bank_prefix} {@bank_color_bad}출금 금액은 숫자만 입력해 주세요." to player
                stop
            if {_check} < 0:
                message "{@bank_prefix} {@bank_color_bad}출금 금액에 음수는 입력할 수 없습니다." to player
                stop

            # 인벤 빈칸 체크 (이전 값 남는 것 방지)
            delete {_empty}
            loop 36 times:
                if slot (loop-iteration - 1) of player's inventory is air:
                    set {_empty} to true
                    stop loop

            if {_empty} is not set:
                message "{@bank_prefix} {@bank_color_bad}인벤토리에 빈 공간이 없습니다. {@bank_color_hint}(종이를 받을 공간이 필요합니다)" to player
                stop

            # 1장 출금
            if arg-3 is not set:
                if {돈::%player%} < {_check}:
                    message "{@bank_prefix} {@bank_color_bad}잔액이 부족합니다. {@bank_color_hint}(보유: {@bank_color_info}%{돈::%player%}%원{@bank_color_hint})" to player
                    stop

                give 1 of paper named "&f돈" with lore "&f%arg-2%원" to player
                subtract {_check} from {돈::%player%}
                message "{@bank_prefix} {@bank_color_good}%arg-1% 완료! {@bank_color_hint}출금: {@bank_color_emph}%{_check}%원 {@bank_color_hint}| 잔액: {@bank_color_info}%{돈::%player%}%원" to player
                stop

            # 여러장 출금
            set {_갯수} to arg-3
            set {_count} to {_갯수} parsed as integer
            if {_count} is not set:
                message "{@bank_prefix} {@bank_color_bad}출금 갯수는 정수만 입력해 주세요." to player
                stop
            if {_count} < 0:
                message "{@bank_prefix} {@bank_color_bad}출금 갯수에 음수는 입력할 수 없습니다." to player
                stop

            set {_총금액} to {_check} * {_count}
            if {돈::%player%} < {_총금액}:
                message "{@bank_prefix} {@bank_color_bad}잔액이 부족합니다. {@bank_color_hint}(필요: {@bank_color_emph}%{_총금액}%원{@bank_color_hint} / 보유: {@bank_color_info}%{돈::%player%}%원{@bank_color_hint})" to player
                stop

            give {_count} of paper named "&f돈" with lore "&f%arg-2%원" to player
            subtract {_총금액} from {돈::%player%}
            message "{@bank_prefix} {@bank_color_good}%arg-1% 완료! {@bank_color_hint}총 출금: {@bank_color_emph}%{_총금액}%원 {@bank_color_hint}(&f%{_count}%장{@bank_color_hint}) | 잔액: {@bank_color_info}%{돈::%player%}%원" to player
            stop

        # /돈 설정 플레이어 금액 (온라인 플레이어만)
        else if arg-1 is "설정":
            if player is not op:
                message "{@bank_prefix} {@bank_color_bad}권한이 부족합니다." to player
                stop

            if arg-2 is not set:
                message "{@bank_prefix} {@bank_color_bad}플레이어를 입력해 주세요. {@bank_color_hint}(/돈 설정 <닉네임> <금액>)" to player
                stop

            if arg-3 is not set:
                message "{@bank_prefix} {@bank_color_bad}설정할 금액을 입력해 주세요. {@bank_color_hint}(/돈 설정 <닉네임> <금액>)" to player
                stop

            set {_amt} to arg-3 parsed as number
            if {_amt} is not set:
                message "{@bank_prefix} {@bank_color_bad}금액은 숫자만 입력해 주세요." to player
                stop
            if {_amt} < 0:
                message "{@bank_prefix} {@bank_color_bad}금액에 음수는 입력할 수 없습니다." to player
                stop

            delete {_target}
            loop all players:
                if loop-player's name is arg-2:
                    set {_target} to loop-player
                    stop loop

            if {_target} is not set:
                message "{@bank_prefix} {@bank_color_bad}존재하지 않는 플레이어입니다. {@bank_color_hint}(현재 접속 중인 플레이어만 설정 가능)" to player
                stop

            set {돈::%{_target}%} to {_amt}
            message "{@bank_prefix} {@bank_color_emph}관리자 &f%player's name%{@bank_color_emph}님이 잔액을 {@bank_color_good}%{_amt}%원{@bank_color_emph}으로 설정했습니다." to {_target}
            message "{@bank_prefix} {@bank_color_good}설정 완료! {@bank_color_info}%arg-2%{@bank_color_hint}님의 잔액을 {@bank_color_emph}%{_amt}%원{@bank_color_hint}으로 변경했습니다." to player
            stop

        # /돈 보내기|송금 플레이어 금액 (온라인 플레이어만)
        else if arg-1 is "보내기" or "송금":
            if arg-2 is not set:
                message "{@bank_prefix} {@bank_color_bad}보낼 플레이어를 입력해 주세요. {@bank_color_hint}(/돈 %arg-1% <닉네임> <금액>)" to player
                stop

            if arg-3 is not set:
                message "{@bank_prefix} {@bank_color_bad}금액을 입력해 주세요. {@bank_color_hint}(/돈 %arg-1% <닉네임> <금액>)" to player
                stop

            set {_pay} to arg-3 parsed as number
            if {_pay} is not set:
                message "{@bank_prefix} {@bank_color_bad}금액은 숫자만 입력해 주세요." to player
                stop
            if {_pay} < 0:
                message "{@bank_prefix} {@bank_color_bad}금액에 음수는 입력할 수 없습니다." to player
                stop
            if {돈::%player%} < {_pay}:
                message "{@bank_prefix} {@bank_color_bad}잔액이 부족합니다. {@bank_color_hint}(보유: {@bank_color_info}%{돈::%player%}%원{@bank_color_hint})" to player
                stop

            delete {_target}
            loop all players:
                if loop-player's name is arg-2:
                    set {_target} to loop-player
                    stop loop

            if {_target} is not set:
                message "{@bank_prefix} {@bank_color_bad}존재하지 않는 플레이어입니다. {@bank_color_hint}(현재 접속 중인 플레이어만 송금 가능)" to player
                stop

            if {_target} is player:
                message "{@bank_prefix} {@bank_color_bad}자기 자신에게는 송금할 수 없습니다." to player
                stop

            subtract {_pay} from {돈::%player%}
            add {_pay} to {돈::%{_target}%}

            message "{@bank_prefix} {@bank_color_good}송금 완료! {@bank_color_info}%arg-2%{@bank_color_hint}님에게 {@bank_color_emph}%{_pay}%원{@bank_color_hint}을 보냈습니다. | 잔액: {@bank_color_info}%{돈::%player%}%원" to player
            message "{@bank_prefix} {@bank_color_good}입금 알림! {@bank_color_info}%player's name%{@bank_color_hint}님이 {@bank_color_emph}%{_pay}%원{@bank_color_hint}을 송금했습니다." to {_target}
            stop

        # 도움말
        else:
            message "{@bank_prefix} {@bank_color_info}사용법:" to player
            message "{@bank_color_hint}- {@bank_color_emph}/돈 {@bank_color_hint}: 잔액 확인" to player
            message "{@bank_color_hint}- {@bank_color_emph}/돈 출금|인출|뽑기 <금액> [갯수] {@bank_color_hint}: 종이 돈으로 출금" to player
            message "{@bank_color_hint}- {@bank_color_emph}/돈 송금|보내기 <플레이어> <금액> {@bank_color_hint}: 플레이어에게 송금" to player
            if player is op:
                message "{@bank_color_hint}- {@bank_color_emph}/돈 설정 <플레이어> <금액> {@bank_color_hint}: (OP) 잔액 설정" to player


# ===== 종이 돈: 우클릭(1장 입금) =====
on rightclick:
    if {돈::%player%} is not set:
        set {돈::%player%} to 0

    if player's tool is paper:
        if player's tool's name is "&f돈":
            set {_lore} to 1st line of player's tool's lore
            remove 1 of player's tool from player

            replace all "&f" with "" in {_lore}
            replace all "원" with "" in {_lore}
            set {_money} to {_lore} parsed as number
            if {_money} is not set:
                message "{@bank_prefix} {@bank_color_bad}해당 종이 돈의 금액을 읽을 수 없습니다." to player
                stop

            add {_money} to {돈::%player%}
            message "{@bank_prefix} {@bank_color_good}입금 완료! {@bank_color_hint}입금: {@bank_color_emph}%{_money}%원 {@bank_color_hint}| 잔액: {@bank_color_info}%{돈::%player%}%원" to player


# ===== 종이 돈: 좌클릭(손에 든 묶음 전부 입금) =====
on leftclick:
    if {돈::%player%} is not set:
        set {돈::%player%} to 0

    if player's tool is paper:
        if player's tool's name is "&f돈":
            set {_lore} to 1st line of player's tool's lore
            set {_amt} to amount of player's tool
            set player's tool to air

            replace all "&f" with "" in {_lore}
            replace all "원" with "" in {_lore}
            set {_money} to {_lore} parsed as number
            if {_money} is not set:
                message "{@bank_prefix} {@bank_color_bad}해당 종이 돈의 금액을 읽을 수 없습니다." to player
                stop

            set {_total} to {_money} * {_amt}
            add {_total} to {돈::%player%}
            message "{@bank_prefix} {@bank_color_good}일괄 입금 완료! {@bank_color_hint}입금: {@bank_color_emph}%{_total}%원 {@bank_color_hint}(&f%{_amt}%장{@bank_color_hint}) | 잔액: {@bank_color_info}%{돈::%player%}%원" to player