# =========================================
# 송금.sk
# /송금 <닉네임> <금액>
# =========================================

options:
    prefix: &8[&6 송금 &8]
    good: &a
    bad: &c
    hint: &7
    emph: &e
    info: &f
    fee_rate: 10

on tab complete of "/송금":
    set tab completions for position 1 to names of all players
    set tab completions for position 2 to "<금액>"

command /송금 [<text>] [<text>]:
    aliases: /thda
    trigger:
        if {돈::%player%} is not set:
            set {돈::%player%} to 0

        if arg-1 is not set:
            message "{@prefix} {@hint}사용법: {@emph}/송금 <닉네임> <금액> {@hint}| 수수료: {@emph}10%%" to player
            stop

        if arg-2 is not set:
            message "{@prefix} {@hint}사용법: {@emph}/송금 <닉네임> <금액>" to player
            stop

        # 자기 자신
        if arg-1 is player's name:
            message "{@prefix} {@bad}자기 자신에게 송금할 수 없습니다." to player
            stop

        # 금액 파싱
        set {_금액} to arg-2 parsed as integer
        if {_금액} is not set:
            message "{@prefix} {@bad}올바른 금액을 입력해주세요." to player
            stop
        if {_금액} < 1000:
            message "{@prefix} {@bad}최소 1,000골드 이상부터 송금할 수 있습니다." to player
            stop

        # 수신자 온라인 체크
        delete {_target}
        loop all players:
            if loop-player's name is arg-1:
                set {_target} to loop-player
                stop loop
        if {_target} is not set:
            message "{@prefix} {@bad}%arg-1%&c님이 온라인 상태가 아닙니다." to player
            stop

        # 레벨 체크
        if {낚시레벨::%player%} is not set:
            set {낚시레벨::%player%} to 1
        if {낚시레벨::%player%} < 15:
            message "{@prefix} {@bad}레벨 15 이상부터 송금이 가능합니다." to player
            stop

        if {낚시레벨::%{_target}%} is not set:
            set {낚시레벨::%{_target}%} to 1
        if {낚시레벨::%{_target}%} < 15:
            message "{@prefix} {@bad}%arg-1%&c님은 레벨 15 미만이라 송금받을 수 없습니다." to player
            stop

        # 수수료 계산 (5%, 내림)
        set {_수수료} to floor({_금액} * {@fee_rate} / 100)
        set {_수신액} to {_금액} - {_수수료}
        set {_실제차감} to {_금액} + {_수수료}

        # 잔액 체크 (수수료 포함)
        if {돈::%player%} < {_실제차감}:
            message "{@prefix} {@bad}골드가 부족합니다. {@hint}필요: {@emph}%{_실제차감}%골드 {@hint}(송금 %{_금액}%골드 + 수수료 %{_수수료}%골드) | 잔액: {@emph}%{돈::%player%}%골드" to player
            stop

        # 처리 (수수료 포함 차감)
        remove {_실제차감} from {돈::%player%}
        if {돈::%{_target}%} is not set:
            set {돈::%{_target}%} to 0
        add {_수신액} to {돈::%{_target}%}

        message "{@prefix} {@good}→ &f%arg-1%&a님에게 {@emph}%{_금액}%골드 {@good}송금 완료! {@hint}(수수료 %{_수수료}%골드) | 잔액: {@emph}%{돈::%player%}%골드" to player
        message "{@prefix} {@good}← &f%player%&a님에게서 {@emph}%{_수신액}%골드 {@good}받음! {@hint}잔액: {@emph}%{돈::%{_target}%}%골드" to {_target}
        도전과제체크(player, "송금", "1")
