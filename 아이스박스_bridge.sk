# =========================================
# 아이스박스_bridge.sk — 아이스박스 Java 이관 마이그/참조 브릿지 (안전 컷오버)
# Java(IceboxGui, PlayerData.icebox)로 전환. 기존 {아이스박스} 보관 아이템은 소유자에게 give-back(손실 0).
#  - on join: 미마이그 플레이어의 Skript 보관 아이템을 인벤으로 반환 + 클리어 (1회)
#  - /iceboxmig (op): 현재 접속자 전원 즉시 마이그
#  - openIcebox 스텁: 메뉴.sk 등이 호출 → Java /아이스박스로 리다이렉트
#  - 자동수납 스텁: 낚시.sk가 호출 → no-op(자동수납은 Java 낚시 경로에 추후 재구현, 현재 비활성)
# =========================================

# 메뉴.sk → openIcebox(player) 호출 → Java GUI 열기
function openIcebox(p: player):
    make {_p} execute command "아이스박스"

# 낚시.sk → 자동수납(player, item) 호출 (Skript 낚시 폴백 시). 자동수납은 현재 비활성(수동 보관).
function 자동수납(p: player, item: item) :: boolean:
    return false

# give-back 마이그 (1회): Skript {아이스박스} 보관물을 소유자 인벤으로 반환
on join:
    wait 40 ticks
    if {아이스박스마이그됨::%player's name%} is not set:
        set {_any} to false
        loop 45 times:
            set {_idx} to loop-number - 1
            set {_it} to {아이스박스::%player%::%{_idx}%}
            if {_it} is set:
                set {_any} to true
                if player can hold {_it}:
                    give {_it} to player
                else:
                    drop {_it} at player's location
                delete {아이스박스::%player%::%{_idx}%}
                delete {아이스박스시간::%player%::%{_idx}%}
        set {아이스박스마이그됨::%player's name%} to true
        if {_any} is true:
            send "&8[&b 아이스박스 &8] &e아이스박스가 새 버전으로 전환되어, 보관했던 물고기를 인벤토리로 돌려드렸습니다." to player
            send "&8[&b 아이스박스 &8] &7/아이스박스 에서 다시 보관하세요. (보존 효과 동일)" to player

# OP: 현재 접속자 전원 즉시 마이그
command /iceboxmig:
    permission: op
    trigger:
        loop all players:
            if {아이스박스마이그됨::%loop-player's name%} is not set:
                set {_any} to false
                loop 45 times:
                    set {_idx} to loop-number - 1
                    set {_it} to {아이스박스::%loop-player%::%{_idx}%}
                    if {_it} is set:
                        set {_any} to true
                        if loop-player can hold {_it}:
                            give {_it} to loop-player
                        else:
                            drop {_it} at loop-player's location
                        delete {아이스박스::%loop-player%::%{_idx}%}
                        delete {아이스박스시간::%loop-player%::%{_idx}%}
                set {아이스박스마이그됨::%loop-player's name%} to true
                if {_any} is true:
                    send "&8[&b 아이스박스 &8] &e보관 물고기를 인벤토리로 반환했습니다." to loop-player
        send "&a[iceboxmig] 접속자 마이그레이션 완료." to player
