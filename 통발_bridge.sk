# =========================================
# 통발_bridge.sk — 통발 Java 이관 마이그 브릿지 (안전 컷오버)
# Java(TrapManager, traps.json)로 전환. 기존 {통발} 설치물·{통발물고기} 생성물은 소유자에게 give-back(손실 0).
#  - on join: 미마이그 플레이어 소유 통발을 통발아이템 + 생성물고기로 인벤 반환 + 클리어 (1회)
#  - /통발마이그 (op): 현재 접속자 전원 즉시 마이그
# Java가 설치/생성/회수/상점을 전부 소유 → 이 브릿지는 마이그 전용. 마이그 후 무효(목록 빔).
# =========================================

# 통발 아이템 재생성 (give-back 전용 — 원본 통발.sk 함수는 Java로 이관됨)
function 통발아이템마이그(grade: text) :: item:
    if {_grade} is "고급":
        set {_item} to iron ingot named "&b고급 통발"
        set lore of {_item} to "&7고급 그물로 만든 통발" and "&7대기: &e7분" and "&7수량: &f1~2마리" and "&7등급: &fE~C" and "" and "&8trap:고급:NEW" and "&a설치: 물 근처에서 [SHIFT+우클릭]"
    else if {_grade} is "최고급":
        set {_item} to gold ingot named "&6최고급 통발"
        set lore of {_item} to "&7황금 그물로 만든 최고급 통발" and "&7대기: &e5분" and "&7수량: &f2~3마리" and "&7등급: &fD~B" and "" and "&8trap:최고급:NEW" and "&a설치: 물 근처에서 [SHIFT+우클릭]"
    else:
        set {_item} to stick named "&f일반 통발"
        set lore of {_item} to "&7나무로 엮은 기본 통발" and "&7대기: &e10분" and "&7수량: &f1마리" and "&7등급: &fE~D" and "" and "&8trap:일반:NEW" and "&a설치: 물 근처에서 [SHIFT+우클릭]"
    return {_item}

# give-back: 한 플레이어 소유 통발 전부를 인벤 반환 + Skript 데이터 클리어
function 통발마이그처리(p: player) :: integer:
    set {_n} to 0
    if {통발목록::*} is not set:
        return 0
    loop {통발목록::*}:
        set {_lk} to loop-value
        if {통발::%{_lk}%::설치자} is {_p}:
            set {_n} to {_n} + 1
            # 생성된 물고기 반환
            loop {통발물고기::%{_lk}%::*}:
                if {_p} can hold loop-value-2:
                    give loop-value-2 to {_p}
                else:
                    drop loop-value-2 at {_p}'s location
            # 통발 아이템 반환
            set {_grade} to {통발::%{_lk}%::등급}
            set {_trap} to 통발아이템마이그({_grade})
            if {_p} can hold {_trap}:
                give {_trap} to {_p}
            else:
                drop {_trap} at {_p}'s location
            # 데이터 삭제
            delete {통발::%{_lk}%::*}
            delete {통발물고기::%{_lk}%::*}
            remove {_lk} from {통발목록::*}
    return {_n}

on join:
    wait 60 ticks
    if {통발마이그됨::%player's name%} is not set:
        set {_n} to 통발마이그처리(player)
        set {통발마이그됨::%player's name%} to true
        if {_n} > 0:
            send "&8[&6 통발 &8] &e통발이 새 버전으로 전환되어, 설치했던 통발 %{_n}%개(+물고기)를 인벤토리로 돌려드렸습니다." to player
            send "&8[&6 통발 &8] &7/통발상점 에서 확인하고 다시 설치하세요." to player

command /통발마이그:
    permission: op
    trigger:
        loop all players:
            if {통발마이그됨::%loop-player's name%} is not set:
                set {_n} to 통발마이그처리(loop-player)
                set {통발마이그됨::%loop-player's name%} to true
                if {_n} > 0:
                    send "&8[&6 통발 &8] &e설치 통발 %{_n}%개(+물고기)를 인벤토리로 반환했습니다." to loop-player
        send "&a[통발마이그] 접속자 마이그레이션 완료." to player
