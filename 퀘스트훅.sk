# ===== 퀘스트 훅 함수 =====
# 기존 파일(낚시.sk, 공간.sk, 판매.sk)에서 호출하는 브릿지 함수
# 활성 퀘스트를 순회하며 목표 매칭 + 진행도 업데이트

# ===== 등급→숫자 변환 (낚시.sk의 rankchange와 동일, 순환의존 방지용) =====
function 퀘스트등급숫자(g: text) :: number:
    if {_g} is "E":
        return 1
    else if {_g} is "D":
        return 2
    else if {_g} is "C":
        return 3
    else if {_g} is "B":
        return 4
    else if {_g} is "A":
        return 5
    else if {_g} is "S":
        return 6
    else if {_g} is "S+":
        return 7
    else if {_g} is "M":
        return 8
    else if {_g} is "L":
        return 9
    else if {_g} is "G":
        return 10
    return 0

# ===== 물고기 잡았을 때 =====
function 퀘스트_물고기(p: player, fishName: text, grade: text, size: number):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "fish":
                # 물고기 이름 체크
                set {_nameOk} to false
                if {_obj::2} is "아무":
                    set {_nameOk} to true
                if {_obj::2} is {_fishName}:
                    set {_nameOk} to true
                if {_nameOk} is true:
                    # 등급 체크 (지정 등급 "이상")
                    set {_gradeOk} to false
                    if {_obj::3} is "아무":
                        set {_gradeOk} to true
                    else:
                        set {_reqRank} to 퀘스트등급숫자({_obj::3})
                        set {_gotRank} to 퀘스트등급숫자({_grade})
                        if {_gotRank} >= {_reqRank}:
                            set {_gradeOk} to true
                    if {_gradeOk} is true:
                        # 최소 크기 체크
                        set {_minSize} to {_obj::5} parsed as number
                        if {_minSize} is not set:
                            set {_minSize} to 0
                        if {_size} >= {_minSize}:
                            set {_target} to {_obj::4} parsed as number
                            set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                            if {_cur} is not set:
                                set {_cur} to 0
                            if {_cur} < {_target}:
                                add 1 to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                                set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                                message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &f%{_cur}%&7/&f%{_target}%" to {_p}
        퀘스트진행체크({_p}, {_qid})

# ===== 레벨업 했을 때 =====
function 퀘스트_레벨업(p: player, lv: integer):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "level":
                set {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%} to {_lv}
                set {_target} to {_obj::2} parsed as number
                if {퀘스트::%{_qid}%::카테고리} is not "주간":
                    message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &fLv.%{_lv}%&7/&fLv.%{_target}%" to {_p}
        퀘스트진행체크({_p}, {_qid})

# ===== 지역에 입장했을 때 =====
function 퀘스트_지역입장(p: player, area: text):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "area":
                if {_obj::2} is {_area}:
                    if {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%} is not 1:
                        set {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%} to 1
                        message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &a지역 도착!" to {_p}
        퀘스트진행체크({_p}, {_qid})

# ===== 접속했을 때 (주간 접속일수 퀘스트) =====
function 퀘스트_접속(p: player):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    set {_days} to {주간접속일수::%{_p}%}
    if {_days} is not set:
        set {_days} to 0
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "login":
                set {_target} to {_obj::2} parsed as number
                set {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%} to {_days}
                if {퀘스트::%{_qid}%::카테고리} is not "주간":
                    if {_days} >= {_target}:
                        message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &a%{_days}%일 접속 달성!" to {_p}
                    else:
                        message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &f%{_days}%&7/&f%{_target}%일" to {_p}
        퀘스트진행체크({_p}, {_qid})

# ===== 일일 퀘스트 완료했을 때 (주간 일퀘완료 퀘스트) =====
function 퀘스트_일퀘완료(p: player):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    set {_cnt} to {주간일퀘완료수::%{_p}%}
    if {_cnt} is not set:
        set {_cnt} to 0
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "quest_daily":
                set {_target} to {_obj::2} parsed as number
                set {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%} to {_cnt}
                if {_cnt} >= {_target}:
                    message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &a일퀘 %{_cnt}%개 달성!" to {_p}
                else:
                    message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &f%{_cnt}%&7/&f%{_target}%개" to {_p}
        퀘스트진행체크({_p}, {_qid})

# ===== 물고기 판매했을 때 =====
function 퀘스트_판매(p: player, count: integer, price: number):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "sell":
                set {_target} to {_obj::2} parsed as number
                set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                if {_cur} is not set:
                    set {_cur} to 0
                if {_cur} < {_target}:
                    add {_count} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                    set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                    if {_cur} > {_target}:
                        set {_cur} to {_target}
                    if {퀘스트::%{_qid}%::카테고리} is not "주간":
                        message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &f%{_cur}%&7/&f%{_target}%" to {_p}
            else if {_obj::1} is "money":
                set {_target} to {_obj::2} parsed as number
                set {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%} to {돈::%{_p}%}
                if {퀘스트::%{_qid}%::카테고리} is not "주간":
                    if {돈::%{_p}%} >= {_target}:
                        message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &a목표 달성!" to {_p}
                    else:
                        message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &f%{돈::%{_p}%}%&7/&f%{_target}%원" to {_p}
        퀘스트진행체크({_p}, {_qid})
