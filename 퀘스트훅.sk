# =========================================
# 퀘스트훅.sk
# 퀘스트 진행 브릿지 — 낚시/판매/레벨/지역 이벤트 연결
# 표시 규칙:
#   메인/튜토 퀘스트 → 진행마다 타이틀 (유저가 직접 수락)
#   일일/주간 쉬운 퀘스트 → 표시 안 함 (완료 시만 채팅)
#   일일/주간 어려운 퀘스트 (B+등급, 특정물고기) → 진행마다 채팅
#   접속 퀘스트 → 하루 1회 채팅
#   지역 도착, 레벨업 → 채팅 (자주 안 일어남)
# =========================================

# ===== 퀘스트 표시 방식 판별 =====
# 반환: "none" (표시 안 함), "title" (타이틀), "chat" (채팅)
function 퀘스트표시방식(qid: text, objType: text, objGrade: text, target: number) :: text:
    set {_cat} to {퀘스트::%{_qid}%::카테고리}
    # 메인/튜토 퀘스트 → 항상 타이틀 (유저가 직접 수락한 퀘스트)
    if {_cat} is "메인" or "튜토":
        return "title"
    # 주간 퀘스트 → 표시 안 함 (너무 빈번)
    if {_cat} is "주간":
        return "none"
    # 일일 퀘스트 → 내용에 따라 분기
    # 쉬운 목표 (아무 물고기, E~C 등급, 판매 횟수, 수량 5이상) → 표시 안 함
    if {_objType} is "fish":
        if {_objGrade} is "아무" or "E" or "D" or "C" or "E~S" or "E~A" or "E~B":
            return "none"
        if {_target} >= 5:
            return "none"
        # B등급 이상 특정 물고기 → 채팅 (드물게 나오니까)
        return "chat"
    if {_objType} is "sell":
        return "none"
    if {_objType} is "money":
        return "none"
    # 기본 → 채팅
    return "chat"

# ===== 등급 문자열 → 숫자 =====
function 퀘스트등급숫자(grade: text) :: number:
    if {_grade} is "E":
        return 1
    else if {_grade} is "D":
        return 2
    else if {_grade} is "C":
        return 3
    else if {_grade} is "B":
        return 4
    else if {_grade} is "A":
        return 5
    else if {_grade} is "S":
        return 6
    else if {_grade} is "S+":
        return 7
    else if {_grade} is "M":
        return 8
    else if {_grade} is "L":
        return 9
    else if {_grade} is "G":
        return 10
    return 0

# ===== 물고기 낚았을 때 =====
# quality: 품질 0~100 (크기 기반, 신선도와 별개)
function 퀘스트_물고기(p: player, fishName: text, grade: text, size: number, quality: number = 50):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "fish":
                set {_nameOk} to false
                if {_obj::2} is "아무":
                    set {_nameOk} to true
                else if {_obj::2} is {_fishName}:
                    set {_nameOk} to true
                if {_nameOk} is true:
                    set {_gradeOk} to false
                    if {_obj::3} is "아무":
                        set {_gradeOk} to true
                    else:
                        set {_reqGrade} to {_obj::3}
                        if {_reqGrade} contains "~":
                            set {_gr::*} to split {_reqGrade} at "~"
                            set {_reqMin} to 퀘스트등급숫자({_gr::1})
                            set {_reqMax} to 퀘스트등급숫자({_gr::2})
                        else:
                            set {_reqMin} to 퀘스트등급숫자({_reqGrade})
                            set {_reqMax} to 10
                        set {_gotRank} to 퀘스트등급숫자({_grade})
                        if {_gotRank} >= {_reqMin}:
                            if {_gotRank} <= {_reqMax}:
                                set {_gradeOk} to true
                    if {_gradeOk} is true:
                        set {_minSize} to {_obj::5} parsed as number
                        if {_minSize} is not set:
                            set {_minSize} to 0
                        if {_size} >= {_minSize}:
                            set {_target} to {_obj::4} parsed as number
                            set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                            if {_cur} is not set:
                                set {_cur} to 0
                            if {_cur} < {_target}:
                                add 1 to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                                set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                                # 표시 방식 판별
                                set {_show} to 퀘스트표시방식({_qid}, "fish", {_obj::3}, {_target})
                                if {_show} is "title":
                                    send title "" with subtitle "&7%{퀘스트::%{_qid}%::이름}% &f%{_cur}%&7/%{_target}%" to {_p} for 1.5 seconds
                                else if {_show} is "chat":
                                    message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &f%{_cur}%&7/&f%{_target}%" to {_p}
            # --- fish_fresh 목표: fish_fresh|이름|등급|수량|최소크기|최소품질 ---
            if {_obj::1} is "fish_fresh":
                set {_nameOk} to false
                if {_obj::2} is "아무":
                    set {_nameOk} to true
                else if {_obj::2} is {_fishName}:
                    set {_nameOk} to true
                if {_nameOk} is true:
                    set {_gradeOk} to false
                    if {_obj::3} is "아무":
                        set {_gradeOk} to true
                    else:
                        set {_reqGrade} to {_obj::3}
                        if {_reqGrade} contains "~":
                            set {_gr::*} to split {_reqGrade} at "~"
                            set {_reqMin} to 퀘스트등급숫자({_gr::1})
                            set {_reqMax} to 퀘스트등급숫자({_gr::2})
                        else:
                            set {_reqMin} to 퀘스트등급숫자({_reqGrade})
                            set {_reqMax} to 10
                        set {_gotRank} to 퀘스트등급숫자({_grade})
                        if {_gotRank} >= {_reqMin}:
                            if {_gotRank} <= {_reqMax}:
                                set {_gradeOk} to true
                    if {_gradeOk} is true:
                        set {_minSize} to {_obj::5} parsed as number
                        if {_minSize} is not set:
                            set {_minSize} to 0
                        set {_minQuality} to {_obj::6} parsed as number
                        if {_minQuality} is not set:
                            set {_minQuality} to 0
                        if {_size} >= {_minSize}:
                            if {_quality} >= {_minQuality}:
                                set {_target} to {_obj::4} parsed as number
                                set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                                if {_cur} is not set:
                                    set {_cur} to 0
                                if {_cur} < {_target}:
                                    add 1 to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                                    set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                                    set {_show} to 퀘스트표시방식({_qid}, "fish", {_obj::3}, {_target})
                                    if {_show} is "title":
                                        send title "" with subtitle "&7%{퀘스트::%{_qid}%::이름}% &f%{_cur}%&7/%{_target}%" to {_p} for 1.5 seconds
                                    else if {_show} is "chat":
                                        message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &f%{_cur}%&7/&f%{_target}%" to {_p}
        퀘스트진행체크({_p}, {_qid})

# ===== 레벨업 했을 때 =====
function 퀘스트_레벨업(p: player, lv: integer):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "level":
                set {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%} to {_lv}
                set {_target} to {_obj::2} parsed as number
                # 레벨업은 자주 안 일어나므로 타이틀
                send title "" with subtitle "&7%{퀘스트::%{_qid}%::이름}% &fLv.%{_lv}%&7/Lv.%{_target}%" to {_p} for 1.5 seconds
        퀘스트진행체크({_p}, {_qid})

# ===== 지역에 입장했을 때 =====
function 퀘스트_지역입장(p: player, area: text):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "area":
                if {_obj::2} is {_area}:
                    if {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%} is not 1:
                        set {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%} to 1
                        # 지역 도착은 1회성 → 항상 채팅
                        message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &a지역 도착!" to {_p}
        퀘스트진행체크({_p}, {_qid})

# ===== 접속했을 때 (주간 접속일수 퀘스트) =====
function 퀘스트_접속(p: player):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    set {_days} to {주간접속일수::%{_p}%}
    if {_days} is not set:
        set {_days} to 0
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "login":
                set {_target} to {_obj::2} parsed as number
                set {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%} to {_days}
                # 접속 퀘스트 → 하루 1회 채팅 (타이틀 아님)
                if {_days} >= {_target}:
                    message "&8[&d 퀘스트 &8] &a%{퀘스트::%{_qid}%::이름}% — %{_days}%일 접속 달성!" to {_p}
                else:
                    message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &f%{_days}%&7/&f%{_target}%일" to {_p}
        퀘스트진행체크({_p}, {_qid})

# ===== 일일 퀘스트 완료했을 때 (주간 일퀘완료 퀘스트) =====
function 퀘스트_일퀘완료(p: player):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    set {_cnt} to {주간일퀘완료수::%{_p}%}
    if {_cnt} is not set:
        set {_cnt} to 0
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "quest_daily":
                set {_target} to {_obj::2} parsed as number
                set {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%} to {_cnt}
                # 일퀘완료도 드물게 일어나므로 채팅
                if {_cnt} >= {_target}:
                    message "&8[&d 퀘스트 &8] &a%{퀘스트::%{_qid}%::이름}% — 일퀘 %{_cnt}%개 달성!" to {_p}
                else:
                    message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &f%{_cnt}%&7/&f%{_target}%개" to {_p}
        퀘스트진행체크({_p}, {_qid})

# ===== 물고기 판매했을 때 =====
function 퀘스트_판매(p: player, count: integer, price: number):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "sell":
                set {_target} to {_obj::2} parsed as number
                set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                if {_cur} is not set:
                    set {_cur} to 0
                if {_cur} < {_target}:
                    add {_count} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                    set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                    if {_cur} > {_target}:
                        set {_cur} to {_target}
                    # 판매는 표시방식 판별
                    set {_show} to 퀘스트표시방식({_qid}, "sell", "", {_target})
                    if {_show} is "title":
                        send title "" with subtitle "&7%{퀘스트::%{_qid}%::이름}% &f%{_cur}%&7/%{_target}%" to {_p} for 1.5 seconds
                    else if {_show} is "chat":
                        message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &f%{_cur}%&7/&f%{_target}%" to {_p}
            else if {_obj::1} is "money":
                set {_target} to {_obj::2} parsed as number
                set {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%} to {돈::%{_p}%}
                # 돈 퀘스트도 표시방식 판별
                set {_show} to 퀘스트표시방식({_qid}, "money", "", {_target})
                if {_show} is "chat":
                    if {돈::%{_p}%} >= {_target}:
                        message "&8[&d 퀘스트 &8] &a%{퀘스트::%{_qid}%::이름}% — 목표 달성!" to {_p}
        퀘스트진행체크({_p}, {_qid})

# ===== 재료를 획득했을 때 =====
# 목표 포맷: material|재료ID|수량
function 퀘스트_재료(p: player, matId: text):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "material":
                set {_reqMat} to {_obj::2}
                if {_reqMat} = "아무":
                    set {_matMatch} to true
                else if {_reqMat} = {_matId}:
                    set {_matMatch} to true
                else:
                    set {_matMatch} to false
                if {_matMatch} is true:
                    set {_target} to {_obj::3} parsed as number
                    set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                    if {_cur} is not set:
                        set {_cur} to 0
                    if {_cur} < {_target}:
                        add 1 to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                        set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                        set {_show} to 퀘스트표시방식({_qid}, "material", "", {_target})
                        if {_show} is "title":
                            send title "" with subtitle "&7%{퀘스트::%{_qid}%::이름}% &f%{_cur}%&7/%{_target}%" to {_p} for 1.5 seconds
                        else if {_show} is "chat":
                            message "&8[&d 퀘스트 &8] &7%{퀘스트::%{_qid}%::이름}% &8- &f%{_cur}%&7/&f%{_target}%" to {_p}
        퀘스트진행체크({_p}, {_qid})

# ===== 조합 완료 시 =====
# 목표 포맷: craft|이름(또는 아무)|수량
function 퀘스트_조합(p: player, craftName: text):
    if {활성퀘스트::%{_p}%::*} is not set:
        stop
    # 조합대 이름의 공백→밑줄 변환 (questsync 호환)
    set {_cn} to {_craftName}
    replace all " " with "_" in {_cn}
    loop {활성퀘스트::%{_p}%::*}:
        set {_qid} to loop-value
        if {퀘스트상태::%{_qid}%::%{_p}%} is not "진행":
            continue
        set {_objIdx} to 0
        loop {퀘스트::%{_qid}%::목표::*}:
            add 1 to {_objIdx}
            set {_obj::*} to split loop-value-2 at "|"
            if {_obj::1} is "craft":
                set {_nameOk} to false
                if {_obj::2} is "아무":
                    set {_nameOk} to true
                else if {_obj::2} is {_cn}:
                    set {_nameOk} to true
                if {_nameOk} is true:
                    set {_target} to {_obj::3} parsed as number
                    set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                    if {_cur} is not set:
                        set {_cur} to 0
                    if {_cur} < {_target}:
                        add 1 to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                        set {_cur} to {퀘스트진행::%{_qid}%::%{_p}%::%{_objIdx}%}
                        send title "" with subtitle "&7%{퀘스트::%{_qid}%::이름}% &f%{_cur}%&7/%{_target}%" to {_p} for 1.5 seconds
        퀘스트진행체크({_p}, {_qid})

# ===== 조합 브릿지 명령어 (조합대.sk → 퀘스트훅) =====
command /questcraftdone <player>:
    permission: op
    executable by: console
    trigger:
        set {_name} to {조합완료이름::%arg-1%}
        delete {조합완료이름::%arg-1%}
        if {_name} is set:
