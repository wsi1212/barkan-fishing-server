# ===== 퀘스트 데이터 정의 =====
# 서버 로드 시 퀘스트 정의를 변수에 세팅
# 퀘스트 목표 포맷:
#   fish|이름(또는 아무)|등급(또는 아무)|수량|최소크기
#   level|목표레벨
#   area|지역명
#   sell|수량
#   money|금액
#   login|일수           — 이번 주 접속 일수
#   quest_daily|횟수     — 이번 주 일일 퀘스트 완료 수

on load:
    # ===== 리스트 초기화 =====
    delete {퀘스트목록::*}
    delete {퀘스트일일쉬움::*}
    delete {퀘스트일일보통::*}
    delete {퀘스트일일어려움::*}
    delete {퀘스트일일전문::*}
    delete {퀘스트주간목록::*}

    # 난이도별 필요 레벨
    set {일일난이도레벨::쉬움} to 1
    set {일일난이도레벨::보통} to 5
    set {일일난이도레벨::어려움} to 10
    set {일일난이도레벨::전문} to 20

    # =========================================
    #   튜토리얼 퀘스트 — 갈매기 바위 (체인)
    #   서버의 모든 기본 기능을 가르치는 15개 퀘스트
    # =========================================

    # ----- 튜토01: 낚싯대를 잡아라 -----
    # [기초 낚시] 낚시 기본 조작
    add "튜토01" to {퀘스트목록::*}
    set {퀘스트::튜토01::이름} to "&e낚싯대를 잡아라"
    set {퀘스트::튜토01::설명::1} to "&7물가에서 낚싯대를 던져"
    set {퀘스트::튜토01::설명::2} to "&7물고기를 &f3마리&7 잡아오세요."
    set {퀘스트::튜토01::타입} to "물고기"
    set {퀘스트::튜토01::카테고리} to "메인"
    set {퀘스트::튜토01::필요레벨} to 1
    delete {퀘스트::튜토01::목표::*}
    add "fish|아무|아무|3|0" to {퀘스트::튜토01::목표::*}
    set {퀘스트::튜토01::보상돈} to 300
    set {퀘스트::튜토01::보상경험치} to 30
    set {퀘스트::튜토01::다음퀘스트} to "튜토02"

    # ----- 튜토02: 등급의 차이 -----
    # [기초 낚시] 등급 시스템 (E < D < C < ...)
    add "튜토02" to {퀘스트목록::*}
    set {퀘스트::튜토02::이름} to "&e등급의 차이"
    set {퀘스트::튜토02::설명::1} to "&7D등급 이상 물고기를"
    set {퀘스트::튜토02::설명::2} to "&f1마리&7 잡아오세요."
    set {퀘스트::튜토02::타입} to "물고기"
    set {퀘스트::튜토02::카테고리} to "메인"
    set {퀘스트::튜토02::필요레벨} to 1
    set {퀘스트::튜토02::선행퀘스트} to "튜토01"
    delete {퀘스트::튜토02::목표::*}
    add "fish|아무|D|1|0" to {퀘스트::튜토02::목표::*}
    set {퀘스트::튜토02::보상돈} to 500
    set {퀘스트::튜토02::보상경험치} to 50
    set {퀘스트::튜토02::다음퀘스트} to "튜토03"

    # ----- 튜토03: 연습이 필요해 -----
    # [기초 낚시] 반복 낚시로 실력 쌓기
    add "튜토03" to {퀘스트목록::*}
    set {퀘스트::튜토03::이름} to "&e연습이 필요해"
    set {퀘스트::튜토03::설명::1} to "&7아무 물고기를"
    set {퀘스트::튜토03::설명::2} to "&f5마리&7 잡아오세요."
    set {퀘스트::튜토03::타입} to "물고기"
    set {퀘스트::튜토03::카테고리} to "메인"
    set {퀘스트::튜토03::필요레벨} to 1
    set {퀘스트::튜토03::선행퀘스트} to "튜토02"
    delete {퀘스트::튜토03::목표::*}
    add "fish|아무|아무|5|0" to {퀘스트::튜토03::목표::*}
    set {퀘스트::튜토03::보상돈} to 800
    set {퀘스트::튜토03::보상경험치} to 60
    set {퀘스트::튜토03::다음퀘스트} to "튜토04"

    # ----- 튜토04: 물고기를 팔아보자 -----
    # [경제] 판매 시스템 (/판매, /상점)
    add "튜토04" to {퀘스트목록::*}
    set {퀘스트::튜토04::이름} to "&e물고기를 팔아보자"
    set {퀘스트::튜토04::설명::1} to "&7잡은 물고기를"
    set {퀘스트::튜토04::설명::2} to "&f3마리&7 판매하세요. &8(/판매)"
    set {퀘스트::튜토04::타입} to "판매"
    set {퀘스트::튜토04::카테고리} to "메인"
    set {퀘스트::튜토04::필요레벨} to 1
    set {퀘스트::튜토04::선행퀘스트} to "튜토03"
    delete {퀘스트::튜토04::목표::*}
    add "sell|3" to {퀘스트::튜토04::목표::*}
    set {퀘스트::튜토04::보상돈} to 500
    set {퀘스트::튜토04::보상경험치} to 40
    set {퀘스트::튜토04::다음퀘스트} to "튜토05"

    # ----- 튜토05: 큰 놈이 비싸다 -----
    # [경제] 크기 = 가격, 미니게임 타이밍
    add "튜토05" to {퀘스트목록::*}
    set {퀘스트::튜토05::이름} to "&e큰 놈이 비싸다"
    set {퀘스트::튜토05::설명::1} to "&7크기 &f25cm 이상&7 물고기를"
    set {퀘스트::튜토05::설명::2} to "&f1마리&7 잡아오세요."
    set {퀘스트::튜토05::타입} to "물고기"
    set {퀘스트::튜토05::카테고리} to "메인"
    set {퀘스트::튜토05::필요레벨} to 1
    set {퀘스트::튜토05::선행퀘스트} to "튜토04"
    delete {퀘스트::튜토05::목표::*}
    add "fish|아무|아무|1|25" to {퀘스트::튜토05::목표::*}
    set {퀘스트::튜토05::보상돈} to 600
    set {퀘스트::튜토05::보상경험치} to 50
    set {퀘스트::튜토05::다음퀘스트} to "튜토06"

    # ----- 튜토06: 돈 관리 -----
    # [경제] 재화 시스템 (/돈)
    add "튜토06" to {퀘스트목록::*}
    set {퀘스트::튜토06::이름} to "&e돈 관리"
    set {퀘스트::튜토06::설명::1} to "&7소지금 &f2,000원&7을"
    set {퀘스트::튜토06::설명::2} to "&7달성하세요. &8(/돈)"
    set {퀘스트::튜토06::타입} to "돈"
    set {퀘스트::튜토06::카테고리} to "메인"
    set {퀘스트::튜토06::필요레벨} to 1
    set {퀘스트::튜토06::선행퀘스트} to "튜토05"
    delete {퀘스트::튜토06::목표::*}
    add "money|2000" to {퀘스트::튜토06::목표::*}
    set {퀘스트::튜토06::보상돈} to 500
    set {퀘스트::튜토06::보상경험치} to 40
    set {퀘스트::튜토06::다음퀘스트} to "튜토07"

    # ----- 튜토07: 성장의 시작 -----
    # [성장] 레벨 시스템, 레벨업 보너스
    add "튜토07" to {퀘스트목록::*}
    set {퀘스트::튜토07::이름} to "&e성장의 시작"
    set {퀘스트::튜토07::설명::1} to "&7낚시 레벨 &f2&7에"
    set {퀘스트::튜토07::설명::2} to "&7도달하세요. &8(/낚시레벨)"
    set {퀘스트::튜토07::타입} to "레벨"
    set {퀘스트::튜토07::카테고리} to "메인"
    set {퀘스트::튜토07::필요레벨} to 1
    set {퀘스트::튜토07::선행퀘스트} to "튜토06"
    delete {퀘스트::튜토07::목표::*}
    add "level|2" to {퀘스트::튜토07::목표::*}
    set {퀘스트::튜토07::보상돈} to 1000
    set {퀘스트::튜토07::보상경험치} to 80
    set {퀘스트::튜토07::다음퀘스트} to "튜토08"

    # ----- 튜토08: 메뉴와 도감 -----
    # [시스템] /메뉴, 도감 시스템
    add "튜토08" to {퀘스트목록::*}
    set {퀘스트::튜토08::이름} to "&e메뉴와 도감"
    set {퀘스트::튜토08::설명::1} to "&7물고기를 &f5마리&7 잡으며"
    set {퀘스트::튜토08::설명::2} to "&7도감을 채워보세요. &8(/메뉴)"
    set {퀘스트::튜토08::타입} to "물고기"
    set {퀘스트::튜토08::카테고리} to "메인"
    set {퀘스트::튜토08::필요레벨} to 1
    set {퀘스트::튜토08::선행퀘스트} to "튜토07"
    delete {퀘스트::튜토08::목표::*}
    add "fish|아무|아무|5|0" to {퀘스트::튜토08::목표::*}
    set {퀘스트::튜토08::보상돈} to 600
    set {퀘스트::튜토08::보상경험치} to 50
    set {퀘스트::튜토08::다음퀘스트} to "튜토09"

    # ----- 튜토09: 도감을 채워라 -----
    # [시스템] 도감 기록, 최대 크기 갱신
    add "튜토09" to {퀘스트목록::*}
    set {퀘스트::튜토09::이름} to "&e도감을 채워라"
    set {퀘스트::튜토09::설명::1} to "&7다양한 물고기를"
    set {퀘스트::튜토09::설명::2} to "&f10마리&7 잡아 도감을 채우세요."
    set {퀘스트::튜토09::타입} to "물고기"
    set {퀘스트::튜토09::카테고리} to "메인"
    set {퀘스트::튜토09::필요레벨} to 1
    set {퀘스트::튜토09::선행퀘스트} to "튜토08"
    delete {퀘스트::튜토09::목표::*}
    add "fish|아무|아무|10|0" to {퀘스트::튜토09::목표::*}
    set {퀘스트::튜토09::보상돈} to 800
    set {퀘스트::튜토09::보상경험치} to 60
    set {퀘스트::튜토09::다음퀘스트} to "튜토10"

    # ----- 튜토10: 장비를 갖춰라 -----
    # [장비] 장비 작업대 (/장비), 부품상점 (/부품상점)
    add "튜토10" to {퀘스트목록::*}
    set {퀘스트::튜토10::이름} to "&e장비를 갖춰라"
    set {퀘스트::튜토10::설명::1} to "&7물고기를 &f10마리&7 판매하여"
    set {퀘스트::튜토10::설명::2} to "&7부품을 살 돈을 모으세요. &8(/부품상점)"
    set {퀘스트::튜토10::타입} to "판매"
    set {퀘스트::튜토10::카테고리} to "메인"
    set {퀘스트::튜토10::필요레벨} to 1
    set {퀘스트::튜토10::선행퀘스트} to "튜토09"
    delete {퀘스트::튜토10::목표::*}
    add "sell|10" to {퀘스트::튜토10::목표::*}
    set {퀘스트::튜토10::보상돈} to 1000
    set {퀘스트::튜토10::보상경험치} to 70
    set {퀘스트::튜토10::다음퀘스트} to "튜토11"

    # ----- 튜토11: 장비의 힘 -----
    # [장비] 장비 스탯 효과 체감, C등급 도전
    add "튜토11" to {퀘스트목록::*}
    set {퀘스트::튜토11::이름} to "&e장비의 힘"
    set {퀘스트::튜토11::설명::1} to "&7장비를 갖추고"
    set {퀘스트::튜토11::설명::2} to "&7C등급 이상 물고기를 &f1마리&7 잡으세요."
    set {퀘스트::튜토11::타입} to "물고기"
    set {퀘스트::튜토11::카테고리} to "메인"
    set {퀘스트::튜토11::필요레벨} to 1
    set {퀘스트::튜토11::선행퀘스트} to "튜토10"
    delete {퀘스트::튜토11::목표::*}
    add "fish|아무|C|1|0" to {퀘스트::튜토11::목표::*}
    set {퀘스트::튜토11::보상돈} to 1200
    set {퀘스트::튜토11::보상경험치} to 80
    set {퀘스트::튜토11::다음퀘스트} to "튜토12"

    # ----- 튜토12: 아이스박스 -----
    # [시스템] 아이스박스 보관, 신선도
    add "튜토12" to {퀘스트목록::*}
    set {퀘스트::튜토12::이름} to "&e아이스박스"
    set {퀘스트::튜토12::설명::1} to "&7물고기를 &f8마리&7 잡아"
    set {퀘스트::튜토12::설명::2} to "&7아이스박스에 보관해보세요."
    set {퀘스트::튜토12::타입} to "물고기"
    set {퀘스트::튜토12::카테고리} to "메인"
    set {퀘스트::튜토12::필요레벨} to 1
    set {퀘스트::튜토12::선행퀘스트} to "튜토11"
    delete {퀘스트::튜토12::목표::*}
    add "fish|아무|아무|8|0" to {퀘스트::튜토12::목표::*}
    set {퀘스트::튜토12::보상돈} to 800
    set {퀘스트::튜토12::보상경험치} to 60
    set {퀘스트::튜토12::다음퀘스트} to "튜토13"

    # ----- 튜토13: 시간과 날씨 -----
    # [고급] 시간대/날씨 보너스 시스템
    add "튜토13" to {퀘스트목록::*}
    set {퀘스트::튜토13::이름} to "&e시간과 날씨"
    set {퀘스트::튜토13::설명::1} to "&7D등급 이상 물고기를"
    set {퀘스트::튜토13::설명::2} to "&f3마리&7 잡아오세요."
    set {퀘스트::튜토13::타입} to "물고기"
    set {퀘스트::튜토13::카테고리} to "메인"
    set {퀘스트::튜토13::필요레벨} to 1
    set {퀘스트::튜토13::선행퀘스트} to "튜토12"
    delete {퀘스트::튜토13::목표::*}
