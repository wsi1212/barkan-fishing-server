# ===== 퀘스트 데이터 — Java QuestManager에서 JSON 로드 후 동기화 =====
# 기존 하드코딩 제거 → /questsync 브릿지로 변수 세팅
# 퀘스트 목표 포맷:
#   fish|이름(또는 아무)|등급(또는 아무)|수량|최소크기
#   fish_fresh|이름(또는 아무)|등급(또는 아무)|수량|최소크기|최소품질(0~100)
#   material|재료ID(또는 아무)|수량
#   level|목표레벨
#   area|지역명
#   sell|수량
#   money|금액
#   login|일수
#   quest_daily|횟수
#   dogam|지역(섬)ID|종수    ← 해당 지역+하위지역 도감 N종 발견 (예: dogam|사막|35)

# ===== questsync 브릿지 명령어 (Java → Skript) =====
command /questsync <text> [<text>] [<text>] [<text>]:
    permission: op
    executable by: console
    trigger:
        if arg-1 is "init":
            # 리스트 초기화
            delete {퀘스트목록::*}
            delete {퀘스트일일쉬움::*}
            delete {퀘스트일일보통::*}
            delete {퀘스트일일어려움::*}
            delete {퀘스트일일전문::*}
            delete {퀘스트주간목록::*}

        else if arg-1 is "difflevel":
            # 난이도 레벨: /questsync difflevel 쉬움 1
            set {일일난이도레벨::%arg-2%} to arg-3 parsed as integer

        else if arg-1 is "daily":
            # 일일 리스트: /questsync daily 쉬움 일일_쉬움_물고기3
            if arg-2 is "쉬움":
                add arg-3 to {퀘스트일일쉬움::*}
            else if arg-2 is "보통":
                add arg-3 to {퀘스트일일보통::*}
            else if arg-2 is "어려움":
                add arg-3 to {퀘스트일일어려움::*}
            else if arg-2 is "전문":
                add arg-3 to {퀘스트일일전문::*}

        else if arg-1 is "weekly":
            # 주간: /questsync weekly 주간_물고기30
            add arg-2 to {퀘스트주간목록::*}

        else if arg-1 is "add":
            # 퀘스트 등록: /questsync add 튜토01
            add arg-2 to {퀘스트목록::*}
            delete {퀘스트::%arg-2%::목표::*}
            delete {퀘스트::%arg-2%::설명::*}

        else if arg-1 is "field":
            # 필드 세팅: /questsync field 튜토01 이름 낚싯대를잡아라
            # arg-2=ID, arg-3=필드명, arg-4=값
            if arg-3 is "필요레벨" or "보상돈" or "보상경험치":
                set {퀘스트::%arg-2%::%arg-3%} to arg-4 parsed as integer
            else:
                set {퀘스트::%arg-2%::%arg-3%} to arg-4

        else if arg-1 is "desc":
            # 설명: /questsync desc 튜토01 1 &7물가에서낚싯대를던져
            set {퀘스트::%arg-2%::설명::%arg-3%} to arg-4

        else if arg-1 is "goal":
            # 목표: /questsync goal 튜토01 fish|아무|아무|3|0
            add arg-3 to {퀘스트::%arg-2%::목표::*}

# =====================================================================
# questpush — Java 퀘스트 GUI on-open 동기 (Skript→Java, per-player)
#   GUI 열 때만 호출. "모든 변경마다 push" 아님(race 방지).
#   {퀘스트목록::*}(1단 플랫 qid 리스트, Java가 sync)를 순회하며 그 플레이어 quest를 Java 미러로 push.
#   온라인 player(UUID키)로 동작 — parsed as offline player(이름키) 쓰지 않음.
# =====================================================================
command /questpush <text>:
    permission: op
    executable by: console
    trigger:
        set {_p} to arg-1 parsed as player
        if {_p} is not set:
            stop
        set {_n} to name of {_p}
        # stale 잔존 방지 — 그 플레이어 quest 미러만 비움(전체 questclear 아님)
        execute console command "pdbackup %{_n}% questclearone x"
        # 모든 퀘스트 상태/진행도 ({퀘스트목록} 순회 — {퀘스트상태::*}는 중첩 중간노드라 열거 불가)
        loop {퀘스트목록::*}:
            set {_qid} to loop-value
            set {_qs} to {퀘스트상태::%{_qid}%::%{_p}%}
            if {_qs} is set:
                set {_prog} to ""
                loop integers from 1 to 10:
                    set {_val} to {퀘스트진행::%{_qid}%::%{_p}%::%loop-integer%}
                    if {_val} is set:
                        if {_prog} is "":
                            set {_prog} to "%loop-integer%::%{_val}%"
                        else:
                            set {_prog} to "%{_prog}%||%loop-integer%::%{_val}%"
                if {_prog} is "":
                    set {_prog} to "없음"
                execute console command "pdbackup %{_n}% quest %{_qid}% %{_qs}% %{_prog}%"
        # 활성 퀘스트 목록
        set {_activeStr} to ""
        loop {활성퀘스트::%{_p}%::*}:
            if {_activeStr} is "":
                set {_activeStr} to loop-value
            else:
                set {_activeStr} to "%{_activeStr}%||%loop-value%"
        if {_activeStr} is "":
            set {_activeStr} to "없음"
        execute console command "pdbackup %{_n}% activequests %{_activeStr}%"
        # 주간 퀘스트 목록
        set {_weeklyStr} to ""
        loop {주간퀘스트::%{_p}%::*}:
            if {_weeklyStr} is "":
                set {_weeklyStr} to loop-value
            else:
                set {_weeklyStr} to "%{_weeklyStr}%||%loop-value%"
        if {_weeklyStr} is "":
            set {_weeklyStr} to "없음"
        execute console command "pdbackup %{_n}% weeklyquests %{_weeklyStr}%"
        # 일일 퀘스트 목록 (dailyquests 전용 케이스 — ID에 _ 포함 가능, exlist는 _→공백 변환되어 금지) + 난이도 (exstr)
        set {_dailyStr} to ""
        loop {일일퀘스트::%{_p}%::*}:
            if {_dailyStr} is "":
                set {_dailyStr} to loop-value
            else:
                set {_dailyStr} to "%{_dailyStr}%||%loop-value%"
        if {_dailyStr} is "":
            set {_dailyStr} to "없음"
        execute console command "pdbackup %{_n}% dailyquests %{_dailyStr}%"
        set {_diff} to {일일퀘스트난이도::%{_p}%}
        if {_diff} is not set:
            set {_diff} to "없음"
        execute console command "pdbackup %{_n}% exstr 일일퀘스트난이도 %{_diff}%"

# =====================================================================
# questaction — Java 퀘스트 GUI 액션 → Skript 로직 함수 위임
#   /questaction <player> accept|reward|abandon|daily <qid 또는 난이도>
# =====================================================================
command /questaction <text> <text> [<text>]:
    permission: op
    executable by: console
    trigger:
        set {_p} to arg-1 parsed as player
        if {_p} is not set:
            stop
        set {_verb} to arg-2
        if {_verb} is "accept":
            퀘스트수락({_p}, arg-3)
        else if {_verb} is "reward":
            퀘스트보상({_p}, arg-3)
        else if {_verb} is "abandon":
            퀘스트포기({_p}, arg-3)
        else if {_verb} is "daily":
            일일퀘스트수락({_p}, arg-3)
