# ===== 퀘스트 데이터 — Java QuestManager에서 JSON 로드 후 동기화 =====
# 기존 하드코딩 제거 → /questsync 브릿지로 변수 세팅
# 퀘스트 목표 포맷:
#   fish|이름(또는 아무)|등급(또는 아무)|수량|최소크기
#   fish_fresh|이름(또는 아무)|등급(또는 아무)|수량|최소크기|최소품질(0~100)
#   material|재료ID(또는 아무)|수량
#   level|목표레벨
#   area|지역명
#   sell|수량
#   money|금액
#   login|일수
#   quest_daily|횟수
#   dogam|지역(섬)ID|종수    ← 해당 지역+하위지역 도감 N종 발견 (예: dogam|사막|35)

# ===== questsync 브릿지 명령어 (Java → Skript) =====
command /questsync <text> [<text>] [<text>] [<text>]:
    permission: op
    executable by: console
    trigger:
        if arg-1 is "init":
            # 리스트 초기화
            delete {퀘스트목록::*}
            delete {퀘스트일일쉬움::*}
            delete {퀘스트일일보통::*}
            delete {퀘스트일일어려움::*}
            delete {퀘스트일일전문::*}
            delete {퀘스트주간목록::*}

        else if arg-1 is "difflevel":
            # 난이도 레벨: /questsync difflevel 쉬움 1
            set {일일난이도레벨::%arg-2%} to arg-3 parsed as integer

        else if arg-1 is "daily":
            # 일일 리스트: /questsync daily 쉬움 일일_쉬움_물고기3
            if arg-2 is "쉬움":
                add arg-3 to {퀘스트일일쉬움::*}
            else if arg-2 is "보통":
                add arg-3 to {퀘스트일일보통::*}
            else if arg-2 is "어려움":
                add arg-3 to {퀘스트일일어려움::*}
            else if arg-2 is "전문":
                add arg-3 to {퀘스트일일전문::*}

        else if arg-1 is "weekly":
            # 주간: /questsync weekly 주간_물고기30
            add arg-2 to {퀘스트주간목록::*}

        else if arg-1 is "add":
            # 퀘스트 등록: /questsync add 튜토01
            add arg-2 to {퀘스트목록::*}
            delete {퀘스트::%arg-2%::목표::*}
            delete {퀘스트::%arg-2%::설명::*}

        else if arg-1 is "field":
            # 필드 세팅: /questsync field 튜토01 이름 낚싯대를잡아라
            # arg-2=ID, arg-3=필드명, arg-4=값
            if arg-3 is "필요레벨" or "보상돈" or "보상경험치":
                set {퀘스트::%arg-2%::%arg-3%} to arg-4 parsed as integer
            else:
                set {퀘스트::%arg-2%::%arg-3%} to arg-4

        else if arg-1 is "desc":
            # 설명: /questsync desc 튜토01 1 &7물가에서낚싯대를던져
            set {퀘스트::%arg-2%::설명::%arg-3%} to arg-4

        else if arg-1 is "goal":
            # 목표: /questsync goal 튜토01 fish|아무|아무|3|0
            add arg-3 to {퀘스트::%arg-2%::목표::*}
