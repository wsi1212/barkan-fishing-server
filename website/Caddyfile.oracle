lh-bizben.duckdns.org {
    reverse_proxy localhost:3000
}

barkan.kr, www.barkan.kr, barkan.kro.kr {
    # OAuth 세션은 호스트별 쿠키라서 레거시 도메인에서 로그인 흐름을
    # 시작하면 barkan.kr 콜백에서 state 쿠키를 찾을 수 없다. 모든 요청을
    # canonical host로 먼저 모아 Discord OAuth state_mismatch를 방지한다.
    @legacy_host host www.barkan.kr barkan.kro.kr
    redir @legacy_host https://barkan.kr{uri} 308
    redir /vip /vip/ 308
    # Compress static JSON tile payloads and JS before they cross the network.
    encode zstd gzip

    handle /community* {
        reverse_proxy 127.0.0.1:3100
    }

    handle_path /vip/* {
        reverse_proxy 127.0.0.1:3100
    }

    handle /barkan-resourcepack*.zip {
        root * /var/www/barkan
        file_server
    }

    handle_path /admin/* {
        reverse_proxy 127.0.0.1:8080
    }

    handle /api/ranking {
        reverse_proxy 127.0.0.1:8080
    }

    handle /ranking* {
        root * /var/www/barkan/site
        rewrite * /ranking.html
        file_server
    }

    handle /wiki* {
        root * /var/www/barkan/site
        rewrite * /wiki.html
        file_server
    }

    handle /dex* {
        root * /var/www/barkan/site
        rewrite * /dex.html
        file_server
    }

    handle /catalog* {
        root * /var/www/barkan/site
        rewrite * /catalog.html
        file_server
    }

    handle /gear* {
        root * /var/www/barkan/site
        rewrite * /gear.html
        file_server
    }

    handle /map* {
        root * /var/www/barkan/site
        rewrite * /map.html
        # The map renderer is cache-busted independently, but keep this HTML
        # shell fresh so an old script version cannot survive a deployment.
        header Cache-Control "no-store"
        file_server
    }

    handle {
        root * /var/www/barkan/site
        try_files {path} /index.html
        file_server
    }
}
