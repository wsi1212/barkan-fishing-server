lh-bizben.duckdns.org {
    reverse_proxy localhost:3000
}

barkan.kr, www.barkan.kr, barkan.kro.kr {
    # OAuth 세션은 호스트별 쿠키라서 레거시 도메인에서 로그인 흐름을
    # 시작하면 barkan.kr 콜백에서 state 쿠키를 찾을 수 없다. 모든 요청을
    # canonical host로 먼저 모아 Discord OAuth state_mismatch를 방지한다.
    @legacy_host host www.barkan.kr barkan.kro.kr
    redir @legacy_host https://barkan.kr{uri} 308
    redir /vip /vip/ 308

    # ── 베드락(모바일) 유저용 짧은 외부 링크 ──────────────────────────────
    # ★왜 필요한가: 베드락 클라이언트에는 «채팅 링크를 눌러 브라우저를 여는» 기능이
    #   아예 없다(Geyser #1340 = Missing Client Feature, not planned). 책·표지판·폼도
    #   같고, 폼 입력칸은 모바일에서 선택·복사조차 안 된다. 그래서 베드락 유저가 외부
    #   주소에 도달하는 유일한 길은 «손으로 치는 것»이다 — 큰 베드락 서버들이 하나같이
    #   짧은 도메인(hive.gg 등)을 쓰는 이유가 이거다.
    #   ⇒ 게임 안에서는 이 짧은 경로만 보여 주고, 진짜 주소는 여기서 갈아끼운다.
    #   경로를 바꾸면 BlockShip config.yml(vote-url-*-short)·DiscordCommand 도 같이 볼 것.
    redir /v   https://minelist.kr/servers/17441-barkan.kr/votes/new 302
    redir /vb  https://minelist.kr/servers/17442-barkan.kr:19132/votes/new 302
    redir /d   https://discord.gg/fWVGGEbBsd 302
    redir /tip https://barkan.kr/community/post/11507518-a6b9-4a0e-986d-c817c354e32f 302
    # Compress static JSON tile payloads and JS before they cross the network.
    encode zstd gzip

    handle /community* {
        reverse_proxy 127.0.0.1:3100
    }

    handle_path /vip/* {
        reverse_proxy 127.0.0.1:3100
    }

    handle /barkan-resourcepack*.zip {
        root * /var/www/barkan
        file_server
    }

    # CraftEngine 가구팩. 예전엔 GitHub Release 자산이었는데, prod 가 스스로 팩을
    # 갱신하려면 업로드 권한(contents:write)이 필요해서 스테이징 무인배포가 불가능했다.
    # 여기서 직접 서빙하면 prod 는 파일 복사 + config sha1 갱신만 하면 된다.
    handle /barkan-furniture*.zip {
        root * /var/www/barkan
        file_server
    }

    handle_path /admin/* {
        reverse_proxy 127.0.0.1:8080
    }

    handle /api/ranking {
        reverse_proxy 127.0.0.1:8080
    }

    handle /ranking* {
        root * /var/www/barkan/site
        rewrite * /ranking.html
        file_server
    }

    # The interactive wiki index remains at /wiki, but each public guide has
    # a static HTML representation.  Crawlers receive its real title, canonical
    # URL, structured data and article text without needing JavaScript.
    @wiki_trailing path_regexp wiki_trailing ^/wiki/(.+)/$
    redir @wiki_trailing /wiki/{re.wiki_trailing.1} 308

    handle /wiki {
        root * /var/www/barkan/site
        rewrite * /wiki.html
        file_server
    }

    handle /wiki/* {
        root * /var/www/barkan/site
        # With no fallback, an unknown guide remains a real 404 instead of
        # becoming the wiki home (and therefore a soft 404 to crawlers).
        try_files {path}.html
        file_server
    }

    handle /dex* {
        root * /var/www/barkan/site
        rewrite * /dex.html
        file_server
    }

    handle /catalog* {
        root * /var/www/barkan/site
        rewrite * /catalog.html
        file_server
    }

    handle /law* {
        root * /var/www/barkan/site
        rewrite * /law.html
        file_server
    }

    handle /gear* {
        root * /var/www/barkan/site
        rewrite * /gear.html
        file_server
    }

    handle /map* {
        root * /var/www/barkan/site
        rewrite * /map.html
        # The map renderer is cache-busted independently, but keep this HTML
        # shell fresh so an old script version cannot survive a deployment.
        header Cache-Control "no-store"
        file_server
    }

    handle {
        root * /var/www/barkan/site
        # Do not turn misspelled URLs into a 200 homepage (a soft 404).
        # Directories still resolve their normal index.html through file_server.
        try_files {path} {path}/
        file_server
    }
}
