# ===== 포탈 시스템 =====
# 특정 구역 진입 → 다른 월드 특정 좌표로 TP
# 지역 시스템(MarSkRebirth)과 완전 독립
#
# 사용법 (OP 전용):
#   /포탈 pos1              — 현재 위치를 꼭짓점1로 설정
#   /포탈 pos2              — 현재 위치를 꼭짓점2로 설정
#   /포탈 생성 <이름>        — 선택한 두 점으로 포탈 입구 생성
#   /포탈 도착점 <이름>      — 현재 위치를 포탈의 도착점으로 설정
#   /포탈 삭제 <이름>        — 포탈 삭제
#   /포탈 목록              — 전체 포탈 목록
#   /포탈 정보 <이름>        — 포탈 상세 정보

# ===== 구역 진입 감지 (0.5초마다) =====
every 10 ticks:
    if {포탈목록::*} is not set:
        stop
    loop all players:
        set {_p} to loop-player
        if {포탈쿨::%{_p}%} is not set:
            set {_px} to x-coordinate of {_p}
            set {_py} to y-coordinate of {_p}
            set {_pz} to z-coordinate of {_p}
            set {_pw} to "%world of {_p}%"
            set {_found} to false
            loop {포탈목록::*}:
                if {_found} is false:
                    set {_name} to loop-value-2
                    if {_pw} is {포탈::%{_name}%::월드}:
                        if {_px} >= {포탈::%{_name}%::minX}:
                            if {_px} <= {포탈::%{_name}%::maxX} + 1:
                                if {_py} >= {포탈::%{_name}%::minY}:
                                    if {_py} <= {포탈::%{_name}%::maxY} + 1:
                                        if {_pz} >= {포탈::%{_name}%::minZ}:
                                            if {_pz} <= {포탈::%{_name}%::maxZ} + 1:
                                                if {포탈::%{_name}%::도착월드} is set:
                                                    set {_found} to true
                                                    # 쿨타임 설정 (3초)
                                                    set {포탈쿨::%{_p}%} to true
                                                    # TP 실행 (월드 이동은 execute in 필수)
                                                    set {_dw} to {포탈::%{_name}%::도착월드}
                                                    set {_dx} to {포탈::%{_name}%::도착x}
                                                    set {_dy} to {포탈::%{_name}%::도착y}
                                                    set {_dz} to {포탈::%{_name}%::도착z}
                                                    make {_p} execute command "execute in minecraft:%{_dw}% run tp @s %{_dx}% %{_dy}% %{_dz}%"
                                                    send "&8[&5포탈&8] &f%{_name}% &7포탈을 통해 이동했습니다." to {_p}
                                                    play sound "entity.enderman.teleport" with volume 0.8 and pitch 1.2 to {_p}
                                                    wait 3 seconds
                                                    delete {포탈쿨::%{_p}%}

# ===== 명령어 =====
command /포탈 [<text>] [<text>]:
    permission: op
    trigger:
        if arg-1 is not set:
            send "&8[&5포탈&8] &f사용법:"
            send "&7/포탈 pos1 &8— 꼭짓점1 설정"
            send "&7/포탈 pos2 &8— 꼭짓점2 설정"
            send "&7/포탈 생성 <이름> &8— 포탈 입구 생성"
            send "&7/포탈 도착점 <이름> &8— 도착점 설정"
            send "&7/포탈 삭제 <이름> &8— 포탈 삭제"
            send "&7/포탈 목록 &8— 전체 목록"
            send "&7/포탈 정보 <이름> &8— 상세 정보"
            stop

        # === pos1 ===
        if arg-1 is "pos1":
            set {포탈pos1::%player%::x} to floor(x-coordinate of player)
            set {포탈pos1::%player%::y} to floor(y-coordinate of player)
            set {포탈pos1::%player%::z} to floor(z-coordinate of player)
            set {포탈pos1::%player%::월드} to "%world of player%"
            send "&8[&5포탈&8] &aPos1 설정: &f%{포탈pos1::%player%::x}% %{포탈pos1::%player%::y}% %{포탈pos1::%player%::z}% &7(%{포탈pos1::%player%::월드}%)"
            stop

        # === pos2 ===
        if arg-1 is "pos2":
            set {포탈pos2::%player%::x} to floor(x-coordinate of player)
            set {포탈pos2::%player%::y} to floor(y-coordinate of player)
            set {포탈pos2::%player%::z} to floor(z-coordinate of player)
            set {포탈pos2::%player%::월드} to "%world of player%"
            send "&8[&5포탈&8] &aPos2 설정: &f%{포탈pos2::%player%::x}% %{포탈pos2::%player%::y}% %{포탈pos2::%player%::z}% &7(%{포탈pos2::%player%::월드}%)"
            stop

        # === 생성 ===
        if arg-1 is "생성":
            if arg-2 is not set:
                send "&8[&5포탈&8] &c/포탈 생성 <이름>"
                stop
            if {포탈pos1::%player%::x} is not set:
                send "&8[&5포탈&8] &cPos1이 설정되지 않았습니다. /포탈 pos1"
                stop
            if {포탈pos2::%player%::x} is not set:
                send "&8[&5포탈&8] &cPos2가 설정되지 않았습니다. /포탈 pos2"
                stop
            if {포탈pos1::%player%::월드} is not {포탈pos2::%player%::월드}:
                send "&8[&5포탈&8] &cPos1과 Pos2가 같은 월드여야 합니다."
                stop
            set {_name} to arg-2
            # min/max 계산
            set {포탈::%{_name}%::월드} to {포탈pos1::%player%::월드}
            if {포탈pos1::%player%::x} < {포탈pos2::%player%::x}:
                set {포탈::%{_name}%::minX} to {포탈pos1::%player%::x}
                set {포탈::%{_name}%::maxX} to {포탈pos2::%player%::x}
            else:
                set {포탈::%{_name}%::minX} to {포탈pos2::%player%::x}
                set {포탈::%{_name}%::maxX} to {포탈pos1::%player%::x}
            if {포탈pos1::%player%::y} < {포탈pos2::%player%::y}:
                set {포탈::%{_name}%::minY} to {포탈pos1::%player%::y}
                set {포탈::%{_name}%::maxY} to {포탈pos2::%player%::y}
            else:
                set {포탈::%{_name}%::minY} to {포탈pos2::%player%::y}
                set {포탈::%{_name}%::maxY} to {포탈pos1::%player%::y}
            if {포탈pos1::%player%::z} < {포탈pos2::%player%::z}:
                set {포탈::%{_name}%::minZ} to {포탈pos1::%player%::z}
                set {포탈::%{_name}%::maxZ} to {포탈pos2::%player%::z}
            else:
                set {포탈::%{_name}%::minZ} to {포탈pos2::%player%::z}
                set {포탈::%{_name}%::maxZ} to {포탈pos1::%player%::z}
            # 목록에 추가
            if {포탈목록::*} does not contain {_name}:
                add {_name} to {포탈목록::*}
            send "&8[&5포탈&8] &a포탈 '%{_name}%' 입구 생성 완료!"
            send "&7범위: %{포탈::%{_name}%::minX}%,%{포탈::%{_name}%::minY}%,%{포탈::%{_name}%::minZ}% → %{포탈::%{_name}%::maxX}%,%{포탈::%{_name}%::maxY}%,%{포탈::%{_name}%::maxZ}%"
            send "&c도착점을 설정하세요: /포탈 도착점 %{_name}%"
            # 임시 변수 정리
            delete {포탈pos1::%player%::*}
            delete {포탈pos2::%player%::*}
            stop

        # === 도착점 ===
        if arg-1 is "도착점":
            if arg-2 is not set:
                send "&8[&5포탈&8] &c/포탈 도착점 <이름>"
                stop
            set {_name} to arg-2
            if {포탈::%{_name}%::월드} is not set:
                send "&8[&5포탈&8] &c포탈 '%{_name}%'이(가) 존재하지 않습니다."
                stop
            set {포탈::%{_name}%::도착월드} to "%world of player%"
            set {포탈::%{_name}%::도착x} to floor(x-coordinate of player)
            set {포탈::%{_name}%::도착y} to floor(y-coordinate of player)
            set {포탈::%{_name}%::도착z} to floor(z-coordinate of player)
            send "&8[&5포탈&8] &a포탈 '%{_name}%' 도착점 설정 완료!"
            send "&7도착: %{포탈::%{_name}%::도착월드}% %{포탈::%{_name}%::도착x}% %{포탈::%{_name}%::도착y}% %{포탈::%{_name}%::도착z}%"
            stop

        # === 삭제 ===
        if arg-1 is "삭제":
            if arg-2 is not set:
                send "&8[&5포탈&8] &c/포탈 삭제 <이름>"
                stop
            set {_name} to arg-2
            if {포탈::%{_name}%::월드} is not set:
                send "&8[&5포탈&8] &c포탈 '%{_name}%'이(가) 존재하지 않습니다."
                stop
            delete {포탈::%{_name}%::*}
            remove {_name} from {포탈목록::*}
            send "&8[&5포탈&8] &c포탈 '%{_name}%' 삭제됨."
            stop

        # === 목록 ===
        if arg-1 is "목록":
            if {포탈목록::*} is not set:
                send "&8[&5포탈&8] &7등록된 포탈이 없습니다."
                stop
            send "&8[&5포탈&8] &f등록된 포탈 (%size of {포탈목록::*}%개):"
            loop {포탈목록::*}:
                set {_name} to loop-value
                if {포탈::%{_name}%::도착월드} is set:
                    send "&a  ✓ %{_name}% &7— %{포탈::%{_name}%::월드}% → %{포탈::%{_name}%::도착월드}%"
                else:
                    send "&c  ✗ %{_name}% &7— 도착점 미설정"
            stop

        # === 정보 ===
        if arg-1 is "정보":
            if arg-2 is not set:
                send "&8[&5포탈&8] &c/포탈 정보 <이름>"
                stop
            set {_name} to arg-2
            if {포탈::%{_name}%::월드} is not set:
                send "&8[&5포탈&8] &c포탈 '%{_name}%'이(가) 존재하지 않습니다."
                stop
            send "&8[&5포탈&8] &f포탈: &e%{_name}%"
            send "&7입구 월드: &f%{포탈::%{_name}%::월드}%"
            send "&7범위: &f%{포탈::%{_name}%::minX}% %{포탈::%{_name}%::minY}% %{포탈::%{_name}%::minZ}% &7→ &f%{포탈::%{_name}%::maxX}% %{포탈::%{_name}%::maxY}% %{포탈::%{_name}%::maxZ}%"
            if {포탈::%{_name}%::도착월드} is set:
                send "&7도착: &f%{포탈::%{_name}%::도착월드}% %{포탈::%{_name}%::도착x}% %{포탈::%{_name}%::도착y}% %{포탈::%{_name}%::도착z}%"
            else:
                send "&c도착점 미설정!"
            stop

        send "&8[&5포탈&8] &c알 수 없는 명령어. /포탈 으로 사용법 확인."
