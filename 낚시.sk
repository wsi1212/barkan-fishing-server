# 기본 E
# E D C B A S S+ M L G
#
#
#
on fish caught:
    if {미니게임::%player%} is 1:
        cancel event
        stop
    # 지역 레벨 제한 체크
    set {_reqLv} to regionRequiredLevel({area::%player%})
    if {_reqLv} > 0:
        if {낚시레벨::%player%} is not set:
            set {낚시레벨::%player%} to 1
        if {낚시레벨::%player%} < {_reqLv}:
            cancel event
            kill fishing hook
            message "&8[&b 낚시 &8] &c이 지역에서 낚시하려면 낚시 레벨 &e%{_reqLv}% &c이상이 필요합니다. &7(현재: Lv.%{낚시레벨::%player%}%)" to player
            stop
    set {_fishes::*} to get_fish({area::%player%})
    cancel event
    kill fishing hook
    set player's level to 0
    set player's level progress to 0
    # ===== 환경 감지 & 특수 물고기 추가 =====
    set {_시간대} to 현재시간대(player)
    set {_날씨} to 현재날씨(player)
    # 전역 환경 물고기 (새벽/밤/비/뇌우)
    if {_시간대} is "새벽":
        set {_dawn::*} to get_dawn_fish({area::%player%})
        add {_dawn::*} to {_fishes::*}
    else if {_시간대} is "밤":
        set {_night::*} to get_night_fish({area::%player%})
        add {_night::*} to {_fishes::*}
    if {_날씨} is "비" or "뇌우":
        set {_rain::*} to get_rain_fish({area::%player%})
        add {_rain::*} to {_fishes::*}
    if {_날씨} is "뇌우":
        set {_thunder::*} to get_thunder_fish({area::%player%})
        add {_thunder::*} to {_fishes::*}
    # 지역별 시간/날씨 물고기 (원양어선 등)
    set {_envFish::*} to get_region_env_fish({area::%player%}, {_시간대}, {_날씨})
    add {_envFish::*} to {_fishes::*}
    # 환경 보너스 계산
    set {_tBonus::*} to split 시간보너스({_시간대}) at "|"
    set {_wBonus::*} to split 날씨보너스({_날씨}) at "|"
    set {_환경경험치보너스} to ({_tBonus::1} parsed as number) + ({_wBonus::1} parsed as number)
    set {_환경크기보너스} to ({_tBonus::2} parsed as number) + ({_wBonus::2} parsed as number)
    set {_환경등급시프트} to ({_tBonus::3} parsed as number) + ({_wBonus::3} parsed as number)
    # 환경 등급업 출처 추적 (이름 + 기여값)
    if ({_tBonus::3} parsed as number) > 0:
        add {_시간대} to {_등급업출처::*}
        add ({_tBonus::3} parsed as number) to {_등급업출처값::*}
    if ({_wBonus::3} parsed as number) > 0:
        add {_날씨} to {_등급업출처::*}
        add ({_wBonus::3} parsed as number) to {_등급업출처값::*}
    # ===== 레벨 기반 최대 등급 캡 (70Lv에 모든 등급 해금) =====
    set {_maxGradeNum} to 6
    if {낚시레벨::%player%} >= 15:
        set {_maxGradeNum} to 7
    if {낚시레벨::%player%} >= 30:
        set {_maxGradeNum} to 8
    if {낚시레벨::%player%} >= 45:
        set {_maxGradeNum} to 9
    if {낚시레벨::%player%} >= 60:
        set {_maxGradeNum} to 10
    # ===== 등급 범위 파싱 → 등급풀 분류 =====
    loop {_fishes::*}:
        set {_fp::*} to split loop-value-1 at "|"
        set {_gradeField} to {_fp::4}
        if {_gradeField} contains "~":
            set {_gr::*} to split {_gradeField} at "~"
            set {_gMin} to rankchange({_gr::1})
            set {_gMax} to rankchange({_gr::2})
        else:
            set {_gMin} to rankchange({_gradeField})
            set {_gMax} to {_gMin}
        if {_gMax} > {_maxGradeNum}:
            set {_gMax} to {_maxGradeNum}
        if {_gMin} <= {_gMax}:
            loop integers from {_gMin} to {_gMax}:
                set {_gName} to num_to_grade(loop-value-2)
                add loop-value-1 to {_%{_gName}%::*}
    # ===== PRD (의사난수분포) 등급 결정 =====
    # base_c × (1 + 연속실패횟수) = 실제 확률. 레벨 제한 미달 등급은 롤/피티 모두 스킵.
    # {_maxGradeNum}: S=6, S+=7, M=8, L=9, G=10
    set {_등급} to "E"
    # G등급 (표기 0.01%) — 레벨 50+ (gradeNum 10)
    if {_maxGradeNum} >= 10:
        set {_p} to {등급피티::%player%::G}
        if {_p} is not set:
            set {_p} to 0
        chance of (0.001 * (1 + {_p}))%:
            set {_등급} to "G"
            set {등급피티::%player%::G} to 0
    # L등급 (표기 0.1%) — 레벨 40+ (gradeNum 9)
    if {_등급} is "E":
        if {_maxGradeNum} >= 9:
            set {_p} to {등급피티::%player%::L}
            if {_p} is not set:
                set {_p} to 0
            chance of (0.001 * (1 + {_p}))%:
                set {_등급} to "L"
                set {등급피티::%player%::L} to 0
    # M등급 (표기 0.3%) — 레벨 30+ (gradeNum 8)
    if {_등급} is "E":
        if {_maxGradeNum} >= 8:
            set {_p} to {등급피티::%player%::M}
            if {_p} is not set:
                set {_p} to 0
            chance of (0.0014 * (1 + {_p}))%:
                set {_등급} to "M"
                set {등급피티::%player%::M} to 0
    # S+ (표기 1.6%) — 레벨 20+ (gradeNum 7)
    if {_등급} is "E":
        if {_maxGradeNum} >= 7:
            set {_p} to {등급피티::%player%::SP}
            if {_p} is not set:
                set {_p} to 0
            chance of (0.04 * (1 + {_p}))%:
                set {_등급} to "S+"
                set {등급피티::%player%::SP} to 0
    # S (표기 3.06%) — 레벨 제한 없음 (gradeNum 6, 기본 캡)
    if {_등급} is "E":
        set {_p} to {등급피티::%player%::S}
        if {_p} is not set:
            set {_p} to 0
        chance of (0.146 * (1 + {_p}))%:
            set {_등급} to "S"
            set {등급피티::%player%::S} to 0
    # A
    if {_등급} is "E":
        set {_p} to {등급피티::%player%::A}
        if {_p} is not set:
            set {_p} to 0
        chance of (0.609 * (1 + {_p}))%:
            set {_등급} to "A"
            set {등급피티::%player%::A} to 0
    # B
    if {_등급} is "E":
        set {_p} to {등급피티::%player%::B}
        if {_p} is not set:
            set {_p} to 0
        chance of (1.868 * (1 + {_p}))%:
            set {_등급} to "B"
            set {등급피티::%player%::B} to 0
    # C
    if {_등급} is "E":
        set {_p} to {등급피티::%player%::C}
        if {_p} is not set:
            set {_p} to 0
        chance of (7.13 * (1 + {_p}))%:
            set {_등급} to "C"
            set {등급피티::%player%::C} to 0
    # D
    if {_등급} is "E":
        set {_p} to {등급피티::%player%::D}
        if {_p} is not set:
            set {_p} to 0
        chance of (21.12 * (1 + {_p}))%:
            set {_등급} to "D"
            set {등급피티::%player%::D} to 0
    # 피티 카운터: 모든 등급 항상 +1 (레벨 해금 시 즉시 터질 수 있도록)
    # 나온 등급만 리셋
    if {_등급} is not "G":
        add 1 to {등급피티::%player%::G}
    if {_등급} is not "L":
        add 1 to {등급피티::%player%::L}
    if {_등급} is not "M":
        add 1 to {등급피티::%player%::M}
    if {_등급} is not "S+":
        add 1 to {등급피티::%player%::SP}
    if {_등급} is not "S":
        add 1 to {등급피티::%player%::S}
    if {_등급} is not "A":
        add 1 to {등급피티::%player%::A}
    if {_등급} is not "B":
        add 1 to {등급피티::%player%::B}
    if {_등급} is not "C":
        add 1 to {등급피티::%player%::C}
    if {_등급} is not "D":
        add 1 to {등급피티::%player%::D}
    # 테스트 등급 강제 적용
    if {테스트등급::%player%} is set:
        set {_등급} to {테스트등급::%player%}
        delete {테스트등급::%player%}
        message "&8[&e 테스트 &8] &a등급 강제 적용: &f%{_등급}%" to player

    if {_%{_등급}%::*} is not set:
        set {_등급} to "E"

    if {_등급} is "E":
        if {_E::*} is not set:
            if {_D::*} is set:
                set {_등급} to "D"
            else if {_C::*} is set:
                set {_등급} to "C"
            else if {_B::*} is set:
                set {_등급} to "B"
            else if {_A::*} is set:
                set {_등급} to "A"
            else if {_S::*} is set:
                set {_등급} to "S"
            else if {_S+::*} is set:
                set {_등급} to "S+"
            else if {_M::*} is set:
                set {_등급} to "M"
            else if {_L::*} is set:
                set {_등급} to "L"
            else if {_G::*} is set:
                set {_등급} to "G"
    else if {_등급} is "D":
        if {_D::*} is not set:
            if {_C::*} is set:
                set {_등급} to "C"
            else if {_B::*} is set:
                set {_등급} to "B"
            else if {_A::*} is set:
                set {_등급} to "A"
            else if {_S::*} is set:
                set {_등급} to "S"
            else if {_S+::*} is set:
                set {_등급} to "S+"
            else if {_M::*} is set:
                set {_등급} to "M"
            else if {_L::*} is set:
                set {_등급} to "L"
            else if {_G::*} is set:
                set {_등급} to "G"
    else if {_등급} is "C":
        if {_C::*} is not set:
            if {_B::*} is set:
                set {_등급} to "B"
            else if {_A::*} is set:
                set {_등급} to "A"
            else if {_S::*} is set:
                set {_등급} to "S"
            else if {_S+::*} is set:
                set {_등급} to "S+"
            else if {_M::*} is set:
                set {_등급} to "M"
            else if {_L::*} is set:
                set {_등급} to "L"
            else if {_G::*} is set:
                set {_등급} to "G"
    else if {_등급} is "B":
        if {_B::*} is not set:
            if {_A::*} is set:
                set {_등급} to "A"
            else if {_S::*} is set:
                set {_등급} to "S"
            else if {_S+::*} is set:
                set {_등급} to "S+"
            else if {_M::*} is set:
                set {_등급} to "M"
            else if {_L::*} is set:
                set {_등급} to "L"
            else if {_G::*} is set:
                set {_등급} to "G"
    else if {_등급} is "A":
        if {_A::*} is not set:
            if {_S::*} is set:
                set {_등급} to "S"
            else if {_S+::*} is set:
                set {_등급} to "S+"
            else if {_M::*} is set:
                set {_등급} to "M"
            else if {_L::*} is set:
                set {_등급} to "L"
            else if {_G::*} is set:
                set {_등급} to "G"
    else if {_등급} is "S":
        if {_S::*} is not set:
            if {_S+::*} is set:
                set {_등급} to "S+"
            else if {_M::*} is set:
                set {_등급} to "M"
            else if {_L::*} is set:
                set {_등급} to "L"
            else if {_G::*} is set:
                set {_등급} to "G"
    else if {_등급} is "S+":
        if {_S+::*} is not set:
            if {_M::*} is set:
                set {_등급} to "M"
            else if {_L::*} is set:
                set {_등급} to "L"
            else if {_G::*} is set:
                set {_등급} to "G"
    else if {_등급} is "M":
        if {_M::*} is not set:
            if {_L::*} is set:
                set {_등급} to "L"
            else if {_G::*} is set:
                set {_등급} to "G"
    else if {_등급} is "L":
        if {_L::*} is not set:
            if {_G::*} is set:
                set {_등급} to "G"
    else:
        message "&f이곳엔 물고기가 존재하지 않습니다." to player
        stop
    set {_크리티컬확률} to 0
    set {_크리티컬데미지} to 1
    set {_최대등급} to "S"
    set {_도망확률감소} to 0
    if {낚시레벨::%player%} >= 5:
        add 5 to {_크리티컬확률}#크확 +5
    if {낚시레벨::%player%} >= 10:
        add 1 to {_크리티컬데미지}#크뎀 +1
    if {낚시레벨::%player%} >= 15:
        add 1 to {_크리티컬확률}#크확 +1
    if {낚시레벨::%player%} >= 20:
        set {_최대등급} to "S+"
        add 1 to {_크리티컬데미지}#크뎀 +1
    if {낚시레벨::%player%} >= 25:
        add 1 to {_크리티컬확률}#크확 +1
    if {낚시레벨::%player%} >= 30:
        set {_최대등급} to "M"
        add 1 to {_크리티컬데미지}#크뎀+1
    if {낚시레벨::%player%} >= 35:
        add 1 to {_크리티컬확률}#크확+1
    if {낚시레벨::%player%} >= 40:
        set {_최대등급} to "L"
        add 1 to {_크리티컬데미지}#크뎀 +1
    if {낚시레벨::%player%} >= 45:
        add 1 to {_크리티컬확률}#크확 +1
    if {낚시레벨::%player%} >= 50:
        set {_최대등급} to "G"
        add 1 to {_크리티컬데미지}
    if {낚시레벨::%player%} >= 55:
        add 1 to {_크리티컬확률}
    if {낚시레벨::%player%} >= 60:
        add 1 to {_크리티컬데미지}
    if {낚시레벨::%player%} >= 65:
        add 5 to {_도망확률감소}
    if {낚시레벨::%player%} >= 70:
        add 1 to {_크리티컬데미지}#크뎀 8 (캡 도달)
    if {낚시레벨::%player%} >= 75:
        add 5 to {_도망확률감소}
    if {낚시레벨::%player%} >= 80:
        add 2 to {_크리티컬확률}#캡 이후 크리확률로 전환
    if {낚시레벨::%player%} >= 85:
        add 10 to {_도망확률감소}
    if {낚시레벨::%player%} >= 90:
        add 2 to {_크리티컬확률}
    if {낚시레벨::%player%} >= 95:
        add 10 to {_도망확률감소}
    if {낚시레벨::%player%} >= 100:
        add 3 to {_크리티컬확률}#만렙 보너스
    # ===== 장비 보너스 스탯 (동적 파싱) =====
    set {_등급시프트} to 0
    set {_경험치보너스} to 0
    set {_크기보너스} to 0
    set {_낚싯대보너스} to 0
    set {_더블찬스} to 0
    set {_트리플찬스} to 0
    set {_판매보너스} to 0
    set {_내구보존} to 0
    set {_eqSlots::1} to "릴"
    set {_eqSlots::2} to "줄"
    set {_eqSlots::3} to "바늘"
    set {_eqSlots::4} to "미끼"
    set {_eqSlots::5} to "찌"
    loop 5 times:
        set {_eqSlot} to {_eqSlots::%loop-iteration%}
        set {_eqName} to {낚싯대부품::%{_eqSlot}%::%player%}
        if {_eqName} is set:
            set {_eqRaw} to get_part_stats_raw({_eqSlot}, {_eqName})
            set {_eqPairs::*} to split {_eqRaw} at ","
            loop {_eqPairs::*}:
                set {_eqKV::*} to split loop-value-2 at ":"
                set {_eqST} to {_eqKV::1}
                set {_eqSV} to {_eqKV::2} parsed as number
                if {_eqST} is "도망감소":
                    add {_eqSV} to {_도망확률감소}
                else if {_eqST} is "크리배율":
                    add {_eqSV} to {_크리티컬데미지}
                else if {_eqST} is "등급업":
                    add {_eqSV} to {_등급시프트}
                    add {_eqSlot} to {_등급업출처::*}
                    add {_eqSV} to {_등급업출처값::*}
                else if {_eqST} is "경험치":
                    add {_eqSV} to {_경험치보너스}
                else if {_eqST} is "크기":
                    add {_eqSV} to {_크기보너스}
                else if {_eqST} is "크리확률":
                    add {_eqSV} to {_크리티컬확률}
                else if {_eqST} is "난이도":
                    add {_eqSV} to {_낚싯대보너스}
                else if {_eqST} is "더블찬스":
                    add {_eqSV} to {_더블찬스}
                else if {_eqST} is "트리플찬스":
                    add {_eqSV} to {_트리플찬스}
                else if {_eqST} is "판매보너스":
                    add {_eqSV} to {_판매보너스}
                else if {_eqST} is "내구보존":
                    add {_eqSV} to {_내구보존}
    # 낚싯대 본체 스탯 — 손에 든 낚싯대 이름으로 판별 (복합 스탯 대응)
    set {_toolName} to name of player's tool
    loop {부품목록::낚싯대::*}:
        if {_toolName} contains loop-value:
            set {_rodRaw} to get_part_stats_raw("낚싯대", loop-value)
            set {_rodPairs::*} to split {_rodRaw} at ","
            loop {_rodPairs::*}:
                set {_rodKV::*} to split loop-value-2 at ":"
                set {_rodST} to {_rodKV::1}
                set {_rodSV} to {_rodKV::2} parsed as number
                if {_rodST} is "난이도":
                    add {_rodSV} to {_낚싯대보너스}
                else if {_rodST} is "도망감소":
                    add {_rodSV} to {_도망확률감소}
                else if {_rodST} is "크리배율":
                    add {_rodSV} to {_크리티컬데미지}
                else if {_rodST} is "등급업":
                    add {_rodSV} to {_등급시프트}
                    add "낚싯대" to {_등급업출처::*}
                    add {_rodSV} to {_등급업출처값::*}
                else if {_rodST} is "경험치":
                    add {_rodSV} to {_경험치보너스}
                else if {_rodST} is "크기":
                    add {_rodSV} to {_크기보너스}
                else if {_rodST} is "크리확률":
                    add {_rodSV} to {_크리티컬확률}
                else if {_rodST} is "더블찬스":
                    add {_rodSV} to {_더블찬스}
                else if {_rodST} is "트리플찬스":
                    add {_rodSV} to {_트리플찬스}
                else if {_rodST} is "판매보너스":
                    add {_rodSV} to {_판매보너스}
                else if {_rodST} is "내구보존":
                    add {_rodSV} to {_내구보존}
            stop loop
    # ===== 강화 보너스 적용 =====
    if {낚싯대강화난이도::%player%} is set:
        add {낚싯대강화난이도::%player%} to {_낚싯대보너스}
    if {낚싯대강화크기::%player%} is set:
        add {낚싯대강화크기::%player%} to {_크기보너스}
    if {낚싯대강화등급업::%player%} is set:
        add {낚싯대강화등급업::%player%} to {_등급시프트}
    if {낚싯대강화크리확률::%player%} is set:
        add {낚싯대강화크리확률::%player%} to {_크리티컬확률}
    if {낚싯대강화경험치::%player%} is set:
        add {낚싯대강화경험치::%player%} to {_경험치보너스}
    if {낚싯대강화더블::%player%} is set:
        add {낚싯대강화더블::%player%} to {_더블찬스}
    if {낚싯대강화트리플::%player%} is set:
        add {낚싯대강화트리플::%player%} to {_트리플찬스}
    if {낚싯대강화판매::%player%} is set:
        add {낚싯대강화판매::%player%} to {_판매보너스}
    if {낚싯대강화내구::%player%} is set:
        add {낚싯대강화내구::%player%} to {_내구보존}
    # ===== 축복(인챈트) 보너스 적용 =====
    if {낚싯대인챈트경험치::%player%} is set:
        add {낚싯대인챈트경험치::%player%} to {_경험치보너스}
    # ===== 도핑 보너스 적용 =====
    도핑체크(player)
    add 도핑경험치(player) to {_경험치보너스}
    add 도핑크기(player) to {_크기보너스}
    add 도핑등급업(player) to {_등급시프트}
    add 도핑도망감소(player) to {_도망확률감소}
    add 도핑크리확률(player) to {_크리티컬확률}
    add 도핑더블찬스(player) to {_더블찬스}
    add 도핑판매보너스(player) to {_판매보너스}
    # ===== 등급 업 (장비 + 환경 + 도핑 합산, 최대 30% 캡) =====
    set {_totalShift} to {_등급시프트} + {_환경등급시프트}
    if {_totalShift} > 30:
        set {_totalShift} to 30
    if {_totalShift} > 0:
        chance of {_totalShift}%:
            set {_nextGrade} to next_grade({_등급})
            if {_nextGrade} is not "":
                if {_%{_nextGrade}%::*} is set:
                    set {_oldGrade} to {_등급}
                    set {_등급} to {_nextGrade}
                    set {_gradeUpOld} to {_oldGrade}
                    set {_gradeUpNew} to {_nextGrade}
                    # 등급업으로 얻은 최종 등급의 피티만 리셋
                    if {_nextGrade} is "D":
                        set {등급피티::%player%::D} to 0
                    else if {_nextGrade} is "C":
                        set {등급피티::%player%::C} to 0
                    else if {_nextGrade} is "B":
                        set {등급피티::%player%::B} to 0
                    else if {_nextGrade} is "A":
                        set {등급피티::%player%::A} to 0
                    else if {_nextGrade} is "S":
                        set {등급피티::%player%::S} to 0
                    else if {_nextGrade} is "S+":
                        set {등급피티::%player%::SP} to 0
                    else if {_nextGrade} is "M":
                        set {등급피티::%player%::M} to 0
                    else if {_nextGrade} is "L":
                        set {등급피티::%player%::L} to 0
                    else if {_nextGrade} is "G":
                        set {등급피티::%player%::G} to 0

    if {용암낚시::%player%} is 1:
        if player's tool's name is not "&f용암 낚싯대":
            message "&c이 낚싯대로는 용암에서 낚시할 수 없습니다." to player
            stop
        

    set {_count} to 0
    loop {_%{_등급}%::*}:
        add 1 to {_count}
    set {_d} to random integer between 1 and {_count}
    set {_f::*} to split {_%{_등급}%::%{_d}%} at "|"
    set {_size} to random number between ({_f::2} parsed as number) and ({_f::3} parsed as number)
    if {_f::1} is not set:
        message "&f이곳엔 물고기가 존재하지 않습니다." to player
        stop
    # ========== 미니게임 시작 ==========
    set {_params::*} to split 미니게임파라미터({_등급}) at "|"
    set {_perfectWidth} to {_params::2} parsed as integer
    set {_speed} to {_params::3} parsed as integer
    set {_좌우속도} to {_params::6} parsed as integer
    set {_변속패턴} to {_params::7} parsed as integer
    set {_스팟이동속도} to {_params::8} parsed as integer
    set {_연속횟수} to {_params::9} parsed as integer
    if {_연속횟수} < 1:
        set {_연속횟수} to 1
    # 물고기 개별 난이도 보정 (같은 등급이라도 물고기마다 다름)
    set {_fishMod::*} to split 물고기개별난이도({_f::1}, {_등급}) at "|"
    set {_fishZoneMod} to {_fishMod::1} parsed as integer
    set {_fishSpeedMod} to {_fishMod::2} parsed as integer
    # 난이도 계산: 물고기 난이도(+) vs 낚싯대 보너스(-)
    set {_fishDiff} to 물고기난이도({_등급})
    set {_net} to {_낚싯대보너스} - {_fishDiff}
    # 커서 기본 속도: net 반영 (난이도 효과 소폭 상향 net/3)
    add floor({_net} / 3) to {_speed}
    add {_fishSpeedMod} to {_speed}
    if {_speed} < 1:
        set {_speed} to 1
    if {_speed} > 8:
        set {_speed} to 8
    # 좌우 속도 배율 적용 (물고기 개별 보정 포함)
    add {_fishSpeedMod} * 10 to {_좌우속도}
    # 바 폭: 난이도 낮으면 줄어듦 (성공존 유지, 실패 영역 감소) [12~30]
    set {_barWidth} to 14 - {_net}
    if {_barWidth} < 12:
        set {_barWidth} to 12
    if {_barWidth} > 30:
        set {_barWidth} to 30
    # 존 폭 = 5 + floor(net/2) + 물고기 개별 보정 [1~10] (난이도 효과 반감)
    set {_zoneWidth} to 5 + floor({_net} / 2) + {_fishZoneMod}
    # 레벨 보너스: 릴 도망확률감소 -> 존 폭 추가 (10%당 +1, 최대 +3)
    set {_zoneBonus} to floor({_도망확률감소} / 10)
    if {_zoneBonus} > 3:
        set {_zoneBonus} to 3
    add {_zoneBonus} to {_zoneWidth}
    # 초과 난이도: 존 폭이 1 미만으로 내려가야 할 만큼 난이도가 높으면 성공영역 랜덤 이동
    if {_zoneWidth} < 1:
        set {_overflowDiff} to 1 - {_zoneWidth}
        set {_zoneWidth} to 1
    else:
        set {_overflowDiff} to 0
    if {_zoneWidth} > 10:
        set {_zoneWidth} to 10
    # 바 폭이 존 폭+2보다 작지 않도록 보정
    if {_barWidth} < {_zoneWidth} + 2:
        set {_barWidth} to {_zoneWidth} + 2
    # 크리티컬 확률은 칸별 굴림에 사용 (기존 퍼펙트존 고정 폭 삭제)
    # 도주 확률 (등급 기본 - 도망확률감소/2, 최소 1%)
    set {_escapeBase} to ({_params::4} parsed as integer) - floor({_도망확률감소} / 2)
    if {_escapeBase} < 1:
        set {_escapeBase} to 1
    set {_escapeInc} to {_params::5} parsed as integer
    # ===== 연속 미니게임 루프 =====
    set {_roundSuccess} to 0
    set {_roundCritical} to 0
    set {_currentRound} to 0
    if {_연속횟수} > 1:
        send "&e&l연속 미니게임! &f총 &e%{_연속횟수}%&f회 성공해야 합니다!" to player
    while {_currentRound} < {_연속횟수}:
        add 1 to {_currentRound}
        # 존 위치 계산 (매 라운드마다 새로 배치)
        set {_maxStart} to {_barWidth} - {_zoneWidth}
        if {_maxStart} < 0:
            set {_maxStart} to 0
        set {_zoneStart} to random integer between 0 and {_maxStart}
        set {_zoneEnd} to {_zoneStart} + {_zoneWidth} - 1
        # 퍼펙트 존 (존 내부 랜덤 위치)
        set {_perfectMaxStart} to {_zoneEnd} - {_perfectWidth} + 1
        # 칸별 크리티컬 굴림 (각 초록 칸마다 크리확률% 독립 판정)
        delete {미니게임크리칸::%player%::*}
        loop integers from {_zoneStart} to {_zoneEnd}:
            chance of {_크리티컬확률}%:
                set {미니게임크리칸::%player%::%loop-integer%} to true
        # 스팟 이동 방향 설정 (일정 방향으로 움직임)
        set {_spotDir} to 1
        chance of 50%:
            set {_spotDir} to -1
        set {_spotMoveCount} to 0
        # 스팟 이동 간격 (이동속도가 높을수록 자주 이동)
        if {_스팟이동속도} > 0:
            set {_spotMoveInterval} to 10 - {_스팟이동속도}
            if {_spotMoveInterval} < 3:
                set {_spotMoveInterval} to 3
        else:
            set {_spotMoveInterval} to 999
        # 글로벌 변수 세팅 (클릭 핸들러용)
        set {미니게임::%player%} to 1
        set {미니게임커서::%player%} to 0
        set {미니게임결과::%player%} to "대기"
        set {미니게임존시작::%player%} to {_zoneStart}
        set {미니게임존끝::%player%} to {_zoneEnd}
        set {미니게임연속현재::%player%} to {_currentRound}
        set {미니게임연속총::%player%} to {_연속횟수}
        set {미니게임크리티컬확률::%player%} to {_크리티컬확률}
        set {미니게임도주확률::%player%} to {_escapeBase}
        set {미니게임도주증가::%player%} to {_escapeInc}
        # 라운드 안내
        if {_연속횟수} > 1:
            send title "" with subtitle "&e%{_currentRound}%/%{_연속횟수}% &f라운드! &e좌클릭!" to player for 1.5 seconds
        else:
            send title "" with subtitle "&e물고기가 물었다! &f좌클릭!" to player for 1.5 seconds
        # ===== 타임아웃 보스바 =====
        delete bossbar named "fishTimer_%player's uuid%"
        set {_timerBar} to bossbar named "fishTimer_%player's uuid%" with title "&a남은 시간" with color green with style segmented 10 with progress 100
        set bossbar players of {_timerBar} to player
        # 타임아웃: 10초 = 200틱 + 인챈트 집중 보너스
        set {_maxSteps} to 200
        if {낚싯대인챈트타임아웃::%player%} is set:
            add {낚싯대인챈트타임아웃::%player%} to {_maxSteps}
        set {_step} to 0
        set {_tickCount} to 0
        set {_direction} to 1
        set {_cursor} to 0
        set {_zoneMoveCount} to 0
        set {_globalTick} to 0
        # 초과 난이도 기반 존 이동 주기
        if {_overflowDiff} > 0:
            set {_zoneMoveInterval} to 8 - {_overflowDiff}
            if {_zoneMoveInterval} < 3:
                set {_zoneMoveInterval} to 3
        # ===== 미니게임 루프 (1라운드) =====
        while {_step} < {_maxSteps}:
            if {미니게임::%player%} is not 1:
                stop
            if {미니게임결과::%player%} is "성공":
                stop loop
            if {미니게임결과::%player%} is "크리티컬":
                stop loop
            if {미니게임결과::%player%} is "도주":
                stop loop
            add 1 to {_globalTick}
            # 변속 패턴 적용: 현재 틱 기반 속도 배율 계산
            set {_변속mult} to 변속배율({_globalTick}, {_변속패턴})
            # 최종 커서 이동 속도 = 기본속도 × (100 / (좌우속도 × 변속배율 / 100))
            # 좌우속도와 변속배율이 높을수록 커서가 빨리 움직임 (speed 값이 낮을수록 빠름)
            set {_effectiveSpeed} to floor({_speed} * 10000 / ({_좌우속도} * {_변속mult}))
            if {_effectiveSpeed} < 1:
                set {_effectiveSpeed} to 1
            # 커서 이동
            add 1 to {_tickCount}
            if {_tickCount} >= {_effectiveSpeed}:
                set {_tickCount} to 0
                set {_maxCursor} to {_barWidth} - 1
                add {_direction} to {_cursor}
                if {_cursor} >= {_maxCursor}:
                    set {_cursor} to {_maxCursor}
                    set {_direction} to -1
                if {_cursor} <= 0:
                    set {_cursor} to 0
                    set {_direction} to 1
                set {미니게임커서::%player%} to {_cursor}
                # 초과 난이도: 성공영역 랜덤 이동 (기존)
                if {_overflowDiff} > 0:
                    add 1 to {_zoneMoveCount}
                    if {_zoneMoveCount} >= {_zoneMoveInterval}:
                        set {_zoneMoveCount} to 0
                        set {_newMaxStart} to {_barWidth} - {_zoneWidth}
                        if {_newMaxStart} < 0:
                            set {_newMaxStart} to 0
                        set {_zoneStart} to random integer between 0 and {_newMaxStart}
                        set {_zoneEnd} to {_zoneStart} + {_zoneWidth} - 1
                        set {미니게임존시작::%player%} to {_zoneStart}
                        set {미니게임존끝::%player%} to {_zoneEnd}
                        # 크리칸 재굴림
                        delete {미니게임크리칸::%player%::*}
                        loop integers from {_zoneStart} to {_zoneEnd}:
                            chance of {_크리티컬확률}%:
                                set {미니게임크리칸::%player%::%loop-integer%} to true
                # 스팟 일정 방향 이동 기믹 (초록/노란 스팟이 한 방향으로 슬라이드)
                if {_스팟이동속도} > 0:
                    add 1 to {_spotMoveCount}
                    if {_spotMoveCount} >= {_spotMoveInterval}:
                        set {_spotMoveCount} to 0
                        # 존 전체를 한 방향으로 1칸 이동
                        add {_spotDir} to {_zoneStart}
                        add {_spotDir} to {_zoneEnd}
                        # 벽에 닿으면 반대로
                        if {_zoneEnd} >= {_barWidth}:
                            set {_spotDir} to -1
                            set {_zoneEnd} to {_barWidth} - 1
                            set {_zoneStart} to {_zoneEnd} - {_zoneWidth} + 1
                        if {_zoneStart} < 0:
                            set {_spotDir} to 1
                            set {_zoneStart} to 0
                            set {_zoneEnd} to {_zoneWidth} - 1
                        set {미니게임존시작::%player%} to {_zoneStart}
                        set {미니게임존끝::%player%} to {_zoneEnd}
                        # 크리칸 재굴림 (이동할 때마다)
                        delete {미니게임크리칸::%player%::*}
                        loop integers from {_zoneStart} to {_zoneEnd}:
                            chance of {_크리티컬확률}%:
                                set {미니게임크리칸::%player%::%loop-integer%} to true
                # 게이지 표시 (가변 바 폭)
                send action bar 미니게임게이지(player, {_cursor}, {_zoneStart}, {_zoneEnd}, {_barWidth}) to player
            add 1 to {_step}
            # 보스바 진행률 업데이트
            set {_prog} to (({_maxSteps} - {_step}) / {_maxSteps}) * 100
            if {_prog} < 0:
                set {_prog} to 0
            set {_sec} to floor(({_maxSteps} - {_step}) / 20)
            set {_decimal} to floor(mod({_maxSteps} - {_step}, 20) / 2)
            set bossbar progress of {_timerBar} to {_prog}
            if {_연속횟수} > 1:
                set {_roundLabel} to " &8(%{_currentRound}%/%{_연속횟수}%)"
            else:
                set {_roundLabel} to ""
            if {_prog} <= 30:
                set bossbar color of {_timerBar} to red
                set bossbar title of {_timerBar} to "&c남은 시간 %{_sec}%.%{_decimal}%초%{_roundLabel}%"
            else if {_prog} <= 60:
                set bossbar color of {_timerBar} to yellow
                set bossbar title of {_timerBar} to "&e남은 시간 %{_sec}%.%{_decimal}%초%{_roundLabel}%"
            else:
                set bossbar color of {_timerBar} to green
                set bossbar title of {_timerBar} to "&a남은 시간 %{_sec}%.%{_decimal}%초%{_roundLabel}%"
            wait 1 tick
        # ===== 라운드 결과 체크 =====
        set {_roundResult} to {미니게임결과::%player%}
        # 타임아웃 또는 도주 → 즉시 실패
        if {_roundResult} is "대기":
            stop loop
        if {_roundResult} is "도주":
            stop loop
        # 성공/크리티컬 → 카운트 및 다음 라운드
        if {_roundResult} is "성공":
            add 1 to {_roundSuccess}
        if {_roundResult} is "크리티컬":
            add 1 to {_roundCritical}
        # 마지막 라운드가 아니면 짧은 대기 후 다음 라운드
        if {_currentRound} < {_연속횟수}:
            send action bar "&a라운드 %{_currentRound}% 성공!" to player
            delete bossbar named "fishTimer_%player's uuid%"
            wait 15 ticks
    # ===== 보스바 정리 =====
    delete bossbar named "fishTimer_%player's uuid%"
    # ===== 미니게임 결과 처리 =====
    # 연속 미니게임: 마지막 라운드의 결과가 최종 결과
    set {_result} to {미니게임결과::%player%}
    # 연속 미니게임에서 모든 라운드를 크리티컬로 통과하면 슈퍼크리티컬
    if {_연속횟수} > 1:
        if {_roundCritical} >= {_연속횟수}:
            set {_result} to "크리티컬"
        else if {_roundSuccess} + {_roundCritical} >= {_연속횟수}:
            # 하나라도 크리티컬이 있으면 크리티컬 유지, 아니면 성공
            if {_roundCritical} > 0:
                set {_result} to "크리티컬"
            else:
                set {_result} to "성공"
    미니게임정리(player)
    # 타임아웃
    if {_result} is "대기":
        message "&c시간 초과! 물고기가 도망갔습니다!" to player
        set {낚시콤보::%player%} to 0
        reduceDurability(player)
        사이드바업데이트(player)
        콤보네임태그(player)
        칭호자동체크(player)
        stop
    # 도주
    if {_result} is "도주":
        message "&c물고기가 도망갔습니다!" to player
        set {낚시콤보::%player%} to 0
        reduceDurability(player)
        사이드바업데이트(player)
        콤보네임태그(player)
        칭호자동체크(player)
        stop
    # 크리티컬 -> 크기 증가 보너스 (크기가 커지면 판매가도 자연스럽게 상승)
    set {_isCritical} to false
    if {_result} is "크리티컬":
        set {_isCritical} to true
        # 크리티컬 크기 증가율 = 크리배율 × 10% (캡: 크리배율 최대 8 = +80%)
        if {_크리티컬데미지} > 8:
            set {_크리티컬데미지} to 8
        set {_critSizePercent} to {_크리티컬데미지} * 10
        set {_critSizeAdd} to {_size} * {_critSizePercent} / 100
        add {_critSizeAdd} to {_size}
        # 경험치 보너스 플래그 (크리티컬 시 경험치도 증가)
        set {_critExpBonus} to true
        set {_critExpMult} to 1 + {_크리티컬데미지} * 0.1
        message "&6★ 크리티컬! &e크기 +%{_critSizePercent}%%% &8(%{_critSizeAdd}%cm↑)" to player
        # 슈퍼 크리티컬 — 등급업 찬스 (2%)
        chance of 2%:
            set {_critNextGrade} to next_grade({_등급})
            if {_critNextGrade} is not "":
                if {_%{_critNextGrade}%::*} is set:
                    set {_critOldGrade} to {_등급}
                    set {_등급} to {_critNextGrade}
                    # 등급 올랐으니 물고기 재선택
                    set {_count2} to 0
                    loop {_%{_등급}%::*}:
                        add 1 to {_count2}
                    set {_d2} to random integer between 1 and {_count2}
                    set {_f::*} to split {_%{_등급}%::%{_d2}%} at "|"
                    set {_size} to random number between ({_f::2} parsed as number) and ({_f::3} parsed as number)
                    # 슈퍼 크리티컬에도 크기 보너스 적용
                    add {_size} * {_critSizePercent} / 100 to {_size}
                    set {_critGradeOldColor} to part_grade_color({_critOldGrade})
                    set {_critGradeNewColor} to part_grade_color({_등급})
                    message "&d&l★★ 퍼펙트! 크리티컬! &r%{_critGradeOldColor}%%{_critOldGrade}% &7→ %{_critGradeNewColor}%%{_등급}% &d&l★★" to player
    else:
        message "&a성공! 물고기를 잡았다!" to player
    # 등급 업 메시지 (미니게임 성공 후에만, 가중 랜덤으로 출처 1개 표시)
    if {_gradeUpNew} is set:
        set {_oldColor} to part_grade_color({_gradeUpOld})
        set {_newColor} to part_grade_color({_gradeUpNew})
        # 기여도 기반 가중 랜덤 출처 선택
        set {_srcTotal} to 0
        loop {_등급업출처값::*}:
            add loop-value to {_srcTotal}
        set {_srcPick} to random integer from 1 to {_srcTotal}
        set {_srcAcc} to 0
        set {_srcIdx} to 0
        set {_pickedSrc} to {_등급업출처::1}
        loop {_등급업출처값::*}:
            add 1 to {_srcIdx}
            add loop-value to {_srcAcc}
            if {_srcAcc} >= {_srcPick}:
                set {_pickedSrc} to {_등급업출처::%{_srcIdx}%}
                stop loop
        message "&8[&e %{_pickedSrc}% &8] &a등급 업 성공! %{_oldColor}%%{_gradeUpOld}% &7→ %{_newColor}%%{_gradeUpNew}%" to player
    # ===== 품질 계산 (크기 보너스 적용 전) =====
    set {_minSize} to {_f::2} parsed as number
    set {_maxSize} to {_f::3} parsed as number
    set {_sizeRange} to {_maxSize} - {_minSize}
    if {_sizeRange} > 0:
        set {_quality} to floor(({_size} - {_minSize}) / {_sizeRange} * 100)
    else:
        set {_quality} to 50
    if {_quality} < 0:
        set {_quality} to 0
    if {_quality} > 100:
        set {_quality} to 100
    # 찌 크기 보너스 적용
    if {_크기보너스} > 0:
        add {_size} * {_크기보너스} / 100 to {_size}
    # ===== 환경 크기 보너스 =====
    if {_환경크기보너스} > 0:
        add {_size} * {_환경크기보너스} / 100 to {_size}
    # 물고기 아이템 생성
    open chest inventory with 1 rows named "&0낚시" to player
    set {_fishItem} to cod named "&f%{_f::1}%"
    delete {_fishLore::*}
    add "&7등급 &e: &f%{_등급}%" to {_fishLore::*}
    add "&7크기 &e: &f%{_size}%cm" to {_fishLore::*}
    if {_isCritical} is true:
        add "&6★ 크리티컬 &e크기+%{_critSizePercent}%%%" to {_fishLore::*}
    if {_판매보너스} > 0:
        add "&e$ 판매보너스 &f+%{_판매보너스}%%%" to {_fishLore::*}
    add "&7신선도 &e: &a100%%" to {_fishLore::*}
    add "&f%now%" to {_fishLore::*}
    add "&8f:%unix timestamp of now%:0:%{_quality}%" to {_fishLore::*}
    set lore of {_fishItem} to {_fishLore::*}
    set slot 0 of player's current inventory to {_fishItem}
    # ===== 더블/트리플 낚시 (독립 확률) =====
    set {_extraFish} to 0
    if {_더블찬스} > 0:
        chance of {_더블찬스}%:
            add 1 to {_extraFish}
    if {_트리플찬스} > 0:
        chance of {_트리플찬스}%:
            add 1 to {_extraFish}
    if {_extraFish} >= 1:
        set {_fishItem2} to cod named "&f%{_f::1}%"
        set lore of {_fishItem2} to {_fishLore::*}
        set slot 1 of player's current inventory to {_fishItem2}
        if {_extraFish} >= 2:
            set {_fishItem3} to cod named "&f%{_f::1}%"
            set lore of {_fishItem3} to {_fishLore::*}
            set slot 2 of player's current inventory to {_fishItem3}
            message "&d&l★★★ 트리플 낚시! &e물고기 3마리!" to player
        else:
            message "&b&l★ 더블 낚시! &e같은 물고기를 한 마리 더 잡았다!" to player
    # ===== 인챈트: 행운 낚시 (추가 보상 확률) =====
    if {낚싯대인챈트행운::%player%} is set:
        if {낚싯대인챈트행운::%player%} > 0:
            chance of {낚싯대인챈트행운::%player%}%:
                # 추가 보상: 소량의 돈
                set {_bonusMoney} to floor(fishprice({_등급}, {_quality}) * 0.1)
                if {_bonusMoney} < 10:
                    set {_bonusMoney} to 10
                add {_bonusMoney} to {돈::%player%}
                message "&d★ 행운! &e추가 보상 %{_bonusMoney}%원!" to player
    # ===== S+ 이상 서버 공지 =====
    if rankchange({_등급}) >= 7:
        set {_gc} to part_grade_color({_등급})
        set {_t} to text component from "&6&l[!] &7%player's name%&f님이 &e&l%{_f::1}% &f을(를) 낚았습니다! &8(%{_gc}%%{_등급}%&8)"
        set hover event of {_t} to a new hover event showing "&7이름 &e: &f%{_f::1}%%nl%&7등급 &e: %{_gc}%%{_등급}%%nl%&7크기 &e: &f%{_size}%cm%nl%&7주인 &e: &f%player's name%"
        send component {_t} to all players
    # ========== 미니게임 끝 ==========
    # 장비 내구도 감소 (장착된 부품만)
    reduceDurability(player)
    # ===== 경험치 = 등급기본EXP × (0.5 + 품질/100) =====
    set {_기본EXP} to 5
    if {_등급} is "D":
        set {_기본EXP} to 6
    else if {_등급} is "C":
        set {_기본EXP} to 8
    else if {_등급} is "B":
        set {_기본EXP} to 10
    else if {_등급} is "A":
        set {_기본EXP} to 13
    else if {_등급} is "S":
        set {_기본EXP} to 17
    else if {_등급} is "S+":
        set {_기본EXP} to 22
    else if {_등급} is "M":
        set {_기본EXP} to 30
    else if {_등급} is "L":
        set {_기본EXP} to 40
    else if {_등급} is "G":
        set {_기본EXP} to 55
    set {_baseExp} to {_기본EXP} * (0.5 + {_quality} / 100)
    if {_경험치보너스} > 0:
        add {_baseExp} * {_경험치보너스} / 100 to {_baseExp}
    # ===== 환경 경험치 보너스 =====
    if {_환경경험치보너스} > 0:
        add {_baseExp} * {_환경경험치보너스} / 100 to {_baseExp}
    # ===== 크리티컬 경험치 보너스 (배율 적용) =====
    if {_critExpBonus} is true:
        set {_origExp} to {_baseExp}
        set {_baseExp} to {_baseExp} * {_critExpMult}
    if {_critExpBonus} is true:
        message "&6낚시 경험치 +%{_baseExp}%exp &8(%{_origExp}% → %{_baseExp}%exp)" to player
    else:
        message "&a낚시 경험치 +%{_baseExp}%exp" to player
    # 공용 함수: 경험치 추가 + 레벨업 체크 + 경험치바 동기화
    낚시경험치추가(player, {_baseExp})
    # ===== 콤보 시스템 =====
    if {낚시콤보::%player%} is not set:
        set {낚시콤보::%player%} to 0
    add 1 to {낚시콤보::%player%}
    if {낚시최대콤보::%player%} is not set:
        set {낚시최대콤보::%player%} to 0
    if {낚시콤보::%player%} > {낚시최대콤보::%player%}:
        set {낚시최대콤보::%player%} to {낚시콤보::%player%}
    if {낚시콤보::%player%} >= 5:
        if mod({낚시콤보::%player%}, 5) is 0:
            message "&6&l%{낚시콤보::%player%}% 콤보! &e연속 낚시 성공!" to player
    사이드바업데이트(player)
    콤보네임태그(player)
    칭호자동체크(player)
    # 조합 재료 드롭 체크
    조합재료드롭체크(player, {area::%player%})

    if {낚시대회::시간} is set:
        fishrank(player, {_f::1}, {_등급}, "%{_size}%")
    if {도감최대::%{_f::1}%::%player%} is not set:
        message "&a처음보는 물고기입니다!" to player
        set {도감최대::%{_f::1}%::%player%} to {_size}
        set {처음낚은날짜::%{_f::1}%::%player%} to now
        set {최대낚은날짜::%{_f::1}%::%player%} to now
    else:
        if {도감최대::%{_f::1}%::%player%} < {_size}:
            message "&a도감을 갱신했습니다!" to player
            set {도감최대::%{_f::1}%::%player%} to {_size}
            set {최대낚은날짜::%{_f::1}%::%player%} to now
    # 퀘스트 훅: 물고기 잡기
    퀘스트_물고기(player, {_f::1}, {_등급}, {_size})

on inventory close:
    if name of event-inventory is "&0낚시":
        set {_autoIB} to false
        if {자동수납해금::%player%} is true:
            if {아이스박스자동수납::%player%} is not set:
                set {아이스박스자동수납::%player%} to true
            if {아이스박스자동수납::%player%} is true:
                set {_autoIB} to true
        set {_ibCount} to 0
        loop 9 times:
            set {_slot} to (loop-iteration) - 1
            set {_item} to slot {_slot} of event-inventory
            if {_item} is not air:
                set {_handled} to false
                # 5단계 이상 아이스박스: 물고기 자동 수납 시도
                if {_autoIB} is true:
                    if isfish({_item}) is true:
                        if 자동수납(player, {_item}) is true:
                            add 1 to {_ibCount}
                            set {_handled} to true
                if {_handled} is false:
                    if player can hold {_item}:
                        give {_item} to player
                    else:
                        # 인벤 꽉 참 - 물고기면 자동 판매
                        set {_autoSold} to false
                        if isfish({_item}) is true:
                            set {_amount} to item amount of {_item}
                            set {_unitPrice} to calcFishPrice({_item})
                            if {_unitPrice} > 0:
                                set {_price} to {_unitPrice} * {_amount}
                                if {돈::%player%} is not set:
                                    set {돈::%player%} to 0
                                add {_price} to {돈::%player%}
                                퀘스트_판매(player, {_amount}, {_price})
                                set {_autoSold} to true
                                set {_등급} to parsegrade({_item})
                                set {_크기} to parsesize({_item})
                                message "&8[&6 상점 &8] &e인벤 가득! 자동 판매: &f%name of {_item}% &7(%{_등급}% / %{_크기}%cm) &e%{_price}%원 &7| 잔액: &f%{돈::%player%}%원" to player
                        if {_autoSold} is false:
                            give {_item} to player
                set slot {_slot} of event-inventory to air
        if {_ibCount} > 0:
            message "&8[&b 아이스박스 &8] &b%{_ibCount}%마리 자동 수납 완료!" to player
function fishrank(p: player, fishname: text, rank: text, size: text):
    if {_fishname} is not set:
        stop
    set {_fish} to "%{_p}'s name%|%{_fishname}%|%{_rank}%|%{_size}%"
    add {_fish} to {낚시대회물고기::*}
        # ---- 방금 잡은 기록이 TOP10 안에 몇 등인지 즉시 계산 ----
    set {_pool::*} to {낚시대회물고기::*}
    set {_total} to size of {_pool::*}

    set {_limit} to 10
    if {_total} < {_limit}:
        set {_limit} to {_total}

    set {_myRank} to 0

    loop {_limit} times:
        set {_best} to {_pool::1}
        loop {_pool::*}:
            if isBetter(loop-value-2, {_best}):
                set {_best} to loop-value-2

        # 이번에 뽑힌 best가 방금 잡은 그 기록이면 등수 확정
        if {_best} is {_fish}:
            set {_myRank} to loop-number
            stop loop

        remove {_best} from {_pool::*}

    if {_myRank} is 0:
        send "&7[낚시대회] 기록 등록! (TOP10 밖) &7%{_fishname}% / %{_rank}% / %{_size}%" to {_p}
    else:
        send "&6[낚시대회] &e%{_myRank}%등&6 기록! &7%{_fishname}% / %{_rank}% / %{_size}%" to {_p}
function isBetter(a: text, b: text) :: boolean:
    # 포맷: 플레이어|물고기|등급|크기
    set {_A::*} to split {_a} at "|"
    set {_B::*} to split {_b} at "|"

    set {_ra} to rankchange({_A::3})
    set {_rb} to rankchange({_B::3})

    if {_ra} > {_rb}:
        return true
    if {_ra} < {_rb}:
        return false

    # 등급이 같으면 크기 비교 (여기서 {_size}는 숫자/소수점만 있다고 했으니 바로 파싱)
    set {_sa} to {_A::4} parsed as number
    set {_sb} to {_B::4} parsed as number
    if {_sa} is not set:
        set {_sa} to 0
    if {_sb} is not set:
        set {_sb} to 0

    if {_sa} > {_sb}:
        return true
function fishtimer(time: integer):
    # time = "분"
    set {낚시대회::총초} to {_time} * 60
    set {낚시대회::남은초} to {_time} * 60

    # 기존 바 있으면 정리
    delete bossbar named "fishingContest"

    # 보스바 생성 (name 과 title 분리)
    set {낚시대회::bar} to bossbar named "fishingContest" with title "&b낚시대회 진행중" with color blue with style segmented 20 with progress 100
    # ★ 중요: 보여줄 플레이어 지정(이거 안 하면 안 보임)
    set bossbar players of {낚시대회::bar} to all players
every 1 second:
    if {낚시대회::bar} is set:
        subtract 1 from {낚시대회::남은초}

        # 남은시간 mm:ss
        set {_m} to floor({낚시대회::남은초} / 60)
        set {_s} to {낚시대회::남은초} mod 60

        # progress (0~100)
        set {_prog} to ({낚시대회::남은초} / {낚시대회::총초}) * 100
        if {_prog} < 0:
            set {_prog} to 0
        set bossbar progress of {낚시대회::bar} to {_prog}

        set bossbar title of {낚시대회::bar} to "&b낚시대회 진행중 | 상금 %{낚시대회::상금}% | 남은시간 %{_m}%:%{_s}%"

        if {낚시대회::남은초} <= 0:
            delete bossbar named "fishingContest"
            broadcast "&e낚시대회가 종료되었습니다! &7(/낚시대회 순위)"
            if {낚시대회물고기::*} is not set:
                broadcast "&7낚시대회의 기록이 없어 상금을 지급하지 못했습니다."
                stop

            set {_pool::*} to {낚시대회물고기::*}
            set {_total} to size of {_pool::*}

            set {_limit} to 10
            if {_total} < {_limit}:
                set {_limit} to {_total}


            loop {_limit} times:
                set {_best} to {_pool::1}
                loop {_pool::*}:
                    if isBetter(loop-value-2, {_best}):
                        set {_best} to loop-value-2

                set {_P::*} to split {_best} at "|"
                
                if loop-number is 1:
                    set {_name} to {_P::1} parsed as player
                    add {낚시대회::상금} to {돈::%{_name}%}
                    message "&a낚시대회 상금으로 %{낚시대회::상금}%원을 받았습니다!" to {_name}
                else if loop-number is 2:
                    set {_name} to {_P::1} parsed as player
                    add {낚시대회::상금}*0.5 to {돈::%{_name}%}
                    message "&a낚시대회 상금으로 %{낚시대회::상금}*0.5%원을 받았습니다!" to {_name}
                else if loop-number is 3:
                    set {_name} to {_P::1} parsed as player
                    add {낚시대회::상금}*0.25 to {돈::%{_name}%}
                    message "&a낚시대회 상금으로 %{낚시대회::상금}*0.25%원을 받았습니다!" to {_name}
                broadcast "&e%loop-number%등 &f%{_P::1}% &7- %{_P::2}% &8(%{_P::3}% / %{_P::4}%)"

                remove {_best} from {_pool::*}
            delete {낚시대회::bar}
            delete {낚시대회::*}
            delete {낚시대회물고기::*}
            stop
            
on join:
    if {낚시대회::bar} is set:
        add player to bossbar players of {낚시대회::bar}
command /낚시대회 [<text>] [<integer>] [<integer>]:
    aliases: /skrtleoghl
    trigger:
        if arg-1 is not set:
            message "/낚시대회 시작 시간 상금" to player
        else if arg-1 is "시작":
            if arg-2 or arg-3 is not set:
                message "/낚시대회 시작 시간 상금" to player
            else:
                if arg-2 > 30:
                    message "&c30분 이상의 시간은 관리자에게 문의해주세요." to player
                    stop
                if {낚시대회::시간} is set:
                    message "&c낚시대회가 이미 진행중입니다." to player
                    stop
                broadcast "&e낚시대회&f가 시작되었습니다! (제한시간 &e%arg-2%&f분, 상금 &e%arg-3%&f원)"
                
                set {낚시대회::시간} to arg-2
                set {낚시대회::상금} to arg-3
                delete {낚시대회물고기::*}
                fishtimer(arg-2)
        else if arg-1 is "강제종료":
            if player is op:
                delete {낚시대회::*}
                delete {낚시대회물고기::*}
                broadcast "관리자 &e%player's name%&f님이 낚시대회를 강제종료하였습니다!"
        else if arg-1 is "순위":
            if {낚시대회물고기::*} is not set:
                send "&7[낚시대회] 아직 기록이 없어."
                stop

            set {_pool::*} to {낚시대회물고기::*}
            set {_total} to size of {_pool::*}

            set {_limit} to 10
            if {_total} < {_limit}:
                set {_limit} to {_total}

            send "&6==== 낚시대회 순위 TOP %{_limit}% &7(총 %{_total}%개 기록) &6===="

            loop {_limit} times:
                set {_best} to {_pool::1}
                loop {_pool::*}:
                    if isBetter(loop-value-2, {_best}):
                        set {_best} to loop-value-2

                set {_P::*} to split {_best} at "|"
                send "&e%loop-number%등 &f%{_P::1}% &7- %{_P::2}% &8(%{_P::3}% / %{_P::4}%)"

                remove {_best} from {_pool::*}
            stop

on tab complete of "/낚시테스트":
    set tab completions for position 1 to "E", "D", "C", "B", "A", "S", "S+", "M", "L", "G" and "해제"

command /낚시테스트 [<text>]:
    permission: op
    trigger:
        if arg-1 is not set:
            message "&8[&e 테스트 &8] &7사용법: &f/낚시테스트 <등급>" to player
            message "&8[&e 테스트 &8] &7등급: &fE, D, C, B, A, S, S+, M, L, G" to player
            message "&8[&e 테스트 &8] &7해제: &f/낚시테스트 해제" to player
            if {테스트등급::%player%} is set:
                message "&8[&e 테스트 &8] &7현재 설정: &e%{테스트등급::%player%}%" to player
            stop
        if arg-1 is "해제":
            delete {테스트등급::%player%}
            message "&8[&e 테스트 &8] &a테스트 등급이 해제되었습니다." to player
            stop
        set {_valid::*} to "E", "D", "C", "B", "A", "S", "S+", "M", "L" and "G"
        if {_valid::*} contains arg-1:
            set {테스트등급::%player%} to arg-1
            message "&8[&e 테스트 &8] &a다음 낚시에서 &e%arg-1% &a등급이 나옵니다." to player
        else:
            message "&8[&e 테스트 &8] &c올바른 등급을 입력하세요: &fE, D, C, B, A, S, S+, M, L, G" to player

function rankchange(t: text) :: number:
    if {_t} is "E":
        return 1
    else if {_t} is "D":
        return 2
    else if {_t} is "C":
        return 3
    else if {_t} is "B":
        return 4
    else if {_t} is "A":
        return 5
    else if {_t} is "S":
        return 6
    else if {_t} is "S+":
        return 7
    else if {_t} is "M":
        return 8
    else if {_t} is "L":
        return 9
    else if {_t} is "G":
        return 10
function num_to_grade(n: integer) :: text:
    if {_n} is 1:
        return "E"
    else if {_n} is 2:
        return "D"
    else if {_n} is 3:
        return "C"
    else if {_n} is 4:
        return "B"
    else if {_n} is 5:
        return "A"
    else if {_n} is 6:
        return "S"
    else if {_n} is 7:
        return "S+"
    else if {_n} is 8:
        return "M"
    else if {_n} is 9:
        return "L"
    else if {_n} is 10:
        return "G"
    return "E"
