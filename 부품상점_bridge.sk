# =========================================
# 부품상점_bridge.sk — 부품 구매 로직 (부품상점.sk에서 분리, 유지)
# 인벤/레시피해금/도감 쓰기 = Skript 권위(장비/조합대와 공유).
# ★ 돈 = Java PlayerData.money 권위. 가격 계산 후 /moneytake(Java)가 잔액 체크+차감을 원자적으로 처리,
#    성공 시 /partbuyok(side-effect)을 콜백 실행. 잔액 부족 메시지는 Java가 출력.
# GUI/명령은 Java(PartShopGui)로 이관. Java가 /partbuy로 구매 트리거.
# =========================================

function buyPart(p: player, type: text, name: text):
    set {_grade} to get_part_grade({_type}, {_name})
    if {_type} is "낚싯대":
        # 낚싯대 카테고리 → 레시피 구매 (해금)
        set {_recipeId} to {부품_레시피ID::낚싯대::%{_name}%}
        if {_recipeId} is not set:
            message "&8[&6 부품상점 &8] &c이 낚싯대는 상점에서 구매할 수 없습니다." to {_p}
            stop
        if {레시피해금::%{_p}%::%{_recipeId}%} is true:
            message "&8[&6 부품상점 &8] &c이미 해금된 레시피입니다." to {_p}
            stop
        set {_price} to round(get_part_price({_type}, {_name}) * 0.5)
        # 돈 차감(Java) 성공 시 partbuyok 콜백: kind=rod, player, type, name, recipeId
        execute console command "moneytake %{_p}'s name% %{_price}% partbuyok rod§§%{_p}'s name%§§%{_type}%§§%{_name}%§§%{_recipeId}%§§%{_price}%"
    else:
        set {_price} to get_part_price({_type}, {_name})
        execute console command "moneytake %{_p}'s name% %{_price}% partbuyok part§§%{_p}'s name%§§%{_type}%§§%{_name}%§§none§§%{_price}%"

# ===== 미끼 구매 =====
function buyBait(p: player, name: text, count: integer):
    if {부품인벤::미끼::%{_p}%::%{_name}%} is not set:
        set {부품인벤::미끼::%{_p}%::%{_name}%} to 0
    # 99개 상한 체크
    set {_current} to {부품인벤::미끼::%{_p}%::%{_name}%}
    if {_current} >= 99:
        message "&8[&6 부품상점 &8] &c이미 99개를 보유하고 있습니다." to {_p}
        stop
    set {_buyCount} to {_count}
    if {_current} + {_buyCount} > 99:
        set {_buyCount} to 99 - {_current}
    set {_unitPrice} to get_part_price("미끼", {_name})
    set {_total} to {_unitPrice} * {_buyCount}
    # 돈 차감(Java) 성공 시 partbuyok 콜백: kind=bait, player, name, buyCount, total
    execute console command "moneytake %{_p}'s name% %{_total}% partbuyok bait§§%{_p}'s name%§§%{_name}%§§%{_buyCount}%§§%{_total}%"

# 구매 성공 콜백 (Java moneytake가 차감 성공 시 실행) — 인벤/레시피/도감 side-effect + 메시지
command /partbuyok <text>:
    permission: op
    executable by: console
    trigger:
        set {_t::*} to split arg-1 at "§§"
        set {_kind} to {_t::1}
        if {_kind} is "bait":
            set {_p} to {_t::2} parsed as player
            if {_p} is not set:
                stop
            set {_name} to {_t::3}
            set {_buyCount} to {_t::4} parsed as integer
            set {_total} to {_t::5} parsed as number
            add {_buyCount} to {부품인벤::미끼::%{_p}%::%{_name}%}
            set {_color} to part_grade_color(get_part_grade("미끼", {_name}))
            message "&8[&6 부품상점 &8] %{_color}%%{_name}% &fx%{_buyCount}%&a 구매! &7(-%{_total}%원 | 보유: %{부품인벤::미끼::%{_p}%::%{_name}%}%개)" to {_p}
            도감_부품({_p}, "미끼", {_name})
            stop
        # rod / part 공통
        set {_p} to {_t::2} parsed as player
        if {_p} is not set:
            stop
        set {_type} to {_t::3}
        set {_name} to {_t::4}
        set {_recipeId} to {_t::5}
        set {_price} to {_t::6} parsed as number
        set {_color} to part_grade_color(get_part_grade({_type}, {_name}))
        if {_kind} is "rod":
            set {레시피해금::%{_p}%::%{_recipeId}%} to true
            message "&8[&6 부품상점 &8] &e[레시피] %{_color}%%{_name}%&a 해금! &7(-%{_price}%원) &7조합대에서 제작하세요." to {_p}
            play sound "ui.toast.challenge_complete" with volume 0.5 and pitch 1.2 to {_p}
            도감_낚싯대({_p}, {_name})
        else:
            add {_name} to {부품인벤::%{_type}%::%{_p}%::*}
            message "&8[&6 부품상점 &8] %{_color}%%을를({_name})%&a 구매했습니다! &7(-%{_price}%원)" to {_p}
            도감_부품({_p}, {_type}, {_name})

# 구매 트리거: category§§name§§player§§count (Java GUI가 호출)
command /partbuy <text>:
    permission: op
    executable by: console
    trigger:
        set {_t::*} to split arg-1 at "§§"
        set {_cat} to {_t::1}
        set {_name} to {_t::2}
        set {_p} to {_t::3} parsed as player
        if {_p} is not set:
            stop
        if {_cat} is "미끼":
            set {_cnt} to {_t::4} parsed as integer
            buyBait({_p}, {_name}, {_cnt})
        else:
            buyPart({_p}, {_cat}, {_name})
