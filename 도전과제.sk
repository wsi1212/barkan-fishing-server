# =========================================
# 도전과제.sk
# 커스텀 도전과제 (업적) 시스템
# 탭: 탐험, 낚시, 경제, 소셜, 수집, 도전
# 보상: 돈, 칭호 (경험치 절대 X)
# =========================================

options:
    prefix: &8[&e ★ &8]
    achieve_color: &6
    tab_explore: &a탐험
    tab_fish: &b낚시
    tab_economy: &e경제
    tab_social: &d소셜
    tab_collect: &c수집
    tab_challenge: &5도전

# ===== 도전과제 데이터 초기화 =====
on load:
    delete {도전과제목록::*}

    # ============================
    #   탐험 탭
    # ============================
    add "탐험_첫발" to {도전과제목록::*}
