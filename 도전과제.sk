# ===== 도전과제 달성 체크 함수 =====
function 도전과제체크(p: player, type: text, value: text):
    loop {도전과제목록::*}:
        set {_id} to loop-value
        # 이미 달성했으면 스킵
        if {도전과제달성::%{_id}%::%{_p}%} is true:
            continue
        set {_조건} to {도전과제::%{_id}%::조건}
        set {_조건parts::*} to split {_조건} at "::"
        set {_조건타입} to {_조건parts::1}
        set {_조건값} to {_조건parts::2}
        # 타입 매칭
        if {_조건타입} is not {_type}:
            continue
        # 값 비교
        set {_met} to false
        if {_조건타입} is "지역":
            if {_value} is {_조건값}:
                set {_met} to true
        else if {_조건타입} is "지역방문":
            if {_조건값} is "전체":
                set {_visitCount} to size of {방문지역::%{_p}%::*}
                set {_totalRegions} to size of {지역리스트::*}
                if {_visitCount} >= {_totalRegions}:
                    set {_met} to true
            else:
                set {_req} to {_조건값} parsed as number
                set {_visitCount} to size of {방문지역::%{_p}%::*}
                if {_visitCount} >= {_req}:
                    set {_met} to true
        else if {_조건타입} is "총낚시":
            set {_req} to {_조건값} parsed as number
            if {총낚시::%{_p}%} >= {_req}:
                set {_met} to true
        else if {_조건타입} is "등급":
            if {_value} is {_조건값}:
                set {_met} to true
        else if {_조건타입} is "크리티컬":
            set {_met} to true
        else if {_조건타입} is "더블":
            set {_met} to true
        else if {_조건타입} is "콤보":
            set {_req} to {_조건값} parsed as number
            set {_val} to {_value} parsed as number
            if {_val} >= {_req}:
                set {_met} to true
        else if {_조건타입} is "보유금":
            set {_req} to {_조건값} parsed as number
            if {돈::%{_p}%} >= {_req}:
                set {_met} to true
        else if {_조건타입} is "총판매":
            set {_req} to {_조건값} parsed as number
            if {총판매::%{_p}%} >= {_req}:
                set {_met} to true
        else if {_조건타입} is "마켓등록":
            set {_met} to true
        else if {_조건타입} is "직거래":
            set {_met} to true
        else if {_조건타입} is "서포터":
            if {보유칭호::%{_p}%::서포터} is true:
                set {_met} to true
        else if {_조건타입} is "접속일":
            set {_req} to {_조건값} parsed as number
            if {접속일수::%{_p}%} >= {_req}:
                set {_met} to true
        else if {_조건타입} is "도감":
            if {_조건값} is "전체":
                set {_docCount} to size of {도감최대::*}
                set {_totalFish} to size of {물고기::*}
                if {_docCount} >= {_totalFish}:
                    set {_met} to true
            else:
                set {_req} to {_조건값} parsed as number
                set {_val} to {_value} parsed as number
                if {_val} >= {_req}:
                    set {_met} to true
        else if {_조건타입} is "레벨":
            set {_req} to {_조건값} parsed as number
            set {_val} to {_value} parsed as number
            if {_val} >= {_req}:
                set {_met} to true
        else if {_조건타입} is "퀘스트":
            if {퀘스트상태::%{_조건값}%::%{_p}%} is "완료":
                set {_met} to true
        else if {_조건타입} is "일퀘올클":
            set {_met} to true
        else if {_조건타입} is "날씨낚시":
            if {_value} is {_조건값}:
                set {_met} to true
        else if {_조건타입} is "시간낚시":
            if {_value} is {_조건값}:
                set {_met} to true
        else if {_조건타입} is "조합":
            set {_req} to {_조건값} parsed as number
            set {_val} to {_value} parsed as number
            if {_val} >= {_req}:
                set {_met} to true
        else if {_조건타입} is "지역도감완성":
            set {_req} to {_조건값} parsed as number
            set {_val} to {_value} parsed as number
            if {_val} >= {_req}:
                set {_met} to true
        else if {_조건타입} is "낚싯대수집":
            if {_조건값} is "전체":
                set {_req} to size of {부품목록::낚싯대::*}
                set {_val} to {_value} parsed as number
                if {_val} >= {_req}:
                    set {_met} to true
            else:
                set {_req} to {_조건값} parsed as number
                set {_val} to {_value} parsed as number
                if {_val} >= {_req}:
                    set {_met} to true
        else if {_조건타입} is "트리플":
            set {_met} to true
        else if {_조건타입} is "크기":
            set {_req} to {_조건값} parsed as number
            set {_val} to {_value} parsed as number
            if {_val} >= {_req}:
                set {_met} to true
        else if {_조건타입} is "수표발행":
            set {_met} to true
        else if {_조건타입} is "송금":
            set {_met} to true
        else if {_조건타입} is "강화":
            set {_req} to {_조건값} parsed as number
            set {_val} to {_value} parsed as number
            if {_val} >= {_req}:
                set {_met} to true
        # 달성!
        if {_met} is true:
            도전과제달성({_p}, {_id})

# ===== 도전과제 달성 처리 =====
function 도전과제달성(p: player, id: text):
    set {도전과제달성::%{_id}%::%{_p}%} to true
    set {_name} to {도전과제::%{_id}%::이름}
    # 마크 도전과제 팝업 (toast)
    if {도전과제adv::%{_id}%} is set:
        execute console command "advancement grant %{_p}'s name% only %{도전과제adv::%{_id}%}%"
    # 채팅 메시지
    message "{@prefix} {@achieve_color}도전과제 달성! %{_name}%" to {_p}
    # 보상
    set {_money} to {도전과제::%{_id}%::보상돈}
    if {_money} is set:
        if {_money} > 0:
            if {돈::%{_p}%} is not set:
                set {돈::%{_p}%} to 0
            add {_money} to {돈::%{_p}%}
            message "{@prefix} &e+%{_money}%원" to {_p}
    set {_titleReward} to {도전과제::%{_id}%::보상칭호}
    if {_titleReward} is set:
        set {보유칭호::%{_p}%::%{_titleReward}%} to true
        set {_tn} to {칭호데이터::%{_titleReward}%::이름}
        if {_tn} is not set:
            set {_tn} to {_titleReward}
        message "{@prefix} &e칭호 획득! &f[%{_tn}%&f]" to {_p}
    play sound "entity.experience_orb.pickup" with volume 0.5 and pitch 1.5 to {_p}
    사이드바업데이트({_p})

# ===== /도전과제 명령어 — GUI =====
on tab complete of "/도전과제":
    set tab completions for position 1 to "탐험", "낚시", "경제", "소셜", "수집" and "도전"

command /도전과제 [<text>]:
    aliases: /ehdwjsrhkwo
    trigger:
        set {_tab} to arg-1
        if {_tab} is not set:
            set {_tab} to "탐험"
        도전과제GUI(player, {_tab})

function 도전과제GUI(p: player, tab: text):
    open chest inventory with 6 rows named "&0도전과제 — %{_tab}%" to {_p}
    # 상단 탭 버튼 (슬롯 0~5)
    set {_tabs::1} to "탐험"
    set {_tabs::2} to "낚시"
    set {_tabs::3} to "경제"
    set {_tabs::4} to "소셜"
    set {_tabs::5} to "수집"
    set {_tabs::6} to "도전"
    set {_tabColors::1} to "&a"
    set {_tabColors::2} to "&b"
    set {_tabColors::3} to "&e"
    set {_tabColors::4} to "&d"
    set {_tabColors::5} to "&c"
    set {_tabColors::6} to "&5"
    set {_tabIcons::1} to leather boots
    set {_tabIcons::2} to fishing rod
    set {_tabIcons::3} to gold ingot
    set {_tabIcons::4} to player head
    set {_tabIcons::5} to book
    set {_tabIcons::6} to diamond sword
    loop integers from 1 to 6:
        set {_tn} to {_tabs::%loop-integer%}
        set {_tc} to {_tabColors::%loop-integer%}
        if {_tn} is {_tab}:
            set slot (loop-integer - 1) of {_p}'s current inventory to {_tabIcons::%loop-integer%} named "%{_tc}%&l%{_tn}% &7(현재)" with lore "&7현재 보고 있는 탭"
        else:
            set slot (loop-integer - 1) of {_p}'s current inventory to {_tabIcons::%loop-integer%} named "%{_tc}%%{_tn}%" with lore "&7클릭하여 이동"
    # 진행률 (슬롯 7)
    set {_total} to 0
    set {_done} to 0
    loop {도전과제목록::*}:
        add 1 to {_total}
        if {도전과제달성::%loop-value%::%{_p}%} is true:
            add 1 to {_done}
    set slot 7 of {_p}'s current inventory to paper named "&e진행률: &f%{_done}%/%{_total}%" with lore "&7전체 도전과제 달성 현황"
    # 구분선 (슬롯 8)
    set slot 8 of {_p}'s current inventory to black stained glass pane named "&f"
    # 도전과제 아이템 (슬롯 9~44)
    set {_slot} to 9
    loop {도전과제목록::*}:
        set {_id} to loop-value
        if {도전과제::%{_id}%::탭} is {_tab}:
            if {_slot} > 44:
                stop loop
            set {_achName} to {도전과제::%{_id}%::이름}
            set {_achDesc} to {도전과제::%{_id}%::설명}
            set {_achIcon} to {도전과제::%{_id}%::아이콘}
            delete {_lore::*}
            add {_achDesc} to {_lore::*}
            add "" to {_lore::*}
            if {도전과제::%{_id}%::보상돈} is set:
                if {도전과제::%{_id}%::보상돈} > 0:
                    add "&7보상: &e%{도전과제::%{_id}%::보상돈}%원" to {_lore::*}
            if {도전과제::%{_id}%::보상칭호} is set:
                set {_rtn} to {칭호데이터::%{도전과제::%{_id}%::보상칭호}%::이름}
                if {_rtn} is not set:
                    set {_rtn} to {도전과제::%{_id}%::보상칭호}
                add "&7보상: 칭호 &f[%{_rtn}%&f]" to {_lore::*}
            add "" to {_lore::*}
            if {도전과제달성::%{_id}%::%{_p}%} is true:
                add "&a✓ 달성 완료!" to {_lore::*}
                set slot {_slot} of {_p}'s current inventory to lime stained glass pane named "&a✓ %{_achName}%" with lore {_lore::*}
            else:
                add "&c✗ 미달성" to {_lore::*}
                set slot {_slot} of {_p}'s current inventory to {_achIcon} named "%{_achName}%" with lore {_lore::*}
            add 1 to {_slot}
    # 하단 바
    loop integers from 45 to 53:
        set slot loop-integer of {_p}'s current inventory to gray stained glass pane named "&f"

# ===== 도전과제 GUI 클릭 =====
on inventory click:
    if player's current inventory's name contains "&0도전과제":
        cancel event
        set {_ci} to index of clicked slot
        # 탭 선택 (슬롯 0~5)
        if {_ci} >= 0:
            if {_ci} <= 5:
                set {_tabs::1} to "탐험"
                set {_tabs::2} to "낚시"
                set {_tabs::3} to "경제"
                set {_tabs::4} to "소셜"
                set {_tabs::5} to "수집"
                set {_tabs::6} to "도전"
                set {_selectedTab} to {_tabs::%({_ci} + 1)%}
                if {_selectedTab} is set:
                    wait 1 tick
                    도전과제GUI(player, {_selectedTab})

# ===== 접속일수 카운터 =====
on join:
    if {접속일수::%player%} is not set:
        set {접속일수::%player%} to 0
    if {마지막접속날짜::%player%} is not set:
        set {마지막접속날짜::%player%} to ""
    set {_today} to "%now%"
    set {_todayShort::*} to split {_today} at " "
    set {_todayDate} to {_todayShort::1}
    if {마지막접속날짜::%player%} is not {_todayDate}:
        add 1 to {접속일수::%player%}
        set {마지막접속날짜::%player%} to {_todayDate}
    # 접속 시 도전과제 일괄 체크
    wait 30 ticks
    도전과제체크(player, "접속일", "%{접속일수::%player%}%")
    도전과제체크(player, "보유금", "%{돈::%player%}%")
    도전과제체크(player, "레벨", "%{낚시레벨::%player%}%")
    # 지역 방문 수
    set {_visitCount} to size of {방문지역::%player%::*}
    if {_visitCount} > 0:
        도전과제체크(player, "지역방문", "%{_visitCount}%")
        # 개별 지역도 체크
        loop {방문지역::%player%::*}:
            도전과제체크(player, "지역", loop-value)
    # 총 낚시 수
    if {총낚시::%player%} is set:
        도전과제체크(player, "총낚시", "%{총낚시::%player%}%")
    # 총 판매 수
    if {총판매::%player%} is set:
        도전과제체크(player, "총판매", "%{총판매::%player%}%")
    # 콤보
    if {낚시최대콤보::%player%} is set:
        도전과제체크(player, "콤보", "%{낚시최대콤보::%player%}%")
    # 도감 수
    set {_docCount} to 0
    loop {도감최대::*}:
        if loop-index contains "%player%":
            add 1 to {_docCount}
    if {_docCount} > 0:
        도전과제체크(player, "도감", "%{_docCount}%")
    # G등급
    if {도감G등급::%player%} is true:
        도전과제체크(player, "등급", "G")
