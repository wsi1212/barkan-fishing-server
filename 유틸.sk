# ===== 받침 여부 판별 =====
# true = 받침 있음, false = 받침 없음
function 받침있음(word: text) :: boolean:
    set {_clean} to {_word}
    replace all "&" with "" in {_clean}
    # 색상 코드 잔여물 제거 (0~9, a~f, k~o, r)
    replace all "§" with "" in {_clean}
    if length of {_clean} < 1:
        return false
    set {_last} to last character of {_clean}
    if {받침없는글자} contains {_last}:
        return false
    return true

# ===== 조사 함수들 =====
# 단어 + 적절한 조사를 붙여서 반환

# 이/가
function 이가(word: text) :: text:
    if 받침있음({_word}) is true:
        return "%{_word}%이"
    return "%{_word}%가"

# 을/를
function 을를(word: text) :: text:
    if 받침있음({_word}) is true:
        return "%{_word}%을"
    return "%{_word}%를"

# 은/는
function 은는(word: text) :: text:
    if 받침있음({_word}) is true:
        return "%{_word}%은"
    return "%{_word}%는"

# 으로/로
function 으로로(word: text) :: text:
    if 받침있음({_word}) is true:
        return "%{_word}%으로"
    return "%{_word}%로"

# 과/와
function 과와(word: text) :: text:
    if 받침있음({_word}) is true:
        return "%{_word}%과"
    return "%{_word}%와"

# 아/야 (호칭)
function 아야(word: text) :: text:
    if 받침있음({_word}) is true:
        return "%{_word}%아"
    return "%{_word}%야"
