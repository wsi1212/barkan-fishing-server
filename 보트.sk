# =========================================
# 보트.sk
# 투명 말 보트 시스템 — 3단 속도 조절, 연료, 티어 업그레이드
# /보트 소환 → 탑승 → 좌클릭 속도 변경 (정지/느림/보통/빠름)
# /보트상점 으로 보트 업그레이드 (9단계)
# =========================================

options:
    boat_prefix: &8[&b 보트 &8]
    boat_cooldown: 300

# ===== 보트 티어 데이터 (9단계) =====
#  1. 나무 보트         180초     기본
#  2. 강화 보트         240초   2,000원
#  3. 철제 보트         300초   5,000원
#  4. 금 보트           390초  15,000원
#  5. 다이아 보트       480초  40,000원
#  6. 에메랄드 보트     600초  80,000원
#  7. 흑요석 보트       750초 150,000원
#  8. 네더라이트 보트   900초 300,000원
#  9. 전설의 보트      1200초 500,000원

function boatTierName(id: number) :: text:
    if {_id} is 1:
        return "나무 보트"
    else if {_id} is 2:
        return "강화 보트"
    else if {_id} is 3:
        return "철제 보트"
    else if {_id} is 4:
        return "금 보트"
    else if {_id} is 5:
        return "다이아 보트"
    else if {_id} is 6:
        return "에메랄드 보트"
    else if {_id} is 7:
        return "흑요석 보트"
    else if {_id} is 8:
        return "네더라이트 보트"
    else if {_id} is 9:
        return "전설의 보트"
    return "보트"

function boatTierFuel(id: number) :: number:
    if {_id} is 1:
        return 180
    else if {_id} is 2:
        return 240
    else if {_id} is 3:
        return 300
    else if {_id} is 4:
        return 390
    else if {_id} is 5:
        return 480
    else if {_id} is 6:
        return 600
    else if {_id} is 7:
        return 750
    else if {_id} is 8:
        return 900
    else if {_id} is 9:
        return 1200
    return 180

function boatTierPrice(id: number) :: number:
    if {_id} is 1:
        return 0
    else if {_id} is 2:
        return 2000
    else if {_id} is 3:
        return 5000
    else if {_id} is 4:
        return 15000
    else if {_id} is 5:
        return 40000
    else if {_id} is 6:
        return 80000
    else if {_id} is 7:
        return 150000
    else if {_id} is 8:
        return 300000
    else if {_id} is 9:
        return 500000
    return 0

function boatTierIcon(id: number) :: item:
    if {_id} is 1:
        return oak boat
    else if {_id} is 2:
        return spruce boat
    else if {_id} is 3:
        return iron ingot
    else if {_id} is 4:
        return gold ingot
    else if {_id} is 5:
        return diamond
    else if {_id} is 6:
        return emerald
    else if {_id} is 7:
        return obsidian
    else if {_id} is 8:
        return netherite ingot
    else if {_id} is 9:
        return nether star
    return oak boat

function boatTierColor(id: number) :: text:
    if {_id} is 1:
        return "&e"
    else if {_id} is 2:
        return "&6"
    else if {_id} is 3:
        return "&f"
    else if {_id} is 4:
        return "&6"
    else if {_id} is 5:
        return "&b"
    else if {_id} is 6:
        return "&a"
    else if {_id} is 7:
        return "&8"
    else if {_id} is 8:
        return "&c"
    else if {_id} is 9:
        return "&d"
    return "&7"

# ===== 속도 단계 데이터 (말 movement_speed 속성값) =====
# 0=정지, 1=느림, 2=보통, 3=빠름
function boatSpeedValue(gear: number) :: number:
    if {_gear} is 1:
        return 0.1
    else if {_gear} is 2:
        return 0.225
    else if {_gear} is 3:
        return 0.4
    return 0

function boatSpeedName(gear: number) :: text:
    if {_gear} is 0:
        return "&c정지"
    else if {_gear} is 1:
        return "&e느림"
    else if {_gear} is 2:
        return "&a보통"
    else if {_gear} is 3:
        return "&b빠름"
    return "&c정지"

function boatSpeedBar(gear: number) :: text:
    if {_gear} is 0:
        return "&8○○○"
    else if {_gear} is 1:
        return "&e●&8○○"
    else if {_gear} is 2:
        return "&a●●&8○"
    else if {_gear} is 3:
        return "&b●●●"
    return "&8○○○"

# ===== 말 속도 속성 변경 =====
function boatSetSpeed(p: player, gear: number):
    set {_horse} to {플레이어보트::%{_p}%}
    if {_horse} is valid:
        set {_spd} to boatSpeedValue({_gear})
        execute console command "execute as %uuid of {_horse}% run attribute @s minecraft:movement_speed base set %{_spd}%"

# ===== 변수 정리 =====
function boatCleanup(p: player):
    set {_horse} to {플레이어보트::%{_p}%}
    if {_horse} is set:
        delete {보트주인::%uuid of {_horse}%}
        if {_horse} is valid:
            kill {_horse}
    delete {플레이어보트::%{_p}%}
    delete {보트탑승중::%{_p}%}
    delete {보트연료::%{_p}%}
    delete {보트최대연료::%{_p}%}
    delete {보트속도::%{_p}%}
    delete {보트마지막위치::%{_p}%}
    delete bossbar named "boat_%uuid of {_p}%"

# ===== 연료 소진 처리 =====
function boatBreakdown(p: player):
    set {_horse} to {플레이어보트::%{_p}%}
    play sound "entity.item.break" with volume 1 to {_p}
    send title "&c⚓ 연료 소진" with subtitle "&7보트가 파괴되었습니다!" to {_p} for 3 seconds
    message "{@boat_prefix} &c연료가 소진되어 보트가 파괴되었습니다!" to {_p}
    message "{@boat_prefix} &7가까운 육지로 이동하면 연료가 자동 보충됩니다." to {_p}
    message "{@boat_prefix} &7보트 소환 쿨타임: &c{@boat_cooldown}초" to {_p}
    set {보트쿨타임::%{_p}%} to unix timestamp of now
    wait 1 tick
    if {_horse} is set:
        if {_horse} is valid:
            kill {_horse}
    delete {플레이어보트::%{_p}%}
    set {보트탑승중::%{_p}%} to false
    delete {보트연료::%{_p}%}
    delete {보트최대연료::%{_p}%}
    delete {보트속도::%{_p}%}
    delete {보트마지막위치::%{_p}%}
    delete bossbar named "boat_%uuid of {_p}%"

# ===== 보트 제거 =====
command /보트제거:
    aliases: /qhxmwprj
    trigger:
        if {플레이어보트::%player%} is set:
            boatCleanup(player)
            message "{@boat_prefix} &c보트를 제거했습니다." to player
        else:
            message "{@boat_prefix} &c소환된 보트가 없습니다." to player

# ===== 보트 소환 (투명 말) =====
command /보트:
    aliases: /qhxm
    trigger:
        # 쿨타임 확인
        if {보트쿨타임::%player%} is set:
            set {_now} to unix timestamp of now
            set {_elapsed} to {_now} - {보트쿨타임::%player%}
            if {_elapsed} < {@boat_cooldown}:
                set {_remain} to {@boat_cooldown} - {_elapsed}
                message "{@boat_prefix} &c쿨타임 중입니다. &7(%{_remain}%초 남음)" to player
                stop
            else:
                delete {보트쿨타임::%player%}
        # 이미 소환된 보트 확인
        if {플레이어보트::%player%} is set:
            set {_old} to {플레이어보트::%player%}
            if {_old} is valid:
                message "{@boat_prefix} &c이미 소환된 보트가 있습니다." to player
                stop
            else:
                boatCleanup(player)
        # 연료비 확인
        if {돈::%player%} is not set:
            set {돈::%player%} to 0
        if {돈::%player%} < 100:
            message "{@boat_prefix} &c연료비가 부족합니다. &7(필요: 100원, 잔액: %{돈::%player%}%원)" to player
            stop
        # 비용 차감
        subtract 100 from {돈::%player%}
        # 티어 정보
        set {_tier} to {보트등급::%player%}
        if {_tier} is not set:
            set {_tier} to 1
        set {_totalFuel} to boatTierFuel({_tier})
        set {_tierName} to boatTierName({_tier})
        set {_tierColor} to boatTierColor({_tier})
        # 가까운 물 수면 찾기 (10블록 이내)
        set {_found} to false
        set {_minDist} to 999
        set {_pLoc} to player's location
        loop blocks in radius 10 around player:
            if loop-block is water:
                if block above loop-block is not water:
                    set {_dist} to distance between {_pLoc} and location of loop-block
                    if {_dist} < {_minDist}:
                        set {_minDist} to {_dist}
                        set {_waterLoc} to location of loop-block
                        set {_found} to true
        if {_found} is false:
            add 100 to {돈::%player%}
            message "{@boat_prefix} &c근처에 물이 없습니다! &7(10블록 이내에서 사용하세요)" to player
            stop
        # 물 수면 위에 살짝 잠긴 상태로 소환
        set {_sx} to x-coordinate of {_waterLoc} + 0.5
        set {_sz} to z-coordinate of {_waterLoc} + 0.5
        set {_sy} to y-coordinate of {_waterLoc} + 0.85
        set {_yaw} to yaw of player
        set {_spawnLoc} to location({_sx}, {_sy}, {_sz}, world of player, {_yaw}, 0)
        spawn a horse at {_spawnLoc}
        set {_horse} to last spawned entity
        # NBT: NoAI, 무적, 길들임, 중력없음, 무음, 안장, 투명화
        execute console command "data merge entity %uuid of {_horse}% {HasVisualFire:0b,NoGravity:1b,Silent:1b,Invulnerable:1b,Glowing:0b,CustomNameVisible:1b,NoAI:1b,Tame:1b,equipment:{saddle:{id:""minecraft:saddle"",count:1}},active_effects:[{id:""minecraft:invisibility"",amplifier:1,duration:199999980,show_particles:0b}]}"
        # 점프 비활성화 + 초기 속도 (보통)
        execute console command "execute as %uuid of {_horse}% run attribute @s minecraft:jump_strength base set 0"
        boatSetSpeed(player, 2)
        set custom name of {_horse} to "%{_tierColor}%%{_tierName}%"
        # 변수 저장
        set {보트주인::%uuid of {_horse}%} to player
        set {플레이어보트::%player%} to {_horse}
        set {보트연료::%player%} to {_totalFuel}
        set {보트최대연료::%player%} to {_totalFuel}
        set {보트속도::%player%} to 2
        message "{@boat_prefix} %{_tierColor}%%{_tierName}%&a를 소환했습니다! &7(-100원)" to player
        message "{@boat_prefix} &7연료: &e%{_totalFuel}%초 &8| &7좌클릭으로 속도 변경" to player
        # 탑승 대기 (10초)
        loop 200 times:
            wait 1 tick
            if {플레이어보트::%player%} is not set:
                stop
            if {_horse} is not valid:
                boatCleanup(player)
                stop
            if vehicle of player is {_horse}:
                set {보트탑승중::%player%} to true
                set {_bar} to bossbar named "boat_%uuid of player%" with title "&f⛽ &a%{_totalFuel}%초 &8| %boatSpeedBar(2)%" with color green with progress 100
                add player to bossbar players of {_bar}
                send action bar "&f속도: %boatSpeedBar(2)% %boatSpeedName(2)% &8| &7좌클릭으로 변경" to player
                message "{@boat_prefix} &a출발! &7좌클릭으로 속도를 변경하세요." to player
                stop
        # 10초 타임아웃 → 환불
        if {보트탑승중::%player%} is not true:
            if {플레이어보트::%player%} is set:
                set {_h} to {플레이어보트::%player%}
                if {_h} is valid:
                    kill {_h}
            delete {플레이어보트::%player%}
            delete {보트연료::%player%}
            delete {보트최대연료::%player%}
            delete {보트속도::%player%}
            add 100 to {돈::%player%}
            message "{@boat_prefix} &e시간 초과로 보트가 사라졌습니다. &a연료비 환불됨." to player

# ===== 좌클릭 속도 변경 =====
on left click:
    if {보트탑승중::%player%} is true:
        cancel event
        set {_gear} to {보트속도::%player%}
        if {_gear} is not set:
            set {_gear} to 0
        add 1 to {_gear}
        if {_gear} > 3:
            set {_gear} to 0
        set {보트속도::%player%} to {_gear}
        boatSetSpeed(player, {_gear})
        set {_name} to boatSpeedName({_gear})
        set {_bar} to boatSpeedBar({_gear})
        send action bar "&f속도: %{_bar}% %{_name}%" to player
        if {_gear} is 0:
            play sound "block.note_block.bass" with volume 0.5 with pitch 0.5 to player
        else if {_gear} is 3:
            play sound "block.note_block.pling" with volume 0.5 with pitch 2 to player
        else:
            play sound "ui.button.click" with volume 0.3 to player

# ===== 다른 플레이어 탑승 방지 =====
# ===== 물 위 제한 (육지 진입 방지) =====
every 2 ticks:
    loop all players:
        if {보트탑승중::%loop-player%} is true:
            set {_horse} to {플레이어보트::%loop-player%}
            if {_horse} is valid:
                set {_loc} to location of {_horse}
                # 말 위치의 블록 확인 (Y=63.85 → floor=63 = 물 블록)
                set {_below} to block at location of {_horse}
                if {_below} is water:
                    # 물 위 — 마지막 유효 위치 저장
                    set {보트마지막위치::%loop-player%} to {_loc}
                else:
                    # 육지 — 마지막 물 위치로 되돌리기
                    if {보트마지막위치::%loop-player%} is set:
                        teleport {_horse} to {보트마지막위치::%loop-player%}

on right click on a horse:
    set {_owner} to {보트주인::%uuid of clicked entity%}
    if {_owner} is set:
        if {_owner} is not player:
            cancel event
            message "{@boat_prefix} &c다른 플레이어의 보트입니다." to player

# ===== 연료 소모 (매초) =====
every 1 second:
    loop all players:
        if {보트탑승중::%loop-player%} is true:
            set {_horse} to {플레이어보트::%loop-player%}
            if {_horse} is not valid:
                boatCleanup(loop-player)
            else:
                set {_maxFuel} to {보트최대연료::%loop-player%}
                if {_maxFuel} is not set:
                    set {_maxFuel} to 180
                # 지역 체크 — 육지면 연료 보충, 바다면 소모
                set {_area} to {area::%loop-player%}
                set {_onLand} to false
                if {_area} is set:
                    if {_area} is not "0":
                        set {_onLand} to true
                if {_onLand} is true:
                    # 육지 — 연료 자동 보충
                    if {보트연료::%loop-player%} < {_maxFuel}:
                        set {보트연료::%loop-player%} to {_maxFuel}
                        play sound "block.brewing_stand.brew" with volume 0.5 to loop-player
                        message "{@boat_prefix} &a⛽ 육지 도착 — 연료가 보충되었습니다!" to loop-player
                else:
                    # 바다 — 속도 0이면 연료 소모 없음, 그 외 1/초
                    set {_gear} to {보트속도::%loop-player%}
                    if {_gear} is not set:
                        set {_gear} to 0
                    if {_gear} > 0:
                        subtract 1 from {보트연료::%loop-player%}
                # 현재 연료
                set {_fuel} to {보트연료::%loop-player%}
                # 연료 소진
                if {_fuel} <= 0:
                    if {_onLand} is false:
                        boatBreakdown(loop-player)
                else:
                    # 보스바 업데이트
                    set {_prog} to ({_fuel} / {_maxFuel}) * 100
                    if {_prog} < 0:
                        set {_prog} to 0
                    if {_prog} > 50:
                        set {_fc} to "&a"
                    else if {_prog} > 20:
                        set {_fc} to "&e"
                    else:
                        set {_fc} to "&c"
                    set {_barId} to "boat_%uuid of loop-player%"
                    set {_bar} to bossbar named {_barId}
                    set {_gear} to {보트속도::%loop-player%}
                    set {_speedBar} to boatSpeedBar({_gear})
                    set bossbar title of {_bar} to "&f⛽ %{_fc}%%{_fuel}%초 &8| %{_speedBar}%"
                    set bossbar progress of {_bar} to {_prog}
                    if {_prog} > 50:
                        set bossbar color of {_bar} to green
                    else if {_prog} > 20:
                        set bossbar color of {_bar} to yellow
                    else:
                        set bossbar color of {_bar} to red
                    # 연료 경고 (바다에서만)
                    if {_onLand} is false:
                        if {_fuel} is 30:
                            message "{@boat_prefix} &e⚠ 연료가 30초 남았습니다!" to loop-player
                        else if {_fuel} is 10:
                            message "{@boat_prefix} &c⚠ 연료가 10초 남았습니다!" to loop-player
                            play sound "block.note_block.bass" with volume 0.7 to loop-player

# ===== 하차 처리 =====
on dismount:
    set {_vehicle} to event-entity
    if {플레이어보트::%player%} is set:
        if {플레이어보트::%player%} is {_vehicle}:
            set {보트탑승중::%player%} to false
            wait 1 tick
            boatCleanup(player)
            message "{@boat_prefix} &7보트에서 내렸습니다." to player

# ===== 접속 종료 시 정리 =====
on quit:
    if {보트탑승중::%player%} is true:
        boatCleanup(player)

# ===== 접속 시 잔여 데이터 정리 =====
on join:
    if {보트탑승중::%player%} is true:
        boatCleanup(player)

# ===== 보트 상점 (업그레이드) =====
command /보트상점:
    aliases: /qhxmtkdwja
    trigger:
        openBoatShop(player)

function openBoatShop(p: player):
    open chest inventory with 2 rows named "&0보트 업그레이드" to {_p}
    set {_currentTier} to {보트등급::%{_p}%}
    if {_currentTier} is not set:
        set {_currentTier} to 1
    # 9티어 표시 (슬롯 0~8)
    loop integers from 1 to 9:
        set {_id} to loop-integer
        set {_slot} to {_id} - 1
        set {_icon} to boatTierIcon({_id})
        set {_color} to boatTierColor({_id})
        set {_name} to boatTierName({_id})
        set {_fuel} to boatTierFuel({_id})
        set {_price} to boatTierPrice({_id})
        delete {_lore::*}
        add "&7티어 &e: &f%{_id}%단계" to {_lore::*}
        add "&7연료 &e: &f%{_fuel}%초 &8(%floor({_fuel} / 60)%분 %mod({_fuel}, 60)%초)" to {_lore::*}
        if {_id} > 1:
            add "&7가격 &e: &f%{_price}%원" to {_lore::*}
        else:
            add "&7가격 &e: &f기본" to {_lore::*}
        add "" to {_lore::*}
        if {_id} is {_currentTier}:
            add "&a현재 사용중" to {_lore::*}
        else if {_id} < {_currentTier}:
            add "&7이미 보유" to {_lore::*}
        else if {_id} is {_currentTier} + 1:
            add "&e클릭하여 업그레이드" to {_lore::*}
        else:
            add "&c이전 단계를 먼저 구매하세요" to {_lore::*}
        set slot {_slot} of {_p}'s current inventory to {_icon} named "%{_color}%%{_name}%" with lore {_lore::*}
    # 하단
    loop integers from 9 to 16:
        set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
    if {돈::%{_p}%} is not set:
        set {돈::%{_p}%} to 0
    set slot 13 of {_p}'s current inventory to gold ingot named "&e내 잔액: &f%{돈::%{_p}%}%원"
    set slot 17 of {_p}'s current inventory to barrier named "&c&l닫기"

# ===== 보트 상점 클릭 =====
on inventory click:
    if player's current inventory's name is "&0보트 업그레이드":
        cancel event
        set {_ci} to index of clicked slot
        if event-item is barrier:
            close player's inventory
        else if event-item is black stained glass pane:
            stop
        else if event-item is gold ingot:
            stop
        else:
            if {_ci} >= 0:
                if {_ci} <= 8:
                    set {_id} to {_ci} + 1
                    set {_currentTier} to {보트등급::%player%}
                    if {_currentTier} is not set:
                        set {_currentTier} to 1
                    if {_id} <= {_currentTier}:
                        message "{@boat_prefix} &c이미 보유한 보트입니다." to player
                        stop
                    if {_id} > {_currentTier} + 1:
                        message "{@boat_prefix} &c이전 단계를 먼저 구매해야 합니다." to player
                        stop
                    set {_price} to boatTierPrice({_id})
                    if {돈::%player%} is not set:
                        set {돈::%player%} to 0
                    if {돈::%player%} < {_price}:
                        message "{@boat_prefix} &c잔액이 부족합니다. &7(필요: %{_price}%원, 잔액: %{돈::%player%}%원)" to player
                        stop
                    subtract {_price} from {돈::%player%}
                    set {보트등급::%player%} to {_id}
                    set {_color} to boatTierColor({_id})
                    set {_name} to boatTierName({_id})
                    set {_fuel} to boatTierFuel({_id})
                    message "{@boat_prefix} %{_color}%%{_name}%&a로 업그레이드! &7(-%{_price}%원 | 잔액: %{돈::%player%}%원)" to player
                    message "{@boat_prefix} &7연료: &e%{_fuel}%초" to player
                    play sound "entity.player.levelup" with volume 1 to player
                    wait 1 tick
                    openBoatShop(player)
