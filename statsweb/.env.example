# 실제 파일명은 .env (이 .example 확장자를 지운 사본). 절대 커밋하지 말 것.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://barkan.kr/admin/callback
# statsweb이 읽을 텔레메트리 폴더 — 박스에서는 실제 plugins/BlockShip/telemetry 경로로.
STATSLAB_DATA_DIR=/home/ubuntu/mcserver/plugins/BlockShip/telemetry
# 세션 쿠키 서명 키 — 운영 배포 전 무작위로 재생성(예: python3 -c "import secrets;print(secrets.token_hex(32))")
SESSION_SECRET=change-me-before-prod

# ── Phase 6(⑪ 콘솔, §10-6) — 아래를 채우는 순간부터 콘솔 액션이 진짜 서버에 명령을 보낸다 ──
# 비워두면(기본) RCON 비활성 — 콘솔에서 뭘 눌러도 "RCON 비활성" 실패만 기록되고 아무 일도 안 일어남.
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=
# playerdata/밴목록 read-only 뷰어 대상 경로 — 비워두면 뷰어가 "설정 안 됨"만 표시.
PLAYERDATA_DIR=/home/ubuntu/mcserver/plugins/BlockShip/playerdata
BANNED_PLAYERS_FILE=/home/ubuntu/mcserver/banned-players.json

# VIP 결제 서비스는 별도 PostgreSQL이 권위. 통계 웹만 Oracle loopback으로 내부 조회·환불 승인한다.
VIP_BILLING_API_URL=http://127.0.0.1:3100
VIP_BILLING_INTERNAL_TOKEN=
