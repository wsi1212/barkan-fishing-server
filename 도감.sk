# ===== 도감 시스템 =====
# 5종 도감: 물고기, 낚싯대, 부품, 재료, 지역
# 첫 발견 시 수집레벨(지역은 탐험레벨) 경험치 지급

# ===== 발견 함수 (외부에서 호출) =====

# --- 물고기 발견 (낚시.sk에서 호출) ---
function 도감_물고기(p: player, fishName: text, grade: text):
    if {도감발견::물고기::%{_p}%::%{_fishName}%} is true:
        stop
    set {도감발견::물고기::%{_p}%::%{_fishName}%} to true
    # 등급별 차등 수집exp
    set {_xp} to 10
    if {_grade} is "D":
        set {_xp} to 15
    else if {_grade} is "C":
        set {_xp} to 20
    else if {_grade} is "B":
        set {_xp} to 30
    else if {_grade} is "A":
        set {_xp} to 50
    else if {_grade} is "S":
        set {_xp} to 80
    else if {_grade} is "S+":
        set {_xp} to 100
    else if {_grade} is "M":
        set {_xp} to 150
    else if {_grade} is "L":
        set {_xp} to 200
    else if {_grade} is "G":
        set {_xp} to 300
    수집경험치추가({_p}, {_xp})
    message "&8[&d 도감 &8] &a새 물고기 등록! &f%{_fishName}% &8(수집 +%{_xp}%exp)" to {_p}
    # 도감 완성도(dogam) 퀘스트 갱신
    퀘스트_도감({_p})

# --- 낚싯대 발견 (조합대.sk에서 호출) ---
function 도감_낚싯대(p: player, rodName: text):
    if {도감발견::낚싯대::%{_p}%::%{_rodName}%} is true:
        stop
    set {도감발견::낚싯대::%{_p}%::%{_rodName}%} to true
    수집경험치추가({_p}, 30)
    message "&8[&d 도감 &8] &a새 낚싯대 등록! &f%{_rodName}% &8(수집 +30exp)" to {_p}
    # Java 도감 즉시 반영 (다음 정기 백업 기다리지 않고 dexDiscovery 미러 push)
    pd백업도감발견({_p}, name of {_p}, "낚싯대")

# --- 부품 발견 (부품상점.sk에서 호출) ---
function 도감_부품(p: player, partType: text, partName: text):
    if {도감발견::부품::%{_p}%::%{_partType}%::%{_partName}%} is true:
        stop
    set {도감발견::부품::%{_p}%::%{_partType}%::%{_partName}%} to true
    수집경험치추가({_p}, 15)
    message "&8[&d 도감 &8] &a새 부품 등록! &f%{_partName}% &8(수집 +15exp)" to {_p}
    # Java 도감 즉시 반영 (부품은 "type::name" 평탄화 백업)
    pd백업도감발견({_p}, name of {_p}, "부품")

# --- 재료 발견 (조합재료.sk에서 호출) ---
function 도감_재료(p: player, matId: text):
    if {도감발견::재료::%{_p}%::%{_matId}%} is true:
        stop
    set {도감발견::재료::%{_p}%::%{_matId}%} to true
    수집경험치추가({_p}, 20)
    set {_matData::*} to split {조합재료::%{_matId}%} at "|"
    message "&8[&d 도감 &8] &a새 재료 등록! &e%{_matData::1}% &8(수집 +20exp)" to {_p}
    # Java 도감 즉시 반영
    pd백업도감발견({_p}, name of {_p}, "재료")

# --- 지역 발견 (탐험.sk 탐험_발견에서 자동 처리 → 여기선 도감 변수만 세팅) ---
function 도감_지역(p: player, regionId: text):
    if {도감발견::지역::%{_p}%::%{_regionId}%} is true:
        stop
    set {도감발견::지역::%{_p}%::%{_regionId}%} to true
    # 탐험exp는 탐험_발견()에서 이미 지급하므로 여기선 도감 등록만
    # Java 도감 즉시 반영
    pd백업도감발견({_p}, name of {_p}, "지역")

# ===== [Java 이관] 도감 GUI(메인+5탭) + 카운트 함수 제거 =====
# 5탭 도감 GUI(도감메인GUI/도감_낚싯대·부품·재료·지역GUI) 및 도감카운트_* 함수는
# Java(com.blockship.dex.MainDexGui)로 이관됨. Java 는 PlayerData(dexDiscovery/fishRecords) +
# FishLoader/PartLoader/RecipeLoader/MaterialLoader/RegionManager 에서 직접 읽어 카운트/표시.
# 발견 기록(도감_물고기/낚싯대/부품/재료/지역) write 함수는 위에 유지(여러 서브시스템이 호출).
# 아래는 퀘스트 dogam 목표용 지역 진행도 헬퍼(Skript 잔존).

# ===== 지역 도감 진행도 (퀘스트 dogam 목표용) =====
# regionSpec: 쉼표로 구분된 지역(섬) ID 목록. 각 지역 + 하위지역의 물고기를 합집합.
# 예: "사막,붉은사막"  /  "강,강_상류,정상,스폰도시"  /  "바르칸"
function 도감_지역발견수(p: player, regionSpec: text) :: number:
    delete {_all::*}
    loop split {_regionSpec} at ",":
        set {_one::*} to 도감_지역종집합(loop-value-1)
        loop {_one::*}:
            if {_all::*} does not contain loop-value-2:
                add loop-value-2 to {_all::*}
    set {_found} to 0
    loop {_all::*}:
        if {도감발견::물고기::%{_p}%::%loop-value%} is true:
            add 1 to {_found}
    return {_found}

# dogam 목표 표시용 지역명 (3곳 이상이면 "첫지역 일대")
function 도감_지역표시(regionSpec: text) :: text:
    set {_parts::*} to split {_regionSpec} at ","
    if size of {_parts::*} > 2:
        set {_dn} to {지역표시이름::%{_parts::1}%}
        if {_dn} is not set:
            set {_dn} to {_parts::1}
        return "%{_dn}% 일대"
    set {_out} to ""
    loop {_parts::*}:
        set {_dn} to {지역표시이름::%loop-value%}
        if {_dn} is not set:
            set {_dn} to loop-value
        if {_out} is "":
            set {_out} to {_dn}
        else:
            set {_out} to "%{_out}%·%{_dn}%"
    return {_out}

# region + 하위 지역(부모체인에 region 포함) 전체 물고기 종 목록 (중복 제거)
# 모든 시간/날씨 버킷을 합산 → 그 지역에서 잡을 수 있는 모든 종
function 도감_지역종집합(region: text) :: texts:
    delete {_buckets::*}
    add "기본" to {_buckets::*}
    add "낮" to {_buckets::*}
    add "낮맑음" to {_buckets::*}
    add "낮비" to {_buckets::*}
    add "밤" to {_buckets::*}
    add "밤맑음" to {_buckets::*}
    add "밤비" to {_buckets::*}
    add "새벽" to {_buckets::*}
    add "비" to {_buckets::*}
    add "뇌우" to {_buckets::*}
    # 대상 지역 집합: region 자신 + 부모체인에 region을 포함한 모든 지역/섬
    delete {_targets::*}
    add {_region} to {_targets::*}
    loop {지역리스트::*}:
        if loop-value is not {_region}:
            if 도감_지역조상포함(loop-value, {_region}) is true:
                add loop-value to {_targets::*}
    loop {섬리스트::*}:
        if loop-value is not {_region}:
            if {_targets::*} does not contain loop-value:
                if 도감_지역조상포함(loop-value, {_region}) is true:
                    add loop-value to {_targets::*}
    delete {_result::*}
    loop {_targets::*}:
        set {_rg} to loop-value-1
        loop {_buckets::*}:
            set {_bk} to loop-value-2
            loop {지역물고기목록::%{_rg}%::%{_bk}%::*}:
                if {_result::*} does not contain loop-value-3:
                    add loop-value-3 to {_result::*}
    return {_result::*}

# region의 부모체인(섬)에 ancestor가 포함되는지
function 도감_지역조상포함(region: text, ancestor: text) :: boolean:
    set {_cur} to {_region}
    loop 32 times:
        set {_pid} to {지역부모섬::%{_cur}%}
        if {_pid} is not set:
            return false
        if {_pid} is {_ancestor}:
            return true
        set {_cur} to {_pid}
    return false

# ===== 브릿지 명령어 (조합대 → 도감, 파일 로드 순서 문제 우회) =====
command /dogamrod <player> <text>:
    permission: op
    executable by: console
    trigger:
        도감_낚싯대(arg-1, arg-2)
