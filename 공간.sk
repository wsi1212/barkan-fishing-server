# =========================================
#   공간.sk — Java(RegionManager/Tracker/WeatherManager) 이관 후 잔존 미러 브릿지
#   지역 입장/퇴장/레벨게이트/알림/환경보너스/lava/area = Java RegionTracker 권위.
#   데드 미러({area}/{용암낚시}/{지역표시이름}/{지역부모섬}/{지역날씨}/{서버날씨}/{지역제외날씨}) push 중단됨
#   → setarea/setlava/regionsync/regionparentsync/regionweather*/지역잔재청소/날씨변수청소 삭제.
#   잔존: regionresync(on load) + on rightclick + {지역리스트}/{섬리스트}/{지역길드} 미러(길드/메뉴가 읽음).
# =========================================

# /sk reload 시 regionresync로 지역/미러 데이터 복원 (Java RegionManager.syncRegionsToSkript).
on load:
    execute console command "regionresync"

# warped sign + 낚싯대 우클릭 취소
on rightclick:
    if clicked block is warped sign:
        if player's tool is fishing rod:
            cancel event

# ===== 지역 리스트 동기화 (Java → Skript) — 길드.sk/메뉴.sk가 {지역리스트} 읽음 =====
command /regionlistsync <text> [<text>]:
    permission: op
    executable by: console
    trigger:
        if arg-1 is "init":
            delete {지역리스트::*}
        else if arg-1 is "add":
            add arg-2 to {지역리스트::*}

# ===== 섬 리스트 동기화 (Java → Skript) — 길드.sk가 {섬리스트} 읽음 =====
command /islandlistsync <text> [<text>]:
    permission: op
    executable by: console
    trigger:
        if arg-1 is "init":
            delete {섬리스트::*}
        else if arg-1 is "add":
            add arg-2 to {섬리스트::*}

# ===== 길드 소유 지역 동기화 (Java → Skript) — 길드.sk가 {지역길드} 읽음 =====
command /regionguildsync <text> <text>:
    permission: op
    executable by: console
    trigger:
        if arg-2 is "없음":
            delete {지역길드::%arg-1%}
        else:
            set {지역길드::%arg-1%} to arg-2

# ===== 지역 삭제 시 정리 (Java RegionManager.deleteRegion에서 호출) =====
command /regiondeletesync <text>:
    permission: op
    executable by: console
    trigger:
        delete {지역표시이름::%arg-1%}
        delete {지역레벨제한::%arg-1%}
        delete {지역부모섬::%arg-1%}
        delete {지역길드::%arg-1%}
        delete {지역허용날씨::%arg-1%}
        delete {지역제외날씨::%arg-1%}
        delete {지역날씨::%arg-1%}
        delete {지역물고기목록::%arg-1%::*}
        if {지역리스트::*} contains arg-1:
            remove arg-1 from {지역리스트::*}
        if {섬리스트::*} contains arg-1:
            remove arg-1 from {섬리스트::*}
        loop all players:
            if {방문지역::%loop-player%::*} contains arg-1:
                remove arg-1 from {방문지역::%loop-player%::*}
