function enterlava(p: player):
    set {용암낚시::%{_p}%} to 1

function exitlava(p: player):
    set {용암낚시::%{_p}%} to 0

# ===== 지역 표시 이름 =====
function regionDisplayName(region: text) :: text:
    if {_region} is "갈매기바위":
        return "갈매기 바위"
    else if {_region} is "바르칸물길":
        return "바르칸 물길"
    else if {_region} is "바르칸동굴":
        return "바르칸 동굴"
    else if {_region} is "lavatest":
        return "용암 지대"
    else if {_region} is "원양어선":
        return "원양어선"
    return {_region}

# ===== 지역 레벨 제한 =====
function regionRequiredLevel(region: text) :: number:
    if {_region} is "갈매기바위":
        return 0
    else if {_region} is "바르칸물길":
        return 0
    else if {_region} is "바르칸동굴":
        return 0
    else if {_region} is "lavatest":
        return 50
    else if {_region} is "원양어선":
        return 15
    return 0

# ===== 레벨 미달 시 진입 거부 처리 =====
function rejectEntry(p: player, region: text):
    set {_req} to regionRequiredLevel({_region})
    message "&8[&b 낚시 &8] &c이 지역은 낚시 레벨 &e%{_req}% &c이상만 입장할 수 있습니다. &7(현재: Lv.%{낚시레벨::%{_p}%}%)" to {_p}
    set {area::%{_p}%} to "0"
    set {거부쿨다운::%{_p}%} to true
    # 탈것 정보 미리 저장
    if {_p} is riding:
        set {_vehicle} to vehicle of {_p}
    # 텔포 (탈것 탑승 중이어도 텔포하면 자동 하차)
    if {안전위치::%{_p}%} is set:
        teleport {_p} to {안전위치::%{_p}%}
    else:
        message "&8[&b 낚시 &8] &c비정상적인 접근이 감지되어 스폰으로 이동합니다." to {_p}
        teleport {_p} to spawn of world "flatroom"
    # 탈것 제거
    wait 1 tick
    if {_vehicle} is set:
        kill {_vehicle}
    # 텔포 후에도 여전히 구역 안이면 스폰으로 강제 이동
    wait 3 ticks
    set {_stillIn} to false
    loop all areas:
        if loop-value is {_region}:
            if {_p} is in area loop-value:
                set {_stillIn} to true
            stop loop
    if {_stillIn} is true:
        message "&8[&b 낚시 &8] &c비정상적인 접근이 감지되어 스폰으로 이동합니다." to {_p}
        teleport {_p} to spawn of world "flatroom"
    # 5초간 안전위치 저장 차단 (경계 근처 위치 저장 방지)
    wait 5 seconds
    delete {거부쿨다운::%{_p}%}

# ===== 입장 처리 =====
function areaEnter(p: player, area: text):
    set {_req} to regionRequiredLevel({_area})
    if {_req} > 0:
        if {낚시레벨::%{_p}%} is not set:
            set {낚시레벨::%{_p}%} to 1
        if {낚시레벨::%{_p}%} < {_req}:
            rejectEntry({_p}, {_area})
            stop
    set {area::%{_p}%} to {_area}
    # 방문 지역 기록 (페리 이용 조건)
    if {방문지역::%{_p}%::*} does not contain {_area}:
        add {_area} to {방문지역::%{_p}%::*}
        set {_firstDisp} to regionDisplayName({_area})
        wait 1 tick
        send title "&6✦ 새로운 지역 발견!" with subtitle "&f%{_firstDisp}%" to {_p}
        play sound "ui.toast.challenge_complete" with volume 0.8 with pitch 1 to {_p}
    set {_display} to regionDisplayName({_area})
    message "&8[&b 낚시 &8] &a%{_display}%&f에 입장하였습니다." to {_p}
    if {_area} is "lavatest":
        enterlava({_p})
    환경보너스알림({_p})
    퀘스트_지역입장({_p}, {_area})

# ===== 퇴장 처리 =====
function areaExit(p: player, area: text):
    set {_display} to regionDisplayName({_area})
    message "&8[&b 낚시 &8] &a%{_display}%&f에서 퇴장하였습니다." to {_p}
    set {area::%{_p}%} to "0"
    if {_area} is "lavatest":
        exitlava({_p})
    # 페리 대기 자동 취소
    if {페리노선목록::*} is set:
        loop {페리노선목록::*}:
            if {페리노선::%loop-value%::탑승지역} is {_area}:
                if {페리대기::%loop-value%::*} contains {_p}:
                    remove {_p} from {페리대기::%loop-value%::*}
                    remove {_p} from bossbar players of (bossbar named "ferry_wait_%loop-value%")
                    message "&8[&9 페리 &8] &e탑승 지역을 벗어나 &f%loop-value%&e 노선 탑승이 취소되었습니다." to {_p}

# ===== 낚시 시도 시 레벨 체크 (마인카트 등 우회 대응) =====
on fishing line cast:
    set {_area} to {area::%player%}
    if {_area} is not set:
        set {_area} to "0"
    if {_area} is not "0":
        set {_req} to regionRequiredLevel({_area})
        if {_req} > 0:
            if {낚시레벨::%player%} is not set:
                set {낚시레벨::%player%} to 1
            if {낚시레벨::%player%} < {_req}:
                cancel event
                rejectEntry(player, {_area})
                stop
    # 기록 안 된 상태에서도 실제 위치 체크
    else:
        loop all areas:
            if player is in area loop-value:
                set {_req} to regionRequiredLevel(loop-value)
                if {_req} > 0:
                    if {낚시레벨::%player%} is not set:
                        set {낚시레벨::%player%} to 1
                    if {낚시레벨::%player%} < {_req}:
                        cancel event
                        rejectEntry(player, loop-value)
                stop loop

on rightclick:
    if clicked block is warped sign:
        if player's tool is fishing rod:
            cancel event

on join:
    # flatroom이 아닌 월드에서 접속하면 flatroom 스폰으로 이동
    if player's world is not world "flatroom":
        teleport player to spawn of world "flatroom"
    wait 5 ticks
    set {안전위치::%player%} to player's location

# ===== 리스폰: 항상 flatroom에서 부활 =====
on respawn:
    set respawn location to spawn of world "flatroom"

# ===== 텔레포트 감지: TP로 지역 진입/퇴장 처리 =====
on teleport:
    wait 1 tick
    set {_oldArea} to {area::%player%}
    if {_oldArea} is not set:
        set {_oldArea} to "0"
    # 텔포 후 현재 위치의 지역 확인
    set {_newArea} to "0"
    loop all areas:
        if player is in area loop-value:
            set {_newArea} to loop-value
            stop loop
    if {_newArea} is {_oldArea}:
        stop
    # 이전 지역 퇴장
    if {_oldArea} is not "0":
        areaExit(player, {_oldArea})
    # 새 지역 입장
    if {_newArea} is not "0":
        areaEnter(player, {_newArea})
    else:
        set {area::%player%} to "0"

# ===== 트리거 기반: 지역 진입 감지 =====
on enter area:
    set {_newArea} to "0"
    loop all areas:
        if player is in area loop-value:
            set {_newArea} to loop-value
            stop loop
    if {_newArea} is "0":
        stop
    set {_oldArea} to {area::%player%}
    if {_oldArea} is not set:
        set {_oldArea} to "0"
    if {_newArea} is {_oldArea}:
        stop
    # 이전 지역 퇴장
    if {_oldArea} is not "0":
        areaExit(player, {_oldArea})
    # 새 지역 입장
    areaEnter(player, {_newArea})

# ===== 트리거 기반: 지역 퇴장 감지 =====
on exit area:
    wait 1 tick
    set {_oldArea} to {area::%player%}
    if {_oldArea} is not set:
        stop
    if {_oldArea} is "0":
        stop
    # 정말 나갔는지 확인 (is in area는 loop-value만 가능)
    set {_stillIn} to false
    loop all areas:
        if loop-value is {_oldArea}:
            if player is in area loop-value:
                set {_stillIn} to true
            stop loop
    if {_stillIn} is false:
        areaExit(player, {_oldArea})
        # 나간 직후 다른 지역에 있는지 체크
        set {_newArea} to "0"
        loop all areas:
            if player is in area loop-value:
                set {_newArea} to loop-value
                stop loop
        if {_newArea} is not "0":
            areaEnter(player, {_newArea})
        else:
            set {안전위치::%player%} to player's location

# ===== 백업 폴링: 안전 위치 저장 + 퇴장 누락 보정 (가벼운 주기) =====
every 3 seconds:
    loop all players:
        set {_oldArea} to {area::%loop-player-1%}
        if {_oldArea} is not set:
            set {_oldArea} to "0"
        if {_oldArea} is "0":
            # 지역 밖: 안전위치 저장만
            if {거부쿨다운::%loop-player-1%} is not set:
                set {안전위치::%loop-player-1%} to loop-player-1's location
        else:
            # 지역 안으로 기록됨: 실제로 나갔는지 1회 체크
            set {_stillIn} to false
            loop all areas:
                if loop-value-2 is {_oldArea}:
                    if loop-player-1 is in area loop-value-2:
                        set {_stillIn} to true
                    stop loop
            if {_stillIn} is false:
                areaExit(loop-player-1, {_oldArea})
                set {안전위치::%loop-player-1%} to loop-player-1's location
            else:
                # 지역 안에 있는데 레벨 미달이면 강제 퇴장
                set {_req} to regionRequiredLevel({_oldArea})
                if {_req} > 0:
                    if {낚시레벨::%loop-player-1%} is not set:
                        set {낚시레벨::%loop-player-1%} to 1
                    if {낚시레벨::%loop-player-1%} < {_req}:
                        if {거부쿨다운::%loop-player-1%} is not set:
                            rejectEntry(loop-player-1, {_oldArea})

