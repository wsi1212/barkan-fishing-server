# =========================================
# 어드민.sk — 관리자 전용 명령어 (partial, 9/24 이관 후 잔류분)
# ★ Java 이관됨 (어드민_bridge.sk / AdminManager / FishingLevelManager):
#     /레벨설정, /최대콤보설정, OP 접속·월드이동 크리에이티브, 레벨필요경험치계산 함수.
# ★ Skript 잔류: /도감관리 — {물고기/부품목록/조합법/조합재료} Skript DB에 강결합이라 Java 동기 read 불가.
# =========================================

# ===== /도감관리 <닉네임> <모드> [물고기이름] =====
# 모드: 전체오픈 / 전체잠금 / 오픈 <물고기> / 잠금 <물고기>
on tab complete of "/도감관리":
    set tab completions for position 1 to names of all players
    set tab completions for position 2 to "전체오픈", "전체잠금", "오픈" and "잠금"
    set tab completions for position 3 to "<물고기이름>"

command /도감관리 [<text>] [<text>] [<text>]:
    permission: op
    permission message: &c권한이 없습니다.
    trigger:
        if arg-1 is not set:
            message "&8[&c 어드민 &8] &7사용법:" to player
            message "&8  &e/도감관리 <닉네임> 전체오픈 &7— 모든 물고기 발견 처리" to player
            message "&8  &e/도감관리 <닉네임> 전체잠금 &7— 모든 물고기 미발견 처리" to player
            message "&8  &e/도감관리 <닉네임> 오픈 <물고기> &7— 특정 물고기 발견 처리" to player
            message "&8  &e/도감관리 <닉네임> 잠금 <물고기> &7— 특정 물고기 미발견 처리" to player
            stop
        if arg-2 is not set:
            message "&8[&c 어드민 &8] &c모드를 입력하세요: 전체오픈, 전체잠금, 오픈, 잠금" to player
            stop

        # 대상 플레이어 찾기
        delete {_target}
        loop all players:
            if loop-player's name is arg-1:
                set {_target} to loop-player
                stop loop
        if {_target} is not set:
            message "&8[&c 어드민 &8] &c%arg-1%님이 온라인 상태가 아닙니다." to player
            stop

        if arg-2 is "전체오픈":
            set {_fishCnt} to 0
            set {_rodCnt} to 0
            set {_partCnt} to 0
            set {_matCnt} to 0
            set {_recipeCnt} to 0
            # --- 물고기 도감 ---
            loop {물고기::*}:
                set {_fp::*} to split loop-value at "|"
                set {_fname} to {_fp::1}
                if {도감최대::%{_fname}%::%{_target}%} is not set:
                    set {_maxSize} to {_fp::3} parsed as number
                    set {도감최대::%{_fname}%::%{_target}%} to {_maxSize}
                    set {처음낚은날짜::%{_fname}%::%{_target}%} to now
                    set {최대낚은날짜::%{_fname}%::%{_target}%} to now
                    add 1 to {_fishCnt}
                set {도감발견::물고기::%{_target}%::%{_fname}%} to true
            # --- 낚싯대 도감 (부품데이터) ---
            if {부품목록::낚싯대::*} is set:
                loop {부품목록::낚싯대::*}:
                    if {도감발견::낚싯대::%{_target}%::%loop-value%} is not true:
                        set {도감발견::낚싯대::%{_target}%::%loop-value%} to true
                        add 1 to {_rodCnt}
            # --- 낚싯대 도감 (조합 [낚싯대] 태그: 초보자 낚싯대 등) ---
            if {조합카테::낚시::*} is set:
                loop {조합카테::낚시::*}:
                    set {_cidA} to loop-value
                    set {_rNameA} to {조합법::%{_cidA}%::이름}
                    if {_rNameA} is set:
                        set {_rItemA} to {조합법::%{_cidA}%::결과}
                        if {_rItemA} is set:
                            set {_rLoreA} to "%lore of {_rItemA}%"
                            if {_rLoreA} contains "[낚싯대]":
                                if {도감발견::낚싯대::%{_target}%::%{_rNameA}%} is not true:
                                    set {도감발견::낚싯대::%{_target}%::%{_rNameA}%} to true
                                    add 1 to {_rodCnt}
            # --- 부품 도감 (릴/줄/바늘/미끼/찌) ---
            set {_pTypes::1} to "릴"
            set {_pTypes::2} to "줄"
            set {_pTypes::3} to "바늘"
            set {_pTypes::4} to "미끼"
            set {_pTypes::5} to "찌"
            loop 5 times:
                set {_pt} to {_pTypes::%loop-iteration%}
                if {부품목록::%{_pt}%::*} is set:
                    loop {부품목록::%{_pt}%::*}:
                        if {도감발견::부품::%{_target}%::%{_pt}%::%loop-value-2%} is not true:
                            set {도감발견::부품::%{_target}%::%{_pt}%::%loop-value-2%} to true
                            add 1 to {_partCnt}
            # --- 재료 도감 ---
            loop {조합재료::*}:
                if {도감발견::재료::%{_target}%::%loop-index%} is not true:
                    set {도감발견::재료::%{_target}%::%loop-index%} to true
                    add 1 to {_matCnt}
            # --- 레시피 해금 (낚싯대 락잠금 ON 항목 전부) ---
            if {조합카테::낚시::*} is set:
                loop {조합카테::낚시::*}:
                    set {_rid} to loop-value
                    if {조합법::%{_rid}%::락잠금} is true:
                        if {레시피해금::%{_target}%::%{_rid}%} is not true:
                            set {레시피해금::%{_target}%::%{_rid}%} to true
                            add 1 to {_recipeCnt}
            message "&8[&c 어드민 &8] &f%arg-1%&a님의 도감을 전체 오픈했습니다." to player
            message "&8  &7물고기 &e+%{_fishCnt}% &8| &7낚싯대 &e+%{_rodCnt}% &8| &7부품 &e+%{_partCnt}% &8| &7재료 &e+%{_matCnt}% &8| &7레시피 &e+%{_recipeCnt}%" to player

        else if arg-2 is "전체잠금":
            set {_fishCnt} to 0
            set {_rodCnt} to 0
            set {_partCnt} to 0
            set {_matCnt} to 0
            set {_recipeCnt} to 0
            # --- 물고기 도감 ---
            loop {물고기::*}:
                set {_fp::*} to split loop-value at "|"
                set {_fname} to {_fp::1}
                if {도감최대::%{_fname}%::%{_target}%} is set:
                    delete {도감최대::%{_fname}%::%{_target}%}
                    delete {처음낚은날짜::%{_fname}%::%{_target}%}
                    delete {최대낚은날짜::%{_fname}%::%{_target}%}
                    add 1 to {_fishCnt}
                delete {도감발견::물고기::%{_target}%::%{_fname}%}
            # --- 낚싯대 도감 (부품데이터) ---
            if {부품목록::낚싯대::*} is set:
                loop {부품목록::낚싯대::*}:
                    if {도감발견::낚싯대::%{_target}%::%loop-value%} is true:
                        delete {도감발견::낚싯대::%{_target}%::%loop-value%}
                        add 1 to {_rodCnt}
            # --- 낚싯대 도감 (조합 [낚싯대] 태그) ---
            if {조합카테::낚시::*} is set:
                loop {조합카테::낚시::*}:
                    set {_cidB} to loop-value
                    set {_rNameB} to {조합법::%{_cidB}%::이름}
                    if {_rNameB} is set:
                        set {_rItemB} to {조합법::%{_cidB}%::결과}
                        if {_rItemB} is set:
                            set {_rLoreB} to "%lore of {_rItemB}%"
                            if {_rLoreB} contains "[낚싯대]":
                                if {도감발견::낚싯대::%{_target}%::%{_rNameB}%} is true:
                                    delete {도감발견::낚싯대::%{_target}%::%{_rNameB}%}
                                    add 1 to {_rodCnt}
            # --- 부품 도감 ---
            set {_pTypes::1} to "릴"
            set {_pTypes::2} to "줄"
            set {_pTypes::3} to "바늘"
            set {_pTypes::4} to "미끼"
            set {_pTypes::5} to "찌"
            loop 5 times:
                set {_pt} to {_pTypes::%loop-iteration%}
                if {부품목록::%{_pt}%::*} is set:
                    loop {부품목록::%{_pt}%::*}:
                        if {도감발견::부품::%{_target}%::%{_pt}%::%loop-value-2%} is true:
                            delete {도감발견::부품::%{_target}%::%{_pt}%::%loop-value-2%}
                            add 1 to {_partCnt}
            # --- 재료 도감 ---
            loop {조합재료::*}:
                if {도감발견::재료::%{_target}%::%loop-index%} is true:
                    delete {도감발견::재료::%{_target}%::%loop-index%}
                    add 1 to {_matCnt}
            # --- 레시피 해금 해제 ---
            if {조합카테::낚시::*} is set:
                loop {조합카테::낚시::*}:
                    set {_rid} to loop-value
                    if {조합법::%{_rid}%::락잠금} is true:
                        if {레시피해금::%{_target}%::%{_rid}%} is true:
                            delete {레시피해금::%{_target}%::%{_rid}%}
                            add 1 to {_recipeCnt}
            message "&8[&c 어드민 &8] &f%arg-1%&a님의 도감을 전체 잠금했습니다." to player
            message "&8  &7물고기 &e-%{_fishCnt}% &8| &7낚싯대 &e-%{_rodCnt}% &8| &7부품 &e-%{_partCnt}% &8| &7재료 &e-%{_matCnt}% &8| &7레시피 &e-%{_recipeCnt}%" to player

        else if arg-2 is "오픈":
            if arg-3 is not set:
                message "&8[&c 어드민 &8] &c물고기 이름을 입력하세요." to player
                stop
            # 물고기 존재 확인
            set {_found} to false
            loop {물고기::*}:
                set {_fp::*} to split loop-value at "|"
                if {_fp::1} is arg-3:
                    set {_found} to true
                    if {도감최대::%arg-3%::%{_target}%} is set:
                        message "&8[&c 어드민 &8] &7%arg-3%는 이미 발견된 물고기입니다." to player
                    else:
                        set {_maxSize} to {_fp::3} parsed as number
                        set {도감최대::%arg-3%::%{_target}%} to {_maxSize}
                        set {처음낚은날짜::%arg-3%::%{_target}%} to now
                        set {최대낚은날짜::%arg-3%::%{_target}%} to now
                        message "&8[&c 어드민 &8] &f%arg-1%&a님의 도감에 &e%arg-3%&a를 등록했습니다." to player
                    stop loop
            if {_found} is false:
                message "&8[&c 어드민 &8] &c'%arg-3%' 물고기를 찾을 수 없습니다." to player

        else if arg-2 is "잠금":
            if arg-3 is not set:
                message "&8[&c 어드민 &8] &c물고기 이름을 입력하세요." to player
                stop
            if {도감최대::%arg-3%::%{_target}%} is set:
                delete {도감최대::%arg-3%::%{_target}%}
                delete {처음낚은날짜::%arg-3%::%{_target}%}
                delete {최대낚은날짜::%arg-3%::%{_target}%}
                message "&8[&c 어드민 &8] &f%arg-1%&a님의 도감에서 &e%arg-3%&a를 제거했습니다." to player
            else:
                message "&8[&c 어드민 &8] &7%arg-3%는 발견되지 않은 물고기입니다." to player

        else:
            message "&8[&c 어드민 &8] &c올바른 모드를 입력하세요: 전체오픈, 전체잠금, 오픈, 잠금" to player
