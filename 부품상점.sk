# =========================================
# 부품상점.sk
# 낚시 부품 상점 GUI + 구매
# =========================================

options:
    shop_prefix: &8[&6 부품상점 &8]

# ===== /부품상점 명령어 =====
on tab complete of "/부품상점":
    set tab completions for position 1 to "낚싯대", "릴", "줄", "바늘", "미끼" and "찌"

command /부품상점 [<text>]:
    aliases: /qnvmatkdwja
    trigger:
        if arg-1 is not set:
            openPartShop(player, "낚싯대")
        else:
            openPartShop(player, arg-1)

# ===== 상점 GUI 열기 =====
function openPartShop(p: player, category: text):
    open chest inventory with 6 rows named "&0부품 상점" to {_p}
    set {상점카테고리::%{_p}%} to {_category}

    # 1행: 카테고리 탭 (slot 0~8)
    set {_cats::1} to "낚싯대"
    set {_cats::2} to "릴"
    set {_cats::3} to "줄"
    set {_cats::4} to "바늘"
    set {_cats::5} to "미끼"
    set {_cats::6} to "찌"
    loop 6 times:
        set {_cat} to {_cats::%loop-iteration%}
        set {_icon} to part_icon_item({_cat})
        set {_slot} to loop-iteration
        subtract 1 from {_slot}
        if {_cat} is {_category}:
            set slot {_slot} of {_p}'s current inventory to {_icon} named "&e&l%{_cat}%" with lore "&a현재 선택됨"
        else:
            set slot {_slot} of {_p}'s current inventory to {_icon} named "&7%{_cat}%" with lore "&7클릭하여 카테고리 변경"
    set slot 6 of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 7 of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 8 of {_p}'s current inventory to barrier named "&c&l닫기"

    # 2~5행: 부품 목록 (slot 9~44)
    delete {상점부품슬롯::%{_p}%::*}
    loop integers from 9 to 44:
        set slot loop-integer of {_p}'s current inventory to air
    set {_slot} to 9
    loop {부품목록::%{_category}%::*}:
        set {_name} to loop-value
        set {_grade} to get_part_grade({_category}, {_name})
        set {_color} to part_grade_color({_grade})
        set {_price} to get_part_price({_category}, {_name})
        set {_dur} to get_part_durability({_category}, {_name})
        set {_icon} to part_icon_item({_category})
        # 낚싯대 카테고리 → 레시피 판매 (paper 아이콘 + 50% 가격)
        if {_category} is "낚싯대":
            set {_icon} to paper
            set {_recipeId} to {부품_레시피ID::낚싯대::%{_name}%}
            set {_price} to round({_price} * 0.5)

        # 동적 lore 생성
        delete {_lore::*}
        add "&7등급 &e: %{_color}%%{_grade}%" to {_lore::*}
        # 스탯 파싱
        set {_statsRaw} to get_part_stats_raw({_category}, {_name})
        set {_pairs::*} to split {_statsRaw} at ","
        loop {_pairs::*}:
            set {_kv::*} to split loop-value-2 at ":"
            set {_desc} to stat_type_desc({_kv::1})
            if {_kv::1} is "등급특화":
                add "&7등급 특화 &e: &f%{_kv::2}%등급 확률 2배" to {_lore::*}
            else:
                set {_vt} to stat_value_text({_kv::1}, {_kv::2} parsed as number)
                add "&7%{_desc}% &e: &f%{_vt}%" to {_lore::*}
        # 레벨 제한 + 출처
        set {_reqLv} to get_part_level_req({_category}, {_name})
        set {_origin} to get_part_origin({_category}, {_name})
        if {_reqLv} > 0:
            set {_playerLv} to {낚시레벨::%{_p}%}
            if {_playerLv} is not set:
                set {_playerLv} to 1
            if {_playerLv} >= {_reqLv}:
                add "&7레벨 &e: &aLv.%{_reqLv}% ✓" to {_lore::*}
            else:
                add "&7레벨 &e: &cLv.%{_reqLv}% ✗ &7(현재 Lv.%{_playerLv}%)" to {_lore::*}
        if {_origin} is not "공용":
            if {_origin} is not "개발자":
                add "&7출처 &e: &f%{_origin}%" to {_lore::*}
        # 내구도 / 가격
        if {_category} is "미끼":
            add "&7가격 &e: &f%{_price}%원/개" to {_lore::*}
        else:
            add "&7내구도 &e: &f%{_dur}%" to {_lore::*}
            add "&7가격 &e: &f%{_price}%원" to {_lore::*}

        # 보유 상태 확인
        set {_owned} to ""
        if {_category} is "낚싯대":
            if {_recipeId} is set:
                if {레시피해금::%{_p}%::%{_recipeId}%} is true:
                    set {_owned} to "&a레시피 보유중 (조합대에서 제작 가능)"
                else:
                    set {_owned} to "&c레시피 미보유"
            else:
                set {_owned} to "&8레시피 없음 (개발자/이벤트용)"
        else if {_category} is "미끼":
            set {_count} to {부품인벤::미끼::%{_p}%::%{_name}%}
            if {_count} is set:
                if {_count} > 0:
                    set {_owned} to "&a보유: %{_count}%/99개"
        else:
            loop {부품인벤::%{_category}%::%{_p}%::*}:
                if loop-value-2 is {_name}:
                    set {_owned} to "&a보유중"
            if {낚싯대부품::%{_category}%::%{_p}%} is {_name}:
                set {_owned} to "&b장착중"
        add "%{_owned}%" to {_lore::*}
        add "" to {_lore::*}
        # 구매 안내
        if {_category} is "낚싯대":
            if {_recipeId} is set:
                if {레시피해금::%{_p}%::%{_recipeId}%} is true:
                    add "&8이미 해금됨" to {_lore::*}
                else:
                    add "&e클릭하여 레시피 구매" to {_lore::*}
            else:
                add "&8구매 불가" to {_lore::*}
        else if {_category} is "미끼":
            set {_price10} to {_price} * 10
            set {_price50} to {_price} * 50
            add "&e좌클릭: 10개 구매 (%{_price10}%원)" to {_lore::*}
            add "&e우클릭: 50개 구매 (%{_price50}%원)" to {_lore::*}
        else:
            add "&e클릭하여 구매" to {_lore::*}

        set {상점부품슬롯::%{_p}%::%{_slot}%} to {_name}
        if {_category} is "낚싯대":
            set slot {_slot} of {_p}'s current inventory to {_icon} named "&e[레시피] %{_color}%%{_name}%" with lore {_lore::*}
        else:
            set slot {_slot} of {_p}'s current inventory to {_icon} named "%{_color}%%{_name}%" with lore {_lore::*}
        add 1 to {_slot}

    # 6행: 정보 바 (slot 45~53)
    loop integers from 45 to 53:
        set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
    if {돈::%{_p}%} is not set:
        set {돈::%{_p}%} to 0
    set slot 49 of {_p}'s current inventory to gold ingot named "&e내 잔액: &f%{돈::%{_p}%}%원"

# ===== 부품 구매 (미끼 외) =====
function buyPart(p: player, type: text, name: text):
    set {_grade} to get_part_grade({_type}, {_name})
    set {_color} to part_grade_color({_grade})
    if {_type} is "낚싯대":
        # 낚싯대 카테고리 → 레시피 구매 (해금)
        set {_recipeId} to {부품_레시피ID::낚싯대::%{_name}%}
        if {_recipeId} is not set:
            message "{@shop_prefix} &c이 낚싯대는 상점에서 구매할 수 없습니다." to {_p}
            stop
        if {레시피해금::%{_p}%::%{_recipeId}%} is true:
            message "{@shop_prefix} &c이미 해금된 레시피입니다." to {_p}
            stop
        set {_price} to round(get_part_price({_type}, {_name}) * 0.5)
        if {돈::%{_p}%} < {_price}:
            message "{@shop_prefix} &c잔액이 부족합니다. (필요: %{_price}%원, 잔액: %{돈::%{_p}%}%원)" to {_p}
            stop
        subtract {_price} from {돈::%{_p}%}
        set {레시피해금::%{_p}%::%{_recipeId}%} to true
        message "{@shop_prefix} &e[레시피] %{_color}%%{_name}%&a 해금! &7(-%{_price}%원) &7조합대에서 제작하세요." to {_p}
        play sound "ui.toast.challenge_complete" with volume 0.5 and pitch 1.2 to {_p}
        도감_낚싯대({_p}, {_name})
    else:
        set {_price} to get_part_price({_type}, {_name})
        if {돈::%{_p}%} < {_price}:
            message "{@shop_prefix} &c잔액이 부족합니다. (필요: %{_price}%원, 잔액: %{돈::%{_p}%}%원)" to {_p}
            stop
        subtract {_price} from {돈::%{_p}%}
        add {_name} to {부품인벤::%{_type}%::%{_p}%::*}
        message "{@shop_prefix} %{_color}%%을를({_name})%&a 구매했습니다! &7(-%{_price}%원 | 잔액: %{돈::%{_p}%}%원)" to {_p}
        도감_부품({_p}, {_type}, {_name})

# ===== 미끼 구매 =====
function buyBait(p: player, name: text, count: integer):
    if {부품인벤::미끼::%{_p}%::%{_name}%} is not set:
        set {부품인벤::미끼::%{_p}%::%{_name}%} to 0
    # 99개 상한 체크
    set {_current} to {부품인벤::미끼::%{_p}%::%{_name}%}
    if {_current} >= 99:
        message "{@shop_prefix} &c이미 99개를 보유하고 있습니다." to {_p}
        stop
    set {_buyCount} to {_count}
    if {_current} + {_buyCount} > 99:
        set {_buyCount} to 99 - {_current}
    set {_unitPrice} to get_part_price("미끼", {_name})
    set {_total} to {_unitPrice} * {_buyCount}
    if {돈::%{_p}%} < {_total}:
        message "{@shop_prefix} &c잔액이 부족합니다. (필요: %{_total}%원, 잔액: %{돈::%{_p}%}%원)" to {_p}
        stop
    subtract {_total} from {돈::%{_p}%}
    add {_buyCount} to {부품인벤::미끼::%{_p}%::%{_name}%}
    set {_grade} to get_part_grade("미끼", {_name})
    set {_color} to part_grade_color({_grade})
    message "{@shop_prefix} %{_color}%%{_name}% &fx%{_buyCount}%&a 구매! &7(-%{_total}%원 | 잔액: %{돈::%{_p}%}%원 | 보유: %{부품인벤::미끼::%{_p}%::%{_name}%}%개)" to {_p}
    도감_부품({_p}, "미끼", {_name})

# ===== 상점 GUI 클릭 =====
on inventory click:
    if player's current inventory's name is "&0부품 상점":
        cancel event
        set {_ci} to index of clicked slot
        # 닫기 버튼
        if event-item is barrier:
            close player's inventory
            stop
        # 카테고리 탭 (slot 0~5) 또는 부품 클릭
        if {_ci} is 0:
            wait 1 tick
            openPartShop(player, "낚싯대")
        else if {_ci} is 1:
            wait 1 tick
            openPartShop(player, "릴")
        else if {_ci} is 2:
            wait 1 tick
            openPartShop(player, "줄")
        else if {_ci} is 3:
            wait 1 tick
            openPartShop(player, "바늘")
        else if {_ci} is 4:
            wait 1 tick
            openPartShop(player, "미끼")
        else if {_ci} is 5:
            wait 1 tick
            openPartShop(player, "찌")
        else:
            # 부품 아이템 클릭 (slot 9~44)
            set {_cat} to {상점카테고리::%player%}
            if {_cat} is set:
                set {_itemName} to {상점부품슬롯::%player%::%{_ci}%}
                if {_itemName} is set:
                    if {_cat} is "미끼":
                        buyBait(player, {_itemName}, 10)
                    else:
                        buyPart(player, {_cat}, {_itemName})
                    wait 1 tick
                    openPartShop(player, {_cat})
