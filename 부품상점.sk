# =========================================
# 부품상점.sk
# 낚시 부품 상점 GUI + 구매
# =========================================

options:
    shop_prefix: &8[&6 부품상점 &8]

# ===== /부품상점 명령어 =====
command /부품상점 [<text>]:
    aliases: /qnvmatkdwja
    trigger:
        if arg-1 is not set:
            openPartShop(player, "낚싯대")
        else:
            openPartShop(player, arg-1)

# ===== 상점 GUI 열기 =====
function openPartShop(p: player, category: text):
    open chest inventory with 6 rows named "&0부품 상점" to {_p}
    set {상점카테고리::%{_p}%} to {_category}

    # 1행: 카테고리 탭 (slot 0~8)
    set {_cats::1} to "낚싯대"
    set {_cats::2} to "릴"
    set {_cats::3} to "줄"
    set {_cats::4} to "바늘"
    set {_cats::5} to "미끼"
    set {_cats::6} to "찌"
    loop 6 times:
        set {_cat} to {_cats::%loop-iteration%}
        set {_icon} to part_icon_item({_cat})
        set {_slot} to loop-iteration
        subtract 1 from {_slot}
        if {_cat} is {_category}:
            set slot {_slot} of {_p}'s current inventory to {_icon} named "&e&l%{_cat}%" with lore "&a현재 선택됨"
        else:
            set slot {_slot} of {_p}'s current inventory to {_icon} named "&7%{_cat}%" with lore "&7클릭하여 카테고리 변경"
    set slot 6 of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 7 of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 8 of {_p}'s current inventory to barrier named "&c&l닫기"

    # 2~5행: 부품 목록 (slot 9~44)
    delete {상점부품슬롯::%{_p}%::*}
    loop integers from 9 to 44:
        set slot loop-integer of {_p}'s current inventory to air
    set {_slot} to 9
    loop {부품목록::%{_category}%::*}:
        set {_name} to loop-value
        set {_grade} to get_part_grade({_category}, {_name})
        set {_color} to part_grade_color({_grade})
        set {_price} to get_part_price({_category}, {_name})
        set {_dur} to get_part_durability({_category}, {_name})
        set {_stat} to get_part_stat({_category}, {_name})
        set {_statdesc} to part_stat_desc({_category})
        set {_icon} to part_icon_item({_category})

        # 보유 상태 확인
        set {_owned} to ""
        if {_category} is "미끼":
            set {_count} to {부품인벤::미끼::%{_p}%::%{_name}%}
            if {_count} is set:
                if {_count} > 0:
                    set {_owned} to "&a보유: %{_count}%개"
        else:
            loop {부품인벤::%{_category}%::%{_p}%::*}:
                if loop-value-2 is {_name}:
                    set {_owned} to "&a보유중"
            if {낚싯대부품::%{_category}%::%{_p}%} is {_name}:
                set {_owned} to "&b장착중"

        set {상점부품슬롯::%{_p}%::%{_slot}%} to {_name}
        if {_category} is "미끼":
            set {_price10} to {_price} * 10
            set {_price50} to {_price} * 50
            set slot {_slot} of {_p}'s current inventory to {_icon} named "%{_color}%%{_name}%" with lore "&7등급 &e: %{_color}%%{_grade}%" and "&7%{_statdesc}% &e: &f+%{_stat}%%%" and "&7내구도(개당) &e: &f%{_dur}%회" and "&7가격 &e: &f%{_price}%원/개" and "%{_owned}%" and "" and "&e좌클릭: 10개 구매 (%{_price10}%원)" and "&e우클릭: 50개 구매 (%{_price50}%원)"
        else:
            set slot {_slot} of {_p}'s current inventory to {_icon} named "%{_color}%%{_name}%" with lore "&7등급 &e: %{_color}%%{_grade}%" and "&7%{_statdesc}% &e: &f+%{_stat}%" and "&7내구도 &e: &f%{_dur}%" and "&7가격 &e: &f%{_price}%원" and "%{_owned}%" and "" and "&e클릭하여 구매"
        add 1 to {_slot}

    # 6행: 정보 바 (slot 45~53)
    loop integers from 45 to 53:
        set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
    if {돈::%{_p}%} is not set:
        set {돈::%{_p}%} to 0
    set slot 49 of {_p}'s current inventory to gold ingot named "&e내 잔액: &f%{돈::%{_p}%}%원"

# ===== 부품 구매 (미끼 외) =====
function buyPart(p: player, type: text, name: text):
    set {_price} to get_part_price({_type}, {_name})
    if {돈::%{_p}%} < {_price}:
        message "{@shop_prefix} &c잔액이 부족합니다. (필요: %{_price}%원, 잔액: %{돈::%{_p}%}%원)" to {_p}
        stop
    subtract {_price} from {돈::%{_p}%}
    set {_grade} to get_part_grade({_type}, {_name})
    set {_color} to part_grade_color({_grade})
    if {_type} is "낚싯대":
        give {_p} 1 of fishing rod named "%{_color}%%{_name}%" with lore "&7등급 &e: %{_color}%%{_grade}%"
    else:
        add {_name} to {부품인벤::%{_type}%::%{_p}%::*}
    message "{@shop_prefix} %{_color}%%{_name}%&a을(를) 구매했습니다! &7(-%{_price}%원 | 잔액: %{돈::%{_p}%}%원)" to {_p}

# ===== 미끼 구매 =====
function buyBait(p: player, name: text, count: integer):
    set {_unitPrice} to get_part_price("미끼", {_name})
    set {_total} to {_unitPrice} * {_count}
    if {돈::%{_p}%} < {_total}:
        message "{@shop_prefix} &c잔액이 부족합니다. (필요: %{_total}%원, 잔액: %{돈::%{_p}%}%원)" to {_p}
        stop
    subtract {_total} from {돈::%{_p}%}
    if {부품인벤::미끼::%{_p}%::%{_name}%} is not set:
        set {부품인벤::미끼::%{_p}%::%{_name}%} to 0
    add {_count} to {부품인벤::미끼::%{_p}%::%{_name}%}
    set {_grade} to get_part_grade("미끼", {_name})
    set {_color} to part_grade_color({_grade})
    message "{@shop_prefix} %{_color}%%{_name}% &fx%{_count}%&a 구매! &7(-%{_total}%원 | 잔액: %{돈::%{_p}%}%원)" to {_p}

# ===== 상점 GUI 클릭 =====
on inventory click:
    if player's current inventory's name is "&0부품 상점":
        cancel event
        # 닫기 버튼
        if event-item is barrier:
            close player's inventory
            stop
        # 카테고리 탭 (slot 0~5)
        set {_ci} to index of clicked slot
        if {_ci} is 0:
            set {상점클릭카테고리::%player%} to "낚싯대"
        else if {_ci} is 1:
            set {상점클릭카테고리::%player%} to "릴"
        else if {_ci} is 2:
            set {상점클릭카테고리::%player%} to "줄"
        else if {_ci} is 3:
            set {상점클릭카테고리::%player%} to "바늘"
        else if {_ci} is 4:
            set {상점클릭카테고리::%player%} to "미끼"
        else if {_ci} is 5:
            set {상점클릭카테고리::%player%} to "찌"
        if {상점클릭카테고리::%player%} is set:
            set {_cat} to {상점클릭카테고리::%player%}
            delete {상점클릭카테고리::%player%}
            set {상점카테고리::%player%} to {_cat}
            # 카테고리 탭 갱신
            set {_cats::1} to "낚싯대"
            set {_cats::2} to "릴"
            set {_cats::3} to "줄"
            set {_cats::4} to "바늘"
            set {_cats::5} to "미끼"
            set {_cats::6} to "찌"
            loop 6 times:
                set {_tabCat} to {_cats::%loop-iteration%}
                set {_tabIcon} to part_icon_item({_tabCat})
                set {_tabSlot} to loop-iteration
                subtract 1 from {_tabSlot}
                if {_tabCat} is {_cat}:
                    set slot {_tabSlot} of player's current inventory to {_tabIcon} named "&e&l%{_tabCat}%" with lore "&a현재 선택됨"
                else:
                    set slot {_tabSlot} of player's current inventory to {_tabIcon} named "&7%{_tabCat}%" with lore "&7클릭하여 카테고리 변경"
            # 아이템 슬롯 갱신
            delete {상점부품슬롯::%player%::*}
            loop integers from 9 to 44:
                set slot loop-integer of player's current inventory to air
            set {_slot} to 9
            loop {부품목록::%{_cat}%::*}:
                set {_name} to loop-value
                set {_grade} to get_part_grade({_cat}, {_name})
                set {_color} to part_grade_color({_grade})
                set {_price} to get_part_price({_cat}, {_name})
                set {_dur} to get_part_durability({_cat}, {_name})
                set {_stat} to get_part_stat({_cat}, {_name})
                set {_statdesc} to part_stat_desc({_cat})
                set {_icon} to part_icon_item({_cat})
                set {_owned} to ""
                if {_cat} is "미끼":
                    set {_count} to {부품인벤::미끼::%player%::%{_name}%}
                    if {_count} is set:
                        if {_count} > 0:
                            set {_owned} to "&a보유: %{_count}%개"
                else:
                    loop {부품인벤::%{_cat}%::%player%::*}:
                        if loop-value-2 is {_name}:
                            set {_owned} to "&a보유중"
                    if {낚싯대부품::%{_cat}%::%player%} is {_name}:
                        set {_owned} to "&b장착중"
                set {상점부품슬롯::%player%::%{_slot}%} to {_name}
                if {_cat} is "미끼":
                    set {_price10} to {_price} * 10
                    set {_price50} to {_price} * 50
                    set slot {_slot} of player's current inventory to {_icon} named "%{_color}%%{_name}%" with lore "&7등급 &e: %{_color}%%{_grade}%" and "&7%{_statdesc}% &e: &f+%{_stat}%%%" and "&7내구도(개당) &e: &f%{_dur}%회" and "&7가격 &e: &f%{_price}%원/개" and "%{_owned}%" and "" and "&e좌클릭: 10개 구매 (%{_price10}%원)" and "&e우클릭: 50개 구매 (%{_price50}%원)"
                else:
                    set slot {_slot} of player's current inventory to {_icon} named "%{_color}%%{_name}%" with lore "&7등급 &e: %{_color}%%{_grade}%" and "&7%{_statdesc}% &e: &f+%{_stat}%" and "&7내구도 &e: &f%{_dur}%" and "&7가격 &e: &f%{_price}%원" and "%{_owned}%" and "" and "&e클릭하여 구매"
                add 1 to {_slot}
            # 잔액 갱신
            if {돈::%player%} is not set:
                set {돈::%player%} to 0
            set slot 49 of player's current inventory to gold ingot named "&e내 잔액: &f%{돈::%player%}%원"
            stop
        # 부품 아이템 클릭 (슬롯 매핑 기반)
        set {_itemName} to {상점부품슬롯::%player%::%{_ci}%}
        if {_itemName} is set:
            set {_cat} to {상점카테고리::%player%}
            if {_cat} is not set:
                stop
            if {_cat} is "미끼":
                if click type is left mouse button:
                    buyBait(player, {_itemName}, 10)
                else:
                    buyBait(player, {_itemName}, 50)
            else:
                buyPart(player, {_cat}, {_itemName})
            # 잔액 갱신
            set slot 49 of player's current inventory to gold ingot named "&e내 잔액: &f%{돈::%player%}%원"
