# =========================================
# 수리.sk
# 장비 수리 시스템 — /수리 GUI
# =========================================

# ===== 수리 비용 계산 =====
# 비용 = (최대내구 - 현재내구) × 등급별 단가
function 수리비용(type: text, p: player) :: number:
    set {_name} to {낚싯대부품::%{_type}%::%{_p}%}
    if {_name} is not set:
        return 0
    set {_maxDur} to get_part_durability({_type}, {_name})
    set {_curDur} to {부품내구도::%{_type}%::%{_p}%}
    if {_curDur} is not set:
        set {_curDur} to 0
    set {_missing} to {_maxDur} - {_curDur}
    if {_missing} <= 0:
        return 0
    set {_grade} to get_part_grade({_type}, {_name})
    set {_단가} to 50
    if {_grade} is "D":
        set {_단가} to 100
    else if {_grade} is "C":
        set {_단가} to 200
    else if {_grade} is "B":
        set {_단가} to 400
    else if {_grade} is "A":
        set {_단가} to 800
    else if {_grade} is "S":
        set {_단가} to 1500
    else if {_grade} is "S+":
        set {_단가} to 3000
    else if {_grade} is "M":
        set {_단가} to 6000
    else if {_grade} is "L":
        set {_단가} to 12000
    else if {_grade} is "G":
        set {_단가} to 25000
    return {_missing} * {_단가}

# ===== /수리 GUI 열기 =====
command /수리:
    aliases: /tnql
    trigger:
        수리GUI열기(player)

function 수리GUI열기(p: player):
    open chest inventory with 3 rows named "&0장비 수리" to {_p}
    loop 9 times:
        set slot (loop-iteration - 1) of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 4 of {_p}'s current inventory to anvil named "&b&l장비 수리" with lore "&7장착된 부품의 내구도를 회복합니다." and "&7소지금: &e%{돈::%{_p}%}%원"
    set {_types::1} to "릴"
    set {_types::2} to "줄"
    set {_types::3} to "바늘"
    set {_types::4} to "미끼"
    set {_types::5} to "찌"
    set {_icons::1} to "clockwork iron ingot"
    set {_icons::2} to string
    set {_icons::3} to "fishing rod"
    set {_icons::4} to "salmon"
    set {_icons::5} to "feather"
    loop 5 times:
        set {_t} to {_types::%loop-iteration%}
        set {_slot} to loop-iteration + 8
        set {_name} to {낚싯대부품::%{_t}%::%{_p}%}
        if {_name} is not set:
            set slot {_slot} of {_p}'s current inventory to gray stained glass pane named "&7%{_t}% &8(미장착)"
        else:
            set {_maxDur} to get_part_durability({_t}, {_name})
            set {_curDur} to {부품내구도::%{_t}%::%{_p}%}
            if {_curDur} is not set:
                set {_curDur} to 0
            set {_grade} to get_part_grade({_t}, {_name})
            set {_color} to part_grade_color({_grade})
            set {_cost} to 수리비용({_t}, {_p})
            set {_durPct} to floor({_curDur} * 100 / {_maxDur})
            if {_durPct} >= 70:
                set {_durColor} to "&a"
            else if {_durPct} >= 30:
                set {_durColor} to "&e"
            else:
                set {_durColor} to "&c"
            if {_cost} <= 0:
                set slot {_slot} of {_p}'s current inventory to iron ingot named "&7%{_t}%: %{_color}%%{_name}%" with lore "%{_durColor}%내구도: %{_curDur}%/%{_maxDur}% &8(%{_durPct}%%%&8)" and "" and "&7이미 완전 수리 상태입니다."
            else:
                set slot {_slot} of {_p}'s current inventory to iron ingot named "&7%{_t}%: %{_color}%%{_name}%" with lore "%{_durColor}%내구도: %{_curDur}%/%{_maxDur}% &8(%{_durPct}%%%&8)" and "" and "&7수리 비용: &e%{_cost}%원" and "&a클릭하여 수리"

# ===== 수리 GUI 클릭 =====
on inventory click:
    if player's current inventory's name is "&0장비 수리":
        cancel event
        set {_ci} to index of clicked slot
        if {_ci} >= 9:
            if {_ci} <= 13:
                set {_idx} to {_ci} - 8
                set {_types::1} to "릴"
                set {_types::2} to "줄"
                set {_types::3} to "바늘"
                set {_types::4} to "미끼"
                set {_types::5} to "찌"
                set {_t} to {_types::%{_idx}%}
                if {_t} is not set:
                    stop
                set {_name} to {낚싯대부품::%{_t}%::%player%}
                if {_name} is not set:
                    message "&c장착된 %{_t}%이(가) 없습니다." to player
                    stop
                set {_cost} to 수리비용({_t}, player)
                if {_cost} <= 0:
                    message "&7이미 완전 수리 상태입니다." to player
                    stop
                if {돈::%player%} < {_cost}:
                    message "&c돈이 부족합니다! &7(필요: &e%{_cost}%원&7, 소지: &e%{돈::%player%}%원&7)" to player
                    stop
                subtract {_cost} from {돈::%player%}
                set {_maxDur} to get_part_durability({_t}, {_name})
                set {부품내구도::%{_t}%::%player%} to {_maxDur}
                set {_grade} to get_part_grade({_t}, {_name})
                set {_color} to part_grade_color({_grade})
                message "&8[&e 수리 &8] %{_color}%%{_name}%&a 수리 완료! &7(-%{_cost}%원)" to player
                play sound "block.anvil.use" with volume 1 with pitch 1.2 to player
                wait 1 tick
                수리GUI열기(player)
