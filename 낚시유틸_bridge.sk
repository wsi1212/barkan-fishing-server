# =========================================
# 낚시유틸_bridge.sk — 낚시 공용 함수 (낚시.sk에서 분리, 삭제 대비 유지)
# rankchange/num_to_grade(등급↔숫자), fishrank/isBetter(대회 기록).
# 브릿지(낚시이벤트/낚시훅)와 다른 파일이 참조하므로 낚시.sk 삭제 후에도 유지돼야 함.
# =========================================

function fishrank(p: player, fishname: text, rank: text, size: text):
    if {_fishname} is not set:
        stop
    # 레벨 제한 — 첫 참가 시에만 검사 (이후 렙업으로 초과해도 OK)
    if {낚시대회참가::%{_p}%} is not set:
        if {낚시대회::최저레벨} is set:
            if {낚시레벨::%{_p}%} < {낚시대회::최저레벨}:
                send "&c[낚시대회] 이 대회는 레벨 %{낚시대회::최저레벨}% 이상만 참여할 수 있습니다." to {_p}
                stop
        if {낚시대회::최고레벨} is set:
            if {낚시레벨::%{_p}%} > {낚시대회::최고레벨}:
                send "&c[낚시대회] 이 대회는 레벨 %{낚시대회::최고레벨}% 이하만 참여할 수 있습니다." to {_p}
                stop
        set {낚시대회참가::%{_p}%} to true
        set {_display} to regionDisplayName({낚시대회::지역})
        if {낚시대회::지역} is set:
            send "&6[낚시대회] &a%{_display}% 지역 대회&f에 참가합니다! 행운을 빌어요!" to {_p}
        else:
            send "&6[낚시대회] &a전역 대회&f에 참가합니다! 행운을 빌어요!" to {_p}
    # 기존 1등 기록 저장 (변경 감지용)
    set {_old1st} to {낚시대회::1등}
    set {_fish} to "%{_p}'s name%|%{_fishname}%|%{_rank}%|%{_size}%"
    add {_fish} to {낚시대회물고기::*}
    # ---- 방금 잡은 기록이 TOP10 안에 몇 등인지 즉시 계산 ----
    set {_pool::*} to {낚시대회물고기::*}
    set {_total} to size of {_pool::*}

    set {_limit} to 10
    if {_total} < {_limit}:
        set {_limit} to {_total}

    set {_myRank} to 0

    loop {_limit} times:
        set {_best} to {_pool::1}
        loop {_pool::*}:
            if isBetter(loop-value-2, {_best}):
                set {_best} to loop-value-2

        # 1등 갱신 추적
        if loop-number is 1:
            set {낚시대회::1등} to {_best}

        # 이번에 뽑힌 best가 방금 잡은 그 기록이면 등수 확정
        if {_best} is {_fish}:
            set {_myRank} to loop-number
            stop loop

        remove {_best} from {_pool::*}

    if {_myRank} is 0:
        send "&7[낚시대회] 기록 등록! (TOP10 밖) &7%{_fishname}% / %{_rank}% / %{_size}%" to {_p}
    else:
        send "&6[낚시대회] &e%{_myRank}%등&6 기록! &7%{_fishname}% / %{_rank}% / %{_size}%" to {_p}
    # ---- 1등 변경 알림 ----
    if {낚시대회::1등} is set:
        if {낚시대회::1등} is not {_old1st}:
            set {_info::*} to split {낚시대회::1등} at "|"
            set {_barPlayers::*} to bossbar players of {낚시대회::bar}
            loop {_barPlayers::*}:
                send "&6[낚시대회] &e🏆 1등 변경! &f%{_info::1}% &7- %{_info::2}% &8(%{_info::3}% / %{_info::4}%)" to loop-value
function isBetter(a: text, b: text) :: boolean:
    # 포맷: 플레이어|물고기|등급|크기
    set {_A::*} to split {_a} at "|"
    set {_B::*} to split {_b} at "|"

    set {_ra} to rankchange({_A::3})
    set {_rb} to rankchange({_B::3})

    if {_ra} > {_rb}:
        return true
    if {_ra} < {_rb}:
        return false

    # 등급이 같으면 크기 비교 (여기서 {_size}는 숫자/소수점만 있다고 했으니 바로 파싱)
    set {_sa} to {_A::4} parsed as number
    set {_sb} to {_B::4} parsed as number
    if {_sa} is not set:
        set {_sa} to 0
    if {_sb} is not set:
        set {_sb} to 0

    if {_sa} > {_sb}:
        return true

function rankchange(t: text) :: number:
    if {_t} is "E":
        return 1
    else if {_t} is "D":
        return 2
    else if {_t} is "C":
        return 3
    else if {_t} is "B":
        return 4
    else if {_t} is "A":
        return 5
    else if {_t} is "S":
        return 6
    else if {_t} is "S+":
        return 7
    else if {_t} is "M":
        return 8
    else if {_t} is "L":
        return 9
    else if {_t} is "G":
        return 10
function num_to_grade(n: integer) :: text:
    if {_n} is 1:
        return "E"
    else if {_n} is 2:
        return "D"
    else if {_n} is 3:
        return "C"
    else if {_n} is 4:
        return "B"
    else if {_n} is 5:
        return "A"
    else if {_n} is 6:
        return "S"
    else if {_n} is 7:
        return "S+"
    else if {_n} is 8:
        return "M"
    else if {_n} is 9:
        return "L"
    else if {_n} is 10:
        return "G"
    return "E"
