# =========================================
# 낚시유틸_bridge.sk — 낚시 공용 함수 (낚시.sk에서 분리, 삭제 대비 유지)
# rankchange/num_to_grade(등급↔숫자) — 여러 스크립트가 참조하므로 낚시.sk 삭제 후에도 유지.
# (fishrank/isBetter 대회 기록 함수는 Java ContestManager로 이관되어 제거됨.)
# =========================================

function rankchange(t: text) :: number:
    if {_t} is "E":
        return 1
    else if {_t} is "D":
        return 2
    else if {_t} is "C":
        return 3
    else if {_t} is "B":
        return 4
    else if {_t} is "A":
        return 5
    else if {_t} is "S":
        return 6
    else if {_t} is "S+":
        return 7
    else if {_t} is "M":
        return 8
    else if {_t} is "L":
        return 9
    else if {_t} is "G":
        return 10
function num_to_grade(n: integer) :: text:
    if {_n} is 1:
        return "E"
    else if {_n} is 2:
        return "D"
    else if {_n} is 3:
        return "C"
    else if {_n} is 4:
        return "B"
    else if {_n} is 5:
        return "A"
    else if {_n} is 6:
        return "S"
    else if {_n} is 7:
        return "S+"
    else if {_n} is 8:
        return "M"
    else if {_n} is 9:
        return "L"
    else if {_n} is 10:
        return "G"
    return "E"
