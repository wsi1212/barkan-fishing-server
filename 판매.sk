# =========================================
# 판매.sk
# 물고기 판매 시스템 (명령어 + 상점 GUI)
# =========================================

options:
    sell_prefix: &8[&6 상점 &8]
    sell_good: &a
    sell_bad: &c
    sell_hint: &7
    sell_emph: &e
    sell_info: &f

# ===== 가격 계산 함수 =====
# 가격 = 등급 배율 × 크기(cm), 소수점 버림
function fishprice(grade: text, size: number) :: number:
    set {_배율} to 0
    if {_grade} is "E":
        set {_배율} to 5
    else if {_grade} is "D":
        set {_배율} to 15
    else if {_grade} is "C":
        set {_배율} to 40
    else if {_grade} is "B":
        set {_배율} to 80
    else if {_grade} is "A":
        set {_배율} to 150
    else if {_grade} is "S":
        set {_배율} to 300
    else if {_grade} is "S+":
        set {_배율} to 500
    else if {_grade} is "M":
        set {_배율} to 1000
    else if {_grade} is "L":
        set {_배율} to 2000
    else if {_grade} is "G":
        set {_배율} to 5000
    set {_price} to floor({_배율} * {_size})
    return {_price}

# ===== 물고기 아이템에서 등급 파싱 =====
function parsegrade(item: item) :: text:
    set {_lore} to 1st line of lore of {_item}
    if {_lore} is not set:
        return ""
    # lore 형식: "&7등급 &e: &f{등급}"
    replace all "&7등급 &e: &f" with "" in {_lore}
    return {_lore}

# ===== 물고기 아이템에서 크기 파싱 =====
function parsesize(item: item) :: number:
    set {_lore} to 2nd line of lore of {_item}
    if {_lore} is not set:
        return 0
    # lore 형식: "&7크기 &e: &f{크기}cm"
    replace all "&7크기 &e: &f" with "" in {_lore}
    replace all "cm" with "" in {_lore}
    set {_s} to {_lore} parsed as number
    if {_s} is not set:
        return 0
    return {_s}

# ===== 물고기인지 확인 =====
function isfish(item: item) :: boolean:
    if {_item} is cod:
        if 1st line of lore of {_item} contains "&7등급":
            return true
    return false

# ===== /판매 명령어 =====
command /판매 [<text>]:
    aliases: /vksao
    trigger:
        if {돈::%player%} is not set:
            set {돈::%player%} to 0

        # /판매 전부
        if arg-1 is "전부":
            set {_총액} to 0
            set {_count} to 0
            loop 36 times:
                set {_slot} to (loop-iteration) - 1
                set {_item} to slot {_slot} of player's inventory
                if isfish({_item}):
                    set {_등급} to parsegrade({_item})
                    set {_크기} to parsesize({_item})
                    if {_등급} is not "":
                        if {_크기} > 0:
                            set {_price} to fishprice({_등급}, {_크기})
                            add {_price} to {_총액}
                            add 1 to {_count}
                            set slot {_slot} of player's inventory to air

            if {_count} is 0:
                message "{@sell_prefix} {@sell_bad}인벤토리에 판매 가능한 물고기가 없습니다." to player
                stop

            add {_총액} to {돈::%player%}
            message "{@sell_prefix} {@sell_good}일괄 판매 완료! {@sell_hint}%{_count}%마리 {@sell_emph}%{_총액}%원 {@sell_hint}| 잔액: {@sell_info}%{돈::%player%}%원" to player
            stop

        # /판매 (손에 든 물고기 1마리)
        if arg-1 is not set:
            if isfish(player's tool) is false:
                message "{@sell_prefix} {@sell_bad}물고기를 손에 들고 사용해 주세요. {@sell_hint}(/판매 전부: 일괄 판매)" to player
                stop

            set {_등급} to parsegrade(player's tool)
            set {_크기} to parsesize(player's tool)

            if {_등급} is "" or {_크기} <= 0:
                message "{@sell_prefix} {@sell_bad}이 물고기의 정보를 읽을 수 없습니다." to player
                stop

            set {_price} to fishprice({_등급}, {_크기})
            set {_name} to player's tool's name
            remove 1 of player's tool from player

            add {_price} to {돈::%player%}
            message "{@sell_prefix} {@sell_good}판매 완료! {@sell_info}%{_name}% {@sell_hint}(%{_등급}% / %{_크기}%cm) {@sell_emph}%{_price}%원 {@sell_hint}| 잔액: {@sell_info}%{돈::%player%}%원" to player
            stop

        # /판매 도움말
        message "{@sell_prefix} {@sell_info}사용법:" to player
        message "{@sell_hint}- {@sell_emph}/판매 {@sell_hint}: 손에 든 물고기 판매" to player
        message "{@sell_hint}- {@sell_emph}/판매 전부 {@sell_hint}: 인벤토리 물고기 일괄 판매" to player
        message "{@sell_hint}- {@sell_emph}/상점 {@sell_hint}: 물고기 상점 GUI 열기" to player

# ===== /상점 명령어 =====
command /상점:
    aliases: /tkdwja
    trigger:
        opensellgui(player)

# ===== 상점 GUI 열기 함수 =====
function opensellgui(p: player):
    open chest inventory with 3 rows named "&0물고기 상점" to {_p}
    # 상단 테두리
    set slot 0 of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 1 of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 2 of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 3 of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 4 of {_p}'s current inventory to gold ingot named "&e&l전부 판매" with lore "&7상점에 넣은 물고기를" and "&7전부 판매합니다."
    set slot 5 of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 6 of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 7 of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 8 of {_p}'s current inventory to barrier named "&c&l닫기"

# ===== 상점 GUI 클릭 처리 =====
on inventory click:
    if player's current inventory's name is "&0물고기 상점":
        # 플레이어 인벤토리(아래쪽) 클릭은 허용
        if clicked inventory is player's inventory:
            stop
        # 장식 유리판 클릭 차단
        if event-item is black stained glass pane:
            cancel event
            stop

        # 전부 판매 버튼
        if event-item is gold ingot:
            if name of event-item is "&e&l전부 판매":
                cancel event
                set {_총액} to 0
                set {_count} to 0
                loop integers from 9 to 26:
                    set {_item} to slot loop-integer of player's current inventory
                    if isfish({_item}):
                        set {_등급} to parsegrade({_item})
                        set {_크기} to parsesize({_item})
                        if {_등급} is not "":
                            if {_크기} > 0:
                                set {_price} to fishprice({_등급}, {_크기})
                                add {_price} to {_총액}
                                add 1 to {_count}
                                set slot loop-integer of player's current inventory to air

                if {_count} is 0:
                    message "&8[&6 상점 &8] &c판매할 물고기가 없습니다. 아래 칸에 물고기를 넣어주세요." to player
                    stop

                if {돈::%player%} is not set:
                    set {돈::%player%} to 0
                add {_총액} to {돈::%player%}
                message "&8[&6 상점 &8] &a판매 완료! &7%{_count}%마리 &e%{_총액}%원 &7| 잔액: &f%{돈::%player%}%원" to player
                stop

        # 닫기 버튼
        if event-item is barrier:
            if name of event-item is "&c&l닫기":
                cancel event
                close player's inventory
                stop

# ===== 상점 GUI 닫을 때 비물고기 아이템 반환 =====
on inventory close:
    if player's current inventory's name is "&0물고기 상점":
        loop integers from 9 to 26:
            set {_item} to slot loop-integer of player's current inventory
            if {_item} is not air:
                if isfish({_item}):
                    # 물고기는 자동 판매
                    set {_등급} to parsegrade({_item})
                    set {_크기} to parsesize({_item})
                    if {_등급} is not "":
                        if {_크기} > 0:
                            set {_price} to fishprice({_등급}, {_크기})
                            if {돈::%player%} is not set:
                                set {돈::%player%} to 0
                            add {_price} to {돈::%player%}
                            add {_price} to {_닫기총액}
                            add 1 to {_닫기수}
                            set slot loop-integer of player's current inventory to air
                        else:
                            give {_item} to player
                            set slot loop-integer of player's current inventory to air
                    else:
                        give {_item} to player
                        set slot loop-integer of player's current inventory to air
                else:
                    # 물고기가 아닌 아이템은 돌려줌
                    give {_item} to player
                    set slot loop-integer of player's current inventory to air

        if {_닫기수} > 0:
            message "&8[&6 상점 &8] &a자동 판매! &7%{_닫기수}%마리 &e%{_닫기총액}%원 &7| 잔액: &f%{돈::%player%}%원" to player
