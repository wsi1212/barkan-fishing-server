# ===== 재배 시스템 =====
# 작물 수확 → 추가 드롭 + 경험치
# 변수: {재배레벨::%p%}, {재배경험치::%p%}, {재배필요경험치::%p%}

# ===== 경험치 추가 함수 =====
function 재배경험치추가(p: player, amount: number):
    if {재배레벨::%{_p}%} is not set:
        set {재배레벨::%{_p}%} to 1
        set {재배경험치::%{_p}%} to 0
        set {재배필요경험치::%{_p}%} to 100
    if {재배레벨::%{_p}%} >= 50:
        stop
    add {_amount} to {재배경험치::%{_p}%}
    loop 50 times:
        if {재배경험치::%{_p}%} >= {재배필요경험치::%{_p}%}:
            if {재배레벨::%{_p}%} >= 50:
                set {재배경험치::%{_p}%} to {재배필요경험치::%{_p}%}
                stop loop
            remove {재배필요경험치::%{_p}%} from {재배경험치::%{_p}%}
            set {재배필요경험치::%{_p}%} to floor({재배필요경험치::%{_p}%} * 1.06)
            add 1 to {재배레벨::%{_p}%}
            send title "&a&l레벨 업!" with subtitle "&f재배 Lv.%{재배레벨::%{_p}%}% &7달성!" to {_p} for 2 seconds
            message "&a[재배] &f레벨이 %{재배레벨::%{_p}%}%LV가 되었습니다!" to {_p}
            play sound "entity.player.levelup" with volume 0.8 and pitch 1.5 to {_p}
        else:
            stop loop

# ===== 재배 레벨 로드맵 GUI =====
function 재배레벨GUI(p: player, page: integer):
    set {_lv} to {재배레벨::%{_p}%}
    if {_lv} is not set:
        set {_lv} to 1
    set {_cur} to {재배경험치::%{_p}%}
    if {_cur} is not set:
        set {_cur} to 0
    set {_need} to {재배필요경험치::%{_p}%}
    if {_need} is not set:
        set {_need} to 100
    set {_remain} to {_need} - {_cur}
    if {_remain} < 0:
        set {_remain} to 0
    if {_need} > 0:
        set {_pct} to floor({_cur} * 100 / {_need})
    else:
        set {_pct} to 0
    # 페이지 계산 (만렙 50)
    set {_perPage} to 29
    set {_startLv} to ({_page} - 1) * {_perPage} + 1
    set {_endLv} to {_page} * {_perPage}
    if {_endLv} > 50:
        set {_endLv} to 50
    open chest inventory with 6 rows named "&0재배 로드맵 (Lv.%{_startLv}%~%{_endLv}%)" to {_p}
    set {재배GUI페이지::%{_p}%} to {_page}
    # ㄹ자 경로
    delete {_path::*}
    loop integers from 0 to 8:
        set {_path::%loop-integer + 1%} to 9 + loop-integer
    set {_path::10} to 26
    loop integers from 0 to 8:
        set {_path::%11 + loop-integer%} to 35 - loop-integer
    set {_path::20} to 36
    loop integers from 0 to 8:
        set {_path::%21 + loop-integer%} to 45 + loop-integer
    # 배경
    loop integers from 0 to 53:
        set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 1 of {_p}'s current inventory to arrow named "&7◀ 스킬 선택"
    # 1행: 정보바
    set {_head} to skull of {_p}
    set {_filled} to 0
    if {_need} > 0:
        set {_filled} to floor({_cur} * 50 / {_need})
    if {_filled} > 50:
        set {_filled} to 50
    set {_bar} to ""
    loop 50 times:
        if loop-iteration <= {_filled}:
            set {_bar} to "%{_bar}%&a|"
        else:
            set {_bar} to "%{_bar}%&8|"
    set slot 4 of {_p}'s current inventory to {_head} named "&a&l재배 Lv.%{_lv}% &7%{_p}'s name%" with lore "&7경험치: &a%{_cur}%&7/&f%{_need}%" and "&8[%{_bar}%&8] &a%{_pct}%%%" and "&7남은 경험치: &e%{_remain}%"
    # 페이지 버튼
    if {_page} > 1:
        set {_prevStart} to ({_page} - 2) * {_perPage} + 1
        set {_prevEnd} to ({_page} - 1) * {_perPage}
        set slot 0 of {_p}'s current inventory to arrow named "&c◀ 이전 페이지" with lore "&7Lv.%{_prevStart}%~%{_prevEnd}%"
    if {_endLv} < 50:
        set {_nextStart} to {_page} * {_perPage} + 1
        set {_nextEnd} to ({_page} + 1) * {_perPage}
        if {_nextEnd} > 50:
            set {_nextEnd} to 50
        set slot 8 of {_p}'s current inventory to arrow named "&a다음 페이지 ▶" with lore "&7Lv.%{_nextStart}%~%{_nextEnd}%"
    # 각 레벨 배치
    loop integers from 1 to 29:
        set {_idx} to loop-integer
        set {_lvNum} to {_startLv} + {_idx} - 1
        if {_lvNum} > 50:
            stop loop
        set {_slot} to {_path::%{_idx}%}
        if {_slot} is not set:
            stop loop
        # 보상 결정
        set {_reward} to ""
        set {_iconType} to "normal"
        if mod({_lvNum}, 5) is 0:
            set {_iconType} to "milestone"
        # === 티어 해금 ===
        if {_lvNum} is 11:
            set {_reward} to "&e&l보너스 드롭 10%% 해금!"
            set {_iconType} to "unlock"
        else if {_lvNum} is 21:
            set {_reward} to "&6&l보너스 드롭 25%% 해금!"
            set {_iconType} to "unlock"
        else if {_lvNum} is 31:
            set {_reward} to "&b&l보너스 드롭 50%% 해금!"
            set {_iconType} to "unlock"
        else if {_lvNum} is 41:
            set {_reward} to "&d&l보너스 드롭 75%% 해금!"
            set {_iconType} to "unlock"
        else if {_lvNum} is 50:
            set {_reward} to "&6&l만렙! 재배 마스터"
            set {_iconType} to "max"
        # === 마일스톤 보상 ===
        else if {_lvNum} is 5:
            set {_reward} to "&a씨앗 추가 획득"
        else if {_lvNum} is 10:
            set {_reward} to "&a보너스 드롭 확률 상승"
        else if {_lvNum} is 15:
            set {_reward} to "&a성장 속도 증가"
        else if {_lvNum} is 20:
            set {_reward} to "&a보너스 드롭 확률 상승"
        else if {_lvNum} is 25:
            set {_reward} to "&a씨앗 추가 획득"
        else if {_lvNum} is 30:
            set {_reward} to "&a더블 보너스 확률 상승"
        else if {_lvNum} is 35:
            set {_reward} to "&a성장 속도 증가"
        else if {_lvNum} is 40:
            set {_reward} to "&a더블 보너스 확률 상승"
        else if {_lvNum} is 45:
            set {_reward} to "&a희귀 씨앗 획득 확률 상승"
        # === 돈 보상 ===
        else if {_lvNum} is 3:
            set {_reward} to "&f보상: 300원"
            set {_iconType} to "chest"
        else if {_lvNum} is 7:
            set {_reward} to "&f보상: 700원"
            set {_iconType} to "chest"
        else if {_lvNum} is 13:
            set {_reward} to "&f보상: 1,500원"
            set {_iconType} to "chest"
        else if {_lvNum} is 17:
            set {_reward} to "&f보상: 2,500원"
            set {_iconType} to "chest"
        else if {_lvNum} is 23:
            set {_reward} to "&e보상: 4,000원"
            set {_iconType} to "chest"
        else if {_lvNum} is 27:
            set {_reward} to "&e보상: 6,000원"
            set {_iconType} to "chest"
        else if {_lvNum} is 33:
            set {_reward} to "&6보상: 10,000원"
            set {_iconType} to "echest"
        else if {_lvNum} is 37:
            set {_reward} to "&6보상: 15,000원"
            set {_iconType} to "echest"
        else if {_lvNum} is 43:
            set {_reward} to "&d보상: 25,000원"
            set {_iconType} to "shulker"
        else if {_lvNum} is 47:
            set {_reward} to "&d보상: 40,000원"
            set {_iconType} to "shulker"
        # 아이콘 결정
        if {_lvNum} is {_lv}:
            set {_icon} to experience bottle named "&a&l◆ Lv.%{_lvNum}% &7(현재)" with lore "&7경험치: &a%{_cur}%&7/&f%{_need}%" and "&8[%{_bar}%&8] &a%{_pct}%%%" and "&7남은 경험치: &e%{_remain}%"
        else if {_lvNum} < {_lv}:
            if {_iconType} is "unlock":
                set {_icon} to nether star named "&a✓ Lv.%{_lvNum}%" with lore "&a달성 완료" and "%{_reward}%"
            else if {_iconType} is "chest" or "echest" or "shulker":
                set {_icon} to lime stained glass pane named "&a✓ Lv.%{_lvNum}%" with lore "&a수령 완료" and "%{_reward}%"
            else if {_reward} is not "":
                set {_icon} to lime stained glass pane named "&a✓ Lv.%{_lvNum}%" with lore "&a달성 완료" and "%{_reward}%"
            else:
                set {_icon} to lime stained glass pane named "&a✓ Lv.%{_lvNum}%"
        else:
            if {_iconType} is "unlock":
                set {_icon} to nether star named "&e★ Lv.%{_lvNum}%" with lore "&7보너스 드롭 해금" and "%{_reward}%"
            else if {_iconType} is "max":
                set {_icon} to nether star named "&6&l★ Lv.50 만렙" with lore "%{_reward}%"
            else if {_iconType} is "milestone":
                set {_icon} to gold nugget named "&e☆ Lv.%{_lvNum}%" with lore "&7마일스톤 보상" and "%{_reward}%"
            else if {_iconType} is "chest":
                set {_icon} to chest named "&f Lv.%{_lvNum}%" with lore "&7레벨업 보상" and "%{_reward}%"
            else if {_iconType} is "echest":
                set {_icon} to ender chest named "&6 Lv.%{_lvNum}%" with lore "&6특별 레벨업 보상" and "%{_reward}%"
            else if {_iconType} is "shulker":
                set {_icon} to purple shulker box named "&d Lv.%{_lvNum}%" with lore "&d전설 레벨업 보상" and "%{_reward}%"
            else:
                set {_icon} to white stained glass pane named "&fLv.%{_lvNum}%"
        set slot {_slot} of {_p}'s current inventory to {_icon}

# 재배 로드맵 클릭
on inventory click:
    if player's current inventory's name contains "&0재배 로드맵":
        cancel event
        if event-item is arrow:
            set {_ci} to index of clicked slot
            set {_page} to {재배GUI페이지::%player%}
            if {_page} is not set:
                set {_page} to 1
            if {_ci} is 8:
                wait 1 tick
                재배레벨GUI(player, {_page} + 1)
            else if {_ci} is 0:
                if {_page} > 1:
                    wait 1 tick
                    재배레벨GUI(player, {_page} - 1)
            else if {_ci} is 1:
                close player's inventory
                레벨선택GUI(player)

# ===== 작물 수확 → 보너스 드롭 + XP =====
on break:
    if event-block is not wheat, carrots, potatoes or beetroots:
        stop
    # 완전 성장 체크
    set {_data} to "%block data of event-block%"
    if event-block is beetroots:
        if {_data} does not contain "age=3":
            stop
    else:
        if {_data} does not contain "age=7":
            stop
    # 레벨 초기화 보장
    if {재배레벨::%player%} is not set:
        set {재배레벨::%player%} to 1
        set {재배경험치::%player%} to 0
        set {재배필요경험치::%player%} to 100
    set {_lv} to {재배레벨::%player%}
    # 보너스 드롭 확률
    set {_chance} to 0
    if {_lv} >= 41:
        set {_chance} to 75
    else if {_lv} >= 31:
        set {_chance} to 50
    else if {_lv} >= 21:
        set {_chance} to 25
    else if {_lv} >= 11:
        set {_chance} to 10
    # 보너스 드롭 판정
    if {_chance} > 0:
        set {_roll} to random integer from 1 to 100
        if {_roll} <= {_chance}:
            if event-block is wheat:
                drop 1 of wheat at location of event-block
            else if event-block is carrots:
                drop 1 of carrot at location of event-block
            else if event-block is potatoes:
                drop 1 of potato at location of event-block
            else if event-block is beetroots:
                drop 1 of beetroot at location of event-block
            send action bar "&a🌾 &f보너스 수확! &8(+1)" to player
    # XP 지급
    재배경험치추가(player, 10)

# ===== 접속 시 초기화 =====
on join:
    if {재배레벨::%player%} is not set:
        set {재배레벨::%player%} to 1
        set {재배경험치::%player%} to 0
        set {재배필요경험치::%player%} to 100

# ===== 명령어 =====
on tab complete of "/재배레벨":
    stop

command /재배레벨:
    aliases: /woqofpqpf
    trigger:
        재배레벨GUI(player, 1)
