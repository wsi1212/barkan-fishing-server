# =========================================
# 카메라툴.sk
# 어드민 카메라 이동 툴 (빌딩/프리셋 확인용)
# 좌클릭: 바라보는 블록으로 텔레포트
# 우클릭: 비행 속도 조절
# =========================================

command /카메라툴:
    aliases: /zkajfkxnf
    permission: op
    trigger:
        give player blaze rod named "&b&l카메라 툴" with lore "&7좌클릭: 텔레포트" and "&7우클릭: 비행속도 변경"
        message "&8[&b 카메라 &8] &a카메라 툴을 지급했습니다."

on left click:
    if player's tool's name is "&b&l카메라 툴":
        if player is op:
            cancel event
            set {_l} to target block
            add 1 to y-coord of {_l}
            set yaw of {_l} to yaw of player's location
            set pitch of {_l} to pitch of player's location
            teleport player to {_l}

on right click:
    if player's tool's name is "&b&l카메라 툴":
        if player is op:
            cancel event
            if {flyspeed.%player's name%} is not set:
                set {flyspeed.%player's name%} to player's fly speed
            add 0.1 to player's fly speed
            add 0.1 to {flyspeed.%player's name%}
            if {flyspeed.%player's name%} > 1:
                set player's fly speed to 0.1
                set {flyspeed.%player's name%} to 0.1
            send action bar "&b비행 속도: &f%player's fly speed%" to player
