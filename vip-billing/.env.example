# Never commit the production .env file.
PORT=3100
DATABASE_URL=postgresql://vip_billing:REPLACE_WITH_GENERATED_SECRET@127.0.0.1:5432/vip_billing
PUBLIC_BASE_URL=https://barkan.kr/vip
STATS_ADMIN_URL=https://barkan.kr/admin/membership
COMMUNITY_BASE_URL=https://barkan.kr/community
# Give BlockShip this same random value through config.yml, never in a git-tracked file.
INTERNAL_API_TOKEN=REPLACE_WITH_64_HEX_CHAR_RANDOM_TOKEN
# Website administrator login. Store only in the Oracle environment file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Leave both empty until the Toss Payments agreement and keys are ready. Payment pages stay disabled safely.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# PG 전환 전 선불 기간권 계좌이체에 표시할 계좌. 실제 운영 값은 Oracle .env에만 저장.
BANK_TRANSFER_BANK=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_HOLDER=
