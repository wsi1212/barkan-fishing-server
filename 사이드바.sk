# =========================================
# 사이드바.sk
# 사이드바 + 콤보 TextDisplay
# =========================================

# ===== 콤보 그라데이션 (100단위로 팔레트 변경) =====
function 콤보그라데이션(combo: integer) :: text:
    set {_numStr} to "%{_combo}%"
    set {_len} to length of {_numStr}
    set {_tier} to floor({_combo} / 100)
    if {_tier} is 1:
        set {_c::1} to "<##FF9AA2>"
        set {_c::2} to "<##FFB7B2>"
        set {_c::3} to "<##FFDAC1>"
        set {_c::4} to "<##FFE4E1>"
        set {_c::5} to "<##FFC0CB>"
        set {_c::6} to "<##FFB6C1>"
    else if {_tier} is 2:
        set {_c::1} to "<##A0E7E5>"
        set {_c::2} to "<##B4F8C8>"
        set {_c::3} to "<##7FDBDA>"
        set {_c::4} to "<##A3E4D7>"
        set {_c::5} to "<##82E0AA>"
        set {_c::6} to "<##76D7C4>"
    else if {_tier} is 3:
        set {_c::1} to "<##C7CEEA>"
        set {_c::2} to "<##D4A5FF>"
        set {_c::3} to "<##E8DAEF>"
        set {_c::4} to "<##D2B4DE>"
        set {_c::5} to "<##BB8FCE>"
        set {_c::6} to "<##C39BD3>"
    else if {_tier} is 4:
        set {_c::1} to "<##FFD700>"
        set {_c::2} to "<##FFEC8B>"
        set {_c::3} to "<##FFF8DC>"
        set {_c::4} to "<##FFEFD5>"
        set {_c::5} to "<##FFE4B5>"
        set {_c::6} to "<##FFD700>"
    else if {_tier} is 5:
        set {_c::1} to "<##FF9AA2>"
        set {_c::2} to "<##FFDAC1>"
        set {_c::3} to "<##FFFFD8>"
        set {_c::4} to "<##B5EAD7>"
        set {_c::5} to "<##A0C4FF>"
        set {_c::6} to "<##C7CEEA>"
    else:
        set {_c::1} to "<##FF6FFF>"
        set {_c::2} to "<##6FE0FF>"
        set {_c::3} to "<##6FFFB4>"
        set {_c::4} to "<##FFFF6F>"
        set {_c::5} to "<##FF9F6F>"
        set {_c::6} to "<##FF6FFF>"
    set {_result} to ""
    loop {_len} times:
        set {_ci} to mod(loop-iteration - 1, 6) + 1
        set {_char} to character at loop-iteration in {_numStr}
        set {_result} to "%{_result}%%{_c::%{_ci}%}%%{_char}%"
    return {_result}

# ===== 사이드바 업데이트 함수 =====
function 사이드바업데이트(p: player):
    set {_lv} to {낚시레벨::%{_p}%}
    if {_lv} is not set:
        set {_lv} to 1
    set {_cur} to {낚시레벨현재경험치::%{_p}%}
    if {_cur} is not set:
        set {_cur} to 0
    set {_need} to {낚시레벨필요경험치::%{_p}%}
    if {_need} is not set:
        set {_need} to 50
    set {_money} to {돈::%{_p}%}
    if {_money} is not set:
        set {_money} to 0
    set {_combo} to {낚시콤보::%{_p}%}
    if {_combo} is not set:
        set {_combo} to 0
    set {_area} to {area::%{_p}%}
    if {_area} is not set:
        set {_area} to "없음"
    # 섬 > 지역 형태 표시
    set {_island} to {섬::%{_p}%}
    if {_island} is set:
        if {_island} is not "0":
            if {_area} is not {_island}:
                if {_area} is not "0":
                    if {_area} is not "없음":
                        set {_islandDisplay} to regionDisplayName({_island})
                        set {_areaDisplay} to regionDisplayName({_area})
                        set {_area} to "%{_islandDisplay}% > %{_areaDisplay}%"
                    else:
                        set {_area} to regionDisplayName({_island})
                else:
                    set {_area} to regionDisplayName({_island})
            else:
                set {_area} to regionDisplayName({_island})
    # 경험치 바 (10칸)
    if {_need} > 0:
        set {_filled} to floor({_cur} * 10 / {_need})
    else:
        set {_filled} to 0
    if {_filled} > 10:
        set {_filled} to 10
    set {_expBar} to ""
    loop 10 times:
        if loop-iteration <= {_filled}:
            set {_expBar} to "%{_expBar}%&a|"
        else:
            set {_expBar} to "%{_expBar}%&8|"
    # 콤보 표시
    if {_combo} >= 100:
        set {_gradient} to 콤보그라데이션({_combo})
        set {_comboText} to "%{_gradient}% &d연속!"
    else if {_combo} >= 50:
        set {_comboText} to "&d&l%{_combo}% &5연속!!"
    else if {_combo} >= 20:
        set {_comboText} to "&c&l%{_combo}% &e연속!"
    else if {_combo} >= 10:
        set {_comboText} to "&c%{_combo}% &e연속!"
    else if {_combo} >= 5:
        set {_comboText} to "&6%{_combo}% &e연속"
    else if {_combo} >= 2:
        set {_comboText} to "&a%{_combo}% &7연속"
    else if {_combo} is 1:
        set {_comboText} to "&71"
    else:
        set {_comboText} to "&70"
    # 시간대
    set {_time} to 현재시간대({_p})
    if {_time} is "낮":
        set {_timeIcon} to "&e☀"
    else if {_time} is "저녁":
        set {_timeIcon} to "&6☀"
    else if {_time} is "밤":
        set {_timeIcon} to "&9☽"
    else:
        set {_timeIcon} to "&b☽"
    set {_weather} to 현재날씨({_p})
    if {_weather} is "맑음":
        set {_weatherIcon} to "&f☁"
    else if {_weather} is "비":
        set {_weatherIcon} to "&b☂"
    else:
        set {_weatherIcon} to "&c⚡"
    # 스코어보드
    set title of {_p}'s scoreboard to "&b&l⚓ 바르칸 열도"
    set line 10 of {_p}'s scoreboard to "&f"
    # 칭호 + 닉네임
    set {_spn} to name of {_p}
    if {길드::%{_spn}%} is set:
        set {_gName} to {길드정보::%{길드::%{_spn}%}%::이름}
        if {_gName} is not set:
            set {_gName} to {길드::%{_spn}%}
        set line 9 of {_p}'s scoreboard to " &b[%{_gName}%] &f%{_p}'s name%"
    else:
        set line 9 of {_p}'s scoreboard to " &f%{_p}'s name%"
    set line 8 of {_p}'s scoreboard to " &e낚시 Lv.%{_lv}% %{_expBar}%"
    set line 7 of {_p}'s scoreboard to " &7소지금: &6%{_money}%원"
    set line 6 of {_p}'s scoreboard to "&f "
    # 채팅 모드
    if {길드채팅모드::%{_p}%} is true:
        set line 5 of {_p}'s scoreboard to " &7채팅 &b길드"
    else if {지역채팅모드::%{_p}%} is true:
        set {_rcnt} to 0
        loop all players:
            if loop-player is not {_p}:
                if {지역채팅모드::%loop-player%} is true:
                    if loop-player's world is {_p}'s world:
                        if distance between {_p} and loop-player <= 500:
                            add 1 to {_rcnt}
        set line 5 of {_p}'s scoreboard to " &7채팅 &e지역 &7(%{_rcnt}%명)"
    else:
        set line 5 of {_p}'s scoreboard to " &7채팅 &a전체"
    set line 4 of {_p}'s scoreboard to " &7위치 &f%{_area}%"
    # guild_world는 항상 맑음
    if {_p}'s world is world "guild_world":
        set line 3 of {_p}'s scoreboard to " &7환경 %{_timeIcon}% %{_time}% &e☀ 맑음"
    else:
        # 날씨 표시 (지역 날씨 > 전역 날씨 > MC 날씨)
        set {_playerArea} to {area::%{_p}%}
        if {_playerArea} is not set:
            set {_playerArea} to "0"
        set {_effectiveW} to ""
        if {지역날씨::%{_playerArea}%} is set:
            set {_effectiveW} to {지역날씨::%{_playerArea}%}
        else if {서버날씨} is set:
            if {지역제외날씨::%{_playerArea}%} does not contain {서버날씨}:
                set {_effectiveW} to {서버날씨}
        if {_effectiveW} is not "":
            if {_effectiveW} is "태풍":
                set {_cwIcon} to "&4⚡"
            else if {_effectiveW} is "안개":
                set {_cwIcon} to "&7☁"
            else if {_effectiveW} is "모래바람":
                set {_cwIcon} to "&6≋"
            else if {_effectiveW} is "눈보라":
                set {_cwIcon} to "&b❄"
            else if {_effectiveW} is "열대야":
                set {_cwIcon} to "&c☀"
            else if {_effectiveW} is "땡볕":
                set {_cwIcon} to "&e☀"
            else if {_effectiveW} is "비":
                set {_cwIcon} to "&b☂"
            else if {_effectiveW} is "뇌우":
                set {_cwIcon} to "&c⚡"
            else:
                set {_cwIcon} to "&e★"
            set line 3 of {_p}'s scoreboard to " &7환경 %{_timeIcon}% %{_time}% %{_cwIcon}% %{_effectiveW}%"
        else:
            # MC 기본 날씨도 지역 제외 체크 (사막에서 비 제외 등)
            if {지역제외날씨::%{_playerArea}%} contains {_weather}:
                set line 3 of {_p}'s scoreboard to " &7환경 %{_timeIcon}% %{_time}% &e☀ 맑음"
            else:
                set line 3 of {_p}'s scoreboard to " &7환경 %{_timeIcon}% %{_time}% %{_weatherIcon}% %{_weather}%"
    set line 2 of {_p}'s scoreboard to " &7콤보 %{_comboText}%"
    set line 1 of {_p}'s scoreboard to ""

# (칭호 태그/네임태그 관련은 칭호.sk에서 관리)

# ===== 사이드바 테스트 명령어 (3가지 방식) =====
# 1. 레거시 Skript (현재 사이드바업데이트가 쓰는 방식)
command /테스트1:
    permission: op
    trigger:
        set title of player's scoreboard to "&aTEST 1 (legacy)"
        set line 3 of player's scoreboard to "&f방식: set title of scoreboard"
        set line 2 of player's scoreboard to "&e%player's name%"
        set line 1 of player's scoreboard to "&7line 1"
        send "[1] legacy 시도함. 보이나?" to player

# 2. Skript 2.13 네이티브
command /테스트2:
    permission: op
    trigger:
        wipe player's sidebar
        set name of sidebar of player to "&bTEST 2 (native)"
        set id based score "&f방식: sidebar of player" in sidebar of player to 3 with id "t2_a"
        set id based score "&e%player's name%" in sidebar of player to 2 with id "t2_b"
        set id based score "&7line 1" in sidebar of player to 1 with id "t2_c"
        send "[2] native 시도함. 보이나?" to player

# 3. 바닐라 /scoreboard 명령
command /테스트3:
    permission: op
    trigger:
        execute console command "scoreboard objectives remove t3"
        execute console command "scoreboard objectives add t3 dummy {""text"":""TEST 3 vanilla""}"
        execute console command "scoreboard objectives setdisplay sidebar t3"
        execute console command "scoreboard players set &fline_a t3 3"
        execute console command "scoreboard players set %player% t3 2"
        execute console command "scoreboard players set &7line_c t3 1"
        send "[3] vanilla 시도함. 보이나?" to player

# 디버그: 현재 objective 상태
command /테스트조회:
    permission: op
    trigger:
        execute player command "scoreboard objectives list"

# 테스트 정리
command /테스트삭제:
    permission: op
    trigger:
        execute console command "scoreboard objectives remove t3"
        wipe player's sidebar
        send "정리됨" to player

# ===== 콤보 테스트 명령어 (op) =====
command /콤보 [<integer>]:
    permission: op
    trigger:
        if arg-1 is set:
            set {낚시콤보::%player%} to arg-1
            if {낚시최대콤보::%player%} is not set:
                set {낚시최대콤보::%player%} to 0
            if arg-1 > {낚시최대콤보::%player%}:
                set {낚시최대콤보::%player%} to arg-1
            message "&8[&b 콤보 &8] &f콤보를 &e%arg-1%&f(으)로 설정했습니다." to player
        else:
            message "&8[&b 콤보 &8] &f현재 콤보: &e%{낚시콤보::%player%}% &8| &f최대: &e%{낚시최대콤보::%player%}%" to player
        사이드바업데이트(player)
        콤보네임태그(player)

# ===== 접속 시 =====
on join:
    wait 5 ticks
    사이드바업데이트(player)

# ===== 백업 폴링 (30초마다, 시간/날씨 변화 반영용) =====
every 30 seconds:
    loop all players:
        사이드바업데이트(loop-player)
