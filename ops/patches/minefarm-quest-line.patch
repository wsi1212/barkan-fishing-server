diff --git a/src/main/java/com/blockship/crop/CropSpecs.java b/src/main/java/com/blockship/crop/CropSpecs.java
index 6aa0c60..39d3b34 100644
--- a/src/main/java/com/blockship/crop/CropSpecs.java
+++ b/src/main/java/com/blockship/crop/CropSpecs.java
@@ -118,6 +118,70 @@ public final class CropSpecs {
         return it;
     }
 
+    // ===================================================================
+    // 압축 작물 꾸러미 — 「마인팜」 퀘스트 보상 (2026-08-16)
+    // ===================================================================
+    /**
+     * 꾸러미 하나에 든 산출물 개수. 스택 한도(64)와 맞춰 뒀다 —
+     * 풀면 정확히 한 스택이 되어 인벤토리에 깔끔히 들어간다.
+     */
+    public static final int BUNDLE_QTY = 64;
+    /** lore 마커 접두 — {@link CropManager}의 우클릭 해제가 이걸 읽는다. */
+    public static final String BUNDLE_TAG = "§8#cropbundle:";
+
+    /** 꾸러미 겉모습. 「눌러 담은 농산물」로 읽히는 블록을 쓴다. */
+    private static Material bundleMat(Spec s) {
+        return switch (s.id) {
+            case "밀" -> Material.HAY_BLOCK;
+            case "수박" -> Material.MELON;
+            case "버섯" -> Material.BROWN_MUSHROOM_BLOCK;
+            default -> Material.BARREL;
+        };
+    }
+
+    /**
+     * 압축 작물 꾸러미 아이템. 우클릭하면 {@link #BUNDLE_QTY}개로 풀린다.
+     *
+     * <p>★조합법은 <b>일부러 없다.</b> 이건 퀘스트 보상 전용 — 「난이도가 오를수록 낱개 대신
+     * 꾸러미로 준다」는 보상 등급 표현이지, 새 압축 경제를 여는 물건이 아니다.
+     * 압축→해제만 되고 해제→압축은 안 되므로 증식 경로가 생기지 않는다.
+     */
+    public static ItemStack bundleItem(String id, int amount) {
+        Spec s = byId(id);
+        if (s == null) return null;
+        ItemStack it = new ItemStack(bundleMat(s), Math.max(1, Math.min(amount, 64)));
+        ItemMeta m = it.getItemMeta();
+        m.displayName(LEG.deserialize("§6압축 " + stripColor(s.name) + " 꾸러미").decoration(IT, false));
+        List<net.kyori.adventure.text.Component> lore = new ArrayList<>();
+        line(lore, "§7" + stripColor(s.name) + " " + BUNDLE_QTY + "개를 눌러 담은 꾸러미.");
+        line(lore, "§7우클릭하여 풀 수 있습니다.");
+        line(lore, "");
+        line(lore, BUNDLE_TAG + s.id);
+        m.lore(lore);
+        it.setItemMeta(m);
+        return it;
+    }
+
+    /** 이 아이템이 압축 꾸러미면 작물 id, 아니면 null. */
+    public static String bundleIdOf(ItemStack it) {
+        if (it == null || it.getType().isAir() || !it.hasItemMeta()) return null;
+        ItemMeta m = it.getItemMeta();
+        List<net.kyori.adventure.text.Component> lore = m == null ? null : m.lore();
+        if (lore == null) return null;
+        for (net.kyori.adventure.text.Component c : lore) {
+            String plain = LEG.serialize(c);
+            if (plain.startsWith(BUNDLE_TAG)) {
+                String id = plain.substring(BUNDLE_TAG.length()).trim();
+                return ALL.containsKey(id) ? id : null;
+            }
+        }
+        return null;
+    }
+
+    private static String stripColor(String s) {
+        return s == null ? "" : s.replaceAll("§[0-9a-fk-orA-FK-OR]", "");
+    }
+
     private static void line(List<net.kyori.adventure.text.Component> lore, String s) {
         lore.add(LEG.deserialize(s).decoration(IT, false));
     }
