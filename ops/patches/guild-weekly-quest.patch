+        put(m, new Tpl("길퀘_수박밭", AXIS_FARM, "&a수박밭", "farm", "수박", "", 790));
+        put(m, new Tpl("길퀘_호박밭", AXIS_FARM, "&a호박밭", "farm", "호박", "", 790));
+        //   특작은 성장시간 반비례 — 밀 20분 400 … 수박 24시간 50. 균일하게 박으면
