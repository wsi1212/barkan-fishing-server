+/**
+ * 섬 경작지(FARMLAND) 칸수 — 「마인팜」 퀘스트 목표 {@code farmland|<수>} 판정용.
+ *
+ * <h2>왜 「청크 단위 더티 추적」인가 (2026-08-16 재설계)</h2>
+ *
+ * 두 가지 뻔한 방법이 둘 다 틀렸다.
+ *
+ * <p><b>① 순수 증분 카운터(설치/파괴 때 ±1)</b> — 호퍼·액자가 쓰는 방식이지만 경작지엔 안 맞는다.
+ * 경작지는 <b>플레이어 없이도</b> 생기고 사라진다: 물이 마르고(BlockFade), 밟히고
+ * (EntityChangeBlock), 피스톤에 밀리고, 용암에 덮인다. 하나만 놓쳐도 카운터가 영구히 어긋나고
+ * <b>유저가 고칠 방법이 없다.</b> 게다가 이미 밭을 다 갈아 둔 기존 섬은 0부터 시작한다.
+ *
+ * <p><b>② 주기적 전수 스캔</b> — 항상 맞지만 <b>아무것도 안 변해도 매번 3,400만 블록을 다시 센다.</b>
+ * 더 나쁜 건 {@code getChunkAt}이 <b>생성도 안 된 공허 청크를 만들어 버린다</b>는 것 —
+ * 섬 대부분이 빈 공간인데 스캔할 때마다 청크가 생성·언로드를 반복한다.
+ *
+ * <p><b>③ 그래서 둘을 합쳤다.</b> 블록이 바뀐 <b>청크만 더럽다고 표시</b>하고, 더러운 청크만
+ * <b>실제 블록에서 다시 센다.</b>
+ * <ul>
+ *   <li>증분처럼 싸다 — 밭 100칸을 갈아도 보통 청크 두어 개만 다시 센다(청크당 ≒1ms).</li>
+ *   <li>스캔처럼 안 틀린다 — 청크 값을 <b>더하는</b> 게 아니라 <b>다시 세서 덮어쓴다.</b>
+ *       이벤트를 과하게 잡아도(관계없는 블록까지) 결과는 언제나 정확하다.</li>
+ *   <li>이벤트를 <b>놓쳐도</b> 스스로 낫는다 — 할 일이 없는 회차마다 가장 오래 검증 안 된
+ *       청크 {@value #HEAL_PER_PASS}개를 순회 재검증한다(400청크 섬이 약 1시간에 한 바퀴).</li>
+ * </ul>
+ *
+ * <h2>추가로 줄인 것</h2>
+ * <ul>
+ *   <li><b>미생성 청크는 건드리지 않는다</b>({@code isChunkGenerated}) — 공허 월드의 빈 공간이
+ *       스캔 때문에 생성되는 사고를 막는다.</li>
+ *   <li><b>기둥마다 최고 블록까지만</b> 훑는다({@code getHighestBlockYAt}). Y 380칸을 다 보지 않으므로
+ *       평평한 섬에서 읽는 블록 수가 한 자릿수 배로 줄어든다. 다층 밭은 그대로 다 센다 —
+ *       위에서부터 내려오므로 <b>높이를 가리지 않는다.</b></li>
+ *   <li>퀘스트를 가진 사람이 하나도 없으면 리스너가 <b>첫 줄에서 즉시 반환</b>한다.</li>
+ * </ul>
+ *
+ * <p>상태는 메모리에만 둔다 — 재시작하면 섬마다 전수 스캔 한 번을 다시 하고, 그게 곧
+ * 「진실과의 재동기화」다. 영속시키면 서버가 꺼진 사이의 변화를 놓친 채 굳는다.
+ */
+public class IslandFarmlandCounter implements Listener {
+
+    /** 한 배치에 스냅샷 뜰 청크 수. 스냅샷 생성만 메인 스레드고, 세는 건 비동기다. */
+    private static final int CHUNKS_PER_BATCH = 4;
+    /**
+     * 할 일이 없는 회차마다 순회 재검증할 청크 수 — 놓친 이벤트의 자가 치유.
+     *
+     * <p>이게 순수 증분 대비 유일한 <b>유휴 비용</b>이다(추적 1명당 10초마다 청크 2개 ≒
+     * 비동기 0.6ms + 메인 0.3ms). 보험이 필요 없다고 판단되면 <b>0으로 두면 유휴 비용이
+     * 문자 그대로 사라진다</b> — 그러면 「내가 잡는 이벤트가 전부다」에 전적으로 기댄다.
+     * 커버 못 하는 경로는 WorldEdit·{@code /setblock}처럼 이벤트를 안 내는 외부 변경이다.
+     */
+    private static final int HEAL_PER_PASS = 2;
+
+    private final JavaPlugin plugin;
+    private final IslandManager islands;
+
+    /** 섬 region id → 상태. <b>비어 있으면 리스너가 아무 일도 안 한다.</b> */
+    private final Map<String, State> byIsland = new HashMap<>();
+    /**
+     * 청크키 → 그 청크를 가진 섬의 상태. <b>추적 중인 섬의 청크만</b> 들어 있다.
+     *
+     * <p>★이게 없으면 {@link #mark}가 {@code RegionManager.getRegionAt}을 부르는데, 그건
+     * <b>전체 region을 매번 순회</b>한다. 섬이 1,000개면 물 한 칸 흐를 때마다
+     * ({@code BlockFromTo}!) 1,000회 반복이다. 청크키 해시 한 번으로 끝내면
+     * <b>섬이 몇 개든 O(1)</b>이다. 섬 간격이 2,000블록이라(최대 지름 301) 청크가 겹칠 일도 없다.
+     */
+    private final Map<Long, State> chunkIndex = new HashMap<>();
+
+    private static final class State {
+        final LinkedHashSet<Long> keys = new LinkedHashSet<>();   // 이 섬에 속한 청크 전부(색인 회수용)
+        final Map<Long, Integer> perChunk = new HashMap<>();      // 청크 → 확정 경작지 수
+        final LinkedHashSet<Long> dirty = new LinkedHashSet<>();  // 다시 셀 청크
+        final Deque<Long> healQueue = new ArrayDeque<>();         // 순회 재검증 순서
+        int total = 0;
+        boolean seeded = false;      // 첫 전수 스캔을 걸었나
+        boolean scanning = false;    // 배치 처리 중
+        /** 씨를 뿌릴 때의 섬 경계(x1,z1,x2,z2). 달라지면 = 경계 업그레이드 → 재파종. */
+        int[] bounds = null;
+    }
+
+    public IslandFarmlandCounter(JavaPlugin plugin, IslandManager islands) {
+        this.plugin = plugin;
+        this.islands = islands;
+        Bukkit.getPluginManager().registerEvents(this, plugin);
+    }
+
+    private static long key(int cx, int cz) { return ((long) cx << 32) | (cz & 0xFFFFFFFFL); }
+
+    // ===================================================================
+    // 조회 — QuestManager가 주기적으로 부른다
+    // ===================================================================
+    /**
+     * 그 플레이어 <b>소유</b> 섬의 경작지 수를 갱신하고 돌려준다(멤버로 얹혀 있는 섬은 세지 않는다 —
+     * 남의 밭으로 퀘스트를 깨는 걸 막는다).
+     *
+     * <p>할 일이 없으면 캐시된 합계로 <b>즉시</b> 콜백한다. 더러운 청크가 있으면 그것만 다시
+     * 센 뒤 콜백한다. 첫 호출은 전수 스캔이라 시간이 걸리며, 그동안은 <b>부분 합계</b>가 오간다
+     * (실제보다 작을 뿐 절대 크지 않으므로 퀘스트가 먼저 완료되는 일은 없다).
+     *
+     * @param done 완료 콜백. 항상 메인 스레드. 섬이 없으면 호출되지 않는다.
+     */
+    public void pump(Player p, IntConsumer done) {
+        IslandData isl = islands.getIslandByOwner(p.getUniqueId().toString());
+        if (isl == null) return;
+        RegionData r = islands.getRegionMgr().getRegion(isl.getId());
+        World w = Bukkit.getWorld(IslandManager.ISLAND_WORLD);
+        if (r == null || !r.hasCoordinates() || w == null) return;
+
+        State st = byIsland.computeIfAbsent(isl.getId(), k -> new State());
+        int[] a = r.getPos1(), b = r.getPos2();
+        final int minY = Math.max(w.getMinHeight(), Math.min(a[1], b[1]));
+        final int maxY = Math.min(w.getMaxHeight() - 1, Math.max(a[1], b[1]));
+        int[] now = {Math.min(a[0], b[0]), Math.min(a[2], b[2]),
+                     Math.max(a[0], b[0]), Math.max(a[2], b[2])};
+
+        // ★경계 업그레이드 감지. 안 보면 새로 생긴 바깥 링이 색인에 없어 **영영 안 세진다** —
+        //   하필 「대지주」가 요구하는 게 바로 그 경계 확장이라 조용히 못 깨는 퀘스트가 된다.
+        //   스캔 중이면 배치가 끝난 다음 회차로 미룬다(자료구조를 밑에서 갈아치우면 안 된다).
+        if (st.seeded && !java.util.Arrays.equals(st.bounds, now)) {
+            if (st.scanning) { done.accept(st.total); return; }
+            chunkIndex.keySet().removeAll(st.keys);
+            byIsland.remove(isl.getId());
+            st = byIsland.computeIfAbsent(isl.getId(), k -> new State());
+        }
+
+        if (!st.seeded) {                       // 첫 만남 = 전수 스캔 예약 + 청크 색인 구축
+            st.seeded = true;
+            st.bounds = now;
+            for (int cx = Math.min(a[0], b[0]) >> 4; cx <= (Math.max(a[0], b[0]) >> 4); cx++)
+                for (int cz = Math.min(a[2], b[2]) >> 4; cz <= (Math.max(a[2], b[2]) >> 4); cz++) {
+                    long k = key(cx, cz);
+                    st.keys.add(k);
+                    st.dirty.add(k);
+                    st.healQueue.add(k);
+                    chunkIndex.put(k, st);
+                }
+        } else if (st.dirty.isEmpty()) {         // 할 일 없음 → 순회 재검증 몇 칸
+            for (int i = 0; i < HEAL_PER_PASS && !st.healQueue.isEmpty(); i++) {
+                Long k = st.healQueue.poll();
+                st.dirty.add(k);
+                st.healQueue.add(k);             // 뒤로 돌려 라운드로빈
+            }
+        }
+
+        if (st.scanning) { done.accept(st.total); return; }   // 이미 돌고 있다 — 중복 배치 금지
+        st.scanning = true;
+        drain(st, w, minY, maxY, done);
+    }
+
+    /** 더러운 청크를 배치로 비운다. 스냅샷=메인, 세기=비동기, 반영=메인. 배치마다 한 틱 이상 쉰다. */
+    private void drain(State st, World w, int minY, int maxY, IntConsumer done) {
+        if (st.dirty.isEmpty()) { st.scanning = false; done.accept(st.total); return; }
+
+        List<Long> keys = new ArrayList<>(CHUNKS_PER_BATCH);
+        Iterator<Long> it = st.dirty.iterator();
+        for (int i = 0; i < CHUNKS_PER_BATCH && it.hasNext(); i++) { keys.add(it.next()); it.remove(); }
+
+        List<ChunkSnapshot> snaps = new ArrayList<>(keys.size());
+        for (long k : keys) {
+            int cx = (int) (k >> 32), cz = (int) k;
+            // ★미생성 청크는 만들지 않는다. 공허 월드에서 이걸 빼먹으면 스캔이 곧 지형 생성이 된다.
+            snaps.add(w.isChunkGenerated(cx, cz)
+                    ? w.getChunkAt(cx, cz).getChunkSnapshot(true, false, false)
+                    : null);
+        }
+
+        Bukkit.getScheduler().runTaskAsynchronously(plugin, () -> {
+            int[] res = new int[keys.size()];
+            for (int i = 0; i < keys.size(); i++)
+                res[i] = snaps.get(i) == null ? 0 : countIn(snaps.get(i), minY, maxY);
+            Bukkit.getScheduler().runTask(plugin, () -> {
+                for (int i = 0; i < keys.size(); i++) {
+                    Integer old = st.perChunk.put(keys.get(i), res[i]);
+                    st.total += res[i] - (old == null ? 0 : old);   // 더하는 게 아니라 덮어쓴다
+                }
+                drain(st, w, minY, maxY, done);
+            });
+        });
+    }
+
+    /** 청크 하나의 FARMLAND 수. 기둥마다 <b>최고 블록까지만</b> 내려간다 — 위쪽 빈 공간을 안 읽는다. */
+    private static int countIn(ChunkSnapshot s, int minY, int maxY) {
+        int n = 0;
+        for (int lx = 0; lx < 16; lx++)
+            for (int lz = 0; lz < 16; lz++) {
+                int top = Math.min(maxY, s.getHighestBlockYAt(lx, lz));
+                for (int y = minY; y <= top; y++)
