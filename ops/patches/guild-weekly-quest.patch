+import org.bukkit.event.block.BlockBreakEvent;
+import org.bukkit.event.block.BlockGrowEvent;
+import org.bukkit.event.block.BlockPlaceEvent;
+import org.bukkit.event.block.BlockSpreadEvent;
+import org.bukkit.plugin.java.JavaPlugin;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * 바닐라 작물 수확 → 퀘스트 목표 {@code farm|<작물|아무>|<수>}.
+ *
+ * <h2>왜 필요한가</h2>
+ * 「밀 20,000개」는 특수 밀로 불가능하다(한 포기 3개 · 20분 · 섬 작물 한도 32칸 = 6,667포기).
+ * 바닐라여야 하는데, {@code SkillManager.onHarvest}는 <b>밀·당근·감자·비트 4종만</b> 알고
+ * 퀘스트 훅도 없다. 그래서 8작물을 보는 전용 분류기를 둔다.
+ *
+ * <h2>★놓고 부수기 — 규칙 하나로 8작물을 전부 덮는다</h2>
+ *
+ * <blockquote><b>플레이어가 놓은 블록엔 표시를 남긴다. 서버가 자라게 한 블록엔 표시가 없다.
+ * 표시 없는 것만 센다.</b></blockquote>
+ *
+ * 표시는 <b>{@link BlockGrowEvent}(자연 성장)에서만 지운다.</b> 이게 전부다.
+ *
+ * <table>
+ *   <tr><th>상황</th><th>흐름</th><th>판정</th></tr>
+ *   <tr><td>정상 밀농사</td><td>심기=표시ON → <b>성장=표시OFF</b> → 수확</td><td>인정</td></tr>
+ *   <tr><td>심고 바로 캐기</td><td>표시ON 유지</td><td>거부</td></tr>
+ *   <tr><td>심고 <b>뼈가루</b>→캐기</td><td>뼈가루는 {@code BlockFertilizeEvent}라 <b>성장이 아니다</b></td><td>거부</td></tr>
+ *   <tr><td>정상 사탕수수</td><td>자라며 <b>새 마디</b>가 생김 = 표시 없음</td><td>인정</td></tr>
+ *   <tr><td>사탕수수 쌓고 캐기</td><td>손으로 놓은 마디 = 표시ON</td><td>거부</td></tr>
+ *   <tr><td>정상 수박·호박</td><td>줄기가 <b>열매를 생성</b> = 표시 없음</td><td>인정</td></tr>
+ *   <tr><td>수박·호박 놓고 캐기</td><td>손으로 놓은 열매 = 표시ON</td><td>거부</td></tr>
+ * </table>
+ *
+ * <p><b>작물별 임시방편이 0개다.</b> 줄기 방향 검사도, 아래 마디 검사도, 좌표 쿨다운도 필요 없다
+ * (좌표 쿨다운은 애초에 못 쓴다 — <b>정상 농장이 바로 같은 자리에서 계속 자라고 계속 캔다</b>).
+ *
+ * <p>★<b>뼈가루 구멍이 이 규칙으로 자동으로 막힌다.</b> 완숙({@code age==max}) 검사만 했으면
+ * 심고 뼈가루 뿌려 캐는 게 그대로 통과했다 — 컴포스터로 뼈가루가 무한 생산되므로 실제 위협이다.
+ * mcMMO가 실전에서 겪은 버그가 정확히 이것이다(놓임 표시가 뼈가루에 지워지던 문제).
+ *
+ * <h2>선행 조사</h2>
+ * mcMMO는 청크마다 놓임 플래그를 디스크에 저장하고(chunkstore), Jobs Reborn은
+ * {@code PlaceAndBreakProtection}을 <b>인메모리(재시작까지)</b>로 굴린다.
+ * 여기는 Jobs 쪽 수준을 택했다 — 재시작 공백을 노리려면 「데일리 재시작 직전에 수천 칸을
+ * 손으로 심어 두기」를 해야 하는데 <b>그건 그냥 농사짓는 것보다 느리다.</b>
+ * 부족하면 청크 PDC 영속(mcMMO식)으로 올리면 된다.
+ *
+ * <h2>비용</h2>
+ * 대상 월드는 {@code island_world}·{@code guild_world}뿐이고 추적 대상은 <b>8작물(+씨앗)</b>뿐이다.
+ * 다른 블록 설치는 첫 줄에서 반환한다.
+ */
+public class VanillaFarmListener implements Listener {
+
+    /** 농사가 일어나는 월드만 본다. */
+    private static final Set<String> WORLDS = Set.of("island_world", "guild_world");
+
+    /** 블록 → 작물 id(한글). 이 맵에 없는 블록은 아예 안 본다. */
+    private static final Map<Material, String> CROP = new HashMap<>();
+    /** 심을 때 놓이는 블록(씨앗이 변한 것) → 작물 id. 표시를 붙일 대상. */
+    private static final Map<Material, String> PLANTED = new HashMap<>();
+    /** 완숙 판정이 필요한 것 — {@code Ageable}이고 age == max 여야 수확이다. */
+    private static final Set<Material> NEEDS_RIPE = Set.of(
+            Material.WHEAT, Material.CARROTS, Material.POTATOES, Material.BEETROOTS, Material.COCOA);
+
+    static {
+        CROP.put(Material.WHEAT, "밀");
+        CROP.put(Material.CARROTS, "당근");
+        CROP.put(Material.POTATOES, "감자");
+        CROP.put(Material.BEETROOTS, "비트");
+        CROP.put(Material.COCOA, "코코아콩");
+        CROP.put(Material.MELON, "수박");
+        CROP.put(Material.PUMPKIN, "호박");
+        CROP.put(Material.SUGAR_CANE, "사탕수수");
+        PLANTED.putAll(CROP);   // 심는 순간의 블록도 같은 재질이다(씨앗 아이템 → 작물 블록)
+    }
+
+    private final JavaPlugin plugin;
+    /** 월드별 「플레이어가 놓았다」 표시. packed position. */
+    private final Map<String, Set<Long>> placed = new HashMap<>();
+    private com.blockship.quest.QuestManager quests;
+
+    public VanillaFarmListener(JavaPlugin plugin) { this.plugin = plugin; }
+
+    public void setQuestManager(com.blockship.quest.QuestManager q) { this.quests = q; }
+
+    /** 진단용 — 표시 중인 블록 수. */
+    public int markedBlocks() {
+        int n = 0;
+        for (Set<Long> s : placed.values()) n += s.size();
+        return n;
+    }
+
+    // ===================================================================
+    // 표시 on/off
+    // ===================================================================
+    private static long key(int x, int y, int z) {
+        // y 를 12비트(-2048~2047 오프셋)로 눌러 담는다 — 월드 높이 -64~320 을 충분히 덮는다.
+        return ((long) (x & 0x3FFFFFF) << 38) | ((long) ((y + 2048) & 0xFFF) << 26) | (z & 0x3FFFFFFL);
+    }
+
+    private Set<Long> setFor(World w) {
+        return placed.computeIfAbsent(w.getName(), k -> new HashSet<>());
+    }
+
+    private boolean watched(Block b) {
+        return WORLDS.contains(b.getWorld().getName()) && CROP.containsKey(b.getType());
+    }
+
+    /** 플레이어가 놓았다 → 표시 ON. */
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onPlace(BlockPlaceEvent e) {
+        Block b = e.getBlockPlaced();
+        if (!WORLDS.contains(b.getWorld().getName())) return;
+        if (!PLANTED.containsKey(b.getType())) return;
+        setFor(b.getWorld()).add(key(b.getX(), b.getY(), b.getZ()));
+    }
+
+    /**
+     * 자연 성장 → 표시 OFF. <b>이 한 곳에서만 지운다.</b>
+     *
+     * <p>{@code BlockGrowEvent}는 작물 단계 상승·줄기의 열매 생성에서 뜬다.
+     * {@code BlockSpreadEvent}는 사탕수수·대나무가 위로 뻗을 때 뜬다.
+     * <b>뼈가루({@code BlockFertilizeEvent})는 여기 안 들어온다</b> — 그게 핵심이다.
+     */
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onGrow(BlockGrowEvent e) { clear(e.getBlock()); }
+
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onSpread(BlockSpreadEvent e) { clear(e.getBlock()); }
+
+    private void clear(Block b) {
+        if (!WORLDS.contains(b.getWorld().getName())) return;
+        Set<Long> s = placed.get(b.getWorld().getName());
+        if (s != null && !s.isEmpty()) s.remove(key(b.getX(), b.getY(), b.getZ()));
+    }
+
+    // ===================================================================
+    // 수확 집계
+    // ===================================================================
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onBreak(BlockBreakEvent e) {
+        Block b = e.getBlock();
+        if (!watched(b)) return;
+        long k = key(b.getX(), b.getY(), b.getZ());
+        Set<Long> s = placed.get(b.getWorld().getName());
+        boolean wasPlaced = s != null && s.remove(k);   // 부수면 표시도 같이 사라진다
+        if (wasPlaced) return;                          // ★놓고 부수기 — 집계 안 함
+
+        if (NEEDS_RIPE.contains(b.getType())) {
+            // 완숙만 수확으로 친다. 표시 규칙과 «둘 다» 거는 이유는, 자연 생성된 미성숙 작물을
+            // 부수는 것까지 수확으로 세면 밭을 갈아엎는 게 곧 진행도가 되기 때문이다.
+            if (!(b.getBlockData() instanceof Ageable age) || age.getAge() < age.getMaximumAge()) return;
+        }
+        String cropId = CROP.get(b.getType());
+        if (cropId != null && quests != null) quests.onFarm(e.getPlayer(), cropId);
+    }
+
+    /** 월드 언로드/재시작 대비 정리 훅은 두지 않는다 — 인메모리라 재시작이 곧 초기화다. */
+    public void clearWorld(String worldName) { placed.remove(worldName); }
+
+    /** 좌표 하나가 지금 「플레이어가 놓음」으로 표시돼 있나 — 테스트/진단용. */
+    public boolean isMarked(Location loc) {
+        Set<Long> s = placed.get(loc.getWorld().getName());
+        return s != null && s.contains(key(loc.getBlockX(), loc.getBlockY(), loc.getBlockZ()));
+    }
+}
