+        put(m, new Tpl("길퀘_사탕수수", AXIS_FARM, "&a사탕수수 강변", "farm", "사탕수수", "", 2600));
+        //   ★코코아·수박·호박은 밀 계열의 30% — 정글나무/줄기 설치가 선행이라 진입 비용이 다르다.
