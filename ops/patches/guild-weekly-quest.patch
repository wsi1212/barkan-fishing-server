+ */
+public final class GuildQuestSpecs {
+
+    /** 길드 레벨 0~15 → 목표 배수. */
+    public static final double[] MULT = {
+        1.00, 1.15, 1.31, 1.50, 1.72, 1.97, 2.25, 2.58,
+        2.95, 3.38, 3.87, 4.43, 5.08, 5.81, 6.66, 7.62
