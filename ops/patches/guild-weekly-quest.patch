+    public Map<String, Integer> getQuestProgress() { if (questProgress == null) questProgress = new LinkedHashMap<>(); return questProgress; }
+    public Map<String, String> getQuestStatus() { if (questStatus == null) questStatus = new LinkedHashMap<>(); return questStatus; }
+    public Map<String, Long> getQuestContrib() { if (questContrib == null) questContrib = new LinkedHashMap<>(); return questContrib; }
+
