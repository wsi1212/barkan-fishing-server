new file mode 100644
index 0000000..65a4bb2
--- /dev/null
+++ b/src/main/java/com/blockship/guild/GuildQuestManager.java
@@ -0,0 +1,300 @@
+package com.blockship.guild;
+
+import net.kyori.adventure.text.serializer.legacy.LegacyComponentSerializer;
+import org.bukkit.Bukkit;
+import org.bukkit.Sound;
+import org.bukkit.entity.Player;
+import org.bukkit.plugin.java.JavaPlugin;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * 주간 길드 퀘스트 엔진 — 축 3개에서 주당 3개, 길드 레벨로 목표가 갈린다.
+ *
+ * <h2>개인 주간과 완전히 분리돼 있다</h2>
+ * 진행도는 {@link GuildData}에 있고 {@code PlayerData.weeklyQuests}를 안 건드린다.
+ * 섞으면 {@code QuestGui.hasOtherMain}의 「한 번에 하나」 잠금에 길드퀘가 끌려 들어간다.
+ *
+ * <h2>리셋 — 길드는 「접속」이 없다</h2>
+ * 개인 주간은 그 사람이 접속할 때 리셋된다. 길드는 그런 순간이 없어서
+ * <b>길드원 아무나 접속할 때</b> 길드 주차를 확인한다({@link #checkWeekly}).
+ *
+ * <h2>★목표치는 주 시작 시점에 «확정»한다</h2>
+ * 매번 다시 계산하면 주중에 길드가 레벨업했을 때 목표가 늘어나 <b>진행도가 뒤로 가는</b> 꼴이 된다.
+ * 그래서 배정할 때 계산해 {@link GuildData#getQuestTarget()}에 박아 둔다.
+ *
+ * <h2>보상 = 금고 몰빵</h2>
+ * 개인 배당은 없다. 금고는 <b>개인 지갑으로 나갈 수 없어서</b>(소비처가 버프·확장뿐)
+ * 넣은 만큼 전부 싱크로 돌아온다 — 크게 줘도 서버 경제에 안 샌다.
+ * 그리고 개인 보상이 없으므로 <b>길드 갈아타기로 먹을 게 없다.</b>
+ * 무임승차는 기여도를 GUI에 노출해 눈으로 막는다({@link #topContributors}) — 지급 로직엔 안 쓴다.
+ *
+ * <p>완료 시 <b>금고에 즉시 자동 입금</b>한다. 「받기」를 두면 아무도 안 눌러 날린다.
+ */
+public class GuildQuestManager {
+
+    private static final LegacyComponentSerializer AMP = LegacyComponentSerializer.legacyAmpersand();
+
+    private final JavaPlugin plugin;
+    private final GuildManager guilds;
+    private final GuildQuestSpecs specs;
+
+    // ── 핫패스 방어 ────────────────────────────────────────────────────────
+    //   bump() 는 «물고기 한 마리마다» 불린다. 여기서 하는 일이 곧 서버 부하다.
+    /** uuid → 길드 id 메모. {@code getGuildByPlayer}가 O(길드 수) 순회라 그대로 두면 안 된다. */
+    private final Map<java.util.UUID, String> guildOf = new java.util.HashMap<>();
+    /** 주차 문자열 캐시 — 날짜 포매팅을 이벤트마다 돌릴 이유가 없다. */
+    private String weekCache = "";
+    private long weekCacheAt = 0L;
+    /** 지연 저장 — guilds.save()는 guilds.json «전체»를 동기 직렬화한다. 이벤트마다 부르면 죽는다. */
+    private boolean dirty = false;
+
+    public GuildQuestManager(JavaPlugin plugin, GuildManager guilds, GuildQuestSpecs specs) {
+        this.plugin = plugin;
+        this.guilds = guilds;
+        this.specs = specs;
+        // 30초마다 한 번만 실제로 쓴다. 완료·주차리셋처럼 «돈이 오가는» 순간은 즉시 저장한다.
+        Bukkit.getScheduler().runTaskTimer(plugin, this::flush, 600L, 600L);
+    }
+
+    public GuildQuestSpecs specs() { return specs; }
+
+    /** 지연 저장 표시. */
+    private void saveSoon() { dirty = true; }
+
+    /** 밀린 저장을 실제로 쓴다. 종료 훅에서도 부를 수 있게 public. */
+    public void flush() {
+        if (!dirty) return;
+        dirty = false;
+        guilds.save();
+    }
+
+    private String thisWeek() {
+        long now = System.currentTimeMillis();
+        if (now - weekCacheAt > 60_000L || weekCache.isEmpty()) {
+            weekCache = com.blockship.util.KoreanTime.sundayWeekKey();
+            weekCacheAt = now;
+        }
+        return weekCache;
+    }
+
+    /**
+     * 그 플레이어의 길드 — 메모 우선, 빗나가면 전체 순회 후 재기억.
+     *
+     * <p>메모가 낡아도(탈퇴·이적) {@code isMember} 확인에서 걸러져 자동으로 고쳐진다.
+     * 확인은 맵 조회 두 번이라 순회보다 압도적으로 싸다.
+     */
+    private GuildData guildOf(Player p) {
+        java.util.UUID id = p.getUniqueId();
+        String uuid = id.toString();
+        String gid = guildOf.get(id);
+        if (gid != null) {
+            GuildData g = guilds.getGuild(gid);
+            if (g != null && g.isMember(uuid)) return g;
+            guildOf.remove(id);                       // 낡음 — 아래로 떨어뜨려 다시 찾는다
+        }
+        GuildData g = guilds.getGuildByPlayer(uuid);
+        if (g != null) guildOf.put(id, g.getId());
+        return g;
+    }
+
+    private void msg(Player p, String s) { p.sendMessage(AMP.deserialize(s)); }
+
+    // ===================================================================
+    // 주차 확인 / 배정
+    // ===================================================================
+    /** 접속 훅. 길드원이면 그 길드의 주차를 확인하고 필요하면 새 주를 연다. */
+    public void onJoin(Player p) {
+        GuildData g = guildOf(p);
+        if (g == null) return;
+        if (checkWeekly(g)) announceNewWeek(g);
+    }
+
+    /**
+     * 주차가 바뀌었으면 리셋 + 배정. 목표치는 <b>이 시점의 길드 레벨</b>로 확정된다.
+     *
+     * @return 새 주를 열었으면 true
+     */
+    public boolean checkWeekly(GuildData g) {
+        String week = thisWeek();
+        if (week.equals(g.getQuestWeek()) && !g.getQuestIds().isEmpty()) return false;
+        int lv = guilds.guildLevel(g);
+        g.resetGuildQuests(week);
+        for (String qid : specs.pickForWeek(week)) {
+            GuildQuestSpecs.Tpl t = specs.get(qid);
+            if (t == null) continue;
+            g.getQuestIds().add(qid);
+            g.getQuestTarget().put(qid, GuildQuestSpecs.targetFor(t, lv));   // ★여기서 확정
+            g.getQuestProgress().put(qid, 0);
+            g.getQuestStatus().put(qid, "진행");
+        }
+        guilds.save();      // 주차 경계는 즉시 — 여기서 날리면 한 주가 통째로 꼬인다
+        return true;
+    }
+
+    private void announceNewWeek(GuildData g) {
+        int lv = guilds.guildLevel(g);
+        for (Player m : onlineMembers(g)) {
+            msg(m, "&8[&b 길드 임무 &8] &e이번 주 길드 임무 &a" + g.getQuestIds().size() + "개&f가 시작됐습니다! &7(길드 Lv." + lv + ")");
+            for (String qid : g.getQuestIds()) {
+                GuildQuestSpecs.Tpl t = specs.get(qid);
+                if (t != null) msg(m, "  &8· " + t.name + " &7— " + com.blockship.util.Num.fmt(target(g, qid)));
+            }
+            msg(m, "  &7확인: &f/길드 임무");
+        }
+    }
+
+    private List<Player> onlineMembers(GuildData g) {
+        List<Player> out = new ArrayList<>();
+        for (String uuid : g.getMembers().keySet()) {
+            try {
+                Player m = Bukkit.getPlayer(java.util.UUID.fromString(uuid));
+                if (m != null && m.isOnline()) out.add(m);
+            } catch (IllegalArgumentException ignored) { }
+        }
+        return out;
+    }
+
+    // ===================================================================
+    // 진행 가산 — QuestManager 의 이벤트 훅들이 그대로 흘려보낸다
+    // ===================================================================
+    /**
+     * 이벤트 하나를 길드 임무에 반영한다.
+     *
+     * <p>★<b>이 메서드는 조용히 실패해선 안 되는 지점이다.</b> {@code QuestManager}의 훅 하나가
+     * 여기로 안 흘러오면 그 목표만 영원히 0으로 남는다. 배선은
+     * {@code ops/patches} 의 검증 스크립트가 전수 확인한다.
+     *
+     * @param verb  fish / harpoon / farm / harvest / sell / submit / material / submitpts …
+     * @param arg   어종·작물id·제출종류. 매칭에 안 쓰면 ""
+     * @param grade fish/harpoon 의 등급. 그 외 ""
+     * @param n     증가량
+     */
+    public void bump(Player p, String verb, String arg, String grade, int n) {
+        if (p == null || n <= 0) return;
+        GuildData g = guildOf(p);
+        if (g == null) return;
+        if (checkWeekly(g)) announceNewWeek(g);
+        if (g.getQuestIds().isEmpty()) return;
+
+        boolean touched = false;
+        for (String qid : new ArrayList<>(g.getQuestIds())) {
+            if (!"진행".equals(g.getQuestStatus().get(qid))) continue;
+            GuildQuestSpecs.Tpl t = specs.get(qid);
+            if (t == null || !t.verb.equals(verb)) continue;
+            if (!argMatch(t.arg, arg)) continue;
+            if (!gradeMatch(t.grade, grade)) continue;
+
+            int target = target(g, qid);
+            int cur = g.getQuestProgress().getOrDefault(qid, 0);
+            if (cur >= target) continue;
+            int next = Math.min(target, cur + n);
+            g.getQuestProgress().put(qid, next);
+            // 기여도 — 표시 전용(§보상은 금고 몰빵이라 지급 로직엔 안 쓴다)
+            String uuid = p.getUniqueId().toString();
+            g.getQuestContrib().merge(uuid, (long) (next - cur), Long::sum);
+            touched = true;
+            if (next >= target) complete(g, qid);
+        }
+        if (touched) saveSoon();   // ★진행도는 지연 저장 — 이벤트마다 전체 직렬화하면 서버가 죽는다
+    }
+
+    /** 인자 없는 verb(sell·submit 등)용 단축. */
+    public void bump(Player p, String verb, int n) { bump(p, verb, "", "", n); }
+
+    private static boolean argMatch(String want, String got) {
+        if (want == null || want.isEmpty() || "아무".equals(want)) return true;
+        return want.equals(got);
+    }
+
+    /** 등급은 「그 등급 이상」이다 — 개인 퀘스트의 gradeMatch 와 같은 규약. */
+    private static boolean gradeMatch(String want, String got) {
+        if (want == null || want.isEmpty() || "아무".equals(want)) return true;
+        if (got == null || got.isEmpty()) return false;
+        return gradeNum(got) >= gradeNum(want);
+    }
+
+    private static int gradeNum(String g) {
+        return switch (g) {
+            case "E" -> 1; case "D" -> 2; case "C" -> 3; case "B" -> 4; case "A" -> 5;
+            case "S" -> 6; case "M" -> 7; case "L" -> 8; case "G" -> 9; default -> 0;
+        };
+    }
+
+    // ===================================================================
+    // 완료 — 금고 즉시 입금
+    // ===================================================================
+    private void complete(GuildData g, String qid) {
+        g.getQuestStatus().put(qid, "완료");
+        long reward = specs.rewardFor(guilds.guildLevel(g));
+        guilds.deposit(g.getId(), reward);
+        dirty = false;                 // deposit 이 이미 저장했다 — 중복 쓰기 방지
+        GuildQuestSpecs.Tpl t = specs.get(qid);
+        String name = t == null ? qid : t.name;
+        for (Player m : onlineMembers(g)) {
+            msg(m, "&8[&b 길드 임무 &8] &a완료! &f" + name);
+            msg(m, "  &7길드 계좌 &6+" + com.blockship.util.Num.fmt(reward) + "원 &8(잔액 "
+                    + com.blockship.util.Num.fmt(g.getTreasury()) + ")");
+            m.playSound(m.getLocation(), Sound.UI_TOAST_CHALLENGE_COMPLETE, 0.7f, 1f);
+        }
+        Bukkit.getScheduler().runTask(plugin, () -> com.blockship.telemetry.Telemetry.log(
+                "guildquest.done", null, Map.of("gid", g.getId(), "qid", qid, "reward", reward)));
+    }
+
+    // ===================================================================
+    // 조회 (GUI/명령어용)
+    // ===================================================================
+    public int target(GuildData g, String qid) { return g.getQuestTarget().getOrDefault(qid, 0); }
+    public int progress(GuildData g, String qid) { return g.getQuestProgress().getOrDefault(qid, 0); }
+    public boolean done(GuildData g, String qid) { return "완료".equals(g.getQuestStatus().get(qid)); }
+
+    /** 이번 주 기여 상위 n명 — 이름과 수치. 무임승차를 «눈으로» 막는 장치다. */
+    public List<Map.Entry<String, Long>> topContributors(GuildData g, int n) {
+        List<Map.Entry<String, Long>> rows = new ArrayList<>(g.getQuestContrib().entrySet());
+        rows.sort(Comparator.comparingLong((Map.Entry<String, Long> e) -> e.getValue()).reversed());
+        return rows.size() <= n ? rows : rows.subList(0, n);
+    }
+
+    public String memberName(GuildData g, String uuid) {
+        GuildData.MemberData m = g.getMembers().get(uuid);
+        return m == null || m.name == null ? uuid.substring(0, 8) : m.name;
+    }
+
+    /** {@code /길드 임무} 텍스트 출력. */
+    public void printStatus(Player p) {
+        GuildData g = guildOf(p);
+        if (g == null) { msg(p, "&c길드에 가입되어 있지 않습니다."); return; }
+        checkWeekly(g);
+        int lv = guilds.guildLevel(g);
+        msg(p, "&8&m                                        ");
+        msg(p, " &b이번 주 길드 임무 &7(길드 Lv." + lv + " · 주차 " + g.getQuestWeek() + ")");
+        for (String qid : g.getQuestIds()) {
+            GuildQuestSpecs.Tpl t = specs.get(qid);
+            if (t == null) continue;
+            int cur = progress(g, qid), tg = target(g, qid);
+            String bar = bar(cur, tg);
+            msg(p, "  " + t.name + (done(g, qid) ? " &a✔" : "")
+                    + "\n    " + bar + " &f" + com.blockship.util.Num.fmt(cur) + "&7/&f" + com.blockship.util.Num.fmt(tg));
+        }
+        long reward = specs.rewardFor(lv);
+        msg(p, " &7퀘당 금고 보상 &6" + com.blockship.util.Num.fmt(reward) + "원 &8(개인 배당 없음 — 금고는 버프·확장에 쓰입니다)");
+        List<Map.Entry<String, Long>> top = topContributors(g, 5);
+        if (!top.isEmpty()) {
+            msg(p, " &7이번 주 기여 —");
+            int i = 1;
+            for (Map.Entry<String, Long> e : top)
+                msg(p, "   &8" + (i++) + ". &f" + memberName(g, e.getKey()) + " &7" + com.blockship.util.Num.fmt(e.getValue()));
+        }
+        msg(p, "&8&m                                        ");
+    }
+
+    private static String bar(int cur, int target) {
+        if (target <= 0) return "&8[..........]";
+        int filled = (int) Math.round(10.0 * Math.min(1.0, (double) cur / target));
+        return "&8[&a" + "■".repeat(filled) + "&7" + "□".repeat(10 - filled) + "&8]";
+    }
+}
diff --git a/src/main/java/com/blockship/guild/GuildQuestSpecs.java b/src/main/java/com/blockship/guild/GuildQuestSpecs.java
new file mode 100644
index 0000000..d6f3e1f
--- /dev/null
+++ b/src/main/java/com/blockship/guild/GuildQuestSpecs.java
@@ -0,0 +1,204 @@
+package com.blockship.guild;
+
+import com.google.gson.Gson;
+import com.google.gson.GsonBuilder;
+import com.google.gson.reflect.TypeToken;
+import org.bukkit.plugin.java.JavaPlugin;
+
+import java.io.*;
+import java.lang.reflect.Type;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * 주간 길드 퀘스트 정의 — `guild-quests.json` (Java 소유, 없으면 코드 내장 기본값을 write 후 load).
+ *
+ * <h2>왜 템플릿 + 배수인가</h2>
+ * 길드 레벨은 0~15다. 3구간으로 뭉치면 Lv4와 Lv5 사이에 절벽이 생기고, 레벨마다 퀘스트를
+ * 따로 쓰면 16×22 = 352개가 된다. 그래서 <b>템플릿 22개 + 배수표 16칸</b>으로 푼다 —
+ * 실제 목표 = {@code round(기준값 × MULT[길드레벨])}.
+ *
+ * <p>배수는 {@code 1.145^lv}(Lv15 = 7.62)다. 「목표 ≒ 활성인원 × 개인 주간 × 1.5」가 되도록 맞췄다.
+ *
+ * <h2>축 3개 · 주당 3개</h2>
+ * 매주 <b>축마다 하나씩</b> 뽑는다. 뽑는 기준은 <b>주차 문자열 해시</b>라
+ * <b>전 서버 길드가 같은 3개</b>를 받는다(목표 수치만 레벨별로 다름) — 비교·공지가 하나로 된다.
+ *
+ * <h2>목표는 가산적인 것만</h2>
+ * 여러 명이 나눠 미는 물건이라 {@code visit}·{@code area}·{@code equip}·{@code level}처럼
+ * 「한 사람이 하면 끝」인 verb, {@code farmland}·{@code islandvisit}처럼 상태를 보는 verb는 못 쓴다.
+ */
+public final class GuildQuestSpecs {
+
+    /** 길드 레벨 0~15 → 목표 배수. */
+    public static final double[] MULT = {
+        1.00, 1.15, 1.31, 1.50, 1.72, 1.97, 2.25, 2.58,
+        2.95, 3.38, 3.87, 4.43, 5.08, 5.81, 6.66, 7.62
+    };
+
+    public static final String AXIS_FISH = "조업";
+    public static final String AXIS_FARM = "농사";
+    public static final String AXIS_HELP = "기여";
+    public static final List<String> AXES = List.of(AXIS_FISH, AXIS_FARM, AXIS_HELP);
+
+    /**
+     * 템플릿 하나.
+     *
+     * @param id    내부 키
+     * @param axis  축 (조업/농사/기여)
+     * @param name  표시명 (& 색코드)
+     * @param verb  목표 verb — fish / harpoon / farm / harvest / sell / submit / material / submitpts
+     * @param arg   verb 인자 (어종·등급·작물id·제출종류). 없으면 ""
+     * @param grade fish/harpoon 전용 등급칸. 그 외 ""
+     * @param base  Lv0 기준값. 실제 목표 = round(base × MULT[lv])
+     */
+    public static final class Tpl {
+        public String id, axis, name, verb, arg, grade;
+        public int base;
+        public Tpl() {}
+        Tpl(String id, String axis, String name, String verb, String arg, String grade, int base) {
+            this.id = id; this.axis = axis; this.name = name;
+            this.verb = verb; this.arg = arg; this.grade = grade; this.base = base;
+        }
+    }
+
+    private static final class Root {
+        /** 퀘스트 하나당 금고 보상 = rewardBase × MULT[lv]. */
+        long rewardBase = 200_000L;
+        LinkedHashMap<String, Tpl> templates = new LinkedHashMap<>();
+    }
+
+    private final JavaPlugin plugin;
+    private final File file;
+    private final Gson gson = new GsonBuilder().setPrettyPrinting().disableHtmlEscaping().create();
+    private Root root = new Root();
+
+    public GuildQuestSpecs(JavaPlugin plugin) {
+        this.plugin = plugin;
+        this.file = new File(plugin.getDataFolder(), "guild-quests.json");
+        load();
+    }
+
+    // ===================================================================
+    // 기본값 — 템플릿 22종
+    // ===================================================================
+    private static LinkedHashMap<String, Tpl> defaults() {
+        LinkedHashMap<String, Tpl> m = new LinkedHashMap<>();
+        // ── 조업 3 ────────────────────────────────────────────────────────
+        put(m, new Tpl("길퀘_대조업", AXIS_FISH, "&b한 주의 대조업", "fish", "아무", "아무", 130));
+        put(m, new Tpl("길퀘_상급어장", AXIS_FISH, "&b상급 어장", "fish", "아무", "B", 26));
+        put(m, new Tpl("길퀘_작살부대", AXIS_FISH, "&b작살 부대", "harpoon", "아무", "A", 11));
+        // ── 농사 15 = 밭농사 8 + 특작 7 ───────────────────────────────────
+        //   밭농사는 바닐라 작물 수확(farm). ★설치 표시로 놓고부수기를 막는다(VanillaFarmListener).
+        put(m, new Tpl("길퀘_밀밭", AXIS_FARM, "&a밀밭 지대", "farm", "밀", "", 2600));
+        put(m, new Tpl("길퀘_당근밭", AXIS_FARM, "&a당근 두렁", "farm", "당근", "", 2600));
+        put(m, new Tpl("길퀘_감자밭", AXIS_FARM, "&a감자 두렁", "farm", "감자", "", 2600));
+        put(m, new Tpl("길퀘_비트밭", AXIS_FARM, "&a비트 두렁", "farm", "비트", "", 2600));
+        put(m, new Tpl("길퀘_사탕수수", AXIS_FARM, "&a사탕수수 강변", "farm", "사탕수수", "", 2600));
+        //   ★코코아·수박·호박은 밀 계열의 30% — 정글나무/줄기 설치가 선행이라 진입 비용이 다르다.
+        put(m, new Tpl("길퀘_코코아", AXIS_FARM, "&a정글의 코코아", "farm", "코코아콩", "", 790));
+        put(m, new Tpl("길퀘_수박밭", AXIS_FARM, "&a수박밭", "farm", "수박", "", 790));
+        put(m, new Tpl("길퀘_호박밭", AXIS_FARM, "&a호박밭", "farm", "호박", "", 790));
+        //   특작은 성장시간 반비례 — 밀 20분 400 … 수박 24시간 50. 균일하게 박으면
+        //   수박은 불가능하고 밀은 시시해진다.
+        put(m, new Tpl("길퀘_특작밀", AXIS_FARM, "&2특수 밀 재배단", "harvest", "밀", "", 52));
+        put(m, new Tpl("길퀘_특작양배추", AXIS_FARM, "&2특수 양배추 재배단", "harvest", "양배추", "", 47));
+        put(m, new Tpl("길퀘_특작당근", AXIS_FARM, "&2특수 당근 재배단", "harvest", "당근", "", 42));
+        put(m, new Tpl("길퀘_특작버섯", AXIS_FARM, "&2특수 버섯 재배단", "harvest", "버섯", "", 37));
+        put(m, new Tpl("길퀘_특작감자", AXIS_FARM, "&2특수 감자 재배단", "harvest", "감자", "", 34));
+        put(m, new Tpl("길퀘_특작토마토", AXIS_FARM, "&2특수 토마토 재배단", "harvest", "토마토", "", 29));
+        put(m, new Tpl("길퀘_특작수박", AXIS_FARM, "&2특수 수박 재배단", "harvest", "수박", "", 7));
+        // ── 기여 4 ────────────────────────────────────────────────────────
+        put(m, new Tpl("길퀘_어시장", AXIS_HELP, "&e어시장 장악", "sell", "", "", 91));
+        put(m, new Tpl("길퀘_제출소", AXIS_HELP, "&e제출소 점거", "submit", "", "", 60));
+        put(m, new Tpl("길퀘_곳간", AXIS_HELP, "&e곳간을 채워라", "material", "아무", "", 91));
+        //   ★submit(횟수)이 아니라 점수다 — 1개씩 20번 넣으면 끝나는 걸 막는다.
+        put(m, new Tpl("길퀘_연회", AXIS_HELP, "&e길드 연회", "submitpts", "요리", "", 20000));
+        return m;
+    }
+
+    private static void put(Map<String, Tpl> m, Tpl t) { m.put(t.id, t); }
+
+    // ===================================================================
+    // 로드 / 저장
+    // ===================================================================
+    public void load() {
+        if (!file.exists()) {
+            root = new Root();
+            root.templates = defaults();
+            write();
+            plugin.getLogger().info("[GuildQuest] guild-quests.json 생성 (템플릿 " + root.templates.size() + ")");
+            return;
+        }
+        try (Reader r = new InputStreamReader(new FileInputStream(file), StandardCharsets.UTF_8)) {
+            Type t = new TypeToken<Root>() {}.getType();
+            Root loaded = gson.fromJson(r, t);
+            if (loaded == null || loaded.templates == null || loaded.templates.isEmpty()) {
+                root = new Root(); root.templates = defaults();
+            } else {
+                root = loaded;
+            }
+            plugin.getLogger().info("[GuildQuest] 템플릿 " + root.templates.size() + "개 로드");
+        } catch (Exception e) {
+            plugin.getLogger().warning("[GuildQuest] guild-quests.json 로드 실패, 기본값 사용: " + e.getMessage());
+            root = new Root(); root.templates = defaults();
+        }
+    }
+
+    private void write() {
+        try {
+            if (!plugin.getDataFolder().exists()) plugin.getDataFolder().mkdirs();
+            try (Writer w = new OutputStreamWriter(new FileOutputStream(file), StandardCharsets.UTF_8)) {
+                gson.toJson(root, w);
+            }
+        } catch (Exception e) {
+            plugin.getLogger().warning("[GuildQuest] guild-quests.json 저장 실패: " + e.getMessage());
+        }
+    }
+
+    // ===================================================================
+    // 조회
+    // ===================================================================
+    public Tpl get(String id) { return root.templates.get(id); }
+    public Map<String, Tpl> all() { return root.templates; }
+
+    public List<Tpl> byAxis(String axis) {
+        List<Tpl> out = new ArrayList<>();
+        for (Tpl t : root.templates.values()) if (axis.equals(t.axis)) out.add(t);
+        return out;
+    }
+
+    /** 길드 레벨을 배수표 범위로 자른다. */
+    public static double multOf(int guildLevel) {
+        return MULT[Math.max(0, Math.min(guildLevel, MULT.length - 1))];
+    }
+
+    /** 그 레벨에서의 실제 목표치. 1 미만으로는 안 내려간다. */
+    public static int targetFor(Tpl t, int guildLevel) {
+        return Math.max(1, (int) Math.round(t.base * multOf(guildLevel)));
+    }
+
+    /** 퀘스트 하나당 금고 보상. */
+    public long rewardFor(int guildLevel) {
+        return Math.round(root.rewardBase * multOf(guildLevel));
+    }
+
+    /**
+     * 그 주차에 배정할 3개(축마다 하나). <b>주차 문자열 해시</b>로 고르므로
+     * 전 서버 길드가 같은 세트를 받는다 — 같은 주에 같은 목표를 두고 비교가 된다.
+     */
+    public List<String> pickForWeek(String week) {
+        List<String> out = new ArrayList<>();
+        for (int i = 0; i < AXES.size(); i++) {
+            List<Tpl> pool = byAxis(AXES.get(i));
+            if (pool.isEmpty()) continue;
+            // 축마다 다른 시드를 써야 세 축이 같은 인덱스로 몰리지 않는다.
+            int h = Math.abs((week + "#" + AXES.get(i)).hashCode());
+            out.add(pool.get(h % pool.size()).id);
+        }
+        return out;
+    }
+}
