+    // ===================================================================
+    // 더티 마킹 — 「이 청크에서 뭔가 바뀌었다」만 말한다
+    // ===================================================================
+    /**
+     * ★<b>블록이 경작지인지 따지지 않는다.</b> 흙을 놓고 물을 대면 나중에 경작지가 되는 식이라,
+     * 「경작지 이벤트」만 잡으려 들면 반드시 새는 경로가 생긴다. 청크를 더럽다고만 표시하고
+     * <b>다시 세서 덮어쓰므로</b> 과하게 잡는 건 공짜고, 덜 잡는 것만 위험하다.
+     */
+    private void mark(Location loc) {
+        if (chunkIndex.isEmpty() || loc == null || loc.getWorld() == null) return;  // 아무도 안 세는 중
+        if (!IslandManager.ISLAND_WORLD.equals(loc.getWorld().getName())) return;
+        // ★해시 한 번. RegionManager를 부르지 않는다 — 그건 전체 region 순회다.
+        long k = key(loc.getBlockX() >> 4, loc.getBlockZ() >> 4);
+        State st = chunkIndex.get(k);
+        if (st != null) st.dirty.add(k);
+    }
+
+    private void mark(Block b) { if (b != null) mark(b.getLocation()); }
+
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onPlace(BlockPlaceEvent e) { mark(e.getBlock()); }
+
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onBreak(BlockBreakEvent e) { mark(e.getBlock()); }
+
+    /** 괭이질 — 흙→경작지 전환은 전용 이벤트가 없어 상호작용으로 잡는다(한 틱 뒤에 세면 된다). */
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onInteract(PlayerInteractEvent e) {
+        if (e.getClickedBlock() != null && e.getAction().name().startsWith("RIGHT_")) mark(e.getClickedBlock());
+    }
+
+    /** 물이 빠져 경작지가 마르는 경우. */
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onFade(BlockFadeEvent e) { mark(e.getBlock()); }
+
+    /** 밟기(엔티티가 경작지를 흙으로 되돌림). */
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onTrample(EntityChangeBlockEvent e) { mark(e.getBlock()); }
+
+    /** 물·용암이 흘러 밭을 적시거나 덮는 경우. */
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onFlow(BlockFromToEvent e) { mark(e.getToBlock()); }
+
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onPistonPush(BlockPistonExtendEvent e) {
+        mark(e.getBlock());
+        for (Block b : e.getBlocks()) mark(b);
+    }
+
+    /** 폭발 — ★비교하며 빠뜨렸던 구멍. 크리퍼·TNT가 밭을 날려도 위 이벤트는 안 뜬다. */
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onBlockExplode(org.bukkit.event.block.BlockExplodeEvent e) {
+        for (Block b : e.blockList()) mark(b);
+    }
+
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onEntityExplode(org.bukkit.event.entity.EntityExplodeEvent e) {
+        for (Block b : e.blockList()) mark(b);
+    }
+
+    @EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+    public void onPistonPull(BlockPistonRetractEvent e) {
+        mark(e.getBlock());
+        for (Block b : e.getBlocks()) mark(b);
+    }
+
+    // ===================================================================
+    // 정리 — ★안 하면 샌다
+    // ===================================================================
+    /**
+     * 그 플레이어의 섬 상태를 버린다 — 퀘스트를 끝냈거나 접속을 끊었을 때.
+     *
+     * <p>★<b>퇴장 정리가 없으면 진짜로 샌다.</b> 퀘스트를 켠 채 로그아웃한 사람의 상태가
+     * 영원히 남고, 큰 섬 하나가 400청크 × 두 자료구조라 사람이 갈릴수록 쌓인다.
+     * 게다가 {@link #chunkIndex}가 안 비면 {@link #mark}의 「아무도 안 세는 중」 지름길이
+     * 영원히 안 걸려서 <b>모든 물 흐름이 해시 조회를 계속 낸다.</b>
+     */
+    public void forget(UUID owner) {
+        IslandData isl = islands.getIslandByOwner(owner.toString());
+        if (isl == null) return;
+        State st = byIsland.remove(isl.getId());
+        if (st != null) chunkIndex.keySet().removeAll(st.keys);
+    }
+
+    /** 접속 종료 → 즉시 정리. 다시 들어오면 전수 스캔 한 번으로 재동기화된다. */
+    @EventHandler(priority = EventPriority.MONITOR)
+    public void onQuit(org.bukkit.event.player.PlayerQuitEvent e) { forget(e.getPlayer().getUniqueId()); }
+
+    /** 지금 추적 중인 섬 수 — 진단용. */
+    public int trackedIslands() { return byIsland.size(); }
+
+    /** 색인에 올라 있는 청크 수 — 진단용(누수 감시). */
+    public int indexedChunks() { return chunkIndex.size(); }
+}
