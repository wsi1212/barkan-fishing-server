# =========================================
# 낚시훅_bridge.sk — Phase 2 훅 디스패처 브릿지
# Java(낚시 보상경로)가 catch 후 호출하는 void 훅들을 기존 Skript 함수로 중계.
# 페이로드: "<type>§§<arg1>§§<arg2>..." (공백/색코드 안전). player는 이름→parsed as player.
# 훅 바디는 각자 스크립트(도감.sk/퀘스트훅.sk/도전과제.sk/캐시이펙트.sk/주간랭킹/길드/칭호)에 그대로 유지.
# 콘솔/내부 전용. Java가 fishing.reward.java(또는 grade) 켜졌을 때만 호출 → 현재 휴면.
# =========================================

command /낚시훅 <text>:
    permission: op
    executable by: console
    trigger:
        set {_t::*} to split arg-1 at "§§"
        set {_type} to {_t::1}
        set {_p} to {_t::2} parsed as player
        if {_p} is not set:
            stop
        if {_type} is "dogam":
            # dogam§§player§§grade§§fish
            도감_물고기({_p}, {_t::4}, {_t::3})
        else if {_type} is "quest_fish":
            # quest_fish§§player§§grade§§size§§quality§§fish
            퀘스트_물고기({_p}, {_t::6}, {_t::3}, {_t::4} parsed as number, {_t::5} parsed as number)
        else if {_type} is "quest_sell":
            # quest_sell§§player§§count§§price
            퀘스트_판매({_p}, {_t::3} parsed as integer, {_t::4} parsed as number)
        else if {_type} is "achieve":
            # achieve§§player§§type§§value
            도전과제체크({_p}, {_t::3}, {_t::4})
        else if {_type} is "fx_success":
            # fx_success§§player§§grade
            캐시이펙트_낚시성공({_p}, {_t::3})
        else if {_type} is "fx_brag":
            캐시이펙트_자랑({_p})
        else if {_type} is "weekrank":
            # weekrank§§player§§grade§§size§§fish
            주간랭킹_물고기({_p}, {_t::5}, {_t::3}, {_t::4} parsed as number)
        else if {_type} is "guildpoint":
            # guildpoint§§player§§grade
            길드포인트적립({_p}, {_t::3})
        else if {_type} is "material":
            # material§§player§§area
            조합재료드롭체크({_p}, {_t::3})
        else if {_type} is "sidebar":
            사이드바업데이트({_p})
        else if {_type} is "combotag":
            콤보네임태그({_p})
        else if {_type} is "titlecheck":
            칭호자동체크({_p})
        else if {_type} is "fishrank":
            # fishrank§§player§§rank§§size§§fish
            fishrank({_p}, {_t::5}, {_t::3}, {_t::4})
