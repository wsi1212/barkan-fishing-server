# =========================================
# 부품데이터.sk
# 낚시 장비 부품 데이터 정의
# 데이터 형식: "표시이름|등급|가격|최대내구도|스탯종류:스탯값" (복합: "종류1:값1,종류2:값2")
# 스탯종류: 도망감소, 크리배율, 등급업, 경험치, 크기, 크리확률, 난이도, 더블찬스, 내구보존, 판매보너스
# =========================================

# 부품 정의(137종)는 BlockShip(parts.json) 소유 → /partsync 로
# {부품::*}, {부품유형리스트::*}, {부품목록::*} 자동 세팅됨. 아래 헬퍼 함수가 그대로 파싱.

# ===== 헬퍼 함수 =====

# 부품 등급 반환
function get_part_grade(type: text, name: text) :: text:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    return {_data::2}

# 부품 가격 반환
function get_part_price(type: text, name: text) :: number:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    return {_data::3} parsed as number

# 부품 최대 내구도 반환
function get_part_durability(type: text, name: text) :: number:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    return {_data::4} parsed as number

# 부품 스탯 원본 문자열 반환 ("종류:값" 또는 "종류1:값1,종류2:값2")
function get_part_stats_raw(type: text, name: text) :: text:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    return {_data::5}

# 부품 레벨 제한 반환 (없으면 0 = 제한 없음)
function get_part_level_req(type: text, name: text) :: number:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    if {_data::6} is set:
        set {_lv} to {_data::6} parsed as number
        if {_lv} is set:
            return {_lv}
    return 0

# 부품 출처(지역) 반환 (없으면 "공용")
function get_part_origin(type: text, name: text) :: text:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    if {_data::7} is set:
        if {_data::7} is not "":
            return {_data::7}
    return "공용"

# 등급별 색상 코드
function part_grade_color(grade: text) :: text:
    if {_grade} is "E":
        return "&7"
    else if {_grade} is "D":
        return "&f"
    else if {_grade} is "C":
        return "&a"
    else if {_grade} is "B":
        return "&b"
    else if {_grade} is "A":
        return "&e"
    else if {_grade} is "S":
        return "&6"
    return "&7"

# 스탯 종류 키워드 → 표시명
function stat_type_desc(statType: text) :: text:
    if {_statType} is "도망감소":
        return "도망 확률 감소"
    else if {_statType} is "크리배율":
        return "크리티컬 배율"
    else if {_statType} is "등급업":
        return "등급 업 확률"
    else if {_statType} is "경험치":
        return "경험치 보너스"
    else if {_statType} is "크기":
        return "크기 보너스"
    else if {_statType} is "크리확률":
        return "크리티컬 확률"
    else if {_statType} is "난이도":
        return "낚시 난이도"
    else if {_statType} is "더블찬스":
        return "더블 낚시"
    else if {_statType} is "트리플찬스":
        return "트리플 낚시"
    else if {_statType} is "내구보존":
        return "내구도 보존"
    else if {_statType} is "판매보너스":
        return "판매가 보너스"
    else if {_statType} is "등급특화":
        return "등급 특화"
    else if {_statType} starts with "등급특화:":
        return "등급 특화"
    else if {_statType} is "행운":
        return "행운"
    return ""

# 스탯 표시값 (크리배율은 ×10, 나머지 그대로)
function stat_display_val(statType: text, val: number) :: number:
    if {_statType} is "크리배율":
        return {_val} * 10
    return {_val}

# 스탯 값 표시 텍스트 (난이도는 "-X", 나머지는 "+X%")
function stat_value_text(statType: text, val: number) :: text:
    set {_dv} to stat_display_val({_statType}, {_val})
    if {_statType} is "난이도":
        return "-%{_dv}%"
    if {_statType} is "등급특화":
        return "x2"
    return "+%{_dv}%%%"

# 부품 유형별 기본 스탯 설명 (미장착 시 표시용)
function part_stat_desc(type: text) :: text:
    if {_type} is "낚싯대":
        return "낚시 난이도"
    else if {_type} is "릴":
        return "도망 확률 감소"
    else if {_type} is "줄":
        return "크리티컬 배율"
    else if {_type} is "바늘":
        return "등급 업 확률"
    else if {_type} is "미끼":
        return "경험치 보너스"
    else if {_type} is "찌":
        return "크기 보너스"
    return ""

# 부품 유형별 GUI 아이콘 아이템
function part_icon_item(type: text) :: item:
    if {_type} is "낚싯대":
        return fishing rod
    else if {_type} is "릴":
        return iron nugget
    else if {_type} is "줄":
        return string
    else if {_type} is "바늘":
        return arrow
    else if {_type} is "미끼":
        return slime ball
    else if {_type} is "찌":
        return lily pad
    return paper

# 다음 등급 반환 (등급 상향 재굴림용)
function next_grade(grade: text) :: text:
    if {_grade} is "E":
        return "D"
    else if {_grade} is "D":
        return "C"
    else if {_grade} is "C":
        return "B"
    else if {_grade} is "B":
        return "A"
    else if {_grade} is "A":
        return "S"
    else if {_grade} is "S":
        return "S+"
    else if {_grade} is "S+":
        return "M"
    else if {_grade} is "M":
        return "L"
    else if {_grade} is "L":
        return "G"
    return ""

# 디버그: 부품 데이터 확인
command /부품확인 [<text>] [<text>]:
    permission: op
    trigger:
        if arg-1 is not set:
            message "&e부품 유형: %{부품유형리스트::*}%" to player
            stop
        if arg-2 is not set:
            message "&e%arg-1% 목록: %{부품목록::%arg-1%::*}%" to player
            stop
        if {부품::%arg-1%::%arg-2%} is set:
            set {_d::*} to split {부품::%arg-1%::%arg-2%} at "|"
            message "&e이름: %{_d::1}% | 등급: %{_d::2}% | 가격: %{_d::3}% | 내구도: %{_d::4}% | 스탯: %{_d::5}%" to player
        else:
            message "&c해당 부품이 존재하지 않습니다." to player
