# =========================================
# 부품데이터.sk
# 낚시 장비 부품 데이터 정의
# 데이터 형식: "표시이름|등급|가격|최대내구도|스탯종류:스탯값" (복합: "종류1:값1,종류2:값2")
# 스탯종류: 도망감소, 크리배율, 등급업, 경험치, 크기, 크리확률, 난이도, 더블찬스, 내구보존, 판매보너스
# =========================================

on load:
    # ===== 부품 유형 리스트 =====
    delete {부품유형리스트::*}
    add "낚싯대" to {부품유형리스트::*}
    add "릴" to {부품유형리스트::*}
    add "줄" to {부품유형리스트::*}
    add "바늘" to {부품유형리스트::*}
    add "미끼" to {부품유형리스트::*}
    add "찌" to {부품유형리스트::*}

    # ===== 낚싯대 (본체) — 15종 =====
    delete {부품목록::낚싯대::*}
    set {부품::낚싯대::나뭇가지} to "나뭇가지|E|0|50|난이도:0"
    set {부품::낚싯대::대나무 막대기} to "대나무 막대기|D|500|100|난이도:1"
    set {부품::낚싯대::참나무 낚싯대} to "참나무 낚싯대|C|2000|200|난이도:2"
    set {부품::낚싯대::강화목 낚싯대} to "강화목 낚싯대|B|8000|350|난이도:3"
    set {부품::낚싯대::흑단목 낚싯대} to "흑단목 낚싯대|A|25000|500|난이도:5"
    set {부품::낚싯대::행운의 낚싯대} to "행운의 낚싯대|D|600|90|난이도:1,등급업:3"
    set {부품::낚싯대::경험의 낚싯대} to "경험의 낚싯대|C|2200|180|난이도:1,경험치:15"
    set {부품::낚싯대::낚시꾼의 낚싯대} to "낚시꾼의 낚싯대|C|2500|190|난이도:1,크리확률:4"
    set {부품::낚싯대::대물 낚싯대} to "대물 낚싯대|C|2300|170|난이도:1,크기:6"
    set {부품::낚싯대::쌍둥이 낚싯대} to "쌍둥이 낚싯대|B|8500|300|난이도:2,더블찬스:5"
    set {부품::낚싯대::황금 낚싯대} to "황금 낚싯대|B|9000|280|난이도:2,판매보너스:12"
    set {부품::낚싯대::견고한 낚싯대} to "견고한 낚싯대|B|7500|450|난이도:2,내구보존:18"
    set {부품::낚싯대::전문가 낚싯대} to "전문가 낚싯대|B|10000|320|난이도:2,크리확률:3"
    set {부품::낚싯대::명인의 낚싯대} to "명인의 낚싯대|A|28000|480|난이도:3,등급업:5"
    set {부품::낚싯대::개발자 낚싯대} to "개발자 낚싯대|S|0|99999|난이도:100"
    set {부품::낚싯대::개발자 크리확률} to "개발자 크리확률|S|0|99999|크리확률:100"
    add "나뭇가지" to {부품목록::낚싯대::*}
    add "대나무 막대기" to {부품목록::낚싯대::*}
    add "참나무 낚싯대" to {부품목록::낚싯대::*}
    add "강화목 낚싯대" to {부품목록::낚싯대::*}
    add "흑단목 낚싯대" to {부품목록::낚싯대::*}
    add "행운의 낚싯대" to {부품목록::낚싯대::*}
    add "경험의 낚싯대" to {부품목록::낚싯대::*}
    add "낚시꾼의 낚싯대" to {부품목록::낚싯대::*}
    add "대물 낚싯대" to {부품목록::낚싯대::*}
    add "쌍둥이 낚싯대" to {부품목록::낚싯대::*}
    add "황금 낚싯대" to {부품목록::낚싯대::*}
    add "견고한 낚싯대" to {부품목록::낚싯대::*}
    add "전문가 낚싯대" to {부품목록::낚싯대::*}
    add "명인의 낚싯대" to {부품목록::낚싯대::*}
    add "개발자 낚싯대" to {부품목록::낚싯대::*}
    add "개발자 크리확률" to {부품목록::낚싯대::*}

    # ===== 릴 (15종) =====
    delete {부품목록::릴::*}
    set {부품::릴::녹슨 릴} to "녹슨 릴|E|80|40|도망감소:3"
    set {부품::릴::나무 릴} to "나무 릴|D|400|80|도망감소:8"
