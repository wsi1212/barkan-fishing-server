    set {부품::릴::강화 릴} to "강화 릴|B|6000|250|도망감소:22"
    set {부품::릴::정밀 릴} to "정밀 릴|A|20000|400|도망감소:30"
    set {부품::릴::행운의 릴} to "행운의 릴|D|500|70|등급업:3"
    set {부품::릴::황금 릴} to "황금 릴|C|2000|130|등급업:7"
    set {부품::릴::고속 릴} to "고속 릴|C|1800|120|크리확률:4"
