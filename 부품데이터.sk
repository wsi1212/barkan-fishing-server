    add "새우" to {부품목록::미끼::*}
    add "반딧불이 미끼" to {부품목록::미끼::*}
    add "황금 미끼" to {부품목록::미끼::*}
    add "향기나는 미끼" to {부품목록::미끼::*}
    add "빛나는 미끼" to {부품목록::미끼::*}
    add "살아있는 미끼" to {부품목록::미끼::*}
    add "마법 미끼" to {부품목록::미끼::*}
    add "거대 미끼" to {부품목록::미끼::*}
    add "쌍둥이 미끼" to {부품목록::미끼::*}
    add "금박 미끼" to {부품목록::미끼::*}
    add "연구 미끼" to {부품목록::미끼::*}
    add "전설의 미끼" to {부품목록::미끼::*}
    add "개발자 미끼" to {부품목록::미끼::*}

    # ===== 찌 (15종) =====
    delete {부품목록::찌::*}
    set {부품::찌::나무 찌} to "나무 찌|E|70|30|크기:0"
    set {부품::찌::코르크 찌} to "코르크 찌|D|350|60|크기:3"
    set {부품::찌::가벼운 찌} to "가벼운 찌|C|1400|120|크기:6"
    set {부품::찌::전자 찌} to "전자 찌|B|5500|200|크기:10"
    set {부품::찌::수정 찌} to "수정 찌|A|18000|350|크기:15"
    set {부품::찌::연구용 찌} to "연구용 찌|D|400|55|경험치:8"
    set {부품::찌::학술 찌} to "학술 찌|C|1500|110|경험치:20"
    set {부품::찌::예민한 찌} to "예민한 찌|C|1600|100|난이도:2"
    set {부품::찌::초정밀 찌} to "초정밀 찌|B|6000|180|난이도:3"
    set {부품::찌::행운 찌} to "행운 찌|C|1800|100|등급업:5"
    set {부품::찌::쌍둥이 찌} to "쌍둥이 찌|B|5000|160|더블찬스:5"
    set {부품::찌::금장 찌} to "금장 찌|C|2000|110|판매보너스:10"
    set {부품::찌::학자 수정찌} to "학자 수정찌|A|19000|320|크기:8,경험치:12"
    set {부품::찌::행운 전자찌} to "행운 전자찌|B|7000|190|크기:5,등급업:4"
    set {부품::찌::개발자 찌} to "개발자 찌|S|0|99999|크기:100"
    add "나무 찌" to {부품목록::찌::*}
    add "코르크 찌" to {부품목록::찌::*}
    add "가벼운 찌" to {부품목록::찌::*}
    add "전자 찌" to {부품목록::찌::*}
    add "수정 찌" to {부품목록::찌::*}
    add "연구용 찌" to {부품목록::찌::*}
    add "학술 찌" to {부품목록::찌::*}
    add "예민한 찌" to {부품목록::찌::*}
    add "초정밀 찌" to {부품목록::찌::*}
    add "행운 찌" to {부품목록::찌::*}
    add "쌍둥이 찌" to {부품목록::찌::*}
    add "금장 찌" to {부품목록::찌::*}
    add "학자 수정찌" to {부품목록::찌::*}
    add "행운 전자찌" to {부품목록::찌::*}
    add "개발자 찌" to {부품목록::찌::*}

# ===== 헬퍼 함수 =====

# 부품 등급 반환
function get_part_grade(type: text, name: text) :: text:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    return {_data::2}

# 부품 가격 반환
function get_part_price(type: text, name: text) :: number:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    return {_data::3} parsed as number

# 부품 최대 내구도 반환
function get_part_durability(type: text, name: text) :: number:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    return {_data::4} parsed as number

# 부품 스탯 원본 문자열 반환 ("종류:값" 또는 "종류1:값1,종류2:값2")
function get_part_stats_raw(type: text, name: text) :: text:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    return {_data::5}

# 등급별 색상 코드
function part_grade_color(grade: text) :: text:
    if {_grade} is "E":
        return "&7"
    else if {_grade} is "D":
        return "&f"
    else if {_grade} is "C":
        return "&a"
    else if {_grade} is "B":
        return "&b"
    else if {_grade} is "A":
        return "&e"
    else if {_grade} is "S":
        return "&6"
    return "&7"

# 스탯 종류 키워드 → 표시명
function stat_type_desc(statType: text) :: text:
    if {_statType} is "도망감소":
        return "도망 확률 감소"
    else if {_statType} is "크리배율":
        return "크리티컬 배율"
    else if {_statType} is "등급업":
        return "등급 업 확률"
    else if {_statType} is "경험치":
        return "경험치 보너스"
    else if {_statType} is "크기":
        return "크기 보너스"
    else if {_statType} is "크리확률":
        return "크리티컬 확률"
    else if {_statType} is "난이도":
        return "낚시 난이도"
    else if {_statType} is "더블찬스":
        return "더블 낚시"
    else if {_statType} is "내구보존":
        return "내구도 보존"
    else if {_statType} is "판매보너스":
        return "판매가 보너스"
    return ""

# 스탯 표시값 (크리배율은 ×10, 나머지 그대로)
function stat_display_val(statType: text, val: number) :: number:
    if {_statType} is "크리배율":
        return {_val} * 10
    return {_val}

# 스탯 값 표시 텍스트 (난이도는 "-X", 나머지는 "+X%")
function stat_value_text(statType: text, val: number) :: text:
    set {_dv} to stat_display_val({_statType}, {_val})
    if {_statType} is "난이도":
        return "-%{_dv}%"
    return "+%{_dv}%%%"

# 부품 유형별 기본 스탯 설명 (미장착 시 표시용)
function part_stat_desc(type: text) :: text:
    if {_type} is "낚싯대":
        return "낚시 난이도"
    else if {_type} is "릴":
        return "도망 확률 감소"
    else if {_type} is "줄":
        return "크리티컬 배율"
    else if {_type} is "바늘":
        return "등급 업 확률"
    else if {_type} is "미끼":
        return "경험치 보너스"
    else if {_type} is "찌":
        return "크기 보너스"
    return ""

# 부품 유형별 GUI 아이콘 아이템
function part_icon_item(type: text) :: item:
    if {_type} is "낚싯대":
        return fishing rod
    else if {_type} is "릴":
        return iron nugget
    else if {_type} is "줄":
        return string
    else if {_type} is "바늘":
        return arrow
    else if {_type} is "미끼":
        return slime ball
    else if {_type} is "찌":
        return lily pad
    return paper

# 다음 등급 반환 (등급 상향 재굴림용)
function next_grade(grade: text) :: text:
    if {_grade} is "E":
        return "D"
    else if {_grade} is "D":
        return "C"
    else if {_grade} is "C":
        return "B"
    else if {_grade} is "B":
        return "A"
    else if {_grade} is "A":
        return "S"
    else if {_grade} is "S":
        return "S+"
    else if {_grade} is "S+":
        return "M"
    else if {_grade} is "M":
        return "L"
    else if {_grade} is "L":
        return "G"
    return ""

# 디버그: 부품 데이터 확인
command /부품확인 [<text>] [<text>]:
    permission: op
    trigger:
        if arg-1 is not set:
            message "&e부품 유형: %{부품유형리스트::*}%" to player
            stop
        if arg-2 is not set:
            message "&e%arg-1% 목록: %{부품목록::%arg-1%::*}%" to player
            stop
        if {부품::%arg-1%::%arg-2%} is set:
            set {_d::*} to split {부품::%arg-1%::%arg-2%} at "|"
            message "&e이름: %{_d::1}% | 등급: %{_d::2}% | 가격: %{_d::3}% | 내구도: %{_d::4}% | 스탯: %{_d::5}%" to player
        else:
            message "&c해당 부품이 존재하지 않습니다." to player
