    set {부품::릴::학자의 릴} to "학자의 릴|C|1600|130|경험치:15"
    set {부품::릴::상인의 릴} to "상인의 릴|C|2200|140|판매보너스:12"
    set {부품::릴::견고한 릴} to "견고한 릴|C|1700|200|내구보존:15"
    set {부품::릴::전술 릴} to "전술 릴|B|8000|220|도망감소:12,크리확률:3"
    set {부품::릴::만능 릴} to "만능 릴|A|22000|380|도망감소:15,등급업:5"
    set {부품::릴::개발자 릴} to "개발자 릴|S|0|99999|도망감소:100"
    set {부품::릴::개발자 더블찬스} to "개발자 더블찬스|S|0|99999|더블찬스:100"
    add "녹슨 릴" to {부품목록::릴::*}
    add "나무 릴" to {부품목록::릴::*}
    add "철제 릴" to {부품목록::릴::*}
    add "강화 릴" to {부품목록::릴::*}
    add "정밀 릴" to {부품목록::릴::*}
    add "행운의 릴" to {부품목록::릴::*}
    add "황금 릴" to {부품목록::릴::*}
    add "고속 릴" to {부품목록::릴::*}
    add "전기 릴" to {부품목록::릴::*}
    add "학자의 릴" to {부품목록::릴::*}
    add "상인의 릴" to {부품목록::릴::*}
    add "견고한 릴" to {부품목록::릴::*}
    add "전술 릴" to {부품목록::릴::*}
    add "만능 릴" to {부품목록::릴::*}
    add "개발자 릴" to {부품목록::릴::*}
    add "개발자 더블찬스" to {부품목록::릴::*}

    # ===== 줄 (15종) =====
    delete {부품목록::줄::*}
    set {부품::줄::삼베줄} to "삼베줄|E|60|20|크리배율:1"
    set {부품::줄::면줄} to "면줄|D|300|40|크리배율:2"
