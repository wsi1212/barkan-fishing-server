    set {부품::줄::PE합사줄} to "PE합사줄|A|16000|250|크리배율:5"
    set {부품::줄::강철 와이어} to "강철 와이어|C|1600|100|도망감소:12"
    set {부품::줄::티타늄줄} to "티타늄줄|B|5500|170|도망감소:20"
    set {부품::줄::행운의 실} to "행운의 실|D|400|35|등급업:3"
    set {부품::줄::축복받은 줄} to "축복받은 줄|B|6000|160|등급업:8"
    set {부품::줄::거미줄} to "거미줄|C|1300|90|크기:6"
    set {부품::줄::쌍줄} to "쌍줄|C|2000|100|더블찬스:5"
    set {부품::줄::황금실} to "황금실|B|5000|130|판매보너스:15"
    set {부품::줄::복합줄} to "복합줄|B|7000|160|크리배율:2,도망감소:10"
    set {부품::줄::행운 합사줄} to "행운 합사줄|A|18000|230|크리배율:3,등급업:5"
    set {부품::줄::개발자 줄} to "개발자 줄|S|0|99999|크리배율:100"
    set {부품::줄::개발자 내구보존} to "개발자 내구보존|S|0|99999|내구보존:100"
