    add "면줄" to {부품목록::줄::*}
    add "나일론줄" to {부품목록::줄::*}
    add "카본줄" to {부품목록::줄::*}
    add "PE합사줄" to {부품목록::줄::*}
    add "강철 와이어" to {부품목록::줄::*}
    add "티타늄줄" to {부품목록::줄::*}
    add "행운의 실" to {부품목록::줄::*}
    add "축복받은 줄" to {부품목록::줄::*}
    add "거미줄" to {부품목록::줄::*}
    add "쌍줄" to {부품목록::줄::*}
    add "황금실" to {부품목록::줄::*}
    add "복합줄" to {부품목록::줄::*}
    add "행운 합사줄" to {부품목록::줄::*}
    add "개발자 줄" to {부품목록::줄::*}
    add "개발자 내구보존" to {부품목록::줄::*}

    # ===== 바늘 (15종) =====
    delete {부품목록::바늘::*}
    set {부품::바늘::구부러진 바늘} to "구부러진 바늘|E|50|15|등급업:0"
    set {부품::바늘::철 바늘} to "철 바늘|D|250|30|등급업:3"
