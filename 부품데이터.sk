# =========================================
# 부품데이터.sk — 잔존 헬퍼만
# 부품 정의/스탯/낚싯대 빌더/상점/도감은 Java(PartLoader/EquipmentManager/DexManager) 권위.
# {부품}/{부품목록}/{부품유형리스트} 미러 + get_part_*/stat_* 헬퍼 제거됨.
# part_grade_color 만 유지: 낚시이벤트_bridge.sk(S등급+ 낚시 공지 색상)가 호출.
# =========================================

# 등급별 색상 코드
function part_grade_color(grade: text) :: text:
    if {_grade} is "E":
        return "&7"
    else if {_grade} is "D":
        return "&f"
    else if {_grade} is "C":
        return "&a"
    else if {_grade} is "B":
        return "&b"
    else if {_grade} is "A":
        return "&e"
    else if {_grade} is "S":
        return "&6"
    return "&7"
