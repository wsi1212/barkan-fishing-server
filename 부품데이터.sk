# =========================================
# 부품데이터.sk
# 낚시 장비 부품 데이터 정의
# 데이터 형식: "표시이름|등급|가격|최대내구도|스탯값"
# =========================================

on load:
    # ===== 부품 유형 리스트 =====
    delete {부품유형리스트::*}
    add "낚싯대" to {부품유형리스트::*}
    add "릴" to {부품유형리스트::*}
    add "줄" to {부품유형리스트::*}
    add "바늘" to {부품유형리스트::*}
    add "미끼" to {부품유형리스트::*}
    add "찌" to {부품유형리스트::*}

    # ===== 낚싯대 (본체) — 크리티컬 확률 보너스 =====
    delete {부품목록::낚싯대::*}
    set {부품::낚싯대::나뭇가지} to "나뭇가지|E|100|50|0"
    set {부품::낚싯대::대나무 막대기} to "대나무 막대기|D|500|100|1"
    set {부품::낚싯대::참나무 낚싯대} to "참나무 낚싯대|C|2000|200|2"
    set {부품::낚싯대::강화목 낚싯대} to "강화목 낚싯대|B|8000|350|3"
    set {부품::낚싯대::흑단목 낚싯대} to "흑단목 낚싯대|A|25000|500|5"
    add "나뭇가지" to {부품목록::낚싯대::*}
    add "대나무 막대기" to {부품목록::낚싯대::*}
    add "참나무 낚싯대" to {부품목록::낚싯대::*}
    add "강화목 낚싯대" to {부품목록::낚싯대::*}
    add "흑단목 낚싯대" to {부품목록::낚싯대::*}

    # ===== 릴 — 도망 확률 감소 =====
    delete {부품목록::릴::*}
    set {부품::릴::녹슨 릴} to "녹슨 릴|E|80|40|0"
    set {부품::릴::나무 릴} to "나무 릴|D|400|80|2"
    set {부품::릴::철제 릴} to "철제 릴|C|1500|150|5"
    set {부품::릴::강화 릴} to "강화 릴|B|6000|250|8"
    set {부품::릴::정밀 릴} to "정밀 릴|A|20000|400|12"
    add "녹슨 릴" to {부품목록::릴::*}
    add "나무 릴" to {부품목록::릴::*}
    add "철제 릴" to {부품목록::릴::*}
    add "강화 릴" to {부품목록::릴::*}
    add "정밀 릴" to {부품목록::릴::*}

    # ===== 줄 — 크리티컬 데미지 보너스 =====
    delete {부품목록::줄::*}
    set {부품::줄::삼베줄} to "삼베줄|E|60|20|0"
    set {부품::줄::면줄} to "면줄|D|300|40|1"
    set {부품::줄::나일론줄} to "나일론줄|C|1200|80|2"
    set {부품::줄::카본줄} to "카본줄|B|5000|150|3"
    set {부품::줄::PE합사줄} to "PE합사줄|A|16000|250|5"
    add "삼베줄" to {부품목록::줄::*}
    add "면줄" to {부품목록::줄::*}
    add "나일론줄" to {부품목록::줄::*}
    add "카본줄" to {부품목록::줄::*}
    add "PE합사줄" to {부품목록::줄::*}

    # ===== 바늘 — 등급 재굴림 횟수 =====
    delete {부품목록::바늘::*}
    set {부품::바늘::구부러진 바늘} to "구부러진 바늘|E|50|15|0"
    set {부품::바늘::철 바늘} to "철 바늘|D|250|30|1"
    set {부품::바늘::날카로운 바늘} to "날카로운 바늘|C|1000|60|2"
    set {부품::바늘::미늘 바늘} to "미늘 바늘|B|4000|100|3"
    set {부품::바늘::용뼈 바늘} to "용뼈 바늘|A|15000|180|5"
    add "구부러진 바늘" to {부품목록::바늘::*}
    add "철 바늘" to {부품목록::바늘::*}
    add "날카로운 바늘" to {부품목록::바늘::*}
    add "미늘 바늘" to {부품목록::바늘::*}
    add "용뼈 바늘" to {부품목록::바늘::*}

    # ===== 미끼 — 경험치 보너스 % =====
    delete {부품목록::미끼::*}
    set {부품::미끼::지렁이} to "지렁이|E|5|1|0"
    set {부품::미끼::떡밥} to "떡밥|D|15|3|10"
    set {부품::미끼::새우} to "새우|C|40|5|20"
    set {부품::미끼::반딧불이 미끼} to "반딧불이 미끼|B|100|8|35"
    set {부품::미끼::황금 미끼} to "황금 미끼|A|300|12|50"
    add "지렁이" to {부품목록::미끼::*}
    add "떡밥" to {부품목록::미끼::*}
    add "새우" to {부품목록::미끼::*}
    add "반딧불이 미끼" to {부품목록::미끼::*}
    add "황금 미끼" to {부품목록::미끼::*}

    # ===== 찌 — 크기 보너스 % =====
    delete {부품목록::찌::*}
    set {부품::찌::나무 찌} to "나무 찌|E|70|30|0"
    set {부품::찌::코르크 찌} to "코르크 찌|D|350|60|3"
    set {부품::찌::가벼운 찌} to "가벼운 찌|C|1400|120|6"
    set {부품::찌::전자 찌} to "전자 찌|B|5500|200|10"
    set {부품::찌::수정 찌} to "수정 찌|A|18000|350|15"
    add "나무 찌" to {부품목록::찌::*}
    add "코르크 찌" to {부품목록::찌::*}
    add "가벼운 찌" to {부품목록::찌::*}
    add "전자 찌" to {부품목록::찌::*}
    add "수정 찌" to {부품목록::찌::*}

# ===== 헬퍼 함수 =====

# 부품 등급 반환
function get_part_grade(type: text, name: text) :: text:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    return {_data::2}

# 부품 가격 반환
function get_part_price(type: text, name: text) :: number:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    return {_data::3} parsed as number

# 부품 최대 내구도 반환
function get_part_durability(type: text, name: text) :: number:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    return {_data::4} parsed as number

# 부품 스탯값 반환
function get_part_stat(type: text, name: text) :: number:
    set {_data::*} to split {부품::%{_type}%::%{_name}%} at "|"
    return {_data::5} parsed as number

# 등급별 색상 코드
function part_grade_color(grade: text) :: text:
    if {_grade} is "E":
        return "&7"
    else if {_grade} is "D":
        return "&f"
    else if {_grade} is "C":
        return "&a"
    else if {_grade} is "B":
        return "&b"
    else if {_grade} is "A":
        return "&e"
    else if {_grade} is "S":
        return "&6"
    return "&7"

# 부품 유형별 스탯 설명 텍스트
function part_stat_desc(type: text) :: text:
    if {_type} is "낚싯대":
        return "크리티컬 확률"
    else if {_type} is "릴":
        return "도망 확률 감소"
    else if {_type} is "줄":
        return "크리티컬 데미지"
    else if {_type} is "바늘":
        return "등급 재굴림"
    else if {_type} is "미끼":
        return "경험치 보너스"
    else if {_type} is "찌":
        return "크기 보너스"
    return ""

# 부품 유형별 GUI 아이콘 아이템
function part_icon_item(type: text) :: item:
    if {_type} is "낚싯대":
        return fishing rod
    else if {_type} is "릴":
        return iron nugget
    else if {_type} is "줄":
        return string
    else if {_type} is "바늘":
        return arrow
    else if {_type} is "미끼":
        return slime ball
    else if {_type} is "찌":
        return lily pad
    return paper

# 다음 등급 반환 (등급 상향 재굴림용)
function next_grade(grade: text) :: text:
    if {_grade} is "E":
        return "D"
    else if {_grade} is "D":
        return "C"
    else if {_grade} is "C":
        return "B"
    else if {_grade} is "B":
        return "A"
    else if {_grade} is "A":
        return "S"
    else if {_grade} is "S":
        return "S+"
    else if {_grade} is "S+":
        return "M"
    else if {_grade} is "M":
        return "L"
    else if {_grade} is "L":
        return "G"
    return ""

# 디버그: 부품 데이터 확인
command /부품확인 [<text>] [<text>]:
    permission: op
    trigger:
        if arg-1 is not set:
            message "&e부품 유형: %{부품유형리스트::*}%" to player
            stop
        if arg-2 is not set:
            message "&e%arg-1% 목록: %{부품목록::%arg-1%::*}%" to player
            stop
        if {부품::%arg-1%::%arg-2%} is set:
            set {_d::*} to split {부품::%arg-1%::%arg-2%} at "|"
            message "&e이름: %{_d::1}% | 등급: %{_d::2}% | 가격: %{_d::3}% | 내구도: %{_d::4}% | 스탯: %{_d::5}%" to player
        else:
            message "&c해당 부품이 존재하지 않습니다." to player
