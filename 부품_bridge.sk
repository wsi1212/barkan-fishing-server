# ===========================================================================
# 부품 브릿지 — Java(BlockShip PartLoader) → Skript 변수 동기화 수신
#
# Java가 parts.json(부품 정의)의 권위 소스. /partsync 로
#   {부품::유형::이름}(파이프 구분 데이터), {부품유형리스트::*}, {부품목록::유형::*} 채움.
# 부품데이터.sk의 헬퍼 함수(get_part_*) + 장비/부품상점 GUI가 그대로 사용.
#
# 전송 포맷: /partsync <필드들을 §§로 join>
#   init
#   type§§<유형>
#   set§§<유형>§§<이름>§§<데이터문자열>
# ===========================================================================

command /partsync <text>:
    permission: op
    executable by: console
    trigger:
        set {_p::*} to arg-1 split at "§§"
        set {_sub} to {_p::1}

        if {_sub} is "init":
            delete {부품::*}
            delete {부품유형리스트::*}
            delete {부품목록::*}

        else if {_sub} is "type":
            add {_p::2} to {부품유형리스트::*}

        else if {_sub} is "set":
            set {_type} to {_p::2}
            set {_name} to {_p::3}
            set {부품::%{_type}%::%{_name}%} to {_p::4}
            add {_name} to {부품목록::%{_type}%::*}
