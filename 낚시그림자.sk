# =========================================
# 낚시그림자.sk — Phase 0 그림자 하네스 토글 (op)
# {낚시그림자}=true 일 때만 낚시.sk가 catch 등급 입력/결과를 Java(/fishshadow)로 전송.
# 게임 동작에는 영향 없음(로깅·패리티 검증 전용). 기본 off.
# 누적 통계: /fishshadow stats (Java, op) | CSV: plugins/BlockShip/fishshadow.csv
# =========================================

command /낚시그림자 [<text>]:
    permission: op
    trigger:
        if arg-1 is "on":
            set {낚시그림자} to true
            send "&8[&b 낚시그림자 &8] &a켜짐 — catch마다 /fishshadow 전송" to player
        else if arg-1 is "off":
            delete {낚시그림자}
            send "&8[&b 낚시그림자 &8] &c꺼짐" to player
        else:
            if {낚시그림자} is true:
                send "&8[&b 낚시그림자 &8] &f현재: &aON &7(/낚시그림자 off 로 끄기, /fishshadow stats 로 통계)" to player
            else:
                send "&8[&b 낚시그림자 &8] &f현재: &cOFF &7(/낚시그림자 on 로 켜기)" to player

on tab complete of "/낚시그림자":
    set tab completions for position 1 to "on" and "off"

# Phase 1 컷오버 토글: 켜면 낚시.sk가 등급 결정을 Java(/fishgrade)에 위임.
# ★ 반드시 /낚시그림자 on 으로 분포 패리티(/fishshadow stats) 확인 후에만 켤 것.
command /낚시자바등급 [<text>]:
    permission: op
    trigger:
        if arg-1 is "on":
            set {낚시자바등급} to true
            send "&8[&b 낚시자바등급 &8] &a켜짐 — 등급 결정을 Java가 소유(/fishgrade)" to player
        else if arg-1 is "off":
            delete {낚시자바등급}
            send "&8[&b 낚시자바등급 &8] &c꺼짐 — Skript 인라인 롤로 복귀" to player
        else:
            if {낚시자바등급} is true:
                send "&8[&b 낚시자바등급 &8] &f현재: &aON" to player
            else:
                send "&8[&b 낚시자바등급 &8] &f현재: &cOFF" to player

on tab complete of "/낚시자바등급":
    set tab completions for position 1 to "on" and "off"

# Phase 3 컷오버 토글: 보상 수학(품질/최종크기/경험치)을 Java(/fishreward)에 위임. 더블/트리플·아이템·등급업은 Skript 유지.
command /낚시자바보상 [<text>]:
    permission: op
    trigger:
        if arg-1 is "on":
            set {낚시자바보상} to true
            send "&8[&b 낚시자바보상 &8] &a켜짐 — 품질/크기/경험치 Java 소유" to player
        else if arg-1 is "off":
            delete {낚시자바보상}
            send "&8[&b 낚시자바보상 &8] &c꺼짐" to player
        else:
            if {낚시자바보상} is true:
                send "&8[&b 낚시자바보상 &8] &f현재: &aON" to player
            else:
                send "&8[&b 낚시자바보상 &8] &f현재: &cOFF" to player

on tab complete of "/낚시자바보상":
    set tab completions for position 1 to "on" and "off"

# Phase 4 컷오버 토글: 미니게임 정적 도출(난이도/존폭/도주율/파라미터)을 Java(/fishminigame)에 위임. 틱 루프는 Skript 유지.
command /낚시자바미니 [<text>]:
    permission: op
    trigger:
        if arg-1 is "on":
            set {낚시자바미니} to true
            send "&8[&b 낚시자바미니 &8] &a켜짐 — 미니게임 정적도출 Java 소유(틱 루프는 Skript)" to player
        else if arg-1 is "off":
            delete {낚시자바미니}
            send "&8[&b 낚시자바미니 &8] &c꺼짐" to player
        else:
            if {낚시자바미니} is true:
                send "&8[&b 낚시자바미니 &8] &f현재: &aON" to player
            else:
                send "&8[&b 낚시자바미니 &8] &f현재: &cOFF" to player

on tab complete of "/낚시자바미니":
    set tab completions for position 1 to "on" and "off"

# Phase 4 최종 컷오버 토글: 미니게임 틱 루프 전체를 Java(MinigameManager)에 위임. /fishmgtest 느낌 검증 후에만 켤 것.
command /낚시자바미니틱 [<text>]:
    permission: op
    trigger:
        if arg-1 is "on":
            set {낚시자바미니틱} to true
            send "&8[&b 낚시자바미니틱 &8] &a켜짐 — 미니게임 틱루프 전체를 Java가 실행" to player
        else if arg-1 is "off":
            delete {낚시자바미니틱}
            send "&8[&b 낚시자바미니틱 &8] &c꺼짐 — Skript 틱루프로 복귀" to player
        else:
            if {낚시자바미니틱} is true:
                send "&8[&b 낚시자바미니틱 &8] &f현재: &aON" to player
            else:
                send "&8[&b 낚시자바미니틱 &8] &f현재: &cOFF" to player

on tab complete of "/낚시자바미니틱":
    set tab completions for position 1 to "on" and "off"

# =========================================
# ★ 플래그 데드락 해결 (2026-06-02)
# 문제: FishingConfig.fullJava 등은 Java static이라 재시작/리로드 시 false로 리셋되는데,
#   {낚시자바전체} 등 Skript 미러는 variables.csv에 persist → 재시작마다 어긋나 바닐라 낚시됨.
# 해결: on load(부팅/리로드 시)에 persist된 Skript 플래그 값을 Java로 재동기화(/fishflag).
#   → 매번 수동 재설정 불필요. 마지막 설정이 재시작 후에도 유지됨.
#   ({낚시자바미니틱}은 낚시.sk가 직접 읽는 Skript 전용 플래그라 동기화 불필요 — 자체 persist.)
on load:
    wait 2 seconds
    if {낚시자바전체} is true:
        execute console command "fishflag full on"
    if {낚시그림자} is true:
        execute console command "fishflag shadow on"
    if {낚시자바등급} is true:
        execute console command "fishflag grade on"
    if {낚시자바보상} is true:
        execute console command "fishflag reward on"
    if {낚시자바미니} is true:
        execute console command "fishflag minigame on"
