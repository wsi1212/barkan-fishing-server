# =========================================
# WaterTeleport.sk
# 플레이어가 물 속에 N초 이상 있으면 지정 위치로 텔레포트
# =========================================

options:
    defaultSeconds: 8          # 기본 제한 시간(초)
    postTeleportCooldown: 3    # 텔포 후 재판정 유예(초)
    msg: &b물 속에 너무 오래 있어 강제 이동되었습니다!

# {waterTP::dest}                 = 텔레포트 목적지 location
# {waterTP::limitSeconds}         = 제한 시간(초)
# {waterTP::time::%uuid%}         = 물속 누적 시간(초)
# {waterTP::cooldown::%uuid%}     = 텔포 후 유예(초)

on script load:
    if {waterTP::limitSeconds} is not set:
        set {waterTP::limitSeconds} to {@defaultSeconds}

# 관리자: 목적지 설정
command /watertp [<text>] [<number>]:
    permission: watertp.admin
    permission message: &c권한이 없습니다. (watertp.admin)
    trigger:
        if arg-1 is "setdest":
            set {waterTP::dest} to location of player
            send "&a[WaterTP] 목적지를 현재 위치로 설정했어요." to player
            stop

        if arg-1 is "setseconds":
            if arg-2 is not set:
                send "&c사용법: /watertp setseconds <초>" to player
                stop
            set {waterTP::limitSeconds} to arg-2
            send "&a[WaterTP] 제한 시간을 %arg-2%초로 설정했어요." to player
            stop

        send "&e[WaterTP] 명령어:" to player
        send "&f- /watertp setdest &7: 현재 위치를 목적지로 설정" to player
        send "&f- /watertp setseconds <초> &7: 물속 제한 시간 변경" to player
        send "&f현재 제한 시간: &b%{waterTP::limitSeconds}%초" to player
        if {waterTP::dest} is set:
            send "&f목적지: &b%{waterTP::dest}%" to player
        else:
            send "&f목적지: &c미설정 ( /watertp setdest )" to player

# 플레이어 나가면 변수 정리
on quit:
    delete {waterTP::time::%uuid of player%}
    delete {waterTP::cooldown::%uuid of player%}

every 1 second:
    # 목적지 없으면 아무것도 안 함(오류 방지)
    if {waterTP::dest} is not set:
        stop

    loop all players:
        # 우회 권한(필요하면 사용)
        if loop-player has permission "watertp.bypass":
            delete {waterTP::time::%uuid of loop-player%}
            continue

        # 텔포 직후 유예 처리
        if {waterTP::cooldown::%uuid of loop-player%} is set:
            subtract 1 from {waterTP::cooldown::%uuid of loop-player%}
            if {waterTP::cooldown::%uuid of loop-player%} <= 0:
                delete {waterTP::cooldown::%uuid of loop-player%}
            delete {waterTP::time::%uuid of loop-player%}
            continue

        # --- "물 속" 판정: 눈 위치의 블록이 water 인지 ---
        set {_eye} to eye location of loop-player
        set {_b} to block at {_eye}

        if {_b} is water:
            add 1 to {waterTP::time::%uuid of loop-player%}
        else:
            delete {waterTP::time::%uuid of loop-player%}
            continue

        # 제한 시간 초과 시 텔레포트
        if {waterTP::time::%uuid of loop-player%} >= {waterTP::limitSeconds}:
            teleport loop-player to {waterTP::dest}
            send "{@msg}" to loop-player
            set {waterTP::cooldown::%uuid of loop-player%} to {@postTeleportCooldown}
            delete {waterTP::time::%uuid of loop-player%}