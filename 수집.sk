# ===== 수집 시스템 =====
# 아이템 누적 수집량 추적 (Hypixel Collection 스타일)
# 변수: {수집레벨::%p%}, {수집경험치::%p%}, {수집필요경험치::%p%}
#       {수집카운트::%p%::%itemId%} = 누적 수집량
# 실제 수집 메카닉은 추후 구현

# ===== 수집 헬퍼 함수 =====
# 외부 시스템에서 호출: 수집_추가(player, "아이템ID", 수량)
# 누적 카운트 증가 + 마일스톤 도달 시 수집 XP 지급
#
# 사용 예시:
#   수집_추가(player, "wheat", 1)        — 밀 1개 수집
#   수집_추가(player, "iron_ingot", 5)   — 철괴 5개 수집
#   수집_추가(player, "salmon", 2)       — 연어 2마리 수집
#
# 마일스톤 (누적 카운트 도달 시 XP):
#   50, 100, 250, 500, 1000, 2500, 5000, 10000
function 수집_추가(p: player, itemId: text, amount: number):
    if {수집카운트::%{_p}%::%{_itemId}%} is not set:
        set {수집카운트::%{_p}%::%{_itemId}%} to 0
    set {_before} to {수집카운트::%{_p}%::%{_itemId}%}
    add {_amount} to {수집카운트::%{_p}%::%{_itemId}%}
    set {_after} to {수집카운트::%{_p}%::%{_itemId}%}
    # 마일스톤 체크
    set {_milestones::1} to 50
    set {_milestones::2} to 100
    set {_milestones::3} to 250
    set {_milestones::4} to 500
    set {_milestones::5} to 1000
    set {_milestones::6} to 2500
    set {_milestones::7} to 5000
    set {_milestones::8} to 10000
    set {_xpRewards::1} to 10
    set {_xpRewards::2} to 20
    set {_xpRewards::3} to 40
    set {_xpRewards::4} to 80
    set {_xpRewards::5} to 150
    set {_xpRewards::6} to 300
    set {_xpRewards::7} to 600
    set {_xpRewards::8} to 1200
    loop integers from 1 to 8:
        set {_ms} to {_milestones::%loop-integer%}
        if {_before} < {_ms}:
            if {_after} >= {_ms}:
                set {_xp} to {_xpRewards::%loop-integer%}
                send "&d&l[수집] &f%{_itemId}% &7%{_ms}%개 달성! &7+&d%{_xp}% XP" to {_p}
                play sound "entity.experience_orb.pickup" with volume 0.7 and pitch 1.5 to {_p}
                수집경험치추가({_p}, {_xp})

# ===== 경험치 추가 함수 =====
function 수집경험치추가(p: player, amount: number):
    if {수집레벨::%{_p}%} is not set:
        set {수집레벨::%{_p}%} to 1
        set {수집경험치::%{_p}%} to 0
        set {수집필요경험치::%{_p}%} to 100
    if {수집레벨::%{_p}%} >= 50:
        stop
    add {_amount} to {수집경험치::%{_p}%}
    loop 50 times:
        if {수집경험치::%{_p}%} >= {수집필요경험치::%{_p}%}:
            if {수집레벨::%{_p}%} >= 50:
                set {수집경험치::%{_p}%} to {수집필요경험치::%{_p}%}
                stop loop
            remove {수집필요경험치::%{_p}%} from {수집경험치::%{_p}%}
            set {수집필요경험치::%{_p}%} to floor({수집필요경험치::%{_p}%} * 1.06)
            add 1 to {수집레벨::%{_p}%}
            send title "&d&l레벨 업!" with subtitle "&f수집 Lv.%{수집레벨::%{_p}%}% &7달성!" to {_p} for 2 seconds
            message "&d[수집] &f레벨이 %{수집레벨::%{_p}%}%LV가 되었습니다!" to {_p}
            play sound "entity.player.levelup" with volume 0.8 and pitch 1.5 to {_p}
        else:
            stop loop

# ===== 수집 레벨 로드맵 GUI =====
function 수집레벨GUI(p: player, page: integer):
    set {_lv} to {수집레벨::%{_p}%}
    if {_lv} is not set:
        set {_lv} to 1
    set {_cur} to {수집경험치::%{_p}%}
    if {_cur} is not set:
        set {_cur} to 0
    set {_need} to {수집필요경험치::%{_p}%}
    if {_need} is not set:
        set {_need} to 100
    set {_remain} to {_need} - {_cur}
    if {_remain} < 0:
        set {_remain} to 0
    if {_need} > 0:
        set {_pct} to floor({_cur} * 100 / {_need})
    else:
        set {_pct} to 0
    set {_perPage} to 29
    set {_startLv} to ({_page} - 1) * {_perPage} + 1
    set {_endLv} to {_page} * {_perPage}
    if {_endLv} > 50:
        set {_endLv} to 50
    open chest inventory with 6 rows named "&0수집 로드맵 (Lv.%{_startLv}%~%{_endLv}%)" to {_p}
    set {수집GUI페이지::%{_p}%} to {_page}
    delete {_path::*}
    loop integers from 0 to 8:
        set {_path::%loop-integer + 1%} to 9 + loop-integer
    set {_path::10} to 26
    loop integers from 0 to 8:
        set {_path::%11 + loop-integer%} to 35 - loop-integer
    set {_path::20} to 36
    loop integers from 0 to 8:
        set {_path::%21 + loop-integer%} to 45 + loop-integer
    loop integers from 0 to 53:
        set slot loop-integer of {_p}'s current inventory to black stained glass pane named "&f"
    set slot 1 of {_p}'s current inventory to arrow named "&7◀ 스킬 선택"
    set {_head} to skull of {_p}
    set {_filled} to 0
    if {_need} > 0:
        set {_filled} to floor({_cur} * 50 / {_need})
    if {_filled} > 50:
        set {_filled} to 50
    set {_bar} to ""
    loop 50 times:
        if loop-iteration <= {_filled}:
            set {_bar} to "%{_bar}%&d|"
        else:
            set {_bar} to "%{_bar}%&8|"
    set slot 4 of {_p}'s current inventory to {_head} named "&d&l수집 Lv.%{_lv}% &7%{_p}'s name%" with lore "&7경험치: &d%{_cur}%&7/&f%{_need}%" and "&8[%{_bar}%&8] &d%{_pct}%%%" and "&7남은 경험치: &e%{_remain}%"
    if {_page} > 1:
        set {_prevStart} to ({_page} - 2) * {_perPage} + 1
        set {_prevEnd} to ({_page} - 1) * {_perPage}
        set slot 0 of {_p}'s current inventory to arrow named "&c◀ 이전 페이지" with lore "&7Lv.%{_prevStart}%~%{_prevEnd}%"
    if {_endLv} < 50:
        set {_nextStart} to {_page} * {_perPage} + 1
        set {_nextEnd} to ({_page} + 1) * {_perPage}
        if {_nextEnd} > 50:
            set {_nextEnd} to 50
        set slot 8 of {_p}'s current inventory to arrow named "&a다음 페이지 ▶" with lore "&7Lv.%{_nextStart}%~%{_nextEnd}%"
    loop integers from 1 to 29:
        set {_idx} to loop-integer
        set {_lvNum} to {_startLv} + {_idx} - 1
        if {_lvNum} > 50:
            stop loop
        set {_slot} to {_path::%{_idx}%}
        if {_slot} is not set:
            stop loop
        set {_reward} to ""
        set {_iconType} to "normal"
        if mod({_lvNum}, 5) is 0:
            set {_iconType} to "milestone"
        # === 티어 해금 ===
        if {_lvNum} is 11:
            set {_reward} to "&e&l수집 도감 슬롯 +10"
            set {_iconType} to "unlock"
        else if {_lvNum} is 21:
            set {_reward} to "&6&l수집 도감 슬롯 +20"
            set {_iconType} to "unlock"
        else if {_lvNum} is 31:
            set {_reward} to "&b&l수집 보너스 +50%%"
            set {_iconType} to "unlock"
        else if {_lvNum} is 41:
            set {_reward} to "&d&l전설 수집품 해금"
            set {_iconType} to "unlock"
        else if {_lvNum} is 50:
            set {_reward} to "&6&l만렙! 수집 마스터"
            set {_iconType} to "max"
        # === 마일스톤 보상 ===
        else if {_lvNum} is 5:
            set {_reward} to "&d수집 카운트 보너스 증가"
        else if {_lvNum} is 10:
            set {_reward} to "&d희귀 수집품 확률 상승"
        else if {_lvNum} is 15:
            set {_reward} to "&d수집 카운트 보너스 증가"
        else if {_lvNum} is 20:
            set {_reward} to "&d희귀 수집품 확률 상승"
        else if {_lvNum} is 25:
            set {_reward} to "&d더블 수집 확률 상승"
        else if {_lvNum} is 30:
            set {_reward} to "&d수집 카운트 보너스 증가"
        else if {_lvNum} is 35:
            set {_reward} to "&d희귀 수집품 확률 상승"
        else if {_lvNum} is 40:
            set {_reward} to "&d트리플 수집 확률 상승"
        else if {_lvNum} is 45:
            set {_reward} to "&d전설 수집품 확률 상승"
        # === 돈 보상 ===
        else if {_lvNum} is 3:
            set {_reward} to "&f보상: 300원"
            set {_iconType} to "chest"
        else if {_lvNum} is 7:
            set {_reward} to "&f보상: 700원"
            set {_iconType} to "chest"
        else if {_lvNum} is 13:
            set {_reward} to "&f보상: 1,500원"
            set {_iconType} to "chest"
        else if {_lvNum} is 17:
            set {_reward} to "&f보상: 2,500원"
            set {_iconType} to "chest"
        else if {_lvNum} is 23:
            set {_reward} to "&e보상: 4,000원"
            set {_iconType} to "chest"
        else if {_lvNum} is 27:
            set {_reward} to "&e보상: 6,000원"
            set {_iconType} to "chest"
        else if {_lvNum} is 33:
            set {_reward} to "&6보상: 10,000원"
            set {_iconType} to "echest"
        else if {_lvNum} is 37:
            set {_reward} to "&6보상: 15,000원"
            set {_iconType} to "echest"
        else if {_lvNum} is 43:
            set {_reward} to "&d보상: 25,000원"
            set {_iconType} to "shulker"
        else if {_lvNum} is 47:
            set {_reward} to "&d보상: 40,000원"
            set {_iconType} to "shulker"
        # 아이콘 결정
        if {_lvNum} is {_lv}:
            set {_icon} to experience bottle named "&d&l◆ Lv.%{_lvNum}% &7(현재)" with lore "&7경험치: &d%{_cur}%&7/&f%{_need}%" and "&8[%{_bar}%&8] &d%{_pct}%%%" and "&7남은 경험치: &e%{_remain}%"
        else if {_lvNum} < {_lv}:
            if {_iconType} is "unlock":
                set {_icon} to nether star named "&a✓ Lv.%{_lvNum}%" with lore "&a달성 완료" and "%{_reward}%"
            else if {_iconType} is "chest" or "echest" or "shulker":
                set {_icon} to lime stained glass pane named "&a✓ Lv.%{_lvNum}%" with lore "&a수령 완료" and "%{_reward}%"
            else if {_reward} is not "":
                set {_icon} to lime stained glass pane named "&a✓ Lv.%{_lvNum}%" with lore "&a달성 완료" and "%{_reward}%"
            else:
                set {_icon} to lime stained glass pane named "&a✓ Lv.%{_lvNum}%"
        else:
            if {_iconType} is "unlock":
                set {_icon} to nether star named "&e★ Lv.%{_lvNum}%" with lore "&7수집 티어 해금" and "%{_reward}%"
            else if {_iconType} is "max":
                set {_icon} to nether star named "&6&l★ Lv.50 만렙" with lore "%{_reward}%"
            else if {_iconType} is "milestone":
                set {_icon} to gold nugget named "&e☆ Lv.%{_lvNum}%" with lore "&7마일스톤 보상" and "%{_reward}%"
            else if {_iconType} is "chest":
                set {_icon} to chest named "&f Lv.%{_lvNum}%" with lore "&7레벨업 보상" and "%{_reward}%"
            else if {_iconType} is "echest":
                set {_icon} to ender chest named "&6 Lv.%{_lvNum}%" with lore "&6특별 레벨업 보상" and "%{_reward}%"
            else if {_iconType} is "shulker":
                set {_icon} to purple shulker box named "&d Lv.%{_lvNum}%" with lore "&d전설 레벨업 보상" and "%{_reward}%"
            else:
                set {_icon} to white stained glass pane named "&fLv.%{_lvNum}%"
        set slot {_slot} of {_p}'s current inventory to {_icon}

on inventory click:
    if player's current inventory's name contains "&0수집 로드맵":
        cancel event
        if event-item is arrow:
            set {_ci} to index of clicked slot
            set {_page} to {수집GUI페이지::%player%}
            if {_page} is not set:
                set {_page} to 1
            if {_ci} is 8:
                wait 1 tick
                수집레벨GUI(player, {_page} + 1)
            else if {_ci} is 0:
                if {_page} > 1:
                    wait 1 tick
                    수집레벨GUI(player, {_page} - 1)
            else if {_ci} is 1:
                wait 1 tick
                레벨선택GUI(player)

on join:
    if {수집레벨::%player%} is not set:
        set {수집레벨::%player%} to 1
        set {수집경험치::%player%} to 0
        set {수집필요경험치::%player%} to 100

on tab complete of "/수집레벨":
    stop

command /수집레벨:
    aliases: /tnwlqfpqpf
    trigger:
        수집레벨GUI(player, 1)
