# =========================================
# 데이터백업.sk
# Java PlayerDataManager ↔ Skript 브릿지
# 5분마다 핵심 변수를 Java JSON으로 백업
# 서버 재시작 시 CSV 유실되면 JSON에서 복원
# =========================================

# ===== 백업 트리거 (Java에서 5분마다 호출) =====
command /pdtriggerbackup <text>:
    permission: op
    executable by: console
    trigger:
        loop all players:
            if name of loop-player is arg-1:
                플레이어데이터백업(loop-player)
                stop

# ===== 퇴장 시 즉시 백업 =====
on quit:
    플레이어데이터백업(player)

# ===== JSON 백필 (전체 플레이어 데이터 → JSON, 오프라인 포함) =====
# 돈 데이터가 있는 모든 UUID를 순회하며 PlayerData JSON 생성/갱신.
# CSV→JSON 추가 작성만 (삭제 없음) → 안전. CSV 제외 전 커버리지 100% 확보용.
command /pd백필:
    permission: op
    executable by: console and players
    trigger:
        set {_cnt} to 0
        loop {돈::*}:
            # UUID→이름은 Java(pdbackfilone)가 해석 후 pdbackupname으로 되돌려 백업 실행
            execute console command "pdbackfilone %loop-index%"
            add 1 to {_cnt}
        send "&8[&ePD&8] &a백필 트리거 완료: &f%{_cnt}%개 UUID &7(Java가 이름해석+백업)" to sender

# 이름 기반 백업 (Java pdbackfilone이 UUID→이름 해석 후 호출) — 오프라인 플레이어 백필용
command /pdbackupname <text>:
    permission: op
    executable by: console
    trigger:
        set {_op} to arg-1 parsed as offline player
        if {_op} is set:
            플레이어데이터백업({_op})

# ===== 메인 백업 함수 (오프라인 플레이어도 허용 — 백필용) =====
function 플레이어데이터백업(p: offline player):
    set {_n} to name of {_p}
    if {_n} is not set:
        stop

    # ★ 안전 가드 (돈/레벨 Java 권위 이관): 돈이 아직 복원 전(미설정)이면 백업 스킵.
    #   CSV 메모리-only 전환 시, 접속 직후 복원 전에 백업이 돌면 빈 {돈}=0을 보내 JSON을 0으로
    #   덮어쓰는 치명적 레이스가 생김 → {돈} 미설정이면 아예 백업하지 않음(데이터 보존).
    #   (신규 플레이어는 on first join에서 {돈}=0이 set되므로 정상 백업됨)
    if {돈::%{_p}%} is not set:
        stop

    # --- Economy ---
    set {_money} to {돈::%{_p}%}
    if {_money} is not set:
        set {_money} to 0
    set {_cash} to {캐시::%{_p}%}
    if {_cash} is not set:
        set {_cash} to 0
    set {_coins} to {추천코인::%{_p}%}
    if {_coins} is not set:
        set {_coins} to 0
    execute console command "pdbackup %{_n}% economy %{_money}% %{_cash}% %{_coins}%"

    # --- Level ---
    set {_lv} to {낚시레벨::%{_p}%}
    if {_lv} is not set:
        set {_lv} to 1
    set {_cur} to {낚시레벨현재경험치::%{_p}%}
    if {_cur} is not set:
        set {_cur} to 0
    set {_req} to {낚시레벨필요경험치::%{_p}%}
    if {_req} is not set:
        set {_req} to 200
    execute console command "pdbackup %{_n}% level %{_lv}% %{_cur}% %{_req}%"

    # --- Combo ---
    set {_combo} to {낚시콤보::%{_p}%}
    if {_combo} is not set:
        set {_combo} to 0
    set {_maxCombo} to {낚시최대콤보::%{_p}%}
    if {_maxCombo} is not set:
        set {_maxCombo} to 0
    execute console command "pdbackup %{_n}% combo %{_combo}% %{_maxCombo}%"

    # --- Equipment (5 slots) ---
    loop "릴", "줄", "바늘", "미끼", "찌":
        set {_partName} to {낚싯대부품::%loop-value%::%{_p}%}
        set {_dur} to {부품내구도::%loop-value%::%{_p}%}
        if {_partName} is not set:
            set {_partName} to "없음"
        else:
            replace all " " with "_" in {_partName}
        if {_dur} is not set:
            set {_dur} to 0
        execute console command "pdbackup %{_n}% equip %loop-value% %{_partName}% %{_dur}%"

    # --- Part Inventory (릴/줄/바늘/찌/낚싯대 — 리스트) ---
    loop "릴", "줄", "바늘", "찌", "낚싯대":
        set {_list} to ""
        loop {부품인벤::%loop-value-1%::%{_p}%::*}:
            set {_item} to loop-value-2
            replace all " " with "_" in {_item}
            if {_list} is "":
                set {_list} to {_item}
            else:
                set {_list} to "%{_list}%||%{_item}%"
        if {_list} is "":
            set {_list} to "없음"
        set {_slotName} to loop-value-1
        replace all " " with "_" in {_slotName}
        execute console command "pdbackup %{_n}% partinv %{_slotName}% %{_list}%"

    # --- Bait Inventory ---
    set {_baitList} to ""
    loop {부품인벤::미끼::%{_p}%::*}:
        set {_cnt} to loop-value
        if {_cnt} is set:
            if {_cnt} > 0:
                set {_baitName} to loop-index
                replace all " " with "_" in {_baitName}
                if {_baitList} is "":
                    set {_baitList} to "%{_baitName}%::%{_cnt}%"
                else:
                    set {_baitList} to "%{_baitList}%||%{_baitName}%::%{_cnt}%"
    if {_baitList} is "":
        set {_baitList} to "없음"
    execute console command "pdbackup %{_n}% baitinv %{_baitList}%"

    # --- Rod Enhancements / Blessings ---
    # ★ 낚싯대강화.sk → Java(Enhance/BlessingManager) 이관: 강화=rodenhance-rid.json(RID 권위),
    #   축복=PlayerData.blessings 권위. Java 단독 write + push-back(restore). backup 제거(클로버 차단).

    # --- Title ---
    set {_title} to {장착칭호::%{_p}%}
    if {_title} is not set:
        set {_title} to "없음"
    else:
        replace all " " with "_" in {_title}
    # ★ 수정: 실제 보유칭호 키 순회(레지스트리 비의존). 키 순서 = 보유칭호::UUID::TITLE (게임 데이터와 일치).
    #   기존엔 {칭호데이터::*}를 돌며 {보유칭호::TITLE::UUID}(잘못된 순서)를 확인해 항상 빈값이었음.
    set {_ownedTitles} to ""
    loop {보유칭호::%{_p}%::*}:
        set {_tname} to loop-index
        replace all " " with "_" in {_tname}
        if {_ownedTitles} is "":
            set {_ownedTitles} to {_tname}
        else:
            set {_ownedTitles} to "%{_ownedTitles}%||%{_tname}%"
    if {_ownedTitles} is "":
        set {_ownedTitles} to "없음"
    execute console command "pdbackup %{_n}% title %{_title}% %{_ownedTitles}%"

    # --- Quests: 활성 목록 ---
    set {_activeStr} to ""
    loop {활성퀘스트::%{_p}%::*}:
        if {_activeStr} is "":
            set {_activeStr} to loop-value
        else:
            set {_activeStr} to "%{_activeStr}%||%loop-value%"
    if {_activeStr} is "":
        set {_activeStr} to "없음"
    execute console command "pdbackup %{_n}% activequests %{_activeStr}%"

    # --- Quests: 모든 퀘스트 상태/진행도 (★ 활성뿐 아니라 완료/메인/튜토 전부 백업) ---
    #   기존엔 활성 퀘스트만 백업해 메인·튜토 완료상태가 복원 시 유실됐음.
    loop {퀘스트상태::*}:
        set {_qid} to loop-index
        set {_qs} to {퀘스트상태::%{_qid}%::%{_p}%}
        if {_qs} is set:
            set {_prog} to ""
            loop integers from 1 to 10:
                set {_val} to {퀘스트진행::%{_qid}%::%{_p}%::%loop-integer%}
                if {_val} is set:
                    if {_prog} is "":
                        set {_prog} to "%loop-integer%::%{_val}%"
                    else:
                        set {_prog} to "%{_prog}%||%loop-integer%::%{_val}%"
            if {_prog} is "":
                set {_prog} to "없음"
            execute console command "pdbackup %{_n}% quest %{_qid}% %{_qs}% %{_prog}%"

    # 주간 퀘스트
    set {_weeklyStr} to ""
    loop {주간퀘스트::%{_p}%::*}:
        if {_weeklyStr} is "":
            set {_weeklyStr} to loop-value
        else:
            set {_weeklyStr} to "%{_weeklyStr}%||%loop-value%"
    if {_weeklyStr} is "":
        set {_weeklyStr} to "없음"
    execute console command "pdbackup %{_n}% weeklyquests %{_weeklyStr}%"

    # --- Ice Box ---
    set {_ibTier} to {아이스박스등급::%{_p}%}
    if {_ibTier} is not set:
        set {_ibTier} to 0
    set {_ibTimer} to {아이스박스시간::%{_p}%}
    if {_ibTimer} is not set:
        set {_ibTimer} to 0
    execute console command "pdbackup %{_n}% icebox %{_ibTier}% %{_ibTimer}%"

    # --- Achievements ---
    set {_achList} to ""
    loop {도전과제목록::*}:
        if {도전과제달성::%loop-value%::%{_p}%} is set:
            if {_achList} is "":
                set {_achList} to loop-value
            else:
                set {_achList} to "%{_achList}%||%loop-value%"
    if {_achList} is "":
        set {_achList} to "없음"
    execute console command "pdbackup %{_n}% achievement %{_achList}%"

    # --- Grade Pity ---
    # ★ 수정: 실제 등급피티 키 순회(고정 등급목록 비의존 → 실제 저장키 d/sp 등 보존).
    set {_pityList} to ""
    loop {등급피티::%{_p}%::*}:
        set {_pv} to loop-value
        if {_pv} > 0:
            if {_pityList} is "":
                set {_pityList} to "%loop-index%::%{_pv}%"
            else:
                set {_pityList} to "%{_pityList}%||%loop-index%::%{_pv}%"
    if {_pityList} is "":
        set {_pityList} to "없음"
    execute console command "pdbackup %{_n}% pity %{_pityList}%"

    # --- Visited Regions ---
    set {_regions} to ""
    loop {방문지역::%{_p}%::*}:
        if {_regions} is "":
            set {_regions} to loop-value
        else:
            set {_regions} to "%{_regions}%||%loop-value%"
    if {_regions} is "":
        set {_regions} to "없음"
    execute console command "pdbackup %{_n}% visitedregions %{_regions}%"

    # --- Fish Records ({도감최대::*} 인덱스로 순회 — 레지스트리 비의존, 삭제된 물고기 기록도 보존) ---
    loop {도감최대::*}:
        set {_fname} to loop-index
        set {_fmax} to {도감최대::%{_fname}%::%{_p}%}
        if {_fmax} is set:
            set {_ffirst} to {처음낚은날짜::%{_fname}%::%{_p}%}
            set {_fmaxd} to {최대낚은날짜::%{_fname}%::%{_p}%}
            if {_ffirst} is not set:
                set {_ffirst} to "없음"
            if {_fmaxd} is not set:
                set {_fmaxd} to "없음"
            set {_fnameClean} to {_fname}
            replace all " " with "_" in {_fnameClean}
            execute console command "pdbackup %{_n}% fishrecord %{_fnameClean}% %{_fmax}% %{_ffirst}% %{_fmaxd}%"

    # --- Phase D 배치1: 확장 스칼라 (스킬레벨/통계/접속/마이그레이션/강화스탯) ---
    # ★ 채굴/재배/요리/수집/탐험 prefix(XX레벨/경험치/필요경험치)는 Java SkillManager 권위로 이관됨 → backup 제거(클로버 차단).
    #   Java가 단독 write(PlayerData.extraNums) + push-back(pdrestoreex). 채집은 .sk 미이관이라 Skript 유지.
    # ★ 낚싯대강화*/낚싯대인챈트* 캐시변수 제거 — Java(Enhance/BlessingManager)가 강화레벨/축복레벨에서
    #   파생 계산해 pdrestoreex로 push-back. Skript는 더 이상 권위 아님 → backup 제거(클로버 차단).
    loop "채집레벨", "채집경험치", "채집필요경험치", "총낚시", "총조합", "총판매", "접속일수", "주간접속일수", "주간일퀘완료수", "용암낚시", "칭호마지막레벨", "송금일일한도":
        set {_sv} to {%loop-value%::%{_p}%}
        if {_sv} is set:
            execute console command "pdbackup %{_n}% exnum %loop-value% %{_sv}%"
    loop "낚시이름", "마지막접속날짜", "주간접속날짜", "일일퀘스트날짜", "주간퀘스트주차":
        set {_sv} to {%loop-value%::%{_p}%}
        if {_sv} is set:
            execute console command "pdbackup %{_n}% exstr %loop-value% %{_sv}%"
    loop "마이그레이션완료", "도감마이그레이션", "도감해금", "도감g등급":
        if {%loop-value%::%{_p}%} is true:
            execute console command "pdbackup %{_n}% exbool %loop-value%"

    # --- Phase D 배치3: 플래그맵(uuid::key=bool) — 정적prefix 단일루프(bare loop-index) ---
    set {_fl} to ""
    loop {레시피해금::%{_p}%::*}:
        if loop-value is true:
            set {_fl} to "%{_fl}%||%loop-index%"
    if {_fl} is not "":
        execute console command "pdbackup %{_n}% exflag 레시피해금 %{_fl}%"
    set {_fl} to ""
    loop {등급해금::%{_p}%::*}:
        if loop-value is true:
            set {_fl} to "%{_fl}%||%loop-index%"
    if {_fl} is not "":
        execute console command "pdbackup %{_n}% exflag 등급해금 %{_fl}%"
    set {_fl} to ""
    loop {캐시외형::%{_p}%::*}:
        if loop-value is true:
            set {_fl} to "%{_fl}%||%loop-index%"
    if {_fl} is not "":
        execute console command "pdbackup %{_n}% exflag 캐시외형 %{_fl}%"
    # 수집품발견/수집품마일스톤 backup 제거 — Java(CollectibleManager)가 PlayerData.extraFlags 단독 권위.
    #   stale Skript값으로 덮어쓰면 클로버(split-brain) → backup 안 함. 복원/실시간 push-back은 유지.

    # --- Phase D 배치3: 인덱스 리스트(낚싯대수집, uuid::N=str, 값 _인코딩) ---
    set {_ls} to ""
    loop {낚싯대수집::%{_p}%::*}:
        set {_iv} to loop-value
        replace all " " with "_" in {_iv}
        if {_ls} is "":
            set {_ls} to {_iv}
        else:
            set {_ls} to "%{_ls}%||%{_iv}%"
    if {_ls} is not "":
        execute console command "pdbackup %{_n}% exlist 낚싯대수집 %{_ls}%"

    # --- Phase D 배치4: 중첩 도감발견(cat::uuid::item) / 탐험발견(uuid::cat::idx) ---
    #   카테고리는 고정 게임상수 → 명시 호출(상위 와일드카드 {도감발견::*} 회피, 헬퍼=단일루프).
    #   ※ 도감 카테고리 추가 시 아래 목록 갱신.
    loop "낚싯대", "물고기", "부품", "재료", "지역":
        pd백업도감발견({_p}, {_n}, loop-value)
    pd백업탐험발견({_p}, {_n}, "지역")

    # --- Done signal ---
    execute console command "pdbackup %{_n}% done"


# =========================================
# ===== 복원 명령어 (Java → Skript) =====
# =========================================

command /pdrestore <text> <text> [<text>] [<text>] [<text>]:
    permission: op
    executable by: console
    trigger:
        set {_p} to arg-1 parsed as player
        if {_p} is not set:
            stop
        if arg-2 is "economy":
            set {돈::%{_p}%} to arg-3 parsed as number
            set {캐시::%{_p}%} to arg-4 parsed as number
            set {추천코인::%{_p}%} to arg-5 parsed as number
            사이드바업데이트({_p})
        else if arg-2 is "level":
            set {낚시레벨::%{_p}%} to arg-3 parsed as number
            set {낚시레벨현재경험치::%{_p}%} to arg-4 parsed as number
            set {낚시레벨필요경험치::%{_p}%} to arg-5 parsed as number
            사이드바업데이트({_p})
        else if arg-2 is "combo":
            set {낚시콤보::%{_p}%} to arg-3 parsed as number
            set {낚시최대콤보::%{_p}%} to arg-4 parsed as number
        else if arg-2 is "equip":
            # arg-3=slot, arg-4=partName, arg-5=durability
            set {_partName} to arg-4
            replace all "_" with " " in {_partName}
            if {_partName} is "없음":
                delete {낚싯대부품::%arg-3%::%{_p}%}
                delete {부품내구도::%arg-3%::%{_p}%}
            else:
                set {낚싯대부품::%arg-3%::%{_p}%} to {_partName}
                set {부품내구도::%arg-3%::%{_p}%} to arg-5 parsed as number
        else if arg-2 is "icebox":
            set {아이스박스등급::%{_p}%} to arg-3 parsed as number
            set {아이스박스시간::%{_p}%} to arg-4 parsed as number

# 확장 복원 (단일 데이터 인자)
command /pdrestoreex <text> <text> <text>:
    permission: op
    executable by: console
    trigger:
        set {_p} to arg-1 parsed as player
        if {_p} is not set:
            stop
        if arg-2 is "partinv":
            # arg-3 = "slot||name1||name2||..."
            set {_parts::*} to split arg-3 at "||"
            set {_slot} to {_parts::1}
            replace all "_" with " " in {_slot}
            delete {부품인벤::%{_slot}%::%{_p}%::*}
            set {_idx} to 0
            loop {_parts::*}:
                add 1 to {_idx}
                if {_idx} > 1:
                    if loop-value is not "없음":
                        set {_itemName} to loop-value
                        replace all "_" with " " in {_itemName}
                        add {_itemName} to {부품인벤::%{_slot}%::%{_p}%::*}
        else if arg-2 is "baitinv":
            # arg-3 = "name::count||name::count||..."
            if arg-3 is not "없음":
                set {_pairs::*} to split arg-3 at "||"
                loop {_pairs::*}:
                    set {_kv::*} to split loop-value at "::"
                    set {_baitName} to {_kv::1}
                    replace all "_" with " " in {_baitName}
                    set {부품인벤::미끼::%{_p}%::%{_baitName}%} to {_kv::2} parsed as number
        else if arg-2 is "rodenhance":
            # arg-3 = "rodName::level"
            set {_kv::*} to split arg-3 at "::"
            set {_rodName} to {_kv::1}
            replace all "_" with " " in {_rodName}
            set {낚싯대강화::%{_rodName}%::%{_p}%} to {_kv::2} parsed as number
        else if arg-2 is "blessing":
            # arg-3 = "id::level"
            set {_kv::*} to split arg-3 at "::"
            set {플레이어축복::%{_kv::1}%::%{_p}%} to {_kv::2} parsed as number
            # 인챈트 캐시 push는 Java BlessingManager(blessingrefresh/onJoin)가 담당
        else if arg-2 is "title":
            # arg-3 = "equipped||owned1||owned2||..."
            set {_parts::*} to split arg-3 at "||"
            set {_equipped} to {_parts::1}
            replace all "_" with " " in {_equipped}
            if {_equipped} is "없음":
                delete {장착칭호::%{_p}%}
            else:
                set {장착칭호::%{_p}%} to {_equipped}
            set {_idx} to 0
            loop {_parts::*}:
                add 1 to {_idx}
                if {_idx} > 1:
                    if loop-value is not "없음":
                        set {_tname} to loop-value
                        replace all "_" with " " in {_tname}
                        # ★ 수정: UUID::TITLE 순서 (게임 데이터와 일치). 기존 TITLE::UUID는 게임이 못 읽었음.
                        set {보유칭호::%{_p}%::%{_tname}%} to true
        else if arg-2 is "quest":
            # arg-3 = "questId::status::obj1Idx::val||obj2Idx::val"
            set {_parts::*} to split arg-3 at "::"
            if size of {_parts::*} >= 2:
                set {_qid} to {_parts::1}
                set {_status} to {_parts::2}
                set {퀘스트상태::%{_qid}%::%{_p}%} to {_status}
                # 진행도 파싱 (3번째 부분부터)
                if size of {_parts::*} >= 3:
                    set {_progStr} to {_parts::3}
                    if {_progStr} is not "없음":
                        set {_progPairs::*} to split {_progStr} at "||"
                        loop {_progPairs::*}:
                            set {_pkv::*} to split loop-value at "::"
                            if size of {_pkv::*} >= 2:
                                set {퀘스트진행::%{_qid}%::%{_p}%::%{_pkv::1}%} to {_pkv::2} parsed as number
        else if arg-2 is "activequests":
            delete {활성퀘스트::%{_p}%::*}
            if arg-3 is not "없음":
                set {_qs::*} to split arg-3 at "||"
                loop {_qs::*}:
                    add loop-value to {활성퀘스트::%{_p}%::*}
        else if arg-2 is "weeklyquests":
            delete {주간퀘스트::%{_p}%::*}
            if arg-3 is not "없음":
                set {_qs::*} to split arg-3 at "||"
                loop {_qs::*}:
                    add loop-value to {주간퀘스트::%{_p}%::*}
        else if arg-2 is "achievement":
            if arg-3 is not "없음":
                set {_achs::*} to split arg-3 at "||"
                loop {_achs::*}:
                    set {도전과제달성::%loop-value%::%{_p}%} to true
        else if arg-2 is "pity":
            if arg-3 is not "없음":
                set {_pairs::*} to split arg-3 at "||"
                loop {_pairs::*}:
                    set {_kv::*} to split loop-value at "::"
                    if size of {_kv::*} >= 2:
                        set {등급피티::%{_p}%::%{_kv::1}%} to {_kv::2} parsed as number
        else if arg-2 is "visitedregions":
            delete {방문지역::%{_p}%::*}
            if arg-3 is not "없음":
                set {_rs::*} to split arg-3 at "||"
                loop {_rs::*}:
                    add loop-value to {방문지역::%{_p}%::*}
        else if arg-2 is "fishrecord":
            # arg-3 = "fishName::maxSize::firstDate::maxDate"
            set {_parts::*} to split arg-3 at "::"
            if size of {_parts::*} >= 4:
                set {_fname} to {_parts::1}
                replace all "_" with " " in {_fname}
                set {도감최대::%{_fname}%::%{_p}%} to {_parts::2} parsed as number
                if {_parts::3} is not "없음":
                    set {처음낚은날짜::%{_fname}%::%{_p}%} to {_parts::3}
                if {_parts::4} is not "없음":
                    set {최대낚은날짜::%{_fname}%::%{_p}%} to {_parts::4}
        else if arg-2 is "exnum":
            # arg-3 = "prefix::value"
            set {_kv::*} to split arg-3 at "::"
            if size of {_kv::*} >= 2:
                set {%{_kv::1}%::%{_p}%} to {_kv::2} parsed as number
        else if arg-2 is "exstr":
            # arg-3 = "prefix§§value" (값에 공백 가능)
            set {_kv::*} to split arg-3 at "§§"
            if size of {_kv::*} >= 2:
                set {%{_kv::1}%::%{_p}%} to {_kv::2}
        else if arg-2 is "exbool":
            # arg-3 = "prefix"
            set {%arg-3%::%{_p}%} to true
        else if arg-2 is "exflag":
            # arg-3 = "prefix||key1||key2..."  → {prefix::p::key} = true
            set {_parts::*} to split arg-3 at "||"
            set {_pre} to {_parts::1}
            set {_idx} to 0
            loop {_parts::*}:
                add 1 to {_idx}
                if {_idx} > 1:
                    set {%{_pre}%::%{_p}%::%loop-value%} to true
        else if arg-2 is "exlist":
            # arg-3 = "prefix||v1||v2..." (값 _인코딩) → {prefix::p::*} 리스트
            set {_parts::*} to split arg-3 at "||"
            set {_pre} to {_parts::1}
            delete {%{_pre}%::%{_p}%::*}
            set {_idx} to 0
            loop {_parts::*}:
                add 1 to {_idx}
                if {_idx} > 1:
                    set {_iv} to loop-value
                    replace all "_" with " " in {_iv}
                    add {_iv} to {%{_pre}%::%{_p}%::*}
        else if arg-2 is "exdex":
            # arg-3 = "cat||item1||item2..." (item 공백가능, greedy arg) → {도감발견::cat::p::item}=true
            set {_parts::*} to split arg-3 at "||"
            set {_cat} to {_parts::1}
            set {_idx} to 0
            loop {_parts::*}:
                add 1 to {_idx}
                if {_idx} > 1:
                    set {도감발견::%{_cat}%::%{_p}%::%loop-value%} to true
        else if arg-2 is "exexp":
            # arg-3 = "cat||v1||v2..." → {탐험발견::p::cat::*} 리스트(순서)
            set {_parts::*} to split arg-3 at "||"
            set {_cat} to {_parts::1}
            delete {탐험발견::%{_p}%::%{_cat}%::*}
            set {_idx} to 0
            loop {_parts::*}:
                add 1 to {_idx}
                if {_idx} > 1:
                    add loop-value to {탐험발견::%{_p}%::%{_cat}%::*}

# ===== 복원 필요 여부 체크 (Java에서 접속 시 호출) =====
command /pdcheckandrestore <text>:
    permission: op
    executable by: console
    trigger:
        set {_p} to arg-1 parsed as player
        if {_p} is not set:
            stop
        # 돈 변수가 없으면 복원 필요 (첫 접속자는 on first join에서 0으로 설정됨)
        if {돈::%{_p}%} is not set:
            execute console command "pdrestoretrigger %arg-1%"
        else if {낚시레벨::%{_p}%} is not set:
            execute console command "pdrestoretrigger %arg-1%"


# =========================================
# ===== Phase D 배치4 백업 헬퍼 (중첩 → 단일루프) =====
# =========================================
# 도감발견::<cat>::<uuid>::<item>=bool  →  카테고리당 단일루프(bare loop-index=item)
function pd백업도감발견(p: offline player, n: text, cat: text):
    set {_d} to ""
    loop {도감발견::%{_cat}%::%{_p}%::*}:
        if loop-value is true:
            if {_d} is "":
                set {_d} to "%loop-index%"
            else:
                set {_d} to "%{_d}%||%loop-index%"
    if {_d} is not "":
        execute console command "pdbackup %{_n}% exdex %{_cat}% %{_d}%"

# 탐험발견::<uuid>::<cat>::<idx>=str  →  카테고리당 단일루프(순서 보존)
function pd백업탐험발견(p: offline player, n: text, cat: text):
    set {_e} to ""
    loop {탐험발견::%{_p}%::%{_cat}%::*}:
        set {_ev} to loop-value
        if {_e} is "":
            set {_e} to {_ev}
        else:
            set {_e} to "%{_e}%||%{_ev}%"
    if {_e} is not "":
        execute console command "pdbackup %{_n}% exexp %{_cat}% %{_e}%"
