# =========================================
# 날씨시간.sk
# 날씨/시간 기반 낚시 보너스 + 특수 물고기 시스템
# =========================================

# ===== 현재 시간대 반환 =====
# Skript 시간: 0:00=MC 6AM, 6:00=MC noon, 12:00=MC 6PM, 18:00=MC midnight
function 현재시간대(p: player) :: text:
    set {_t} to time in {_p}'s world
    if {_t} is between 15:00 and 22:59:
        return "밤"
    else if {_t} is between 11:00 and 14:59:
        return "저녁"
    else if {_t} is between 3:00 and 10:59:
        return "낮"
    else:
        return "새벽"

# ===== 현재 날씨 반환 =====
function 현재날씨(p: player) :: text:
    if weather in {_p}'s world is thunder:
        return "뇌우"
    else if weather in {_p}'s world is rain:
        return "비"
    return "맑음"

# ===== 시간 보너스 (exp%|size%|gradeshift%) =====
# 낮: 경험치 특화 / 저녁: 크기 특화 / 밤: 밸런스 / 새벽: 등급업 특화
function 시간보너스(time: text) :: text:
    if {_time} is "낮":
        return "20|0|0"
    else if {_time} is "저녁":
        return "0|15|0"
    else if {_time} is "밤":
        return "10|10|1"
    else if {_time} is "새벽":
        return "0|0|2"
    return "0|0|0"

# ===== 날씨 보너스 (exp%|size%|gradeshift%) =====
# 맑음: 경험치 / 비: 크기 특화 / 뇌우: 등급업 특화
function 날씨보너스(weather: text) :: text:
    if {_weather} is "맑음":
        return "10|0|0"
    else if {_weather} is "비":
        return "0|15|1"
    else if {_weather} is "뇌우":
        return "0|0|3"
    return "0|0|0"

# ===== 시간대 색상 =====
function 시간대색상(time: text) :: text:
    if {_time} is "새벽":
        return "&d"
    else if {_time} is "낮":
        return "&e"
    else if {_time} is "저녁":
        return "&6"
    else if {_time} is "밤":
        return "&9"
    return "&f"

# ===== 날씨 색상 =====
function 날씨색상(weather: text) :: text:
    if {_weather} is "맑음":
        return "&e"
    else if {_weather} is "비":
        return "&b"
    else if {_weather} is "뇌우":
        return "&c"
    return "&f"

# ===== 커스텀 날씨 시스템 → Java WeatherManager로 이관 =====
# /날씨설정 명령어는 Java에서 처리
# Java에서 /weathersync 콘솔 명령어로 Skript 변수 동기화

# 커스텀 날씨 보너스 데이터 (Skript 낚시 로직에서 참조)
on load:
    set {커스텀날씨::태풍::보너스} to "0|25|5"
    set {커스텀날씨::태풍::효과} to "난이도+3,도망+15"
    set {커스텀날씨::안개::보너스} to "15|0|3"
    set {커스텀날씨::안개::효과} to "시야감소"
    set {커스텀날씨::모래바람::보너스} to "0|0|4"
    set {커스텀날씨::모래바람::효과} to "난이도+2"
    set {커스텀날씨::눈보라::보너스} to "30|10|0"
    set {커스텀날씨::눈보라::효과} to "난이도+1"
    set {커스텀날씨::열대야::보너스} to "10|20|2"
    set {커스텀날씨::열대야::효과} to ""
    set {커스텀날씨::땡볕::보너스} to "0|20|0"
    set {커스텀날씨::땡볕::효과} to "난이도+1"

# Java → Skript 날씨 동기화 브릿지는 공간.sk 의 /regionweatherevent 가 단독 담당.
# (Java WeatherManager 가 startGlobalWeather/syncToSkript 에서 regionweatherevent 만 dispatch)
# 과거 /weathersync 는 어디서도 호출되지 않는 사문(dead) 명령이라 제거함 — {서버날씨}는 regionweatherevent 가 권위.

# 커스텀 날씨 보너스 반환 (Skript 낚시 로직에서 호출)
function 커스텀날씨보너스() :: text:
    if {서버날씨} is set:
        return {커스텀날씨::%{서버날씨}%::보너스}
    return "0|0|0"

function 커스텀날씨이름() :: text:
    if {서버날씨} is set:
        return {서버날씨}
    return ""

function 커스텀날씨효과난이도() :: number:
    if {서버날씨} is set:
        set {_fx} to {커스텀날씨::%{서버날씨}%::효과}
        if {_fx} contains "난이도+":
            set {_parts::*} to split {_fx} at ","
            loop {_parts::*}:
                if loop-value contains "난이도+":
                    set {_v} to loop-value
                    replace "난이도+" with "" in {_v}
                    return {_v} parsed as number
    return 0

function 커스텀날씨효과도망() :: number:
    if {서버날씨} is set:
        set {_fx} to {커스텀날씨::%{서버날씨}%::효과}
        if {_fx} contains "도망+":
            set {_parts::*} to split {_fx} at ","
            loop {_parts::*}:
                if loop-value contains "도망+":
                    set {_v} to loop-value
                    replace "도망+" with "" in {_v}
                    return {_v} parsed as number
    return 0

# 환경 물고기 함수 → 지역별물고기.sk로 이관됨 (fish.json 기반)

# ===== 자체 weather 보유 가능 여부 (Java canOwnWeather 미러) =====
# - 섬 자체: 불가
# - 섬 직속 자식 (parent in 섬리스트): 가능
# - 자식의 자식 (parent in 지역리스트): 불가 → 부모 inherit 강제
function 자체날씨가능(region: text) :: boolean:
    if {섬리스트::*} contains {_region}:
        return false
    set {_pid} to {지역부모섬::%{_region}%}
    if {_pid} is not set:
        return true
    if {섬리스트::*} contains {_pid}:
        return true
    return false

# ===== 유효 커스텀 날씨 반환 (자기 active > 부모 체인 active > 전역) =====
function 유효커스텀날씨(p: player) :: text:
    set {_area} to {area::%{_p}%}
    if {_area} is not set:
        set {_area} to "0"
    if {_area} is "0":
        if {서버날씨} is set:
            return {서버날씨}
        return ""
    # 1. 자기 자신 active 우선 — 단, 자체 weather 보유 가능한 region만
    if 자체날씨가능({_area}) is true:
        if {지역날씨::%{_area}%} is set:
            return {지역날씨::%{_area}%}
    # 2. 부모 체인 active 따라가기
    set {_cur} to {_area}
    loop 32 times:
        set {_pid} to {지역부모섬::%{_cur}%}
        if {_pid} is not set:
            stop loop
        if {지역날씨::%{_pid}%} is set:
            # 자식이 거부하면 맑음
            if {지역제외날씨::%{_area}%} contains {지역날씨::%{_pid}%}:
                return ""
            return {지역날씨::%{_pid}%}
        set {_cur} to {_pid}
    # 3. 전역 날씨 (체인 어디든 제외 시 무시)
    if {서버날씨} is set:
        if {지역제외날씨::%{_area}%} contains {서버날씨}:
            return ""
        set {_cur2} to {_area}
        loop 32 times:
            set {_pid2} to {지역부모섬::%{_cur2}%}
            if {_pid2} is not set:
                stop loop
            if {지역제외날씨::%{_pid2}%} contains {서버날씨}:
                return ""
            set {_cur2} to {_pid2}
        return {서버날씨}
    return ""

# ===== 표시용 날씨 (커스텀 있으면 커스텀, 없으면 MC) =====
function 표시날씨(p: player) :: text:
    set {_custom} to 유효커스텀날씨({_p})
    if {_custom} is not "":
        return {_custom}
    return 현재날씨({_p})

# ===== 환경 보너스 알림 (지역 입장 시) =====
function 환경보너스알림(p: player):
    set {_시간대} to 현재시간대({_p})
    set {_mcWeather} to 현재날씨({_p})
    set {_displayWeather} to 표시날씨({_p})
    set {_tBonus::*} to split 시간보너스({_시간대}) at "|"
    set {_customW} to 유효커스텀날씨({_p})
    if {_customW} is not "":
        set {_cBonus::*} to split 커스텀날씨보너스지역({_p}) at "|"
        set {_expTotal} to ({_tBonus::1} parsed as number) + ({_cBonus::1} parsed as number)
        set {_sizeTotal} to ({_tBonus::2} parsed as number) + ({_cBonus::2} parsed as number)
        set {_gradeShift} to ({_tBonus::3} parsed as number) + ({_cBonus::3} parsed as number)
    else:
        set {_wBonus::*} to split 날씨보너스({_mcWeather}) at "|"
        set {_expTotal} to ({_tBonus::1} parsed as number) + ({_wBonus::1} parsed as number)
        set {_sizeTotal} to ({_tBonus::2} parsed as number) + ({_wBonus::2} parsed as number)
        set {_gradeShift} to ({_tBonus::3} parsed as number) + ({_wBonus::3} parsed as number)
    set {_tColor} to 시간대색상({_시간대})
    set {_wColor} to 날씨색상({_displayWeather})
    send "%{_tColor}%%{_시간대}% %{_wColor}%%{_displayWeather}%" to {_p}
    if {_expTotal} > 0:
        if {_gradeShift} > 0:
            send "&a  [환경 보너스] &fEXP +%{_expTotal}%%%  크기 +%{_sizeTotal}%%%  등급업 %{_gradeShift}%%%" to {_p}
        else:
            send "&a  [환경 보너스] &fEXP +%{_expTotal}%%%  크기 +%{_sizeTotal}%%%" to {_p}
    else if {_gradeShift} > 0:
        send "&a  [환경 보너스] &f등급업 %{_gradeShift}%%%" to {_p}

# ===== 지역별 커스텀 날씨 보너스 =====
function 커스텀날씨보너스지역(p: player) :: text:
    set {_w} to 유효커스텀날씨({_p})
    if {_w} is not "":
        if {커스텀날씨::%{_w}%::보너스} is set:
            return {커스텀날씨::%{_w}%::보너스}
    return "0|0|0"

# ===== /날씨 명령어 → Java WeatherInfoCommand로 이관 (BlockShip) =====
# 표시 전용 명령. 권위 변수({서버날씨}/{area}/{지역날씨} 등)는 여전히 Skript/공간.sk 소유지만,
# Java는 RegionTracker/WeatherManager/FishLoader 자체 권위로만 동작(Skript 변수 안 읽음).
# 이 파일의 함수들(현재시간대/현재날씨/시간보너스/날씨보너스/유효커스텀날씨/커스텀날씨* 등)은
# 낚시.sk·사이드바.sk·장비.sk·공간.sk(미이관)가 라이브로 호출하므로 그대로 유지한다.
