# =========================================
# 돈_bridge.sk — Phase 5 fishing 머니 지급 브릿지
# Java(낚시 보상/자동판매/대회상금)가 계산한 금액을 라이브 {돈} 에 더함.
# {돈} 권위는 Skript 유지(23개 스크립트가 읽고씀) — Java는 오늘 Skript가 하던 'add to {돈}'을 대신 트리거만.
# 콘솔/내부 전용. Java FishingHooks.pay()가 fishing.pay.java 켜졌을 때만 호출 → 현재 휴면.
# =========================================

command /fishpay <text> <number>:
    permission: op
    executable by: console
    trigger:
        set {_p} to arg-1 parsed as player
        if {_p} is not set:
            stop
        if {돈::%{_p}%} is not set:
            set {돈::%{_p}%} to 0
        add arg-2 to {돈::%{_p}%}

# ===== 머니 접근 브릿지 (Java MoneyBridge용) — {돈}은 Skript 단일 권위 유지 =====
# 읽기: Java가 호출 → 현재 {돈}을 Java PlayerData.money 캐시에 push (동기)
command /moneyread <text>:
    permission: op
    executable by: console
    trigger:
        set {_p} to arg-1 parsed as player
        if {_p} is not set:
            stop
        if {돈::%{_p}%} is not set:
            set {돈::%{_p}%} to 0
        execute console command "moneycacheset %{_p}'s name% %{돈::%{_p}%}%"

# 오프라인 포함 지급 (마켓 판매자 등): 이름→offline player 키로 {돈} 가산
command /moneyoffline <text> <number>:
    permission: op
    executable by: console
    trigger:
        set {_op} to arg-1 parsed as offline player
        if {_op} is not set:
            stop
        if {돈::%{_op}%} is not set:
            set {돈::%{_op}%} to 0
        add arg-2 to {돈::%{_op}%}

# 쓰기: Java가 계산 후 {돈} 변경 (오늘 Skript가 하던 그대로)
command /moneyop <text> <text> <number>:
    permission: op
    executable by: console
    trigger:
        set {_p} to arg-1 parsed as player
        if {_p} is not set:
            stop
        if {돈::%{_p}%} is not set:
            set {돈::%{_p}%} to 0
        if arg-2 is "add":
            add arg-3 to {돈::%{_p}%}
        else if arg-2 is "subtract":
            subtract arg-3 from {돈::%{_p}%}
        else if arg-2 is "set":
            set {돈::%{_p}%} to arg-3
