# ===== 날개 그리기 함수 (하이픽셀 방식) =====
# 핵심: dust 파티클 + count 0 + speed 0 → 정확한 좌표에 1점, 수명 최소
# 매 틱마다 그려서 잔상 없이 플레이어를 따라감
function 날개그리기(p: player, coords: texts, r: number, g: number, b: number, size: number):
    set {_loc} to location of {_p}
    set {_yaw} to yaw of {_p}
    # 등 뒤 방향 (yaw + 180)
    set {_backRad} to ({_yaw} + 180) * 3.14159 / 180
    # 좌우 방향 (yaw + 90)
    set {_sideRad} to ({_yaw} + 90) * 3.14159 / 180
    set {_backX} to -1 * sin({_backRad}) * 0.35
    set {_backZ} to cos({_backRad}) * 0.35
    set {_baseX} to x-coordinate of {_loc} + {_backX}
    set {_baseY} to y-coordinate of {_loc} + 0.8
    set {_baseZ} to z-coordinate of {_loc} + {_backZ}
    set {_w} to world of {_p}
    loop {_coords::*}:
        set {_pt::*} to split loop-value at "|"
        set {_side} to {_pt::1} parsed as number
        set {_up} to {_pt::2} parsed as number
        set {_sideX} to -1 * sin({_sideRad}) * {_side}
        set {_sideZ} to cos({_sideRad}) * {_side}
        set {_ly} to {_baseY} + {_up}
        # 왼쪽 날개 — dust count:0 speed:0 = 정확한 좌표에 1점
        set {_lx} to {_baseX} + {_sideX}
        set {_lz} to {_baseZ} + {_sideZ}
        execute console command "particle dust %{_r}% %{_g}% %{_b}% %{_size}% %{_lx}% %{_ly}% %{_lz}% 0 0 0 0 1 force"
        # 오른쪽 날개 (좌우반전)
        set {_rx2} to {_baseX} - {_sideX}
        set {_rz2} to {_baseZ} - {_sideZ}
        execute console command "particle dust %{_r}% %{_g}% %{_b}% %{_size}% %{_rx2}% %{_ly}% %{_rz2}% 0 0 0 0 1 force"

# 매 2틱마다 렌더 (1틱=너무 빈번, 4틱=잔상)
# dust 파티클 기본 수명 ~1초지만 count:0+speed:0이면 제자리에 고정
# 2틱 간격이면 이전 프레임이 거의 사라질 때 새 프레임 그려짐
every 2 ticks:
    loop all players:
        set {_fx} to {장착이펙트::날개::%loop-player%}
        if {_fx} is set:
            if {_fx} is "천사날개":
                # 흰색, 사이즈 0.7 (작은 점 = 깃털 느낌)
                날개그리기(loop-player, {날개좌표::천사::*}, 1.0, 1.0, 1.0, 0.7)
            else if {_fx} is "악마날개":
                # 붉은색, 사이즈 0.8
                날개그리기(loop-player, {날개좌표::악마::*}, 0.8, 0.1, 0.1, 0.8)
            else if {_fx} is "나비날개":
                # 보라+분홍, 사이즈 0.6 (작은 나비)
                날개그리기(loop-player, {날개좌표::나비::*}, 0.8, 0.3, 0.9, 0.6)
            else if {_fx} is "용날개":
                # 주황+금색, 사이즈 0.9 (크고 위엄)
                날개그리기(loop-player, {날개좌표::용::*}, 1.0, 0.6, 0.0, 0.9)

# ===== 캐시상점 연동 =====
# 이펙트 상점 데이터는 캐시상점.sk에서 일괄 관리
# 이 파일에서는 이펙트 실행/GUI만 담당
