# =========================================
# 수표.sk
# /수표 <금액> [장수]
# 돈 → 종이 수표로 출금 (수수료 5%, 올림)
# 우클릭/좌클릭 입금은 돈.sk 에서 처리
# =========================================

options:
    prefix: &8[&b 수표 &8]
    good: &a
    bad: &c
    hint: &7
    emph: &e
    info: &f
    fee_rate: 0.05

on tab complete of "/수표":
    set tab completions for position 1 to "<금액>"
    set tab completions for position 2 to "[장수]"

command /수표 [<text>] [<text>]:
    aliases: /tnvy
    trigger:
        if {돈::%player%} is not set:
            set {돈::%player%} to 0

        if arg-1 is not set:
            message "{@prefix} {@hint}사용법: {@emph}/수표 <금액> [장수] {@hint}| 수수료: {@emph}5%%" to player
            message "{@hint}손에 들고 우클릭 → 1장 입금 | 좌클릭 → 묶음 전체 입금" to player
            stop

        set {_check} to arg-1 parsed as number
        if {_check} is not set:
            message "{@prefix} {@bad}금액은 숫자만 입력해 주세요." to player
            stop
        if {_check} <= 0:
            message "{@prefix} {@bad}금액은 1 이상이어야 합니다." to player
            stop

        # 인벤 빈칸 체크
        delete {_empty}
        loop 36 times:
            if slot (loop-iteration - 1) of player's inventory is air:
                set {_empty} to true
                stop loop
        if {_empty} is not set:
            message "{@prefix} {@bad}인벤토리에 빈 공간이 없습니다. {@hint}(수표를 받을 공간이 필요합니다)" to player
            stop

        # 장수 파싱 (기본 1장)
        set {_count} to 1
        if arg-2 is set:
            set {_count} to arg-2 parsed as integer
            if {_count} is not set:
                message "{@prefix} {@bad}장수는 정수만 입력해 주세요." to player
                stop
            if {_count} <= 0:
                message "{@prefix} {@bad}장수는 1 이상이어야 합니다." to player
                stop

        # 수수료 계산 (5%, 올림) — 수표 액면가는 그대로, 뽑는 사람이 수수료 부담
        set {_총액면} to {_check} * {_count}
        set {_총수수료} to ceil({_총액면} * {@fee_rate})
        set {_총차감} to {_총액면} + {_총수수료}

        if {돈::%player%} < {_총차감}:
            set {_단수수료} to ceil({_check} * {@fee_rate})
            message "{@prefix} {@bad}잔액이 부족합니다. {@hint}필요: {@emph}%{_총차감}%원 {@hint}(액면 %{_총액면}%원 + 수수료 %{_총수수료}%원) | 보유: {@emph}%{돈::%player%}%원" to player
            stop

        set {_ts} to unix timestamp of now
        set {_bill} to paper named "&e%{_check}%원"
        set lore of {_bill} to "&8━━━━━━━━━━━━━" and "&f액면가: &e%{_check}%원" and "&8━━━━━━━━━━━━━" and "&7발행처: &f바르칸 열도 중앙은행" and "&7발행일: &f%{_ts}%" and "&7발행인: &f%player's name%" and "&8━━━━━━━━━━━━━" and "&8[바르칸열도 정식발행]"
        give {_count} of {_bill} to player
        subtract {_총차감} from {돈::%player%}

        if {_count} is 1:
            message "{@prefix} {@good}발행 완료! {@hint}액면가: {@emph}%{_check}%원 {@hint}| 수수료: {@emph}%{_총수수료}%원 {@hint}| 잔액: {@emph}%{돈::%player%}%원" to player
        else:
            message "{@prefix} {@good}발행 완료! {@hint}액면가: {@emph}%{_총액면}%원 {@hint}(&f%{_count}%장{@hint}) | 수수료: {@emph}%{_총수수료}%원 {@hint}| 잔액: {@emph}%{돈::%player%}%원" to player
