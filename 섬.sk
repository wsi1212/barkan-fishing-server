# 섬 명령어 — SuperiorSkyblock2 /is 한글 래퍼

command /섬 [<text>]:
    aliases: /tja
    trigger:
        if arg-1 is "퇴장" or "xhdwkd":
            # 섬 월드에 있는지 체크 (SuperiorSkyblock2 월드 이름에 "island" 포함)
            set {_w} to "%world of player%"
            if {_w} contains "Superior":
                if {섬이전위치::%player%} is set:
                    teleport player to {섬이전위치::%player%}
                    send "&a이전 위치로 돌아왔습니다." to player
                    delete {섬이전위치::%player%}
                else:
                    # 이전 위치가 없으면 flatroom 스폰으로
                    teleport player to spawn of world "world"
                    send "&a메인 월드로 돌아왔습니다." to player
            else:
                send "&c섬이 아닙니다." to player
        else if arg-1 is "메뉴":
            make player execute command "/is panel"
        else if arg-1 is "생성":
            set {섬이전위치::%player%} to location of player
            make player execute command "/is create %player%"
            set {섬생성::%player%} to true
        else:
            # 섬 입장 전 현재 위치 저장
            set {섬이전위치::%player%} to location of player
            if arg-1 is set:
                make player execute command "/is %arg-1%"
            else:
                # 섬이 없으면 자동 생성, 있으면 이동
                if {섬생성::%player%} is not set:
                    make player execute command "/is create %player%"
                    set {섬생성::%player%} to true
                else:
                    make player execute command "/is go"

on tab complete of "/섬":
    set tab completions for position 1 to "퇴장", "생성", "메뉴"
